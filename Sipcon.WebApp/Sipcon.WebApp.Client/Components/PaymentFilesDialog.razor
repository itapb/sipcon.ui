

@using Sipcon.WebApp.Client.Pages
@using Sipcon.WebApp.Client.Repository.Auth
@using System.Text.RegularExpressions
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using FluentValidation


@inject IAttachmentService AttachmentService
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime

<MudDialog Class="blur dialog-background" ActionsClass="dialog-background-surface">

    <DialogContent>

        <MudContainer Class="blur dialog-background-title py-2 pt-2 pa-2">
            <MudText Typo="Typo.h6">

                <MudIcon Icon="@Icons.Material.Filled.UploadFile" Class="mr-3 mb-n1" />
                @Title

            </MudText>
        </MudContainer>

        <MudContainer Class="dialog-background-surface py-2 pt-2 pa-2">

            
        @* Attachment *@
        <MudCard Elevation="2" Class="pa-1 mt-2">
            <MudCardHeader Style="padding-bottom: 0px;">
                <CardHeaderContent>
                    <MudStack Row="true">
                        <MudIcon Icon="@Icons.Material.Outlined.FileUpload" Color="Color.Default" Style="font-size: 1.8rem;"></MudIcon>
                        <MudText Typo="Typo.subtitle2">Comprobantes Cargados</MudText>
                    </MudStack>
                </CardHeaderContent>
                <CardHeaderActions>
                    <div class="d-flex justify-left">
                            <MudStack Row="true" @onclick="() => ClickUploadFiles()">
                                <MudText Typo="Typo.subtitle2" Class="mt-2">Agregar</MudText>
                                <MudBadge Content="_attachment.Count()" Color="Color.Primary" Overlap="true"
                                          Class="mr-6 mt-2" OnClick="() => ClickUploadFiles()">
                                    <MudIcon Icon="@Icons.Material.Filled.AttachFile" Color="Color.Default" />
                                </MudBadge>
                            </MudStack>
                            <MudButton StartIcon="@Icons.Material.Filled.KeyboardReturn" Variant="Variant.Text"
                                       Color="Color.Dark" IconColor="Color.Secondary" IconSize="Size.Small" Size="Size.Small"
                                       OnClick="() => OnClickCloseButton()">
                                Cerrar
                            </MudButton>
                    </div>
                        
                </CardHeaderActions>
            </MudCardHeader>

            <MudCardContent Style="padding-top: 0px;">

                <div id="unique_id_scroll_section" class="ma-0" style="height:230px;overflow: auto;">

                    <MudContainer Class="dialog-background-surface py-1 pt-0 pa-1">
                        <MudDivider />
                        @if (_attachment.Count > 0)
                        {
                            <MudGrid Spacing="0" Justify="Justify.Center">

                                @foreach (var item in _attachment)
                                {
                                    <MudItem xs="12" sm="4">
                                        <MudLink OnClick="() => ClickPreviewImage(item.Id, item.FileName)" Color="Color.Info">
                                            <MudText Typo="Typo.caption">
                                                <MudIcon Icon="@Icons.Custom.FileFormats.FileDocument" Color="Color.Inherit" Class="mr-2" />@item.FileName
                                            </MudText>
                                        </MudLink>
                                    </MudItem>
                                    <MudItem xs="12" sm="4">
                                        <MudText Typo="Typo.caption">@item.DateCreate!.Value.ToString("F", CultureInfo.GetCultureInfo("es-VE"))</MudText>
                                    </MudItem>
                                    <MudItem xs="12" sm="4">
                                        <div class="d-flex justify-left">
                                            <MudStack Row="true">
                                                <MudTooltip Text="descargar">
                                                    <MudIconButton Icon="@Icons.Material.Outlined.FileDownload" Class="mr-2" Color="Color.Info" Size="Size.Small" OnClick="() => ClickExportAttachment(item.Id, item.FileName)" />
                                                </MudTooltip>
                                                <MudTooltip Text="eliminar">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Class="mr-2" Color="Color.Info" Size="Size.Small" OnClick="() => ClickDeleteAttachment(item.Id)" />
                                                </MudTooltip>
                                                <MudTooltip Text="vista previa">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Preview" Class="mr-2" Color="Color.Info" Size="Size.Small" OnClick="() => ClickPreviewImage(item.Id, item.FileName)" />
                                                </MudTooltip>
                                            </MudStack>
                                        </div>
                                    </MudItem>
                                }
                            </MudGrid>
                        }
                    </MudContainer>
                    <MudScrollToTop TopOffset="100"
                                    Selector="#unique_id_scroll_section"
                                    VisibleCssClass="visible absolute"
                                    HiddenCssClass="invisible">

                    </MudScrollToTop>
                </div>

                <MudDivider />

                    @if (!_nestedVisible)
                    {
                        <MudPaper Class="ma-2 mt-6"  Elevation="1" >
                            <MudContainer Style="padding: 6px;">
                                <div class="d-flex">
                                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="0">
                    
                                        <MudIcon Icon="@Icons.Material.Filled.Info" Color="@(_success ? Color.Default : Color.Error)" Style="font-size: 2rem;"></MudIcon>
                                        <MudText Class="nested"><p>@_nestedErrorMessage</p> </MudText>
                    
                                    </MudStack>

                                    @* <div class="d-flex ml-auto">
                                        <MudStack Row="false" AlignItems="AlignItems.End" Spacing="0">
                        
                                        </MudStack>
                            
                                    </div> *@

                                </div>
                            </MudContainer>
     
                        </MudPaper>

    
    
                    }

            </MudCardContent>
        </MudCard>
            
           

        @if (!dataLoaded)
        {
            <MudOverlay Visible="isLoaded" DarkBackground="true" Absolute="true">
                <MudProgressCircular Color="Color.Secondary" Indeterminate="true" />
            </MudOverlay>
        }

        </MudContainer>

        

    </DialogContent>
    
</MudDialog>


    


@code { 
    [Inject] private UserSession Session { get; set; } = null!;
    [Inject] private AuthenticationProviderJWT AuthenticationStateProvider { get; set; } = null!;
    
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter]public string IdPayment { get; set; } = string.Empty;
    [Parameter] public string Title { get; set; } = string.Empty;
    
    private List<Attachment> _attachment { get; set; } = new List<Attachment>();
   
    private string _moduleName = "PAGOS-ASEGURAMIENTO";
    
    private string _nestedErrorMessage { get; set; } = string.Empty;
    private bool _nestedVisible { get; set; } = true;
    private bool _success { get; set; } = false;
    private bool dataLoaded = false;
    private bool isLoaded = false;

   
   
    IList<IBrowserFile> _files = new List<IBrowserFile>();
    private void UploadFiles(IBrowserFile file)
    {
        _files.Add(file);
        //TODO upload the files to the server
    }


    protected override async Task OnInitializedAsync()
    {
        await AuthenticationStateProvider.RefreshStaticVariables();
        Session.IsNewOrEdit = true;

        await GetPaymentDetails();

        StateHasChanged();
        await Task.CompletedTask;

    }


    private async Task GetPaymentDetails()
    {

        await GetAttachments();
            
        await Task.Delay(50);
        StateHasChanged();
       

    }

    private async Task OnClickCloseButton()
    {
       
        MudDialog.Close(DialogResult.Ok(true));

    }

    private async Task GetAttachments()
    {
        _attachment = new List<Attachment>();
        var serviceResponse = await AttachmentService.GetAttachments(Convert.ToInt32(IdPayment), _moduleName);
        if (serviceResponse.Processed)
        {
            _attachment = serviceResponse.Data ?? new List<Attachment>();

            await Task.Delay(50);
            StateHasChanged();
        }

        await Task.CompletedTask;
    }


    private async Task ClickDeleteAttachment(int IdAttachment)
    {
        var option = new DialogOptions
        {
            CloseButton = false,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            BackdropClick = false
        };
        bool? result = await DialogService.ShowMessageBox(
            "Comprobantes Agregados",
            $"Seguro de Eliminar Archivo? ",
            yesText: "Si", noText: "No", "", option);

        if (result == true)
        {
            _nestedErrorMessage = string.Empty;
            _nestedVisible = true;
            var serviceResponse = await AttachmentService.DeleteAttachment(IdAttachment, Session.UserId);
            if (serviceResponse.Processed)
            {
                await GetAttachments();
                await Task.Delay(50);
            }
            else
            {
                //Console.WriteLine(serviceResponse.Message);
                _success = false;
                _nestedErrorMessage = serviceResponse.Message ?? MessageEnum.GenerateNotOK.GetStringValue();
                
                OpenNested();
            }
            StateHasChanged();
            await Task.CompletedTask;
           

           
        }
    }

    private async Task ClickPreviewImage(int IdAttachment, string FileName)
    {
        _nestedErrorMessage = string.Empty;
        _nestedVisible = true;

        DialogOptions options = new() { BackdropClick = false, MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true, NoHeader = false };
        var parameters = new DialogParameters<PreviewImageDialog> { { x => x.Title, "Vista Previa." } , { x => x.IdAttachment, IdAttachment.ToString() } , { x => x.NameAttachment, FileName } };
        var dialog = await DialogService.ShowAsync<PreviewImageDialog>("Vista Previa.", parameters, options);

        StateHasChanged();

        await Task.CompletedTask;
    }

    private async Task ClickExportAttachment(int IdAttachment, string FileName)
    {
        _nestedErrorMessage = string.Empty;
        _nestedVisible = true;
        var serviceResponse = await AttachmentService.GetAttachment(IdAttachment, Session.UserId);
        if (serviceResponse.Processed)
        {
            _success = true;
            _nestedErrorMessage = "";

            var applicationName = string.Empty;
            var fileExtension = Path.GetExtension(FileName).ToLowerInvariant();
            switch (fileExtension)
            {
                case ".jpg":
                case ".jpeg":
                    applicationName = "image/jpeg";
                    break;
                case ".png":
                case ".pneg":
                    applicationName = "image/png";
                    break;
                case ".mp4":
                    applicationName = "video/mp4";
                    break;
                case ".pdf":
                    applicationName = "application/pdf";
                    break;
                default:
                    applicationName = "application/pdf";
                    break;
            }

            var base64File = Convert.ToBase64String(serviceResponse.Data.ToArray());
            var fileUrl = $"data:{applicationName};base64,{base64File}";
            await JSRuntime.InvokeVoidAsync("downloadFile", fileUrl, FileName);

        }
        else
        {
            _success = false;
            _nestedErrorMessage = serviceResponse.Message ?? MessageEnum.ExportNotOK.GetStringValue();
            OpenNested();

        }
    }


    private async Task ClickUploadFiles()
    {
        _nestedErrorMessage = string.Empty;
        _nestedVisible = true;
        DialogOptions options = new() { BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = false, NoHeader = true };
        var parameters = new DialogParameters<ImporFilesDialog> { { x => x.Title, "Cargar Comprobante" } };
        var dialog = await DialogService.ShowAsync<ImporFilesDialog>("Cargar Comprobante", parameters, options);

        var result = await dialog.Result;
        if (!result!.Canceled)
        {
            bool isFormData = false;
            dataLoaded = false;
            isLoaded = true;
            StateHasChanged();
            IReadOnlyList<IBrowserFile> files = (IReadOnlyList<IBrowserFile>)(result.Data ?? new List<IBrowserFile>());
            const long maxAllowedSize = 6 * 1024 * 1024; // 6MB
            //Console.WriteLine($"Número de archivos seleccionados: {files.Count}");

            using (MultipartFormDataContent formData = new MultipartFormDataContent())
            {
                foreach (var file in files)
                {

                    if (file.Size == 0)
                    {
                        _success = false;
                        isFormData = false;
                        _nestedErrorMessage = MessageEnum.ImportError.GetStringValue();
                        dataLoaded = true;
                        isLoaded = false;
                        StateHasChanged();
                        OpenNested();
                        break;
                    }
                    else if (file.Size > maxAllowedSize)
                    {
                        _success = false;
                        isFormData = false;
                        _nestedErrorMessage = MessageEnum.ImportErrorMaxByte.GetStringValue();
                        dataLoaded = true;
                        isLoaded = false;
                        StateHasChanged();
                        OpenNested();
                        break;
                    }
                    else
                    {

                        var content = new StreamContent(file.OpenReadStream(maxAllowedSize: maxAllowedSize));

                        content.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);

                        formData.Add(content, "files", file.Name);

                        isFormData = true;

                    }
                }

                if (isFormData)
                {
                    var serviceResponse = await AttachmentService.CreateAttachment(Convert.ToInt32(IdPayment), _moduleName, Session.UserId, formData);
                    if (serviceResponse.Processed)
                    {
                        _success = true;
                        _nestedErrorMessage = MessageEnum.ImportOK.GetStringValue();
                        dataLoaded = true;
                        isLoaded = false;
                        StateHasChanged();
                        await GetAttachments();
                    }
                    else
                    {
                        _success = false;
                        _nestedErrorMessage = serviceResponse.Message ?? MessageEnum.ImportNotOK.GetStringValue();
                        dataLoaded = true;
                        isLoaded = false;
                        StateHasChanged();
                        OpenNested();
                    }
                     StateHasChanged();
                    await Task.Delay(50);
                }
                else{
                    dataLoaded = true;
                    isLoaded = false;
                    StateHasChanged();
                }
            }

        }

        await Task.CompletedTask;
    }


    private void OpenNested()
    {
        _nestedVisible = false;
        StateHasChanged();
    }


    

}
