@inject IDialogService DialogService

<MudDataGrid @ref="PaymentPreviewDataGrid"
             T="Payment"
             ServerData="LoadGridData"
             Hover="false"
             Dense="true"
             Bordered="false"
             Filterable="false"
             Striped="false"
             FixedHeader
             Height="260px"
             Style="width: 100%;">
    <Columns>

        <TemplateColumn Title="Tipo" HeaderStyle="width: 25%;">
            <CellTemplate>
                <div class="d-flex justify-start">
                    @if (context.Item.TypeName != null)
                    {
                        Color color = Color.Default;
                        string style = "font-size: 11px; font-style: italic; margin: 0;";
                        string txt = "";

                        var pair = context.Item.TypeName.ToUpper() switch
                        {
                            "RETENCION" => (txt: "Retencion", color: Color.Dark),
                            "TRANSFERENCIA" => (txt: "Transferencia", color: Color.Info),
                            "EFECTIVO" => (txt: "Efectivo", color: Color.Success),
                            _ => (txt: "", color: Color.Error)
                        };
                        txt = pair.txt;
                        color = pair.color;

                        <MudChip T="string" Variant="Variant.Text" Color="@color" Size="Size.Small" Style="@style">
                            @(txt)
                        </MudChip>
                    }
                </div>
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="Referencia" HeaderStyle="width: 25%;">
            <CellTemplate>
                <MudText Typo="Typo.caption" Align="Align.Left" Inline="true" Color="Color.Primary" Style="font-weight:bold; word-break: break-all;">
                    @context.Item.Reference
                </MudText>
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="Moneda" HeaderStyle="width: 25%;">
            <CellTemplate>
                <div class="d-flex justify-start">
                    @if (context.Item.CurrencyName != null)
                    {
                        Color color = Color.Default;
                        string style = "font-size: 10px; font-style: italic; margin: 0;";
                        string txt = "";

                        var pair = context.Item.CurrencyName.ToUpper() switch
                        {
                            "BS - BOLIVAR" => (txt: "Bs." + context.Item.AmountBs?.ToString("N2"), color: Color.Warning),
                            "$ - DOLAR" => (txt: "$." + context.Item.Amount?.ToString("N2"), color: Color.Success),
                            _ => (txt: "", color: Color.Error)
                        };
                        txt = pair.txt;
                        color = pair.color;

                        <MudChip T="string" Variant="Variant.Text" Color="@color" Size="Size.Small" Style="@style">
                            @(txt)
                        </MudChip>
                    }
                </div>
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="Fecha" HeaderStyle="width: 15%;">
            <CellTemplate>
                <MudText Typo="Typo.caption" Align="Align.Left" Style="font-size: 11px;">
                    @(context.Item.Date.ToString("dd/MM/yyyy"))
                </MudText>
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn StickyRight="true" HeaderStyle="width: 10%; min-width: 90px;">
            <CellTemplate>
                <MudButtonGroup Size="@Size.Small" Variant="Variant.Text" Color="Color.Dark">
                    @if (context.Item.StatusName != null && (context.Item.StatusName.ToUpper() == "BORRADOR" || context.Item.StatusName.ToUpper() == "PARA APROBAR"))
                    {
                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="() => OnClickEditButton(context.Item)" Class="pa-1" />
                    }
                    @if (context.Item.StatusName != null && context.Item.StatusName.ToUpper() == "BORRADOR")
                    {
                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="() => OnClickDeleteButton(context.Item)" Class="pa-1" />
                    }
                    <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.AttachFile" OnClick="() => OnClickAttachamentButton(context.Item)" Class="pa-1" />
                </MudButtonGroup>
            </CellTemplate>
        </TemplateColumn>

    </Columns>
</MudDataGrid>


@code { 

    [Parameter] public IEnumerable<Payment> PaymentDetails { get; set; } = new List<Payment>();
    [Parameter] public EventCallback<Payment> OnClickPaymentEdit { get; set; }
    [Parameter] public EventCallback<Payment> OnClickPaymentDelete { get; set; }

    private MudDataGrid<Payment>? PaymentPreviewDataGrid;

    private int _rowCount = 0;

    protected override async Task OnInitializedAsync()
    {
        
        await ReloadPaymentReportGrid();
        

    }

    private async Task ReloadPaymentReportGrid()
    {
        if (PaymentPreviewDataGrid != null)
        {
            await PaymentPreviewDataGrid.ReloadServerData();
        }
    }

    private async Task<GridData<Payment>> LoadGridData(GridState<Payment> state)
    {

        _rowCount = state.Page * state.PageSize;

        return new GridData<Payment> { TotalItems = PaymentDetails.Count(), Items = PaymentDetails };
    }


    private async Task OnClickEditButton(Payment payment)
    {
        await OnClickPaymentEdit.InvokeAsync(payment);
        StateHasChanged();
    }

    private async Task OnClickDeleteButton(Payment payment)
    {
        await OnClickPaymentDelete.InvokeAsync(payment);
        StateHasChanged();
    }

    private async Task OnClickAttachamentButton(Payment args)
    {

        DialogOptions options = new() { BackdropClick = false, MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = false, NoHeader = true };
        var parameters = new DialogParameters<PaymentFilesDialog> { { x => x.Title, "Agregar Comprobantes" }, { x => x.IdPayment, args.Id.ToString() } };
        var dialog = await DialogService.ShowAsync<PaymentFilesDialog>("Agregar Comprobantes", parameters, options);

        var result = await dialog.Result;
        if (!result!.Canceled)
        {
            await PaymentPreviewDataGrid!.ReloadServerData();

        }
        StateHasChanged();
        await Task.CompletedTask;
    }

}
