

<MudDataGrid @ref="PaymentPreviewDataGrid"
        T="Payment"
        ServerData="LoadGridData"
        Hover="false"
        Dense="true"
        Bordered="false"
        Filterable="false"
        Striped="false" 
        FixedHeader Height="calc(68vh - 40px)"
>
    <Columns>
        
        <TemplateColumn Title="Tipo">
            <CellTemplate>
                <div class="d-flex justify-start">
                    @if (context.Item.TypeName != null)
                    {
                        Color color = Color.Default;
                        string style = "";
                        string txt = "";
                        if (context.Item.TypeName.ToUpper() == "RETENCION")
                        {
                            color = Color.Dark;
                            txt = "Retencion";
                        }
                        else if (context.Item.TypeName.ToUpper() == "TRANSFERENCIA")
                        {
                            color = Color.Info;
                            txt = "Transferencia";
                        }
                        else if (context.Item.TypeName.ToUpper() == "EFECTIVO")
                        {
                            color = Color.Success;
                            txt = "Efectivo";
                        }
                        else
                        {
                            color = Color.Error;
                        }
                        style += ";font-size: 12px";
                        style += ";font-style:italic";

                        <MudChip T="string" Variant="Variant.Text" Color="@color" Style="@style">
                            @(txt)
                        </MudChip>
                    }
                   
                </div>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Referencia">
            <CellTemplate>
                <MudText Typo="Typo.caption" Align="Align.Left" Inline="true" Color="Color.Primary" Style="font-weight:bold;">@context.Item.Reference</MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Monto">
            <CellTemplate>
                <div class="d-flex justify-center">
                    <MudText Typo="Typo.caption" Align="Align.End">
                        @(context.Item.Amount?.ToString("N2"))
                    </MudText>
                </div>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Moneda">
            <CellTemplate>
                <div class="d-flex justify-start">
                    @if (context.Item.CurrencyName != null)
                    {
                        Color color = Color.Default;
                        string style = "";
                        string txt = "";
                        if (context.Item.CurrencyName.ToUpper() == "BS - BOLIVAR")
                        {
                            color = Color.Warning;
                            txt = "Bs.";
                        }
                        else if (context.Item.CurrencyName.ToUpper() == "$ - DOLAR")
                        {
                            color = Color.Success;
                            txt = "USD";
                        }
                        else
                        {
                            color = Color.Error;
                        }
                        style += ";font-size: 12px";
                        style += ";font-style:italic";

                        <MudChip T="string" Variant="Variant.Text" Color="@color" Style="@style">
                            @(txt)
                        </MudChip>
                    }
                   
                </div>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Fecha">
            <CellTemplate>
                <MudText Typo="Typo.caption" Align="Align.Left">@(context.Item.DateRate.ToString("dd/MM/yyyy"))</MudText>
            </CellTemplate>
        </TemplateColumn>
       
        @* <TemplateColumn StickyRight="true">
            <CellTemplate>
                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.AttachFile" Href="@("paymentfiles/" + context.Item.Id)" />
            </CellTemplate>
        </TemplateColumn> *@
        <TemplateColumn StickyRight="true">
            <CellTemplate>
                @if (context.Item.StatusName != null)
                {
                    if (context.Item.StatusName.ToUpper() == "BORRADOR")
                    {
                        <MudButtonGroup Size="@Size.Small" Variant="Variant.Text" Color="Color.Dark">
                            <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="() => OnClickEditButton(context.Item)" />
                            <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="() => OnClickDeleteButton(context.Item)" />
                        </MudButtonGroup>
                        
                    }
                }
            </CellTemplate>
        </TemplateColumn>

    </Columns>
</MudDataGrid>


@code { 

    [Parameter] public IEnumerable<Payment> PaymentDetails { get; set; } = new List<Payment>();
    [Parameter] public EventCallback<Payment> OnClickPaymentEdit { get; set; }
    [Parameter] public EventCallback<Payment> OnClickPaymentDelete { get; set; }

    private MudDataGrid<Payment>? PaymentPreviewDataGrid;

    private int _rowCount = 0;

    protected override async Task OnInitializedAsync()
    {
        
        await ReloadPaymentReportGrid();
        

    }

    

    private async Task ReloadPaymentReportGrid()
    {
        if (PaymentPreviewDataGrid != null)
        {
            await PaymentPreviewDataGrid.ReloadServerData();
        }
    }

    

    private async Task<GridData<Payment>> LoadGridData(GridState<Payment> state)
    {

        _rowCount = state.Page * state.PageSize;

        return new GridData<Payment> { TotalItems = PaymentDetails.Count(), Items = PaymentDetails };
    }


    private async Task OnClickEditButton(Payment payment)
    {
        await OnClickPaymentEdit.InvokeAsync(payment);
        StateHasChanged();
    }

    private async Task OnClickDeleteButton(Payment payment)
    {
        await OnClickPaymentDelete.InvokeAsync(payment);
        StateHasChanged();
    }

}
