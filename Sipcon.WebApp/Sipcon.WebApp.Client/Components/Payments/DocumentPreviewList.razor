
@inject IPaymentService PaymentService
@inject ISnackbar Snackbar
@using System.Globalization

<MudDataGrid @ref="DocumentPreviewDataGrid"
             T="AccountPreview"
             ServerData="LoadGridData"
             Hover="false"
             Dense="true"
             Bordered="false"
             Filterable="false"
             Striped="true"
             Class="mt-2"
             FixedHeader
             Height="calc(28vh - 40px)">
    <Columns>
        @* 1. Documento (Texto - Alineado a la Izquierda) *@
        <TemplateColumn Title="Documento" HeaderClass="px-2 text-start" CellClass="px-2 text-start" HeaderStyle="width: 110px;">
            <CellTemplate>
                <MudText Typo="Typo.caption" Color="Color.Primary" Class="fw-bold">
                    @context.Item.Number
                </MudText>
            </CellTemplate>
        </TemplateColumn>

        @* 2. Fecha Tasa (Texto/Fecha - Alineado a la Izquierda) *@
        <TemplateColumn Title="Fecha Tasa" HeaderClass="px-2 text-start" CellClass="px-2 text-start" HeaderStyle="width: 100px;">
            <CellTemplate>
                <MudText Typo="Typo.caption">
                    @(context.Item.DateRate?.ToString("dd/MM/yyyy"))
                </MudText>
            </CellTemplate>
        </TemplateColumn>

        @* 3. Concepto (Badges - Alineado a la Izquierda) *@
        <TemplateColumn Title="Concepto" HeaderClass="px-2 text-start" CellClass="px-2 text-start" HeaderStyle="width: 140px;">
            <CellTemplate>
                @if (context.Item.ConceptName != null)
                {
                    var pair = context.Item.ConceptName.ToUpper() switch
                    {
                        "BASE" => (txt: "Base", color: Color.Dark),
                        "PLACA" => (txt: "Placa", color: Color.Info),
                        "IVA (25%)" => (txt: "IVA (25%)", color: Color.Success),
                        "RETENCION IVA (75%)" => (txt: "Retención IVA (75%)", color: Color.Warning),
                        _ => (txt: context.Item.ConceptName, color: Color.Error)
                    };

                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@pair.color" Class="ma-0 pa-0">
                        @pair.txt
                    </MudChip>
                }
            </CellTemplate>
        </TemplateColumn>

        @* 4. Tipo (Badges - Alineado a la Izquierda) *@
        <TemplateColumn Title="Tipo" HeaderClass="px-2 text-start" CellClass="px-2 text-start" HeaderStyle="width: 130px;">
            <CellTemplate>
                @if (context.Item.TypeName != null)
                {
                    var pair = context.Item.TypeName.ToUpper() switch
                    {
                        "UNIDADES" => (txt: "Unidades", color: Color.Dark),
                        "REPUESTOS" => (txt: "Repuestos", color: Color.Info),
                        "PROFORMA" => (txt: "Proforma", color: Color.Success),
                        "OTROS" => (txt: "Otros", color: Color.Primary),
                        "GASTOS ADMINISTRATIVOS" => (txt: "Gastos Adm.", color: Color.Warning),
                        _ => (txt: context.Item.TypeName, color: Color.Error)
                    };

                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@pair.color" Class="ma-0 pa-0">
                        @pair.txt
                    </MudChip>
                }
            </CellTemplate>
        </TemplateColumn>

        @* 5. Saldo Pendiente (Monto - Alineado a la Derecha) *@
        <TemplateColumn Title="Saldo Pendiente" HeaderClass="px-2 text-end" CellClass="px-2 text-end" HeaderStyle="width: 140px;">
            <CellTemplate>
                @if (context.Item.ConceptName != null)
                {
                    var isUsd = selectCurrencyId == 2;
                    var formattedAmount = isUsd
                        ? "$ " + context.Item.Amount?.ToString("N2")
                        : "Bs. " + context.Item.AmountBs?.ToString("N2");

                    var color = context.Item.ConceptName.ToUpper() == "BASE" ? Color.Success : Color.Warning;

                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@color" Class="ma-0 pa-0">
                        @formattedAmount
                    </MudChip>
                }
            </CellTemplate>
        </TemplateColumn>

        @* 6. Monto Abonado (Monto/Input - Alineado a la Derecha) *@
        <TemplateColumn Title="Monto Abonado" HeaderClass="px-2 text-end" CellClass="px-2 text-end" HeaderStyle="width: 160px;">
            <CellTemplate>
                @{
                    var isBase = context.Item.ConceptName?.ToUpper() == "BASE";
                    var typeName = context.Item.TypeName?.ToUpper();
                    var isValidType = typeName == "UNIDADES" || typeName == "REPUESTOS" || typeName == "PROFORMA";
                    var canEdit = isBase && isValidType && (context.Item.Detail == true || context.Item.Detail == null);
                    var isUsd = selectCurrencyId == 2;
                }

                <div class="d-flex justify-end align-center w-100">
                    @if (canEdit)
                    {
                        <MudNumericField T="double?"
                                         Value="@(isUsd ? context.Item.PaidAmount : context.Item.PaidAmountBs)"
                                         ValueChanged="@(async (double? val) => await OnPaidAmountInputChanged(context.Item, val, isUsd))"
                                         Culture="@System.Globalization.CultureInfo.InvariantCulture"
                                         Format="N2"
                                         HideSpinButtons="true"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Adornment="Adornment.Start"
                                         AdornmentText="@(isUsd ? "$" : "Bs.")"
                                         ReadOnly="@(context.Item.TransactionStatusName?.ToUpper() == "POR REVISION")"
                                         AdornmentIcon="@(_isSuccess ? Icons.Material.Filled.Check : Icons.Material.Filled.AttachMoney)"
                                         AdornmentColor="@(_isSuccess ? Color.Success : Color.Default)"
                                         Disabled="@(context.Item.PaymentId == 0)"
                                         Style="font-size: 12px; text-align: right;"
                                         Class="my-0 custom-dense-input w-100" />
                    }
                    else
                    {
                        var amount = isUsd
                            ? (context.Item.PaidAmount ?? context.Item.Amount)?.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)
                            : (context.Item.PaidAmountBs ?? context.Item.AmountBs)?.ToString("N2", System.Globalization.CultureInfo.InvariantCulture);

                        var prefix = isUsd ? "$ " : "Bs. ";

                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning" Class="ma-0 pa-0">
                            @(prefix + amount)
                        </MudChip>
                    }
                </div>
            </CellTemplate>
        </TemplateColumn>

        @* 7. Acciones (Botón - Centrado) *@
        <TemplateColumn HeaderClass="px-1 text-center" CellClass="px-1 text-center" HeaderStyle="width: 50px;">
            <CellTemplate>
                @if (context.Item.Detail == true || context.Item.Detail == null)
                {
                    <MudTooltip Text="Eliminar">
                        <MudIconButton Size="@Size.Small"
                                       Color="Color.Default"
                                       Icon="@Icons.Material.Outlined.Delete"
                                       OnClick="() => OnClickDeleteButton(context.Item)"
                                       Class="pa-1" />
                    </MudTooltip>
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

<style>
    /* Reduce la altura vertical y padding interno de los inputs numéricos dentro del grid */
    .custom-dense-input .mud-input-slot {
        padding-top: 2px !important;
        padding-bottom: 2px !important;
        height: 26px !important;
    }

    .custom-dense-input .mud-input-adornment {
        margin-right: 2px !important;
    }
</style>


@code { 
    [Inject] private UserSession Session { get; set; } = null!;
    [Parameter] public IEnumerable<AccountPreview> DocumentDetails { get; set; } = new List<AccountPreview>();
    [Parameter] public bool? IsVisibleToolBar { get; set; } = false;
    [Parameter] public EventCallback OnAmountUpdated { get; set; }
    [Parameter] public EventCallback<AccountPreview> OnClickSettlementDelete { get; set; }
    [Parameter] public int? selectCurrencyId { get; set; } = 0;


    private bool _isSuccess = false;
    private int _lastSavedId = -1;
    private bool _isSaving = false;

    private MudDataGrid<AccountPreview>? DocumentPreviewDataGrid;

    private int _rowCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await ReloadPaymentReportGrid();

    }

    private async Task ReloadPaymentReportGrid()
    {
        if (DocumentPreviewDataGrid != null)
        {
            await DocumentPreviewDataGrid.ReloadServerData();
        }
    }

    private async Task<GridData<AccountPreview>> LoadGridData(GridState<AccountPreview> state)
    {

        _rowCount = state.Page * state.PageSize;

        return new GridData<AccountPreview> { TotalItems = DocumentDetails.Count(), Items = DocumentDetails };
    }

    private async Task OnPaidAmountInputChanged(AccountPreview item, double? newValue, bool isUsd)
    {
        if (item == null) return;

        // Redondeo explícito a 2 decimales
        double? roundedVal = newValue.HasValue
            ? Math.Round(newValue.Value, 2, MidpointRounding.AwayFromZero)
            : null;

        // Asignamos directamente la propiedad correspondiente en el objeto
        if (isUsd)
        {
            item.PaidAmount = roundedVal;
        }
        else
        {
            item.PaidAmountBs = roundedVal;
        }

        // Ejecutamos el envío al servidor
        await UpdatePaidAmount(item);
    }

    private async Task OnClickDeleteButton(AccountPreview settlements)
    {
        await OnClickSettlementDelete.InvokeAsync(settlements);
        StateHasChanged();
    }


    private async Task UpdatePaidAmount(AccountPreview item)
    {
        if (item == null) return;

        // Evitamos peticiones simultáneas, pero permitimos procesar cambios si el flag de guardado está libre
        if (_isSaving) return;

        _isSaving = true;

        try
        {
            bool isUsd = selectCurrencyId == 2;

            // 1. Evaluamos la moneda actual para tomar el monto abonado correcto
            double? rawAmount = isUsd ? item.PaidAmount : item.PaidAmountBs;

            // 2. Redondeamos a 2 decimales
            double? amountToSend = rawAmount.HasValue
                ? Math.Round(rawAmount.Value, 2, MidpointRounding.AwayFromZero)
                : null;

            var dto = new PostPaidAmount
            {
                Id = item.Id,
                PaymentId = item.PaymentId,
                PaidAmount = amountToSend
            };

            var serviceResponse = await PaymentService.UpdatePaidAmount(dto, Session.UserId);

            if (serviceResponse != null && serviceResponse.Processed)
            {
                _isSuccess = true;
                StateHasChanged();

                await Task.Delay(800);
                _isSuccess = false;

                // Recargamos la grilla y notificamos al componente padre
                if (DocumentPreviewDataGrid != null)
                {
                    await DocumentPreviewDataGrid.ReloadServerData();
                }

                if (OnAmountUpdated.HasDelegate)
                {
                    await OnAmountUpdated.InvokeAsync();
                }
            }
            else
            {
                Snackbar.Add(serviceResponse?.Message ?? "Error al actualizar el monto", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error crítico: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
            _lastSavedId = -1; // Reseteamos sin Task.Delay extra
        }
    }

}
