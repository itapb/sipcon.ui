@using System.Text.RegularExpressions
@using System.ComponentModel.DataAnnotations
@using FluentValidation
@using System.Globalization

@inject IPaymentService PaymentService
@inject UtilModuleActions ModuleActionsService
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime

<MudDialog Position="DialogPosition.Custom" Style="margin-right: 0; margin-left: auto; height: 100vh; max-height: 100vh; border-radius: 0; width: 900px; max-width: 100vw; overflow: hidden;">
    <DialogContent >


        @* ================= LEYENDA INFORMATIVA DE EDICIÓN ================= *@
        <div class="d-flex align-center gap-1 mb-2 flex-shrink-0" style="color: #b76e00;">
            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
            <MudText Typo="Typo.caption" Style="font-weight: 500; line-height: 1.2;">
                Nota: Puede editar el monto a abonar en la tabla si el tipo de factura lo permite.
            </MudText>
        </div>

        @* ================= FACTURAS AGREGADAS (EXPANDIDO DINÁMICO) ================= *@
        <MudPaper Class="pa-3 d-flex flex-column" Style="background-color: #f9fafb; border-radius: 8px; flex: 1 1 35%; min-height: 220px; overflow: hidden;">
            <div class="d-flex align-center mb-2 flex-shrink-0">
                <MudText Style="color: #8b4c25; font-weight: bold;" Typo="Typo.subtitle1">Facturas agregadas</MudText>
                <MudBadge Content="@(_panelContent?.Count ?? 0)" Color="Color.Primary" Overlap="true" Class="ml-auto">
                    <MudIcon Icon="@Icons.Material.Filled.AddShoppingCart" Color="Color.Default" Size="Size.Medium" />
                </MudBadge>
            </div>

            @if (_panelContent != null && _panelContent.Count > 0)
            {
                <div class="flex-grow-1 overflow-hidden">
                    <DocumentPreviewList OnClickSettlementDelete="(arg) => OnDeleteDocument(arg)"
                                         DocumentDetails="_panelContent"
                                         selectCurrencyId="SelectedCurrencyId"
                                         IsVisibleToolBar="false"
                                         OnAmountUpdated="RefreshTotals" />
                </div>
            }
        </MudPaper>

        @* ================= COLUMNAS CENTRALES (AMPLIADO Y MEJOR PADDING) ================= *@
        <MudGrid Class="ma-0 pa-0 flex-grow-1 overflow-hidden" Spacing="2" Style="flex: 2 1 60%; min-height: 380px;">

            @* --- COLUMNA IZQUIERDA: FORMULARIO DE CAPTURA --- *@
            <MudItem xs="12" md="6" Class="d-flex flex-column h-100 overflow-hidden pa-1">
                <MudCard Class="h-100 d-flex flex-column overflow-hidden" Style="border-radius:8px;" Elevation="1">
                    <MudCardHeader Class="py-3 px-4 border-bottom flex-shrink-0 d-flex align-center">
                        <CardHeaderContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.CreditCard" Style="color: #8b4c25; font-size: 1.2rem;" />
                                <MudText Typo="Typo.subtitle1" Style="color: #8b4c25; font-weight: bold; line-height: 1.2;">
                                    @(_disabledSelect ? "Agregar Retención" : "Agregar Método de Pago")
                                </MudText>
                            </MudStack>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            @if (_model.Id != 0)
                            {
                                <MudButton StartIcon="@Icons.Material.Filled.Close" Variant="Variant.Text"
                                           Color="Color.Dark" IconColor="Color.Secondary" IconSize="Size.Small" Size="Size.Small"
                                           OnClick="() => OnClickCancelButton()">
                                    Limpiar
                                </MudButton>
                            }
                        </CardHeaderActions>
                    </MudCardHeader>

                    <MudCardContent Class="py-3 px-4 flex-grow-1 d-flex flex-column justify-space-between overflow-y-auto">
                        <MudForm Model="@_model" @ref="@form" Validation="@(_modelValidator.ValidateValue)" ValidationDelay="0" Class="flex-grow-1">
                            <MudGrid Spacing="2">
                                <MudItem xs="6">
                                    <MudText Typo="Typo.caption" Style="color: #8b4c25; font-weight: 600;">Moneda</MudText>
                                    <MudSelect T="int?" Disabled="true" Value="_model.CurrencyId" ValueChanged="OnCurrencyTypeChanged"
                                               Margin="Margin.Dense" Dense="true" Variant="Variant.Outlined" Style="color: #8b4c25; font-size: 13px;">
                                        @if (CurrencyList != null)
                                        {
                                            @foreach (var currency in CurrencyList)
                                            {
                                                <MudSelectItem T="int?" Value="@((int?)currency.Value)">@currency.Text</MudSelectItem>
                                            }
                                        }
                                    </MudSelect>
                                </MudItem>

                                <MudItem xs="6">
                                    <MudText Typo="Typo.caption" Style="color: #8b4c25; font-weight: 600;">Tipo de Pago</MudText>
                                    <MudSelect T="int?" Value="_model.TypeId" ValueChanged="OnPayTypeChanged" Placeholder="Todos los Tipos"
                                               Style="color: #8b4c25; font-size: 13px;" Clearable="true" Dense="true" Margin="Margin.Dense"
                                               Variant="Variant.Outlined" For="@(() => _model.TypeId)" ReadOnly="@(!_model.IsActive || _isReadOnlyAmount)" Disabled="@_disabledSelect">
                                        @if (PaymentTypeList != null)
                                        {
                                            var style = "color: #8b4c25; font-size: 13px;";
                                            @foreach (var action in PaymentTypeList)
                                            {
                                                <MudSelectItem T="int?" Value="@action.Value" Style="@style" Disabled="@(action.Text?.ToUpper() == "RETENCION" && _disabledRetencion)">@action.Text</MudSelectItem>
                                            }
                                        }
                                    </MudSelect>
                                </MudItem>

                                <MudItem xs="6">
                                    <MudText Typo="Typo.caption" Style="color: #8b4c25; font-weight: 600;">Fecha</MudText>
                                    <MudDatePicker @ref="_pickerDatePayment"
                                                   @bind-Date="_model.Date"
                                                   Style="color: #8b4c25; font-size: 13px; min-width: 100px;"
                                                   Class="align-end"
                                                   Placeholder="dd/MM/yyyy"
                                                   DateFormat="dd/MM/yyyy"
                                                   AutoClose="true"
                                                   Adornment="Adornment.Start"
                                                   AdornmentColor="Color.Default"
                                                   Variant="Variant.Outlined"
                                                   PickerVariant="PickerVariant.Inline"
                                                   Margin="Margin.Dense"
                                                   For="@(() => _model.Date)"
                                                   ReadOnly="@(!_hasRetention)"
                                                   Disabled="@(!_hasRetention)">
                                        <PickerActions>
                                            <MudButton Class="mr-auto align-self-start" OnClick="@(() => _pickerDatePayment.ClearAsync())">Borrar</MudButton>
                                            <MudButton OnClick="@(() => _pickerDatePayment.CloseAsync(false))">Cancelar</MudButton>
                                        </PickerActions>
                                    </MudDatePicker>
                                </MudItem>

                                @if (selectedPaymentType != null && selectedPaymentType.Text?.ToUpper() != "EFECTIVO")
                                {
                                    <MudItem xs="6">
                                        <MudText Typo="Typo.caption" Style="color: #8b4c25; font-weight: 600;">@(_disabledSelect ? "Nro. Retención" : "Nro. Referencia")</MudText>
                                        <MudTextField @bind-Value="_model.Reference" Typo="Typo.caption" Variant="Variant.Outlined"
                                                      Placeholder="@(_disabledSelect ? "Número de retención" : "Número de referencia")"
                                                      Style="color: #8b4c25; font-size: 13px; background-color:#f8fafc;"
                                                      MaxLength="40" Margin="Margin.Dense" For="@(() => _model.Reference)" ReadOnly="@(!_model.IsActive || _isReadOnly)" Disabled="@(!_model.IsActive || _isReadOnly)" />
                                    </MudItem>
                                }

                                <MudItem xs="@(selectedPaymentType != null && selectedPaymentType.Text?.ToUpper() != "EFECTIVO" ? 12 : 6)">
                                    <MudText Typo="Typo.caption" Style="color: #8b4c25; font-weight: 600;">
                                        @(selectedCurrency != null && selectedCurrency.Text?.ToUpper() == "$ - DOLAR" ? "Monto (USD)" : "Monto (Bs)")
                                    </MudText>
                                    <MudNumericField @bind-Value="_model.Amount" @bind-Value:after="AfterValueChangeAmount" Typo="Typo.caption" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                     Culture="@CultureInfo.GetCultureInfo("en-US")" T="double?" Style="color: #8b4c25; font-size: 13px; background-color:#f8fafc;"
                                                     Class="align-right" HideSpinButtons="true" Pattern="^[0-9.]*$" Min="0.00" MaxLength="18" For="@(() => _model.Amount)" ReadOnly="@(!_model.IsActive || _isReadOnlyAmount)" />
                                </MudItem>

                                @if (selectedPaymentType != null && selectedPaymentType.Text?.ToUpper() == "TRANSFERENCIA")
                                {
                                    <MudItem xs="6">
                                        <MudText Typo="Typo.caption" Style="color: #8b4c25; font-weight: 600;">Banco Origen</MudText>
                                        <MudSelect T="int?" Value="_model.BankOriginId" ValueChanged="OnBankOriginChanged" Placeholder="Banco Origen"
                                                   Style="color: #8b4c25; font-size: 13px;" Clearable="true" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                   For="@(() => _model.BankOriginId)" ReadOnly="@(!_model.IsActive || _isReadOnly)">
                                            @if (BankOriginList != null)
                                            {
                                                @foreach (var action in BankOriginList)
                                                {
                                                    <MudSelectItem T="int?" Value="@action.Value" Style="color: #8b4c25; font-size: 13px;">@action.Text</MudSelectItem>
                                                }
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="6">
                                        <MudText Typo="Typo.caption" Style="color: #8b4c25; font-weight: 600;">Cuenta Destino</MudText>
                                        <MudSelect T="int?" Value="_model.AccountId" ValueChanged="OnAccountBankChanged" Placeholder="Cuenta Destino"
                                                   Style="color: #8b4c25; font-size: 13px;" Clearable="true" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                   For="@(() => _model.AccountId)" ReadOnly="@(!_model.IsActive || _isReadOnly)">
                                            @if (AccountList != null)
                                            {
                                                @foreach (var action in AccountList)
                                                {
                                                    <MudSelectItem T="int?" Value="@action.Value" Style="color: #8b4c25; font-size: 13px;">@action.Text</MudSelectItem>
                                                }
                                            }
                                        </MudSelect>
                                    </MudItem>
                                }
                            </MudGrid>
                        </MudForm>

                        <MudStack Row="true" Spacing="2" Class="mt-3 pt-3 border-top flex-shrink-0">
                            <MudButton StartIcon="@Icons.Material.Filled.FileUpload" Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                                       FullWidth="true" OnClick="() => OnClickAttachamentButton()" Disabled="@(!_model.IsActive || _isReadOnly || _model.Id == 0)">
                                Comprobante
                            </MudButton>

                            <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small" IconColor="Color.Secondary"
                                       FullWidth="true" OnClick="OnValidSubmit">
                                @(_model.Id != 0 ? "Guardar" : _disabledSelect ? "Agregar Retención" : "Agregar Pago")
                            </MudButton>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            @* --- COLUMNA DERECHA: LISTA --- *@
            <MudItem xs="12" md="6" Class="d-flex flex-column h-100 overflow-hidden pa-1">
                <MudCard Class="h-100 d-flex flex-column overflow-hidden" Style="border-radius:8px;" Elevation="1">
                    <MudCardHeader Class="py-3 px-4 border-bottom flex-shrink-0 d-flex align-center">
                        <CardHeaderContent>
                            <MudBadge Content="@(PaymentList?.Count() ?? 0)" Color="Color.Primary" Overlap="true">
                                <MudText Typo="Typo.subtitle1" Style="color: #8b4c25; font-weight: bold; line-height: 1.2;">
                                    @(_disabledSelect ? "Retenciones Agregadas" : "Métodos Agregados")
                                </MudText>
                            </MudBadge>
                        </CardHeaderContent>
                    </MudCardHeader>

                    <MudCardContent Class="py-3 px-4 flex-grow-1 overflow-y-auto">
                        @if (PaymentList != null && PaymentList.Count > 0)
                        {
                            <PaymentPreviewList PaymentDetails="@PaymentList"
                                                OnClickPaymentEdit="(arg) => OnPaymentEdit(arg)"
                                                OnClickPaymentDelete="(arg) => OnPaymentDelete(arg)">
                            </PaymentPreviewList>
                        }
                        else
                        {
                            <div class="d-flex flex-column align-center justify-center h-100 py-4" style="opacity: 0.5;">
                                <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Style="font-size: 2.5rem; color: #8b4c25;" />
                                <MudText Typo="Typo.body2" Style="color: #8b4c25;" Class="mt-2">No hay ítems agregados aún</MudText>
                            </div>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

        </MudGrid>
        @if (!_isLoading && PaymentList != null)
        {
            bool isBs = SelectedCurrencyId == 1;
            string currencySymbol = isBs ? "Bs." : "$";

            <MudPaper Class="pa-3 mt-auto pt-3 flex-shrink-0" Style="background: #ffffff; border-radius: 8px; border-top: 1px solid #e0e0e0; position: sticky; bottom: 0; z-index: 2;" Elevation="3">
                <div class="d-flex flex-column gap-2">
                    <div class="d-flex align-center justify-space-between">
                        <MudStack Row="false" AlignItems="AlignItems.Start" Spacing="0">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Info" Style="color: #8b4c25; font-size: 1.2rem;" />
                                <MudText Typo="Typo.subtitle2" Style="color: #8b4c25; font-weight: bold;">
                                    @(_disabledSelect ? "Resumen" : "Resumen de Pago")
                                </MudText>
                            </MudStack>
                            <MudText Typo="Typo.caption" Style="font-size: 11px;">
                                Documentos: @(_panelContent?.Count ?? 0) | @(_disabledSelect ? "Retenciones: " : "Métodos: ") @(PaymentList.Count)
                            </MudText>
                        </MudStack>

                        <MudStack Row="false" AlignItems="AlignItems.End" Spacing="0">
                            @* --- TOTAL --- *@
                            <MudText Typo="Typo.caption" Align="Align.End" Style="font-size: 12px;">
                                <span>Total: </span>
                                <MudText Typo="Typo.caption" Style="font-weight: bold; font-size: 12px;" Inline="true">
                                    @if (_panelContent != null)
                                    {
                                        var totalSum = isBs
                                            ? _panelContent.Sum(x => (x.PaidAmountBs ?? 0) > 0 ? x.PaidAmountBs.Value : (x.AmountBs ?? 0))
                                            : _panelContent.Sum(x => (x.PaidAmount ?? 0) > 0 ? x.PaidAmount.Value : (x.Amount ?? 0));

                                        @($"{currencySymbol} {totalSum:N2}")
                                    }
                                </MudText>
                            </MudText>

                            @* --- AGREGADO --- *@
                            <MudText Typo="Typo.caption" Align="Align.End" Style="font-size: 12px;">
                                <span>Agregado: </span>
                                <MudText Typo="Typo.caption" Style="font-weight: bold; font-size: 12px;" Inline="true">
                                    @{
                                        var addedSum = isBs
                                            ? PaymentList.Sum(x => x.AmountBs ?? 0)
                                            : PaymentList.Sum(x => x.Amount ?? 0);
                                    }
                                    @($"{currencySymbol} {addedSum:N2}")
                                </MudText>
                            </MudText>

                            @* --- POR PAGAR --- *@
                            <MudText Typo="Typo.caption" Style="color: #a1231b; font-size: 12px;" Align="Align.End">
                                <span>Por Pagar: </span>
                                <MudText Typo="Typo.subtitle2" Style="color: #a1231b; font-weight: bold;" Inline="true">
                                    @($"{currencySymbol} {CalculateOutstandingBalance():N2}")
                                </MudText>
                            </MudText>
                        </MudStack>
                    </div>

                    <MudButton StartIcon="@Icons.Material.Filled.Payments"
                               Variant="Variant.Filled"
                               Color="Color.Dark"
                               Size="Size.Medium"
                               FullWidth="true"
                               IconColor="Color.Secondary"
                               OnClick="OnClickProcessButton"
                               Disabled="@(CalculateOutstandingBalance() != 0)">
                        @(_disabledSelect ? "Reportar Retención" : "Reportar Pago")
                    </MudButton>
                </div>
            </MudPaper>
        }

        <NestedDialogCustom IsVisible="@_nestedVisible"
                            Icon="@Icons.Material.Filled.Payments"
                            Success="@_successNested"
                            onCloseNested="() => ClosedNested()"
                            ErrorMessage="@_errorMessageNested"
                            Title="@(_disabledSelect ? "Reportar Retención" : "Reportar Pago")" />
    </DialogContent>
</MudDialog>
@code {
    [Inject] private UserSession Session { get; set; } = null!;
    [Parameter] public int SelectedPaymentId { get; set; } = 0;
    [Parameter] public EventCallback OnClickCloseDetail { get; set; }

    private MudForm? form;

    private PaymentUpdate _model { get; set; } = new PaymentUpdate();
    private List<AccountPreview> _panelContent = new List<AccountPreview>();
    private List<Payment> PaymentList = new List<Payment>();
    private MudDatePicker _pickerDatePayment = new MudDatePicker();
    private List<SelectOption> PaymentTypeList = new List<SelectOption>();
    private List<SelectOption> CurrencyList = new List<SelectOption>();
    private List<SelectOption> BankOriginList = new List<SelectOption>();
    private List<SelectOption> AccountList = new List<SelectOption>();
    private SelectOption? selectedPaymentType = null;
    private SelectOption? selectedCurrency = null;
    private SelectOption? selectedBankOrigin = null;
    private SelectOption? selectedAccount = null;
    private double? _calculatedAmount = 0;
    private bool _isCurrencyLocked = false;
    private bool _isLoading = true;
    bool _hasRetention => _panelContent.Any(x => x.ConceptName == "RETENCION IVA (75%)");
    private int SelectedCurrencyId { get; set; } = 0;
    private DateTime SelectDateRate { get; set; } = DateTime.Now;


    private string _errorMessageNested = string.Empty;
    private bool _nestedVisible = false;
    private bool _successNested = false;
    bool _isReadOnly = false;
    bool _isReadOnlyAmount = false;
    bool _isExpanded = false;
    bool _disabledRetencion = false;
    bool _disabledSelect = false;
    bool _IsAmountBS = false;

    private List<string> _ConceptNameList = new List<string>()
    {
        "PLACA" ,
        "IVA (25%)",
        "RETENCION IVA (75%)",
    };

    private List<string> _typeDocumentList = new List<string>()
    {
        "PROFORMA"
    };

    PaymentValidator _modelValidator = new PaymentValidator();

    IMask maskDate = new DateMask("dd/MM/yyyy");

    SelectValidator<string> _SelectValidator = new SelectValidator<string>(x => x
       .NotNull().WithMessage("Campo requerido")
       .NotEmpty().WithMessage("Campo requerido")
       .Length(1, 20).WithMessage("Campo requerido entre 1-20 carácteres"));

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;

        // 1. Cargar las listas maestras de selección
        PaymentTypeList = await ModuleActionsService.GetPaymentSelectOption();
        CurrencyList = await ModuleActionsService.GetCurrencySelectOption();
        BankOriginList = await ModuleActionsService.GetBankOriginSelectOption();
        AccountList = await ModuleActionsService.GetBankAccountSelectOption(Session.SupplierId, selectedCurrency?.Value);

        // 2. Consultar si existe un carrito pendiente para obtener el PaymentId dinámicamente
        await FetchPendingCartAndLoadDetailsAsync();

        _isLoading = false;
        StateHasChanged();
    }

    /// <summary>
    /// Consulta el carrito pendiente del usuario, obtiene el PaymentId activo y carga sus documentos y pagos asociados.
    /// </summary>
    private async Task FetchPendingCartAndLoadDetailsAsync()
    {
        try
        {
            var cartResponse = await PaymentService.GetPendingCart(Session.UserId, Session.DealerId);

            if (cartResponse != null && cartResponse.Processed && cartResponse.Data != null && cartResponse.Data.Any())
            {
                var pendingCart = cartResponse.Data.FirstOrDefault();

                if (pendingCart != null && pendingCart.PaymentId.HasValue && pendingCart.PaymentId.Value > 0)
                {
                    SelectedPaymentId = pendingCart.PaymentId.Value;
                    SelectedCurrencyId = pendingCart.CurrencyId.Value;
                    SelectDateRate = pendingCart.DateRate ?? DateTime.Now;

                }
            }

            // 3. Si se obtuvo un PaymentId válido del carrito pendiente (o se pasó por parámetro)
            if (SelectedPaymentId > 0)
            {
                await GetDocuments(SelectedPaymentId);
                await GetPayments(SelectedPaymentId);

                var paymentArg = PaymentList.FirstOrDefault(x => x.Id == SelectedPaymentId || x.PaymentId == SelectedPaymentId);
                if (paymentArg != null)
                {
                    await OnPaymentEdit(paymentArg);
                }
                else
                {
                    await CleanModel();
                }
            }
            else
            {
                await CleanModel();
            }
        }
        catch (Exception ex)
        {
            _errorMessageNested = $"Error consultando carrito pendiente: {ex.Message}";
            _successNested = false;
            OpenNested();
        }
    }

    private async Task GetDocuments(int paymentId)
    {
        var serviceResponse = await PaymentService.GetAccountByPayment(Session.UserId, paymentId);

        // Mantenemos la referencia de la lista local limpiando y agregando directamente desde la BD
        _panelContent.Clear();

        if (serviceResponse.Processed && serviceResponse.Data != null)
        {
            _panelContent.AddRange(serviceResponse.Data);

            if (_panelContent.Any())
            {
                await Task.Delay(20);
            }
        }

        StateHasChanged();
    }

    private async Task GetPayments(int paymentId)
    {
        var serviceResponse = await PaymentService.GetPaymentDetails(Session.UserId, paymentId);

        // Mantenemos la misma referencia de lista limpiando y agregando
        PaymentList.Clear();

        if (serviceResponse.Processed && serviceResponse.Data != null)
        {
            PaymentList.AddRange(serviceResponse.Data);
            await Task.Delay(20);
        }

        if (!PaymentList.Any())
        {
            await CleanModel();
        }

        StateHasChanged();
    }

   

    private async Task OnClickCloseButton()
    {
        await CleanModel();

        // Limpiamos la lista local del panel sin reasignar la instancia
        _panelContent.Clear();

        await OnClickCloseDetail.InvokeAsync();
        StateHasChanged();
    }

    private async Task OnClickCancelButton()
    {
        await CleanModel();
        _isReadOnly = false;
        StateHasChanged();
    }

    private async Task OnClickProcessButton()
    {
        var option = new DialogOptions
        {
            CloseButton = false,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            BackdropClick = false
        };

        bool? confir = await DialogService.ShowMessageBox(
            "Procesar Pago",
            "¿Seguro de Procesar?",
            yesText: "Si", noText: "No", "", option);

        if (confir == true)
        {
            Payment arg = PaymentList.FirstOrDefault() ?? new Payment();
            List<PostAction> ActionList = new List<PostAction>
            {
                new PostAction
                {
                    RecordId = arg.PaymentId > 0 ? arg.PaymentId : SelectedPaymentId,
                    ModuleId = 0,
                    ActionName = "PROCESS",
                    ActionComment = "Procesar Pago",
                    RelatedId = 0
                }
            };

            var serviceResponse = await PaymentService.PaymentsActions(ActionList, Session.UserId);
            if (serviceResponse.Processed)
            {
                PaymentList = new List<Payment>();
                _successNested = true;
                _errorMessageNested = serviceResponse.Message ?? MessageEnum.ProcessNotOK.GetStringValue();
                await OnClickCloseButton();
            }
            else
            {
                _successNested = false;
                _errorMessageNested = serviceResponse.Message ?? MessageEnum.ProcessNotOK.GetStringValue();
            }
            OpenNested();
        }

        StateHasChanged();
    }

    private async Task OnClickAttachamentButton()
    {
        if (_model.Id == 0)
        {
            _errorMessageNested = "Debe guardar el método de pago antes de agregar un comprobante.";
            _successNested = false;
            OpenNested();
            return;
        }

        DialogOptions options = new() { BackdropClick = false, MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = false, NoHeader = true };
        var parameters = new DialogParameters<PaymentFilesDialog> { { x => x.Title, "Agregar Comprobantes" }, { x => x.IdPayment, _model.Id.ToString() } };
        await DialogService.ShowAsync<PaymentFilesDialog>("Agregar Comprobantes", parameters, options);

        StateHasChanged();
    }

    private async Task OnValidSubmit()
    {
        await form!.Validate();

        if (form.IsValid)
        {
            _errorMessageNested = "";

            var serviceResponse = await PaymentService.CreatePayment(_model, Session.UserId);
            if (serviceResponse.Processed)
            {
                if (serviceResponse.Data != null)
                {
                  

                    // 1. Refrescar la lista de pagos actualizados desde el backend
                    await GetPayments(SelectedPaymentId);

                    // 2. Refrescar los documentos asociados (por si cambiaron montos pendientes)
                    await GetDocuments(SelectedPaymentId);

                    // 3. Limpiar el formulario para permitir ingresar un nuevo pago si se requiere
                    await CleanModel();

                    StateHasChanged();
                }
            }
            else
            {
                _successNested = false;
                _errorMessageNested = serviceResponse.Message ?? MessageEnum.SaveNotOK.GetStringValue();
                OpenNested();
            }
        }

        StateHasChanged();
    }

    private async Task OnPaymentEdit(Payment arg)
    {
        form!.ResetValidation();
        await form!.ResetAsync();

        selectedCurrency = CurrencyList.FirstOrDefault(p => p.Text.ToUpper() == arg.CurrencyName.ToUpper());
        selectedPaymentType = PaymentTypeList.FirstOrDefault(p => p.Text.ToUpper() == arg.TypeName.ToUpper());
        _disabledRetencion = true;
        _disabledSelect = false;

        // Se removió el bloqueo condicional de moneda (_isCurrencyLocked).
        // Ahora la moneda se carga directamente de forma informativa según el registro/PendingCart.

        if (_panelContent.Any(x => x.ConceptName.Trim() == "RETENCION IVA (75%)"))
        {
            selectedPaymentType = PaymentTypeList.FirstOrDefault(p => p.Text.ToUpper() == "RETENCION");
            _disabledRetencion = false;
            _disabledSelect = true;
        }

        await OnCurrencyTypeChanged();

        if (arg.TypeName.ToUpper() == "TRANSFERENCIA")
        {
            selectedAccount = AccountList.FirstOrDefault(p => p.Value == arg.AccountId);
            selectedBankOrigin = BankOriginList.FirstOrDefault(p => p.Value == arg.BankOriginId);
        }
        else
        {
            selectedAccount = null;
            selectedBankOrigin = null;
        }

        _model = new PaymentUpdate()
        {
            TypeId = selectedPaymentType?.Value,
            CurrencyId = SelectedCurrencyId,
            BankOriginId = selectedBankOrigin?.Value,
            AccountId = selectedAccount?.Value,
            Date = arg.Date,
            Reference = string.IsNullOrWhiteSpace(arg.Reference) ? null : arg.Reference,
            Amount = selectedCurrency != null && selectedCurrency.Text.ToUpper() == "BS - BOLIVAR" ? arg.AmountBs : arg.Amount,
            PaymentId = SelectedPaymentId,
            Id = arg.Id,
            SupplierId = arg.SupplierId,
            DealerId = arg.DealerId,
            IsActive = arg.IsActive
        };

        _isReadOnly = !(arg.StatusName.ToUpper() == "BORRADOR" || arg.StatusName.ToUpper() == "PARA APROBAR");
        _isReadOnlyAmount = !(arg.StatusName.ToUpper() == "BORRADOR");

        StateHasChanged();
    }

    private async Task OnPaymentDelete(Payment arg)
    {
        var option = new DialogOptions
        {
            CloseButton = false,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            BackdropClick = false
        };

        bool? confir = await DialogService.ShowMessageBox(
            "Eliminar Pago",
            "¿Seguro de Eliminar?",
            yesText: "Si", noText: "No", "", option);

        if (confir == true)
        {
            List<PostAction> ActionList = new List<PostAction>
        {
            new PostAction
            {
                RecordId = arg.Id,
                ModuleId = 0,
                ActionName = "DEACTIVATE",
                ActionComment = "Eliminar Detalle Pago",
                RelatedId = arg.PaymentId
            }
        };

            var serviceResponse = await PaymentService.DeletePaymentDetails(ActionList, Session.UserId);
            if (serviceResponse.Processed)
            {
               
                // Refrescar pagos y documentos
                await GetPayments(SelectedPaymentId);
                await GetDocuments(SelectedPaymentId);

                // Limpiar el formulario de edición
                await CleanModel();

                StateHasChanged();
            }
            else
            {
                _successNested = false;
                _errorMessageNested = serviceResponse.Message ?? MessageEnum.DeleteNotOK.GetStringValue();
                OpenNested();
            }
        }
    }

    private async Task OnDeleteDocument(AccountPreview doc)
    {
        var option = new DialogOptions
        {
            CloseButton = false,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            BackdropClick = false
        };

        bool? confir = await DialogService.ShowMessageBox(
            "Eliminar Documento",
            "¿Desea remover este documento del pago?",
            yesText: "Si", noText: "No", "", option);

        if (confir == true)
        {
            List<PostAction> actionList = new List<PostAction>
        {
            new PostAction
            {
                RecordId = doc.Id,
                ModuleId = 0,
                ActionName = "DEACTIVATE",
                ActionComment = "Eliminar Documento/Settlement del Pago",
                RelatedId = SelectedPaymentId
            }
        };

            var serviceResponse = await PaymentService.DeleteSettlements(actionList, Session.UserId);
            if (serviceResponse.Processed)
            {
                // 1. Refrescar los documentos desde la BD directamente a _panelContent
                await GetDocuments(SelectedPaymentId);

                // 2. Refrescar la lista de pagos en caso de reajustes en los saldos
                await GetPayments(SelectedPaymentId);

                // 3. Evaluar la cantidad restante sobre _panelContent
                if (!_panelContent.Any())
                {
                    await OnClickCloseButton();
                }
                else
                {
                    await CleanModel();
                    StateHasChanged();
                }
            }
            else
            {
                _successNested = false;
                _errorMessageNested = serviceResponse.Message ?? MessageEnum.DeleteNotOK.GetStringValue();
                OpenNested();
            }
        }
    }

    private async Task CleanModel()
    {
        form!.ResetValidation();
        await form!.ResetAsync();

        selectedPaymentType = PaymentTypeList.FirstOrDefault(p => p.Text.ToUpper() == "TRANSFERENCIA");
        selectedCurrency = CurrencyList.FirstOrDefault(p => p.Text.ToUpper() == "$ - DOLAR");
        _disabledRetencion = true;
        _disabledSelect = false;

       
        selectedAccount = null;
        selectedBankOrigin = null;

         if (_panelContent.Any(x => x.ConceptName.Trim() == "RETENCION IVA (75%)"))
        {
            selectedPaymentType = PaymentTypeList.FirstOrDefault(p => p.Text.ToUpper() == "RETENCION");
            _disabledRetencion = false;
            _disabledSelect = true;
        }

        _model = new PaymentUpdate()
        {
            TypeId = selectedPaymentType?.Value,
            CurrencyId = SelectedCurrencyId,
            AccountId = null,
            BankOriginId = null,
            SupplierId = Session.SupplierId,
            DealerId = Session.DealerId,
        };

       

        await OnCurrencyTypeChanged();

        if (SelectedPaymentId != 0)
        {
            _model.Date = SelectDateRate;
            _model.PaymentId = PaymentList.FirstOrDefault()?.PaymentId ?? SelectedPaymentId;
        }
        else
        {
            _model.Date = SelectDateRate;
            _model.PaymentId = 0;

            if (_panelContent.Any())
            {
                _model.Date = _panelContent.Where(x => x.DateRate != null).FirstOrDefault()?.DateRate ?? DateTime.Now;
            }
        }

        _isReadOnly = false;
        StateHasChanged();
    }

    private double CalculateOutstandingBalance()
    {
        if (_panelContent == null || !_panelContent.Any())
            return 0;

        double balance = 0;

        // SelectedCurrencyId == 1 -> Bolívares (Bs)
        if (SelectedCurrencyId == 1)
        {
            double totalBs = _panelContent.Sum(x => (x.PaidAmountBs ?? 0) > 0 ? x.PaidAmountBs.Value : (x.AmountBs ?? 0));
            double addedBs = PaymentList?.Sum(x => x.AmountBs ?? 0) ?? 0;

            balance = totalBs - addedBs;
        }
        // Cualquier otra moneda (SelectedCurrencyId == 2 o distinto de 1) -> Dólares ($)
        else
        {
            double totalUsd = _panelContent.Sum(x => (x.PaidAmount ?? 0) > 0 ? x.PaidAmount.Value : (x.Amount ?? 0));
            double addedUsd = PaymentList?.Sum(x => x.Amount ?? 0) ?? 0;

            balance = totalUsd - addedUsd;
        }

        return Math.Round(balance, 2);
    }

    private async Task OnCurrencyTypeChanged()
    {
        _model.CurrencyId = SelectedCurrencyId;
        selectedCurrency = CurrencyList.FirstOrDefault(item => item.Value == SelectedCurrencyId);

        if (selectedCurrency != null)
        {
            AccountList = await ModuleActionsService.GetBankAccountSelectOption(Session.SupplierId, selectedCurrency.Value);
            selectedAccount = null;
            _model.AccountId = null;
        }
        else
        {
            AccountList = new List<SelectOption>();
        }

        StateHasChanged();
    }

