@using System.Text.RegularExpressions
@using System.ComponentModel.DataAnnotations
@using FluentValidation
@using System.Globalization

@inject IPaymentService PaymentService
@inject UtilModuleActions ModuleActionsService
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime

<MudCard Class="ma-3" Style="background-color: #eff6ff80;">
    <MudCardContent Style="padding-top: 0px;">
        @* //Documents Selecteds *@
        <MudPaper Class="ma-2" Style="background-color: #f9fafb; border-radius:10px;">
            <MudExpansionPanels Style="background-color: #f9fafb;">
                <MudExpansionPanel HideIcon="true" MaxHeight="1000" ExpandedChanged="OnExpandedChanged">
                    <TitleContent>
                        <div class="d-flex">
                            <MudIcon Icon="@Icons.Material.Filled.FileOpen" Style="color: #8b4c25;font-size: 1.5rem;"></MudIcon>
                            <MudText Style="color: #8b4c25;font-weight:bold;"> Facturas de Vehículos agregadas</MudText>
                            <div class="d-flex ml-auto">
                                <MudBadge Content="SelectedDocuments.Count()" Color="Color.Primary" Overlap="true"
                                          OnClick="() => OnExpandedChanged(!_isExpanded)"
                                          Class="mr-6 mt-2">
                                    <MudIcon Icon="@Icons.Material.Filled.AddShoppingCart" Color="Color.Default" />
                                </MudBadge>
                                <MudButton StartIcon="@Icons.Material.Filled.KeyboardReturn" Variant="Variant.Text"
                                           Color="Color.Dark" IconColor="Color.Secondary" IconSize="Size.Small" Size="Size.Small"
                                           OnClick="() => OnClickCloseButton()">
                                    Cerrar
                                </MudButton>
                            </div>
                            
                        </div>
                    </TitleContent>
                    <ChildContent>
                        
                        @if (_panelContent.Count > 0)
                        {
                            <DocumentPreviewList DocumentDetails="_panelContent" IsVisibleToolBar="false" OnAmountUpdated="RefreshTotals" />
                        }
                        
                        
                    </ChildContent>
                    
                </MudExpansionPanel>
            </MudExpansionPanels>

                    
        </MudPaper>

       
        <MudPaper Class="ma-2" Style="background: transparent;" Elevation="0">
            <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center">

                @* //Form Payment *@
                <MudCard Style="width: 50%;border-radius:10px; min-height: 499px;">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudStack Row="true">
                                <MudIcon Icon="@Icons.Material.Filled.CreditCard" Style="color: #8b4c25;font-size: 1.5rem;"></MudIcon>
                                <MudText Typo="Typo.subtitle1" Style="color: #8b4c25;">@(_disabledSelect ? "Agregar Retención" : "Agregar Método de Pago")</MudText>
                            </MudStack>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            @if (_model.Id != 0)
                            { 
                                <MudButton StartIcon="@Icons.Material.Filled.Close" Variant="Variant.Text"
                                           Color="Color.Dark" IconColor="Color.Secondary" IconSize="Size.Small" Size="Size.Small"
                                           OnClick="() => OnClickCancelButton()">
                                    Limpiar
                                </MudButton>
                            }
                            
                        </CardHeaderActions>
                    </MudCardHeader>

                    <MudCardContent Style="padding-top: 0px;">

                        @* //Form datos payment *@
                        <MudForm Model="@_model" @ref="@form" Validation="@(_modelValidator.ValidateValue)" ValidationDelay="0">

                            <div class="mud-width-full mt-2">
                                @* <MudText Typo="Typo.caption" Style="color: #8b4c25">
                                        <span>Tipo de Moneda</span>
                                    </MudText> *@
                                <MudSelect T="int?"
                                           Label="Moneda"
                                           Disabled="_isCurrencyLocked"
                                           Value="_model.CurrencyId"
                                           ValueChanged="OnCurrencyTypeChanged">
                                    @foreach (var currency in CurrencyList)
                                    {
                                        <MudSelectItem Value="@((int?)currency.Value)">@currency.Text</MudSelectItem>
                                    }
                                </MudSelect>

                            </div>

                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <div class="mud-width-full">
                                    <MudText Typo="Typo.caption" Style="color: #8b4c25">
                                        <span>Tipo de Pago</span>
                                    </MudText>
                                    <MudSelect T="int?"
                                               Value="_model.TypeId"
                                               ValueChanged="OnPayTypeChanged"
                                               Placeholder="Todos los Tipos"
                                               Style="color: #8b4c25;font-size: 12px;line-height: 12px;min-width: 120px;"
                                               Class="mt-0"
                                               Clearable="true"
                                               Dense="true"
                                               Typo="Typo.caption"
                                               AdornmentColor="Color.Default"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense"
                                               For="@(() => _model.TypeId)"
                                               Immediate="false"
                                               ReadOnly="@(!_model.IsActive || _isReadOnlyAmount)"
                                               Disabled="@_disabledSelect">
                                        @if (PaymentTypeList != null)
                                        {
                                            var style = "color: #8b4c25;font-size: 12px;line-height: 12px;";
                                            @foreach (var action in PaymentTypeList)
                                            {
                                                if (action.Text.ToUpper() == "RETENCION")
                                                {
                                                    <MudSelectItem T="int?" Value="@action.Value" Style="@style" Disabled="_disabledRetencion">@action.Text</MudSelectItem>    
                                                }else
                                                {
                                                    <MudSelectItem T="int?" Value="@action.Value" Style="@style">@action.Text</MudSelectItem>
                                                }
                                                
                                                
                                            }
                                        }
                                    </MudSelect>
                                </div>
        
                                <div class="mud-width-full">
                                    <MudText Typo="Typo.caption" Style="color: #8b4c25">
                                        <span>Fecha</span>
                                    </MudText>
                                    <MudDatePicker @ref="_pickerDatePayment"
                                                   @bind-Date="_model.Date"
                                                   Style="color: #8b4c25;font-size: 12px;line-height: 14px;min-width: 120px;margin-top: -4px;"
                                                   Class="align-end"
                                                   Placeholder="dd/MM/yyyy"
                                                   DateFormat="dd/MM/yyyy"
                                                   AutoClose="true"
                                                   Adornment="Adornment.Start"
                                                   AdornmentColor="Color.Default"
                                                   Variant="Variant.Outlined"
                                                   PickerVariant="PickerVariant.Inline"
                                                   Margin="Margin.Dense"
                                                   For="@(() => _model.Date)"
                                                   ReadOnly="@(!_hasRetention)"
                                                   Disabled="@(!_hasRetention)">
                                        <PickerActions>
                                            <MudButton Class="mr-auto align-self-start" OnClick="@(() => _pickerDatePayment.ClearAsync())">Borrar</MudButton>
                                            <MudButton OnClick="@(() => _pickerDatePayment.CloseAsync(false))">Cancelar</MudButton>
                                        </PickerActions>
                                    </MudDatePicker>
                                </div>

                            </MudStack>
          
                            <MudStack Row="true">

                                @if (selectedPaymentType != null && selectedPaymentType.Text.ToUpper() != "EFECTIVO")
                                {
                                    <div class="mud-width-full">
                                        <MudText Typo="Typo.caption" Style="color: #8b4c25">
                                            <span>@(_disabledSelect ? "Nro. Retención" : "Nro. Referencia")</span>
                                        </MudText>
                                        <MudTextField @bind-Value="_model.Reference"
                                        Typo="Typo.caption"
                                        Variant="Variant.Outlined"
                                        Placeholder=@(_disabledSelect ? "Número de retención" : "Número de referencia")
                                        Style="color: #8b4c25;font-size: 12px; line-height: 0px;min-width: 120px;background-color:#e8e8e8;"
                                        Class="mt-0"
                                        MaxLength="16"
                                        For="@(() => _model.Reference)"
                                        Immediate="false"
                                        ReadOnly="@(!_model.IsActive || _isReadOnly)"
                                        Disabled="@(!_model.IsActive || _isReadOnly)">
                                        </MudTextField>
                                    </div>
                                 }
                                <div class="mud-width-full">
                                    <MudText Typo="Typo.caption" Style="color: #8b4c25">
                                        <span>@(selectedCurrency != null && selectedCurrency.Text.ToUpper() == "$ - DOLAR" ? "Monto en Dólares (USD)" : "Monto en Bs")</span>
                                    </MudText>
                                    <MudNumericField @bind-Value="_model.Amount"
                                                     @bind-Value:after="AfterValueChangeAmount"
                                                     Typo="Typo.caption"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Culture="@CultureInfo.GetCultureInfo("en-US")"
                                                     T="double?"
                                                     Placeholder=@(selectedCurrency != null && selectedCurrency.Text.ToUpper() == "$ - DOLAR" ? "Monto (USD)" : "Monto (Bs)")
                                                     Style="color: #8b4c25;font-size: 12px;line-height: 16px;min-width: 120px;background-color:#e8e8e8;"
                                                     Class="align-right mt-0"
                                                     HideSpinButtons="true"
                                                     Pattern="^[0-9.]*$"
                                                     Min="0.00"
                                                     MaxLength="18"
                                                     For="@(() => _model.Amount)"
                                                     Immediate="false"
                                                     ReadOnly="@(!_model.IsActive || _isReadOnlyAmount )"                               />

                                </div>
       
                            </MudStack>

  
                            @if (selectedPaymentType != null && selectedPaymentType.Text.ToUpper() == "TRANSFERENCIA")
                            {
                                <MudDivider Class="mt-1" />
       
                                <MudStack Row="false" Class="mt-2">
                                   
                                    <div class="mud-width-full">
                                        <MudText Typo="Typo.caption" Style="color: #8b4c25">
                                            <span>Banco Origen</span>
                                        </MudText>
                                        <MudSelect T="int?"
                                                   Value="_model.BankOriginId"
                                                   ValueChanged="OnBankOriginChanged"
                                                   Placeholder="Banco Origen Fondos"
                                                   Style="color: #8b4c25;font-size: 12px;line-height: 12px;min-width: 120px;"
                                                   Class="mt-0"
                                                   Clearable="true"
                                                   Dense="true"
                                                   Typo="Typo.caption"
                                                   AdornmentColor="Color.Default"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   For="@(() => _model.BankOriginId)"
                                                   Immediate="false"
                                                   ReadOnly="@(!_model.IsActive || _isReadOnly)">
                                            @if (BankOriginList != null)
                                            {
                                                @foreach (var action in BankOriginList)
                                                {
                                                    <MudSelectItem T="int?" Value="@action.Value" Style="color: #8b4c25;font-size: 12px;line-height: 12px;">@action.Text</MudSelectItem>
                                                }
                                            }
                                        </MudSelect>
                                    </div>

                                    <div class="mud-width-full">
                                        <MudText Typo="Typo.caption" Style="color: #8b4c25">
                                            <span>Cuenta Banco Destino</span>
                                        </MudText>
                                        <MudSelect T="int?"
                                                   Value="_model.AccountId"
                                                   ValueChanged="OnAccountBankChanged"
                                                   Placeholder="Cuenta Destino"
                                                   Style="color: #8b4c25;font-size: 12px;line-height: 12px;min-width: 120px;"
                                                   Class="mt-0"
                                                   Clearable="true"
                                                   Dense="true"
                                                   Typo="Typo.caption"
                                                   AdornmentColor="Color.Default"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   For="@(() => _model.AccountId)"
                                                   Immediate="false"
                                                   ReadOnly="@(!_model.IsActive || _isReadOnly)">
                                            @if (AccountList != null)
                                            {
                                                @foreach (var action in AccountList)
                                                {
                                                    <MudSelectItem T="int?" Value="@action.Value" Style="color: #8b4c25;font-size: 12px;line-height: 12px;">@action.Text</MudSelectItem>
                                                }
                                            }
                                        </MudSelect>
                                    </div>

        

           
                                </MudStack>
                            }
                            <MudText Typo="Typo.caption" Class="mt-2" Style="color: #8b4c25">
                                <span>Adjuntar Comprobante</span>
                            </MudText>
                            <MudButton StartIcon="@Icons.Material.Filled.FileUpload" Variant="Variant.Outlined"
                                       Color="Color.Default" Size="Size.Small" IconColor="Color.Default"
                                       FullWidth="true" OnClick="() => OnClickAttachamentButton()"
                                       Disabled="@(!_model.IsActive || _isReadOnly|| _model.Id == 0)" Class="mt-0">
                                Seleccionar Archivo
                            </MudButton>


                            <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled"
                                       Color="Color.Dark" Size="Size.Small" IconColor="Color.Secondary"
                                       FullWidth="true" OnClick="OnValidSubmit"
                                       Disabled="false"
                                       Class="mt-4">
                                @(_model.Id != 0 ? "Guardar" : _disabledSelect ? "Agregar Retención" : "Agregar Pago")
                            </MudButton>

   

                        </MudForm>
                           
                        
           
                    </MudCardContent>

                </MudCard>

                @* //Payment Details *@
                <MudCard Style="width: 50%;border-radius:10px; min-height: 300px;">
                    <MudCardHeader Style="padding: 6px;padding-top: 10px;">
                        <CardHeaderContent>
                            <MudStack Row="true">
                                <MudBadge Content="PaymentList.Count()" Color="Color.Primary" Overlap="true"
                                          Class="mr-6 mt-2">
                                    <MudText Typo="Typo.subtitle1" Style="color: #8b4c25;">@(_disabledSelect ? "Retenciones Agregadas..." : "Métodos Agregados...")</MudText>
                                </MudBadge>
                                
                            </MudStack>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Style="padding: 6px;padding-top: 0px;" Class="">
                                
                        @if (PaymentList.Count > 0)
                        {
                            <PaymentPreviewList PaymentDetails="@PaymentList" 
                                                OnClickPaymentEdit="(arg) => OnPaymentEdit(arg)"
                                                OnClickPaymentDelete="(arg) => OnPaymentDelete(arg)">
                            </PaymentPreviewList>
                        }

                    </MudCardContent>
                </MudCard>
            </MudStack>
            
                    
        </MudPaper>

        <MudDivider Class="mt-2" />

        @* //Total Footer *@

        @if (!_isLoading && !PaymentList.Any(x => x.StatusName != null && x.StatusName.ToUpper() == "PARA APROBAR"))
            {
        <MudPaper Class="ma-2 mt-6" Style="background: transparent;" Elevation="0">
            <MudContainer Style="padding: 6px;">
                <div class="d-flex">
                    <MudStack Row="false" AlignItems="AlignItems.Start" Spacing="0">
                        <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="0">
                            <MudIcon Icon="@Icons.Material.Filled.Info" Style="color: #8b4c25;font-size: 1.5rem;"></MudIcon>
                            <MudText Typo="Typo.subtitle2" Style="color: #8b4c25;">@(_disabledSelect ? "Resumen" : "Resumen de Pago")</MudText>
                        </MudStack>
                        <MudStack Row="false" AlignItems="AlignItems.Start" Spacing="0">
                            <MudText Typo="Typo.caption">@(string.Concat("Documentos seleccionados: ", SelectedDocuments.Count()))</MudText>
                            <MudText Typo="Typo.caption" Class="mt-0">@(string.Concat(_disabledSelect ? "Retenciones: " : "Métodos de pago: ", PaymentList.Count()))</MudText>
                        </MudStack>
                    </MudStack>

                    <div class="d-flex ml-auto">
                        <MudStack Row="false" AlignItems="AlignItems.End" Spacing="0">
                            <MudText Typo="Typo.caption" Align="Align.End">
                                <span>Total a Pagar:</span>
                                    <MudText Typo="Typo.subtitle1" Style="font-weight:bold;" Inline="true">
                                        @if (SelectedDocuments.Any(x => _ConceptNameList.Contains(x.ConceptName)))
                                        {
                                            @(string.Concat("Bs. ", SelectedDocuments
                                                .Sum(x => (x.PaidAmountBs ?? 0) > 0 ? x.PaidAmountBs.Value : x.AmountBs ?? 0)
                                                .ToString("N2")))
                                        }
                                        else
                                        {
                                            @(string.Concat("$ ", SelectedDocuments
                                                .Sum(x => (x.PaidAmount ?? 0) > 0 ? x.PaidAmount.Value : x.Amount ?? 0)
                                                .ToString("N2")))
                                        }
                                    </MudText>
                            </MudText>
                            
                            <MudText Typo="Typo.caption" Align="Align.End" Class="mt-0">
                                <span>@(_disabledSelect ? "Total Retenciones Agregadas:" : "Total Métodos Agregados:")</span>
                                <MudText Typo="Typo.subtitle1" Style="font-weight:bold;" Inline="true">
                                    @if (SelectedDocuments.Any(x => _ConceptNameList.Contains(x.ConceptName)))
                                    {
                                        @(string.Concat("Bs. ", PaymentList.ToList().Sum(x => x.AmountBs ?? 0).ToString("N2")))
                                    }
                                    else
                                    {
                                        @(string.Concat("$ ", PaymentList.ToList().Sum(x => x.Amount ?? 0).ToString("N2")))
                                    }

                                </MudText>
                            </MudText>
                            
                            <MudText Typo="Typo.caption" Style="color: #a1231b" Align="Align.End" Class="mt-0">
                                <span>Por Pagar:</span>
                                <MudText Typo="Typo.h6" Style="color: #a1231b;font-weight:bold;" Inline="true">
                                    @if (SelectedDocuments.Any(x => _ConceptNameList.Contains(x.ConceptName)))
                                    {
                                            @(string.Concat("Bs. ", (SelectedDocuments.ToList().Sum(x => (x.PaidAmountBs ?? 0) > 0 ? x.PaidAmountBs.Value : x.AmountBs ?? 0) -
                                                                PaymentList.ToList().Sum(x => x.AmountBs ?? 0)).ToString("N2")))
                                    }
                                    else
                                    {
                                            @(string.Concat("$ ", (SelectedDocuments.ToList().Sum(x => (x.PaidAmount ?? 0) > 0 ? x.PaidAmount.Value : x.Amount ?? 0) -
                                                                PaymentList.ToList().Sum(x => x.Amount ?? 0)).ToString("N2")))
                                    }
                                    
                                </MudText>
                            </MudText>
                        </MudStack>
                            
                    </div>

                </div>
            </MudContainer>
            <MudContainer Style="padding: 6px; padding-top: 0px;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-0">
                        <MudButton StartIcon="@Icons.Material.Filled.Payments"
                                   Variant="Variant.Filled"
                                   Color="Color.Dark"
                                   Size="Size.Small"
                                   IconColor="Color.Secondary"
                                   FullWidth="true"
                                   OnClick="OnClickProcessButton"
                                   Disabled="@(CalculateOutstandingBalance() != 0)"
                                   Class="mt-4">
                            @(_disabledSelect ? "Reportar Retención" : "Reportar Pago")
                        </MudButton>
                </MudStack>
            </MudContainer>

        </MudPaper>
        }
    </MudCardContent>

    <NestedDialogCustom IsVisible="@_nestedVisible" 
        Icon="@Icons.Material.Filled.Payments"
        Success="@_successNested"
                        onCloseNested="() => ClosedNested()"
                        ErrorMessage="@_errorMessageNested"
                        Title="@(_disabledSelect ? "Reportar Retención" : "Reportar Pago")" />
</MudCard>

@code {
    [Inject] private UserSession Session { get; set; } = null!;
    [Parameter] public IEnumerable<AccountPreview> SelectedDocuments { get; set; } = new List<AccountPreview>();
    [Parameter] public int SelectedPaymentId { get; set; } = 0;
    [Parameter] public EventCallback OnClickCloseDetail { get; set; }

    private MudForm? form;

    private PaymentUpdate _model { get; set; } = new PaymentUpdate();
    private List<AccountPreview> _panelContent = new List<AccountPreview>();
    private List<Payment> PaymentList  = new List<Payment>();
    private MudDatePicker _pickerDatePayment = new MudDatePicker();
    private List<SelectOption> PaymentTypeList = new List<SelectOption>();
    private List<SelectOption> CurrencyList = new List<SelectOption>();
    private List<SelectOption> BankOriginList = new List<SelectOption>();
    private List<SelectOption> AccountList = new List<SelectOption>();
    private SelectOption? selectedPaymentType = null;
    private SelectOption? selectedCurrency = null;
    private SelectOption? selectedBankOrigin = null;
    private SelectOption? selectedAccount = null;
    private double? _calculatedAmount = 0;
    private bool _isCurrencyLocked = false;
    // private bool _isChanged = true;
    private bool _isLoading = true;
    bool _hasRetention => SelectedDocuments.Any(x => x.ConceptName == "RETENCION IVA (75%)");

    private string _errorMessageNested = string.Empty;
    private bool _nestedVisible = false;
    private bool _successNested = false;
    bool _isReadOnly = false;
    bool _isReadOnlyAmount = false;
    bool _isExpanded = false;
    bool _disabledRetencion = false;
    bool _disabledSelect = false;
    bool _IsAmountBS = false;

    private List<string> _ConceptNameList = new List<string>()
    {
        "PLACA" ,
        "IVA (25%)",
        "RETENCION IVA (75%)",
    };

    private List<string> _typeDocumentList = new List<string>()
    {
        "PROFORMA"
    };

    PaymentValidator _modelValidator = new PaymentValidator();

    IMask maskDate = new DateMask("dd/MM/yyyy");

    SelectValidator<string> _SelectValidator = new SelectValidator<string>(x => x
       .NotNull().WithMessage("Campo requerido")
       .NotEmpty().WithMessage("Campo requerido")
       .Length(1, 20).WithMessage("Campo requerido entre 1-20 carácteres"));


    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;

        if (SelectedDocuments.Count() > 0)
        {
            _panelContent = SelectedDocuments.ToList();
        }

        PaymentTypeList = await ModuleActionsService.GetPaymentSelectOption();
        CurrencyList = await ModuleActionsService.GetCurrencySelectOption();
        BankOriginList = await ModuleActionsService.GetBankOriginSelectOption();
        AccountList = await ModuleActionsService.GetBankAccountSelectOption(Session.SupplierId, selectedCurrency?.Value);

        if (SelectedPaymentId != 0)
        {
            await GetDocuments();
            await GetPayments();

            // Buscamos el objeto exacto por ID en la lista cargada
            var paymentArg = PaymentList.FirstOrDefault(x => x.Id == SelectedPaymentId);

            if (paymentArg != null)
            {
                await OnPaymentEdit(paymentArg);
            }
        }
        else
        {
            await CleanModel();
        }

        _isLoading = false;
        StateHasChanged();
    }

    private async Task GetDocuments()
    {
        SelectedDocuments = new List<AccountPreview>();
        _panelContent = new List<AccountPreview>();

        var serviceResponse = await PaymentService.GetAccountByPayment(Session.UserId, SelectedPaymentId);
        if (serviceResponse.Processed)
        {
            SelectedDocuments = serviceResponse.Data;
            if (SelectedDocuments.Count() > 0)
            {
                _panelContent = SelectedDocuments.ToList();
                _IsAmountBS = SelectedDocuments.Any(x => _ConceptNameList.Contains(x.ConceptName)) ? true : false;

                // 2. Evaluamos el bloqueo con la nueva variable
                _isCurrencyLocked = SelectedDocuments.Any(x => _ConceptNameList.Contains(x.ConceptName));

                if (_isCurrencyLocked)
                {
                    // Forzamos la selección visual a Bolívares
                    selectedCurrency = CurrencyList.FirstOrDefault(p => p.Text.ToUpper() == "BS - BOLIVAR");
                    if (selectedCurrency != null)
                    {
                        _model.CurrencyId = selectedCurrency.Value;
                    }
                }

                await Task.Delay(20);
            }
            else
            {
                _isCurrencyLocked = false;
            }
        }

        StateHasChanged();
    }

    private async Task GetPayments()
    {

        PaymentList = new List<Payment>();

        var serviceResponse = await PaymentService.GetPaymentDetails(Session.UserId, SelectedPaymentId);
        if (serviceResponse.Processed)
        {

            PaymentList = serviceResponse.Data.ToList();
            await Task.Delay(20);

        }
        if (PaymentList.Count <= 0)
        {
            await OnClickCloseButton();
            return;
        }
        CleanModel().Wait(20);

        StateHasChanged();
        Task.CompletedTask.Wait();
    }

    private async Task OnExpandedChanged(bool expanded)
    {
        _isExpanded = expanded;
        if (_isExpanded)
        {
            await Task.Delay(150);
            _panelContent = SelectedDocuments.ToList();
        }
        else
        {
            Task.Delay(150).ContinueWith(t => _panelContent = new List<AccountPreview>()).CatchAndLog();
        }
        StateHasChanged();
    }

    private async Task OnClickCloseButton()
    {
        CleanModel().Wait(20);

        if (SelectedDocuments.Count() > 0)
        {
            SelectedDocuments = new List<AccountPreview>();
            _panelContent = new List<AccountPreview>();
        }



        await OnClickCloseDetail.InvokeAsync();
        StateHasChanged();
    }

    private async Task OnClickCancelButton()
    {

        await CleanModel();

        _isReadOnly = false;

        StateHasChanged();
    }

    private async Task OnClickProcessButton()
    {

        var option = new DialogOptions
        {
            CloseButton = false,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            BackdropClick = false
        };
        bool? confir = await DialogService.ShowMessageBox(
            "Procesar Pago",
            $"Seguro de Procesar? ",
            yesText: "Si", noText: "No", "", option);

        if (confir == true)
        {
            Payment arg = PaymentList.FirstOrDefault() ?? new Payment();
            List<PostAction> ActionList = new List<PostAction>();
            var _Action = new PostAction
            {
                RecordId = arg.PaymentId,
                ModuleId = 0,
                ActionName = "PROCESS",
                ActionComment = "Procesar Pago",
                RelatedId = 0
            };
            ActionList.Add(_Action);

            var serviceResponse = await PaymentService.PaymentsActions(ActionList, Session.UserId);
            if (serviceResponse.Processed)
            {
                PaymentList = new List<Payment>();
                _successNested = true;
                _errorMessageNested = serviceResponse.Message ?? MessageEnum.ProcessNotOK.GetStringValue();
                OnClickCloseButton();
            }
            else
            {
                _successNested = false;
                _errorMessageNested = serviceResponse.Message ?? MessageEnum.ProcessNotOK.GetStringValue();
            }
            OpenNested();
            
        }

        StateHasChanged();
        await Task.CompletedTask;
    }

