    private async Task OnValidSubmit()
    {
        await form!.Validate();

        if (form.IsValid)
        {
            _errorMessageNested = "";

            if (_model.Id == 0 && SelectedPaymentId == 0)
            {
                _model.Settlements = SelectedDocuments.Select(d => new DocumentUpdate()
                {
                    DocumentId = d.Id,
                    DateRate = d.DateRate ?? DateTime.Now,
                    Rate = d.Rate ?? 0,

                }).ToList();

            }
            else
            {
                _model.Settlements = new List<DocumentUpdate>();
            }

            var serviceResponse = await PaymentService.CreatePayment(_model, Session.UserId);
            if (serviceResponse.Processed)
            {
                if (serviceResponse.Data != null)
                {
                    if (SelectedPaymentId == 0)
                    {
                        SelectedPaymentId = serviceResponse.Data.LastId;
                    }

                    GetPayments().Wait(20);
                    GetDocuments().Wait(20);

                    // CleanModel().Wait(20);
                    StateHasChanged();
                    await Task.CompletedTask;
                }
            }
            else
            {
                _successNested = false;
                _errorMessageNested = serviceResponse.Message ?? MessageEnum.SaveNotOK.GetStringValue();

                OpenNested();
            }
        }

        StateHasChanged();
        await Task.CompletedTask;

    }

    private async Task OnPaymentEdit(Payment arg)
    {
        form!.ResetValidation();
        await form!.ResetAsync();

        selectedCurrency = CurrencyList.FirstOrDefault(p => p.Text.ToUpper() == arg.CurrencyName.ToUpper());
        selectedPaymentType = PaymentTypeList.FirstOrDefault(p => p.Text.ToUpper() == arg.TypeName.ToUpper());
        _disabledRetencion = true;
        _disabledSelect = false;

        // 4. Aseguramos el estado de bloqueo al editar el registro
        _isCurrencyLocked = SelectedDocuments.Count(x => _ConceptNameList.Contains(x.ConceptName)) > 0;

        if (_isCurrencyLocked)
        {
            selectedCurrency = CurrencyList.FirstOrDefault(p => p.Text.ToUpper() == "BS - BOLIVAR");
        }

        if (SelectedDocuments.Where(x => x.ConceptName.Trim() == "RETENCION IVA (75%)").Count() > 0)
        {
            selectedPaymentType = PaymentTypeList.FirstOrDefault(p => p.Text.ToUpper() == "RETENCION");
            _disabledRetencion = false;
            _disabledSelect = true;
        }

        await OnCurrencyTypeChanged(selectedCurrency?.Value);

        if (arg.TypeName.ToUpper() == "TRANSFERENCIA")
        {
            selectedAccount = AccountList.FirstOrDefault(p => p.Value == arg.AccountId);
            selectedBankOrigin = BankOriginList.FirstOrDefault(p => p.Value == arg.BankOriginId);
        }
        else
        {
            selectedAccount = null;
            selectedBankOrigin = null;
        }

        _model = new PaymentUpdate()
        {
            TypeId = selectedPaymentType != null ? selectedPaymentType.Value : null,
            CurrencyId = selectedCurrency != null ? selectedCurrency.Value : null,
            BankOriginId = selectedBankOrigin != null ? selectedBankOrigin.Value : null,
            AccountId = selectedAccount != null ? selectedAccount.Value : null,
            Date = arg.Date,
            Reference = string.IsNullOrWhiteSpace(arg.Reference) ? null : arg.Reference,
            Amount = selectedCurrency != null && selectedCurrency.Text.ToUpper() == "BS - BOLIVAR" ? arg.AmountBs : arg.Amount,
            PaymentId = arg.PaymentId,
            Id = arg.Id,
            SupplierId = arg.SupplierId,
            DealerId = arg.DealerId,
            IsActive = arg.IsActive
        };

        _isReadOnly = !(arg.StatusName.ToUpper() == "BORRADOR" || arg.StatusName.ToUpper() == "PARA APROBAR");
        _isReadOnlyAmount = !(arg.StatusName.ToUpper() == "BORRADOR");

        StateHasChanged();
    }

    private async Task OnPaymentDelete(Payment arg)
    {
        var option = new DialogOptions
        {
            CloseButton = false,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            BackdropClick = false
        };
        bool? confir = await DialogService.ShowMessageBox(
            "Eliminar Pago",
            $"Seguro de Eliminar? ",
            yesText: "Si", noText: "No", "", option);

        if (confir == true)
        {

            List<PostAction> ActionList = new List<PostAction>();
            var _Action = new PostAction
            {
                RecordId = arg.Id,
                ModuleId = 0,
                ActionName = "DEACTIVATE",
                ActionComment = "Eliminar Detalle Pago",
                RelatedId = arg.PaymentId
            };
            ActionList.Add(_Action);

            var serviceResponse = await PaymentService.DeletePaymentDetails(ActionList, Session.UserId);
            if (serviceResponse.Processed)
            {
                

                if (SelectedPaymentId == arg.Id)
                {
                    SelectedPaymentId = PaymentList.Where(x => x.Id != arg.Id).FirstOrDefault()?.Id ?? 0;
                }

                GetPayments().Wait(20);
                StateHasChanged();
                await Task.CompletedTask;
            }
            else
            {
                _successNested = false;
                _errorMessageNested = serviceResponse.Message ?? MessageEnum.DeleteNotOK.GetStringValue();
                OpenNested();
            }
        }

    }

    private async Task CleanModel()
    {
        form!.ResetValidation();
        await form!.ResetAsync();

        selectedPaymentType = PaymentTypeList.FirstOrDefault(p => p.Text.ToUpper() == "TRANSFERENCIA");
        selectedCurrency = CurrencyList.FirstOrDefault(p => p.Text.ToUpper() == "$ - DOLAR");
        _disabledRetencion = true;
        _disabledSelect = false;

        // 3. Evaluamos si el limpiar modelo debe mantener la moneda bloqueada en BS
        _isCurrencyLocked = SelectedDocuments.Count(x => _ConceptNameList.Contains(x.ConceptName)) > 0;

        if (_isCurrencyLocked)
        {
            selectedCurrency = CurrencyList.FirstOrDefault(p => p.Text.ToUpper() == "BS - BOLIVAR");
        }

        if (SelectedDocuments.Where(x => x.ConceptName.Trim() == "RETENCION IVA (75%)").Count() > 0)
        {
            selectedPaymentType = PaymentTypeList.FirstOrDefault(p => p.Text.ToUpper() == "RETENCION");
            _disabledRetencion = false;
            _disabledSelect = true;
        }

        if (SelectedDocuments.Where(x => x.TypeName.Trim() == "PROFORMA").Count() > 0)
        {
            selectedCurrency = CurrencyList.FirstOrDefault(p => p.Text.ToUpper() == "$ - DOLAR");
            _isCurrencyLocked=true;
        }

        selectedAccount = null;
        selectedBankOrigin = null;
        _model = new PaymentUpdate()
        {
            TypeId = selectedPaymentType != null ? selectedPaymentType.Value : null,
            CurrencyId = selectedCurrency != null ? selectedCurrency.Value : null,
            AccountId = null,
            BankOriginId = null,
            SupplierId = Session.SupplierId,
            DealerId = Session.DealerId,
        };

        await OnCurrencyTypeChanged(selectedCurrency?.Value);

        if (SelectedPaymentId != 0)
        {
            _model.Date = PaymentList.FirstOrDefault()?.DateRate ?? DateTime.Now;
            _model.PaymentId = PaymentList.FirstOrDefault()?.PaymentId ?? 0;
        }
        else
        {
            _model.Date = DateTime.Now;
            _model.PaymentId = 0;

            if (_panelContent.Count() > 0)
            {
                _model.Date = _panelContent.Where(x => x.DateRate != null).FirstOrDefault()?.DateRate ?? DateTime.Now;
            }
        }

        _isReadOnly = false;
        StateHasChanged();
    }


    private double CalculateOutstandingBalance()
    {
        double balance = 0;
    
        if (SelectedDocuments.Any(x => _ConceptNameList.Contains(x.ConceptName)))
        {
            balance = SelectedDocuments.Sum(x => (x.PaidAmountBs ?? 0) > 0 ? x.PaidAmountBs.Value : x.AmountBs ?? 0) - PaymentList.Sum(x => x.AmountBs ?? 0);
        }
        else
        {
            balance = SelectedDocuments.Sum(x => (x.PaidAmount ?? 0) > 0 ? x.PaidAmount.Value : x.Amount ?? 0) - PaymentList.Sum(x => x.Amount ?? 0);
        }
    
        return Math.Round(balance, 2);
    }

    private async Task OnCurrencyTypeChanged(int? newValue)
    {
        _model.CurrencyId = newValue;

