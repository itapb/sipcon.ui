@using System.ComponentModel.DataAnnotations
@using FluentValidation

@inject IFaseService FaseService
@inject IDialogService DialogService
@inject UtilModuleActions ModuleActionsService

<MudForm Model="@_fase" @ref="@_form" Validation="@(_faseValidator.ValidateValue)" ValidationDelay="0">
    <MudDialog Class="blur dialog-background" ActionsClass="dialog-background-surface">
        <DialogContent>
             
            <MudContainer Class="blur dialog-background-title py-2 pt-2 pa-2">
                <MudCard>
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudGrid Spacing="0" Justify="Justify.Center">
                                <MudItem xs="12" sm="4">
                                    <div class="d-flex justify-left">
                                        <MudSwitch @bind-Value="_fase.IsActive"
                                                   Label="Activo"
                                                   LabelPlacement="Placement.End"
                                                   Color="Color.Success"
                                                   Disabled="@(ActionsModal == ActionsEnum.Create)" />
                                    </div>
                                </MudItem>
                                <MudItem xs="12" sm="2"></MudItem>
                                <MudItem xs="12" sm="6">
                                    <div class="d-flex justify-right" style="justify-content: end;">
                                        <MudButton OnClick="Cancel">Cancelar</MudButton>
                                        <MudFab StartIcon="@Icons.Material.Filled.Save"
                                                Label="Aceptar"
                                                OnClick="@(async () => await OnValidSubmit())"
                                                Color="Color.Info"
                                                Size="Size.Small" />
                                    </div>
                                </MudItem>
                            </MudGrid>
                        </CardHeaderContent>
                    </MudCardHeader>
                </MudCard>
            </MudContainer>
             
            <MudContainer Class="dialog-background-surface py-2 pt-2 pa-2">
                <MudGrid Spacing="1" Justify="Justify.Center">
                    <MudItem xs="12" sm="12">
                        <MudCard>
                            <MudCardHeader>
                                <CardHeaderContent>
                                    <MudStack Row="true">
                                        <MudIcon Icon="@Icons.Material.Filled.AccountTree"
                                                 Color="Color.Default"
                                                 Style="font-size: 2rem;" />
                                        <MudText Typo="Typo.h6">Fase</MudText>
                                    </MudStack>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent Style="padding-top: 0px;">
                                <MudSelect T="int?"
                                           @bind-Value="_fase.AreaId"
                                           Label="Área"
                                           Variant="Variant.Text"
                                           Margin="Margin.Dense"
                                           Disabled="@(!(_fase.IsActive ?? false))"
                                           For="@(() => _fase.AreaId)"
                                           ToStringFunc="@(id => _areaOptions.FirstOrDefault(a => a.Value == id)?.Text ?? string.Empty)">
                                    @foreach (var area in _areaOptions)
                                    {
                                        <MudSelectItem T="int?" Value="@area.Value">@area.Text</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudTextField Typo="Typo.caption"
                                              @bind-Value="_fase.Name"
                                              Label="Fase"
                                              MaxLength="100"
                                              Variant="Variant.Text"
                                              Margin="Margin.Dense"
                                              Disabled="@(!(_fase.IsActive ?? false))"
                                              For="@(() => _fase.Name)"
                                              Immediate="true" /> 
                                <MudNumericField T="int?"
                                                 @bind-Value="_fase.OrderBy"
                                                 Label="Orden"
                                                 Variant="Variant.Text"
                                                 Margin="Margin.Dense"
                                                 Min="1"
                                                 Disabled="@(!(_fase.IsActive ?? false))"
                                                 For="@(() => _fase.OrderBy)"
                                                 Immediate="true" /> 
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                </MudGrid>
            </MudContainer>
              
            <MudDialog @bind-Visible="_nestedModalVisible">
                <TitleContent>
                    <MudStack Row="true">
                        <MudIcon Icon="@Icons.Material.Filled.AccountTree"
                                 Color="@(_successModal ? Color.Default : Color.Error)"
                                 Style="font-size: 2rem;" />
                        <MudText Typo="Typo.h6">Fase</MudText>
                    </MudStack>
                </TitleContent>
                <DialogContent>
                    <MudText Class="nested"><p>@_errorModalMessage</p></MudText>
                </DialogContent>
                <DialogActions>
                    <MudButton Color="Color.Info" OnClick="CloseNestedModal"
                               Variant="Variant.Filled" Class="px-10">Ok</MudButton>
                </DialogActions>
            </MudDialog>

        </DialogContent>
    </MudDialog>
</MudForm>

<style>
    .blur { backdrop-filter: blur(10px); }
    .dialog-background { background-color: transparent; }
    .dialog-background-title {
        background: rgb(from var(--mud-palette-info-lighten) r g b / 50%);
        color: var(--mud-palette-white);
    }
    .dialog-background-surface {
        background: rgb(from var(--mud-palette-surface) r g b / 75%);
    }
</style>

@code {
    [Inject] private UserSession Session { get; set; } = null!;

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public int         IdFase      { get; set; }
    [Parameter] public ActionsEnum ActionsModal { get; set; }

    private MudForm? _form;
    private Fase     _fase              = new();
    private string   _errorModalMessage = string.Empty;
    private bool     _nestedModalVisible;
    private bool     _successModal;

    private IEnumerable<SelectOption> _areaOptions = new List<SelectOption>();

    private readonly FaseValidator _faseValidator = new();

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        // Cargar opciones de área siempre (necesario tanto en Create como en Edit)
        _areaOptions = await ModuleActionsService.GetAreaOption(Session.UserId, Session.SupplierId, Session.DealerId);

        if (ActionsModal == ActionsEnum.Create)
        {
            _fase = new Fase
            {
                Id         = 0,
                IsActive   = true,
                SupplierId = Session.SupplierId,
                DealerId   = Session.DealerId,
                UserId     = Session.UserId,
                OrderBy    = 1
            };
            await Task.Delay(50);
            StateHasChanged();
        }
        else
        {
            await GetFase();
        }
    }

    // ── Cargar fase existente ─────────────────────────────────────────────────

    private async Task GetFase()
    {
        var serviceResponse = await FaseService.GetFase(IdFase, Session.UserId);
        if (serviceResponse.Processed)
        {
            _fase = serviceResponse.Data ?? new Fase();
            await Task.Delay(50);
            StateHasChanged();
        }
        else
        {
            _fase              = new Fase();
            _errorModalMessage = serviceResponse.Message ?? MessageEnum.GetError.GetStringValue();
            OpenNested();
        }
    }

    // ── Guardar ───────────────────────────────────────────────────────────────

    private async Task OnValidSubmit()
    {
        await _form!.Validate();
        if (!_form.IsValid) return;

        _errorModalMessage = string.Empty;

        _fase.SupplierId = Session.SupplierId;
        _fase.DealerId   = Session.DealerId;
        _fase.UserId     = Session.UserId;

        var serviceResponse = await FaseService.SaveFase(_fase, Session.UserId);

        if (serviceResponse.Processed)
        {
            if (ActionsModal == ActionsEnum.Create)
            {
                ActionsModal = ActionsEnum.Edit;
                var result   = serviceResponse.Data ?? new ActionResult();
                if (result is not null)
                {
                    IdFase = result.LastId;
                    await GetFase();
                }
            }
            _errorModalMessage = MessageEnum.SaveOK.GetStringValue();
            _successModal      = true;
        }
        else
        {
            _successModal      = false;
            _errorModalMessage = serviceResponse.Message ?? MessageEnum.SaveNotOK.GetStringValue();
        }

        OpenNested();
        StateHasChanged();
    }

    // ── Cancelar / Cerrar ─────────────────────────────────────────────────────

    private void Cancel()
    {
        if (_successModal)
            MudDialog.Close(DialogResult.Ok(true));
        else
            MudDialog.Cancel();
    }

    private async Task CloseNestedModal()
    {
        _nestedModalVisible = false;
        StateHasChanged();
        await Task.Delay(50);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void OpenNested()
    {
        _nestedModalVisible = true;
        StateHasChanged();
    }

    // ── Validador ─────────────────────────────────────────────────────────────

    public class FaseValidator : AbstractValidator<Fase>
    {
        public FaseValidator()
        {
            RuleFor(x => x.Name)
                .NotEmpty().WithMessage("El nombre es obligatorio.")
                .MaximumLength(100).WithMessage("El nombre no puede superar los 100 caracteres.");

            RuleFor(x => x.OrderBy)
                .NotNull().WithMessage("El orden es obligatorio.")
                .GreaterThan(0).WithMessage("El orden debe ser mayor a 0.");

            RuleFor(x => x.AreaId)
                .NotNull().WithMessage("Debe seleccionar un área.")
                .GreaterThan(0).WithMessage("Debe seleccionar un área.");
        }

        public Func<object, string, Task<IEnumerable<string>>> ValidateValue =>
            async (model, propertyName) =>
            {
                var result = await ValidateAsync(
                    ValidationContext<Fase>.CreateWithOptions(
                        (Fase)model, x => x.IncludeProperties(propertyName)));
                return result.IsValid
                    ? Array.Empty<string>()
                    : result.Errors.Select(e => e.ErrorMessage);
            };
    }
}
