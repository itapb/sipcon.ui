
@using MudBlazor

@inject IInventoryCountService InventoryCountService
@inject UserSession Session
@inject ILogger<InventoryCountDialogDetails> Logger

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">

            <!-- ENCABEZADO -->
            <MudPaper Class="pa-3" Elevation="1">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.History"
                                 Color="Color.Info"
                                 Class="mr-2" />
                        Historial de conteos
                    </MudText>

                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Consulta de todos los conteos relacionados con la parte
                        y ubicación seleccionadas.
                    </MudText>
                </MudStack>
            </MudPaper>

            <!-- INFORMACIÓN DEL REGISTRO -->
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="4">
                    <MudPaper Class="pa-3" Outlined="true">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            INVENTARIO
                        </MudText>
                        <MudText Typo="Typo.subtitle1">
                            <b>@InventoryCountId</b>
                        </MudText>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudPaper Class="pa-3" Outlined="true">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            ID PARTE
                        </MudText>
                        <MudText Typo="Typo.subtitle1">
                            <b>@PartId</b>
                        </MudText>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudPaper Class="pa-3" Outlined="true">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            ID UBICACIÓN
                        </MudText>
                        <MudText Typo="Typo.subtitle1">
                            <b>@LocationId</b>
                        </MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <!-- ESTADOS DE CARGA -->
            @if (isLoading)
            {
                <MudProgressLinear Indeterminate="true"
                                   Color="Color.Info" />

                <MudText Typo="Typo.body2" Align="Align.Center">
                    Consultando historial de conteos...
                </MudText>
            }
            else if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <MudAlert Severity="Severity.Error">
                    @errorMessage
                </MudAlert>
            }
            else if (!itemsDetails.Any())
            {
                <MudAlert Severity="Severity.Info">
                    No se encontraron conteos relacionados con este registro.
                </MudAlert>
            }
            else
            {
                <!-- RESUMEN -->
                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Justify="Justify.SpaceBetween">

                    <MudText Typo="Typo.subtitle2">
                        Registros encontrados
                    </MudText>

                    <MudChip T="string"
                             Color="Color.Info"
                             Variant="Variant.Outlined">
                        @itemsDetails.Count registros
                    </MudChip>
                </MudStack>

                <!-- TABLA DE HISTORIAL -->
                <MudTable T="GetInventoryCountDetail"
                          Items="@itemsDetails"
                          Dense="true"
                          Hover="true"
                          Striped="true"
                          Bordered="true"
                          Elevation="1"
                          FixedHeader="true"
                          Height="400px">

                    <HeaderContent>
                        <MudTh>PLANILLA</MudTh>
                        <MudTh>FECHA CONTEO</MudTh>
                        <MudTh>USUARIO</MudTh>
                        <MudTh>CÓDIGO</MudTh>
                        <MudTh>DESCRIPCIÓN</MudTh>
                        <MudTh>ZONA</MudTh>
                        <MudTh>UBICACIÓN</MudTh>
                        <MudTh Style="text-align:right">
                            CANT. ANTERIOR
                        </MudTh>
                        <MudTh Style="text-align:right">
                            CANT. CONTADA
                        </MudTh>
                        <MudTh Style="text-align:right">
                            DIFERENCIA
                        </MudTh>
                        <MudTh>ESTATUS</MudTh>
                    </HeaderContent>

                    <RowTemplate>
                        <MudTd DataLabel="Planilla">
                            @(context.NumForm?.ToString() ?? "-")
                        </MudTd>

                        <MudTd DataLabel="Fecha conteo">
                            @(context.CountDate?.ToString("dd/MM/yyyy HH:mm")
                                ?? context.Created?.ToString("dd/MM/yyyy HH:mm")
                                ?? "-")
                        </MudTd>

                        <MudTd DataLabel="Usuario">
                            @(context.UserName ?? "Sin asignar")
                        </MudTd>

                        <MudTd DataLabel="Código">
                            @(context.InnerCode ?? "-")
                        </MudTd>

                        <MudTd DataLabel="Descripción">
                            @(context.PartName ?? "-")
                        </MudTd>

                        <MudTd DataLabel="Zona">
                            @(context.Zone ?? "-")
                        </MudTd>

                        <MudTd DataLabel="Ubicación">
                            @(context.Location ?? "-")
                        </MudTd>

                        <MudTd DataLabel="Cant. anterior"
                               Style="text-align:right">
                            @(context.QuantityOld?.ToString() ?? "-")
                        </MudTd>

                        <MudTd DataLabel="Cant. contada"
                               Style="text-align:right">
                            @(context.QuantityNew?.ToString() ?? "-")
                        </MudTd>

                        <MudTd DataLabel="Diferencia"
                               Style="text-align:right">
                            <MudText Color="@GetDifferenceColor(context.Diference)">
                                @(context.Diference?.ToString() ?? "-")
                            </MudText>
                        </MudTd>

                        <MudTd DataLabel="Estatus">
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="Variant.Outlined"
                                     Color="@GetStatusColor(context.StatusName)">
                                @(context.StatusName ?? "Sin estatus")
                            </MudChip>
                        </MudTd>
                    </RowTemplate>

                    <NoRecordsContent>
                        <MudText Class="pa-4">
                            No existen registros para mostrar.
                        </MudText>
                    </NoRecordsContent>

                </MudTable>
            }

        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel"
                   Variant="Variant.Outlined"
                   Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.Close">
            Cerrar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public int PartId { get; set; }

    [Parameter]
    public int LocationId { get; set; }

    [Parameter]
    public int InventoryCountId { get; set; }

    private bool isLoading;
    private string errorMessage = string.Empty;

    private List<GetInventoryCountDetail> itemsDetails = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDetails();
    }

    private async Task LoadDetails()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var response =
                await InventoryCountService.GetInventoryCountDetailAll(
                    InventoryCountId,
                    PartId,
                    LocationId,
                    Session.SupplierId,
                    Session.UserId
                );

            if (response != null &&
                response.Processed &&
                response.Data != null)
            {
                itemsDetails = response.Data;
            }
            else
            {
                itemsDetails = new();

                errorMessage = response?.Message
                    ?? "No fue posible consultar el historial de conteos.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Error consultando historial. Inventario: {InventoryId}, " +
                "Parte: {PartId}, Ubicación: {LocationId}",
                InventoryCountId,
                PartId,
                LocationId
            );

            itemsDetails = new();
            errorMessage =
                "Ocurrió un error al consultar el historial de conteos.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private Color GetDifferenceColor(int? difference)
    {
        if (!difference.HasValue || difference.Value == 0)
            return Color.Default;

        return Color.Error;
    }

    private Color GetStatusColor(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
            return Color.Default;

        return status.Trim().ToUpperInvariant() switch
        {
            "CONTADO" => Color.Success,
            "PROCESADO" => Color.Success,
            "POR CONTAR" => Color.Warning,
            "PENDIENTE" => Color.Warning,
            "BLOQUEADO" => Color.Error,
            _ => Color.Default
        };
    }

    private void Cancel()
    {
        MudDialog.Close();
    }
}