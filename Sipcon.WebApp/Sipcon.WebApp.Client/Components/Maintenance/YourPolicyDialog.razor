@using System.Text.RegularExpressions
@using System.ComponentModel.DataAnnotations
@using FluentValidation
@using System.Globalization
@using MudBlazor @* <--- ASEGÚRATE DE TENER ESTO *@

@inject IMaintenanceService MaintenanceService
@inject IPolicyService PolicyService
@inject IDialogService DialogService
@inject UtilModuleActions ModuleActionsService
@inject NavigationManager UriHelper
@inject IJSRuntime JSRuntime

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Seleccionar Escala de Garantía</MudText>
    </TitleContent>
    <DialogContent>
        <MudContainer Class="dialog-background-surface py-1 pt-0 pa-1" Style="max-height: 400px; overflow-y: auto;">
            <MudTimeline TimelinePosition="TimelinePosition.Start">
                @if (PolicyDetails != null)
                {
                    @foreach (var item in PolicyDetails)
                    {
                        // Definimos la lógica de selección aquí mismo
                        var isSelectable = item.Valid?.ToUpper() == "NO REGISTRADO" || item.Valid?.ToUpper() == "PENDIENTE";

                        <MudTimelineItem TimelineAlign="TimelineAlign.End"
                                         Color="@GetTimelineColor(item.Valid)"
                                         Size="Size.Small">

                            <MudButton Variant="Variant.Text"
                                       OnClick="@(() => SelectItem(item))"
                                       FullWidth="true"
                                       Disabled="@(!isSelectable)"
                                       Style="@(isSelectable
                                                                   ? "text-transform: none; text-align: left; padding: 8px;"
                                                                   : "text-transform: none; text-align: left; padding: 8px; opacity: 0.6; cursor: not-allowed;")">

                        <div style="display: flex; flex-direction: column; width: 100%;">
                            @* Primera línea *@
                            <MudText Typo="Typo.body2" Style="font-size: 11px;">
                                @item.Valid <b>@(item.FromKm?.ToString("N0") + "-" + item.UpToKm?.ToString("N0") + " kms.") </b>
                            </MudText>

                                    @* Segunda línea *@
                                    <MudText Typo="Typo.body2" Style="font-size: 11px;" Class="mud-text-secondary">
                                        @("Desde: " + item.FromDate?.ToString("dd MMM yyyy") + " - Hasta: " + item.UpToDate?.ToString("dd MMM yyyy"))
                                    </MudText>

                                    @* Tercera línea *@
                                    <MudText Typo="Typo.body2" Style="font-size: 11px;" Class="mud-text-secondary">
                                        @("Km: " + item.KM?.ToString("N0") + " - " + item.Date?.ToString("dd MMM yyyy") + " - Servicio: " + item.ServiceId?.ToString("N0"))
                                    </MudText>
                                </div>
                            </MudButton>
                        </MudTimelineItem>
                     }
                }
            </MudTimeline>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cerrar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    // Es vital que este nombre sea exacto y esté dentro de MudBlazor
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] 
    public List<PolicyDetail> PolicyDetails { get; set; } = new();

    private void SelectItem(PolicyDetail detail) 
    {
        if (MudDialog != null)
            MudDialog.Close(DialogResult.Ok(detail));
    }

    private void Cancel() 
    {
        if (MudDialog != null)
            MudDialog.Cancel();
    }

    private Color GetTimelineColor(string status)
    {
        return status?.ToUpper() switch
        {
            "VALIDO" => Color.Success,
            "NO VALIDO" => Color.Error,
            "PENDIENTE" => Color.Info,
            "NO REGISTRADO" => Color.Warning,
            "SRAN" => Color.Default,
            _ => Color.Default
        };
    }
}