@using Sipcon.WebApp.Client.Models
@using Sipcon.WebApp.Client.Pages.Policy
@using Sipcon.WebApp.Client.Services
@using System.Globalization
@using MudBlazor
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IRateService RateService

<MudDialog Class="blur dialog-background" ActionsClass="dialog-background-surface">
    <DialogContent>
        <MudContainer Class="blur dialog-background-title py-2 pt-2 pa-2">
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudGrid Spacing="0" Justify="Justify.Center">
                            <MudItem xs="12" sm="6">
                                <div class="d-flex justify-left">
                                    <MudText Typo="Typo.h6">@(ActionsModal == ActionsEnum.Edit ? "Editar Tasa" : "Nueva Tasa")</MudText>
                                </div>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <div class="d-flex justify-right" style="justify-content: end;">
                                    <MudButton OnClick="Cancel">Cancelar</MudButton>
                                    <MudFab StartIcon="@Icons.Material.Filled.Save" Label="Aceptar" OnClick="Save" Color="Color.Info" Size="Size.Small" />
                                </div>
                            </MudItem>
                        </MudGrid>
                    </CardHeaderContent>
                </MudCardHeader>
            </MudCard>
        </MudContainer>

        <MudContainer Class="dialog-background-surface py-2 pt-2 pa-2">
            <MudGrid Spacing="1" Justify="Justify.Center">
                <MudItem xs="12">
                    <MudCard>
                        <MudCardContent Style="padding-top: 0px;">
                            <MudDatePicker Date="_rate.DDate"
                                           Label="Fecha"
                                           Required="true"
                                           Format="dd/MM/yyyy"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Disabled="@_isEdit" />
    
                            <MudNumericField @bind-Value="_rate.NRate"
                                             Label="Tasa"
                                             Required="true"
                                             Format="N2"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Culture="@CultureInfo.GetCultureInfo("es-VE")" />
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </MudContainer>
    </DialogContent>
</MudDialog>

<style>
    .blur {
        backdrop-filter: blur(10px);
    }

    .dialog-background {
        background-color: transparent;
    }

    .dialog-background-title {
        background: rgb(from var(--mud-palette-info-lighten) r g b / 50%);
        color: var(--mud-palette-white);
    }

    .dialog-background-surface {
        background: rgb(from var(--mud-palette-surface) r g b / 75%);
    }
</style>

@code {
   
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Rate RateItem { get; set; } = new();
    [Parameter] public ActionsEnum ActionsModal { get; set; }
    
    private Rate _rate = new();
    private bool _isEdit => ActionsModal == ActionsEnum.Edit;
    
    protected override void OnInitialized()
    {
        if (_isEdit && RateItem != null)
        {
            _rate = RateItem;
        }
        else
        {
            _rate = new Rate
            {
                Id = 0,
                NRate = null,
                DDate = DateTime.Today
            };
        }
    }
   
    private void Cancel() => MudDialog.Cancel();
    
    private async Task Save()
    {
        // Validaciones del lado del cliente
        if (_rate.NRate == null)
        {
            await DialogService.ShowMessageBox(
                "Validación",
                "LA TASA ES OBLIGATORIA",
                yesText: "OK"
            );
            return;
        }
    
        if (_rate.NRate < 0)
        {
            await DialogService.ShowMessageBox(
                "Validación",
                "LA TASA NO PUEDE SER NEGATIVA",
                yesText: "OK"
            );
            return;
        }
    
        if (_rate.NRate == 0)
        {
            await DialogService.ShowMessageBox(
                "Validación",
                "LA TASA NO PUEDE SER 0",
                yesText: "OK"
            );
            return;
        }
    
        var rateToSend = new Rate
        {
            Id = _rate.Id,
            NRate = _rate.NRate
        };
    
        var response = await RateService.SaveRate(rateToSend);
    
        if (response.Processed)
        {
            await DialogService.ShowMessageBox(
                "Éxito",
                _isEdit ? "Tasa actualizada correctamente" : "Tasa creada correctamente",
                yesText: "OK"
            );
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            await DialogService.ShowMessageBox(
                "Error",
                response.Message ?? "Ocurrió un error al procesar la operación",
                yesText: "OK"
            );
        }
    }

}
