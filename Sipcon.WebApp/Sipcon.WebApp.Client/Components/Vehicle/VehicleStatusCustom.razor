@using System.Globalization; 

<MudDataGrid @ref="_estatusRecordGrid"
             T="EstatusHistory"
             ServerData="ServerReload"
             Striped="true"
             Dense="true"
             Hover="true"
             Filterable="false"
             FixedHeader Height="calc(100vh - 400px)"
             @bind-CurrentPage="_CurrentPage">
        <Columns>   
            <TemplateColumn  Title="">
                <CellTemplate>
                <MudText Typo="Typo.caption" Inline="true" Style="font-weight:bold;font-style:italic">
                    @(context.Item.Date?.ToString("ddd dd MMM yyyy", CultureInfo.GetCultureInfo("es-VE")))
                    </MudText>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn  Title="">
                <CellTemplate>
                    <div class="d-flex justify-center">
                        @if (!string.IsNullOrEmpty(context.Item.Estatus))
                        {
                            string style = "";

                            if (context.Item.Estatus.ToUpper() == "BORRADOR")
                                style += "";
                            else if (context.Item.Estatus.ToUpper() == "DISPONIBLE")
                            {
                                style += "color:#fff";
                                style += ";background-color:#0099F3";
                            }
                            else if (context.Item.Estatus.ToUpper() == "ASIGNADO")
                            {
                                style += "color:#fff";
                                style += ";background-color:#0099F3";
                            }
                            else if (context.Item.Estatus.ToUpper() == "NO DISPONIBLE")
                            {
                                style += "color:#fff";
                                style += ";background-color:#757575";
                            }
                            else
                            {
                                style += "color:#fff";
                                style += ";background-color:#FF7043";
                            }
                            style += ";font-size: 10px";
                            style += ";font-style:italic";

                            <MudChip T="string" Style="@style" Label="true" Disabled="true">
                                @(context.Item.Estatus.ToUpper())
                            </MudChip>
                        }

                    </div>
                </CellTemplate>
            </TemplateColumn>
            
        </Columns>
        
    </MudDataGrid>




@code { [Inject] private UserSession Session { get; set; } = null!;

    [Parameter] public List<EstatusHistory> EstatusRecord { get; set; } = new List<EstatusHistory>();
    
    private MudDataGrid<EstatusHistory>? _estatusRecordGrid;

    private string _searchString = string.Empty;
    private int _CurrentPage = 0;
    private int _rowCount = 0;
    private int _rowsTotal = 0;


    private async Task<GridData<EstatusHistory>> ServerReload(GridState<EstatusHistory> state)
    {
       
        _rowCount = state.Page * state.PageSize;
        IEnumerable<EstatusHistory> _details = new List<EstatusHistory>();
        

        if (EstatusRecord.Count > 0)
        {
            _details = EstatusRecord;
            _rowsTotal = EstatusRecord.Count;
           
        }
        else
        {
            _details = new List<EstatusHistory>();
            _rowsTotal = 0;
        }

        await Task.CompletedTask;

        return new GridData<EstatusHistory> { TotalItems = _rowsTotal, Items = _details };

    }
   
}
