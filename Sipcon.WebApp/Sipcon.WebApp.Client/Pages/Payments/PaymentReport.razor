@page "/paymentreport"

@using System.Globalization
@using System.Text.Json
@using Sipcon.WebApp.Client.Components.Payments
@using Sipcon.WebApp.Client.Repository.Auth


@inject IPaymentService PaymentService
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@inject HubEventsService hubEventsService
@inject UtilModuleActions ModuleActionsService
@implements IDisposable

<PageTitle>Aseguramiento de Ingreso</PageTitle>

<CustomBreadcrumbs mItems="ItemsNavigate"></CustomBreadcrumbs>

<MudText Typo="Typo.h6">Aseguramiento de Ingreso</MudText>
<MudText Typo="Typo.caption">Gestión de transferencias reportadas por concesionarios</MudText>



<MudContainer Style="position:relative;padding: 0;">
    
        @* //Filtros *@
    <MudCard Class="mt-4 pa-0">
        <MudCardContent Style="padding-top: 0px;">
   
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
            
                <MudSelect T="SelectOption"
                            @bind-Value="SelectedPayment"
                            ToStringFunc="@(e => e?.Text)"
                            Style="font-size: 12px;line-height: 15px;min-width: 80px;"
                            Typo="Typo.caption"
                            Label="Tipo de Pago"
                            Placeholder="Todas los tipos"
                            AdornmentColor="Color.Default"
                            Variant="Variant.Outlined"
                            Clearable="true"
                            Dense="true"
                            Margin="Margin.Dense">
                    @if (PaymentList != null)
                    {
                        @foreach (var action in PaymentList)
                        {
                            <MudSelectItem T="SelectOption" Value="@action">@action.Text</MudSelectItem>
                        }
                    }
                </MudSelect>


                <MudSelect T="SelectOption"
                            @bind-Value="SelectedStatus"
                            ToStringFunc="@(e => e?.Text)"
                            Style="font-size: 12px;line-height: 15px;min-width: 80px;"
                            Typo="Typo.caption"
                            Label="Estado"
                            Placeholder="Todos los estados"
                            AdornmentColor="Color.Default"
                            Variant="Variant.Outlined"
                            Clearable="true"
                            Dense="true"
                            Margin="Margin.Dense">
                    @if (StatusList != null)
                    {
                        @foreach (var action in StatusList)
                        {
                            <MudSelectItem T="SelectOption" Value="@action">@action.Text</MudSelectItem>
                        }
                    }
                </MudSelect>

                <MudSelect T="SelectOption"
                            @bind-Value="SelectedCurrency"
                            ToStringFunc="@(e => e?.Text)"
                            Style="font-size: 12px;line-height: 15px;min-width: 80px;"
                            Typo="Typo.caption"
                            Label="Moneda"
                            Placeholder="Todas las Monedas"
                            AdornmentColor="Color.Default"
                            Variant="Variant.Outlined"
                            Clearable="true"
                            Dense="true"
                            Margin="Margin.Dense">
                    @if (CurrencyList != null)
                    {
                        @foreach (var action in CurrencyList)
                        {
                            <MudSelectItem T="SelectOption" Value="@action">@action.Text</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudStack>
            <MudStack Row="true">
                <MudDatePicker @ref="_picker"
                                @bind-Date="_dateFrom"
                                Style="font-size: 12px;line-height: 15px;min-width: 80px;"
                                Adornment="Adornment.End"
                                AdornmentColor="Color.Default"
                                Class="align-right"
                                Label="Desde"
                                Placeholder="dd/MM/yyyy"
                                Variant="Variant.Outlined"
                                PickerVariant="PickerVariant.Inline"
                                Margin="Margin.Dense"
                                DateFormat="dd/MM/yyyy"
                                AutoClose="true">
                    <PickerActions>
                        <MudButton Class="mr-auto align-self-start" OnClick="@(() => _picker.ClearAsync())">Borrar</MudButton>
                        <MudButton OnClick="@(() => _picker.CloseAsync(false))">Cancelar</MudButton>
                    </PickerActions>
                </MudDatePicker>

                <MudDatePicker @ref="_pickerTo"
                                @bind-Date="_dateTo"
                                Style="font-size: 12px;line-height: 15px;min-width: 80px;"
                                Adornment="Adornment.End"
                                AdornmentColor="Color.Default"
                                Class="align-right"
                                Label="Hasta"
                                Placeholder="dd/MM/yyyy"
                                Variant="Variant.Outlined"
                                PickerVariant="PickerVariant.Inline"
                                Margin="Margin.Dense"
                                DateFormat="dd/MM/yyyy"
                                AutoClose="true">
                    <PickerActions>
                        <MudButton Class="mr-auto align-self-start" OnClick="@(() => _pickerTo.ClearAsync())">Borrar</MudButton>
                        <MudButton OnClick="@(() => _pickerTo.CloseAsync(false))">Cancelar</MudButton>
                    </PickerActions>
                </MudDatePicker>
                <div class="d-flex justify-end">
                    <MudButton StartIcon="@Icons.Material.Filled.Search" Variant="Variant.Filled" Style="margin: 11px;"
                               Size="Size.Small"
                               OnClick="ClickRefreshPayments">Buscar</MudButton>
                </div>
                
            </MudStack>

        </MudCardContent>
    </MudCard>

    <MudContainer Class="mt-4 pa-0">
        @* //Resumen *@
        <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mud-width-full mud-height-full">
            <MudPaper Class="mud-height-full mud-width-full" Style="cursor: pointer;width: 25%;background-color: #f9fafb;" @onclick="() => ClickRefreshPaymentResument(null)">
          
                <MudStack Style="height: 100%; min-height: 60px;" AlignItems="AlignItems.Center" Justify="Justify.Center">
                
                    <MudText Typo="Typo.h5" Color="Color.Dark" Style="font-weight:bold;">
                        @PaymentResumenList.Sum(x => x.Count).ToString()
                        <MudText Typo="Typo.subtitle2" Color="Color.Dark">Total</MudText>
                    </MudText>
                
                </MudStack>
          
            </MudPaper>

            @if (PaymentResumenList.Count() > 0)
            {
                foreach (var Item in PaymentResumenList)
                {
                    Color color = Color.Default;
                    string backgroundColor = "cursor: pointer;";
                    string style = "";
                    string txt = "";
                    int total = PaymentResumenList.Sum(x => x.Count);
                    string porcentajeStr = "";

                    if (total != 0)
                    {
                        porcentajeStr = ((Item.Count / (double)total) * 100).ToString("N2");
                    }

                    switch (Item.Name.ToUpper())
                    {
                        case "BORRADOR":
                            color = Color.Warning;
                            txt = "Borrador";
                            backgroundColor += "width: 25%;background-color: #fff9f0;";
                            break;
                        case "APROBADO":
                            color = Color.Primary;
                            txt = "Aprobado";
                            backgroundColor += "width: 25%;background-color: #f5f4fd;";
                            break;
                        case "PARA VALIDAR": 
                            color = Color.Info;
                            txt = "Para Validar";
                            backgroundColor += "width: 25%;background-color: #eff6ff;";
                            break;
                        case  "VALIDADO":
                            color = Color.Success;
                            txt = "Validado";
                            backgroundColor += "width: 25%;background-color: #f0fdf4;";
                            break;
                        default:
                            color = Color.Error;
                            backgroundColor += "width: 25%;background-color: #f9fafb;";
                            break;
                    };
                    
                    style += "font-size: 14px";
                    style += ";font-style:italic";

                
                    <MudPaper Class="mud-height-full mud-width-full" Style="@backgroundColor" @onclick="() => ClickRefreshPaymentResument(Item.Id)">
          
                        <MudStack Row="true"  Style="height: 100%; min-height: 60px;" AlignItems="AlignItems.Center" Justify="Justify.Center">
                            <MudText Typo="Typo.h5" Color="@color" Style="font-weight:bold;" Class="mr-4">
                                @Item.Count.ToString()
                            </MudText>
                            <MudStack Row="false" Justify="Justify.FlexEnd" Spacing="0">
                                <MudText Typo="Typo.subtitle2" Color="@color" Style="@style">@(txt)</MudText>
                                @if (!string.IsNullOrEmpty(porcentajeStr))
                                {
                                    <MudText Typo="Typo.subtitle1" Color="@color" Inline="true" Style="font-size: 12px">@(" " + porcentajeStr + "%")</MudText>
                                }
                                
                            </MudStack>
                            
                        </MudStack>
          
                    </MudPaper>

                }
           
            }

        </MudStack>
    </MudContainer>

        @* //Detalle *@
    <MudCard Class="mt-4 pa-0">
        <MudCardHeader>
            <CardHeaderContent>
                <MudStack Row="true">
                    <MudIcon Icon="@Icons.Material.Filled.Payments" Color="Color.Default" Style="font-size: 2rem;"></MudIcon>
                    <MudText Typo="Typo.h6">Transferencias Reportadas</MudText>
                </MudStack>
                <MudText Typo="Typo.caption">Revise y confirme las transferencias reportadas por los concesionarios</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                                    
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent Style="padding-top: 0px;">

            <MudDataGrid @ref="PaymentsDataGrid"
                            T="Payment"
                            ServerData="LoadGridData"
                            MultiSelection="true"
                            Hover="false"
                            Dense="true"
                            Bordered="false"
                            Filterable="false"
                            FixedHeader Height="calc(100vh - 240px)"
                            Loading="Loading"
                            @bind-CurrentPage="PaymentCurrentPage">
        
                <ToolBarContent>
                    <MudTextField @bind-Value="SearchString"
                                    OnKeyUp="HandleKeyDownSearch"
                                    Variant="Variant.Filled"
                                    Placeholder="Buscar por documento o tipo..."
                                    Adornment="Adornment.Start"
                                    AdornmentIcon="@Icons.Material.Filled.Search"
                                    IconSize="Size.Small"
                                    Style="font-size: 12px; line-height: 1px;max-width: 840px"
                                    Immediate="true"
                                    Typo="Typo.caption">
                    </MudTextField>
                    <MudSpacer />
        
                   
                    <MudButton StartIcon="@Icons.Material.Filled.Download" Variant="Variant.Outlined"
                                Size="Size.Small"
                                OnClick="ExportItemsAsync"
                               Class="mr-2">Exportar</MudButton>
                    
                    @if (selectedPaymens.Count > 0)
                    { 
                        foreach (var module in ItemsModules!)
                        {
                            @if (module.Text.ToUpper() != "EXPORTAR")
                            {
                                <MudButton StartIcon="@(module.Icon ?? "")"
                                           Color="GetTimelineColor(module.Text.ToUpper())"
                                           Variant="Variant.Outlined"
                                           Size="Size.Small"
                                           OnClick="() => HandleMenuClick(module)"
                                           Disabled="@(!selectedPaymens.Any())"
                                           Class="mr-2">@module.Text</MudButton>
                            }

                        }
                    }
                        
                   
                    @* <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="Open user menu">
                        @foreach (var module in ItemsModules!)
                        {
                            <MudMenuItem Icon="@(module.Icon ?? "")"
                                            Label="@module.Text"
                                            OnClick="() => HandleMenuClick(module)"
                                            Disabled="@(!selectedPaymens.Any())" />
                        }
                    </MudMenu> *@
                </ToolBarContent>
                <ColGroup>
                    <col style="width: 2%;" />
                    <col style="width: 2%;" />
                    <col style="width: 5%;" />
                    <col style="width: 8%;" />
                    <col style="width: 5%;" />
                    <col style="width: 20%;" />
                    <col style="width: 10%;" />
                    <col style="width: 10%;" />
                    <col style="width: 24%;" />
                    <col style="width: 4%;" />
                    <col style="width: 10%;" />
                </ColGroup>
                <Columns>
               @*      <SelectColumn T="Payment" /> *@
                    <TemplateColumn>
                        <HeaderTemplate>
                            <MudCheckBox @bind-Value="IsAllCheckBoxSelected" @bind-Value:after="AfterAsyncAllCheck" />
                        </HeaderTemplate>
                        <CellTemplate>
                            <MudCheckBox @bind-Value="context.Item.IsSelected" @bind-Value:after="AfterAsyncCheck"
                                         Disabled="@(context.Item.StatusName.ToUpper() == "BORRADOR")" />
                        </CellTemplate>
                    </TemplateColumn>
                    @* ButtonDisabledFunc="@(context => context.StatusName.ToUpper() == "BORRADOR")" *@
                    <HierarchyColumn T="Payment" EnableHeaderToggle="false" />

                    <TemplateColumn Title="Fecha">
                        <CellTemplate>
                            <MudText Typo="Typo.caption" Align="Align.Left">@(context.Item.DateRate.ToString("dd/MM/yyyy"))</MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Tipo">
                        <CellTemplate>
                            <div class="d-flex justify-start">
                                @if (context.Item.TypeName != null)
                                {
                                    Color color = Color.Default;
                                    string style = "";
                                    string txt = "";

                                    var pair = context.Item.TypeName.ToUpper() switch
                                    {
                                        "RETENCION"     => (txt: "Retencion", color: Color.Dark),
                                        "TRANSFERENCIA" => (txt: "Transferencia", color: Color.Info),
                                        "EFECTIVO"      => (txt: "Efectivo", color: Color.Success),
                                        _               => (txt: "", color: Color.Error)
                                    };
                                    txt = pair.txt;
                                    color = pair.color;

                                    style += ";font-size: 12px;font-style:italic";

                                    <MudChip T="string" Variant="Variant.Text" Color="@color" Style="@style">
                                        @(txt)
                                    </MudChip>
                                }
                   
                            </div>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Moneda">
                        <CellTemplate>
                            <div class="d-flex justify-start">
                                @if (context.Item.CurrencyName != null)
                                {
                                    Color color = Color.Default;
                                    string style = "";
                                    string txt = "";
                                    var pair = context.Item.CurrencyName.ToUpper() switch
                                    {
                                        "BS - BOLIVAR" => (txt: "Bs.", color: Color.Warning),
                                        "$ - DOLAR" => (txt: "USD", color: Color.Success),
                                        _               => (txt: "", color: Color.Error)
                                    };
                                    txt = pair.txt;
                                    color = pair.color;
                                     
                                    style += ";font-size: 12px; font-style:italic";

                                    <MudChip T="string" Variant="Variant.Text" Color="@color" Style="@style">
                                        @(txt)
                                    </MudChip>
                                }
                   
                            </div>
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Title="Banco" Sortable="false" ShowFilterIcon="false" Property="x => x.BankName.ToLower()" CellStyle="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 0;" />
                    <TemplateColumn Title="Referencia">
                        <CellTemplate>
                            <MudText Typo="Typo.caption" Align="Align.Left" Inline="true" Color="Color.Primary" Style="font-weight:bold;">@context.Item.Reference</MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Monto">
                        <CellTemplate>
                            <div class="d-flex justify-center">
                                <MudText Typo="Typo.caption" Align="Align.End">
                                    @(context.Item.Amount?.ToString("N2"))
                                </MudText>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>
                    
                    <TemplateColumn Title="Estado">
                        <CellTemplate>
                            <div class="d-flex justify-start">
                                @if (context.Item.StatusName != null)
                                {
                                    Color color = Color.Default;
                                    string style = "";
                                    string txt = "";
                                    var pair = context.Item.StatusName.ToUpper() switch
                                    {
                                        "BORRADOR" => (txt: "Borrador", color: Color.Warning),
                                        "APROBADO" => (txt: "Aprobado", color: Color.Primary),
                                        "PARA VALIDAR" => (txt: "Para Validar", color: Color.Info),
                                        "VALIDADO" => (txt: "Validado", color: Color.Success),

                                        _ => (txt: "", color: Color.Error)
                                    };
                                    txt = pair.txt;
                                    color = pair.color;
                                                                                                                                               
                                    style += "font-size: 12px;font-style:italic";

                                    <MudChip T="string" Variant="Variant.Text" Color="@color" Style="@style">
                                        @(txt)
                                    </MudChip>
                                }
                   
                            </div>
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Title="Concesionario" Sortable="false" ShowFilterIcon="false" Property="x => x.DealerName.ToLower()" CellStyle="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 0;" />
                    <TemplateColumn StickyRight="true">
                        <CellTemplate>
                            <MudButtonGroup Size="@Size.Small" Variant="Variant.Text" Color="Color.Dark">
                                @if (context.Item.StatusName != null)
                                {
                                    if (context.Item.StatusName.ToUpper() == "BORRADOR")
                                    {
                                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="() => ClickEditPayment(context.Item)" />
                                    }
                                }
                                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.AttachFile" OnClick="() => OnClickAttachamentButton(context.Item)" />
                            </MudButtonGroup>
                            
                        </CellTemplate>
                    </TemplateColumn>

                </Columns>
                <ChildRowContent>
                    
                    <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mud-width-full mud-height-full">
                        <MudCard Style="width: 30%; min-height:176px;">
                            <MudCardHeader Style="padding-top: 8px;">
                                <CardHeaderContent>
                                    <MudText Typo="Typo.button" Align="Align.Left" Inline="true" Color="Color.Primary" Style="font-weight:bold;">
                                        @("#" + context.Item.Id.ToString().PadLeft(10, '0'))
                                    </MudText>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent Style="padding-top: 0px;">
                                <MudText Style="font-weight:bold;" Typo="Typo.body2">Cuenta Nro. : <MudText Inline="true" Typo="Typo.caption">@context.Item.AccountNumber</MudText></MudText>
                                <MudText Style="font-weight:bold;" Typo="Typo.body2">Banco       : <MudText Inline="true" Typo="Typo.caption">@context.Item.BankName</MudText></MudText>
                                @if (context.Item.TypeName.ToUpper() == "TRANSFERENCIA")
                                {
                                    <MudText Style="font-weight:bold;" Typo="Typo.body2">Banco Origen: <MudText Inline="true" Typo="Typo.caption">@context.Item.BankOriginName</MudText></MudText>
                       
                                }
                            </MudCardContent>
                        </MudCard>
                    
                        <MudCard Style="width: 70%; min-height:176px;">
                  
                            <MudCardContent Style="padding-top: 0px;" Class="">
                                
                                <DocumentPreviewList DocumentDetails="context.Item.AccountPreview" IsVisibleToolBar="true" />

                            </MudCardContent>
                        </MudCard>
                    </MudStack>
                    
                </ChildRowContent>
                <PagerContent>
                    <MudDataGridPager T="Payment" PageSizeOptions="new int[] { 100 }" InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Registros por Pagina" />
                </PagerContent>
            </MudDataGrid>

        </MudCardContent>
    </MudCard>

</MudContainer>

@if (IdPaymentPreviewSelected > 0)
{
    @* **//Reportar Pago *@
    <MudDrawerContainer Class="mud-height-full">
        <MudDrawer @bind-Open="@_openDrawer" Width="950px" Anchor="Anchor.End" Elevation="1" Variant="@DrawerVariant.Temporary" OverlayAutoClose="false">
    
            <PaymentAccountDetail SelectedDocuments="@DocumentSelecteds" 
                SelectedPaymentId="@IdPaymentPreviewSelected" 
                OnClickCloseDetail="() => ClickClosedDrawer()">
            </PaymentAccountDetail>
    
        </MudDrawer>
    </MudDrawerContainer>
}

<NestedDialogCustom IsVisible="@NestedVisible"
                    Icon="@Icons.Material.Filled.Payments"
                    Success="@Success"
                    onCloseNested="() => NestedVisible = false"
                    ErrorMessage="@NestedErrorMessage"
                    Title="@("Aseguramiento de Ingreso")" />




@code {
    [Inject] private UserSession Session { get; set; } = null!;
    [Inject] private AuthenticationProviderJWT AuthenticationStateProvider { get; set; } = null!;

    private List<BreadcrumbItem> ItemsNavigate =
               [
        new("Home", href: "", icon: Icons.Material.Filled.Home),
        new("Portal de Pagos",href: "", icon: Icons.Material.Filled.Payments),
        new("Aseguramiento de Ingreso",  href: "paymentreport", disabled: false, icon: Icons.Material.Filled.Payment),
    ];

    private string ModuleName = "PAGOS-ASEGURAMIENTO";
    private string NestedErrorMessage = string.Empty;
    private bool NestedVisible;
    private bool Success = false;
    private bool Loading = false;
    private bool _open;
    private string SearchString = string.Empty;
    private bool _openDrawer = false;

    private List<ModuleAction> ItemsModules = new List<ModuleAction>([]);
    private List<PaymentResumen> PaymentResumenList { get; set; } = new List<PaymentResumen>();

    private bool IsAllCheckBoxSelected = false;
    int PaymentCurrentPage = 0;

    private MudDataGrid<Payment>? PaymentsDataGrid;
    private List<Payment> selectedPaymens = new List<Payment>();

    private List<AccountPreview> DocumentSelecteds { get; set; } = new List<AccountPreview>();
    private int IdPaymentPreviewSelected = 0;
    private bool IsPaymentSelected = false;

    IMask maskDate = new DateMask("dd/MM/yyyy");
    private DateTime? _dateFrom { get; set; } = null;
    private DateTime? _dateTo { get; set; } = null;
    private MudDatePicker _picker = new MudDatePicker();
    private MudDatePicker _pickerTo = new MudDatePicker();
    private List<SelectOption> StatusList = new List<SelectOption>();
    private List<SelectOption> CurrencyList = new List<SelectOption>();
    private List<SelectOption> PaymentList = new List<SelectOption>();
    private SelectOption? SelectedStatus;
    private SelectOption? SelectedCurrency;
    private SelectOption? SelectedPayment;


    private Color GetTimelineColor(string status)
    {
        return status switch
        {
            "VALIDAR" => Color.Success,
            "RECHAZAR" => Color.Error,
            "PROCESAR" => Color.Info,
            "APROBAR" => Color.Warning,
            _ => Color.Default
        };
    }


    protected override async Task OnInitializedAsync()
    {
        await AuthenticationStateProvider.RefreshStaticVariables();
        await LoadDataAsync();
        hubEventsService.OnDealerChanged += ReloadPaymentReportGrid;
        hubEventsService.OnSupplierChanged += ReloadPaymentReportGrid;
        await Task.CompletedTask;

    }

    private async Task LoadDataAsync()  
    {
        ItemsModules = await ModuleActionsService.GetModuleActions(Session.UserId, ModuleName);
        StatusList = await ModuleActionsService.GetStatusByModule(Session.UserId, ModuleName);
        PaymentList = await ModuleActionsService.GetPaymentSelectOption();
        CurrencyList = await ModuleActionsService.GetCurrencySelectOption();

        await Task.CompletedTask;
    }

    private async Task ReloadPaymentReportGrid()
    {
        if (PaymentsDataGrid != null )
        {
            await PaymentsDataGrid.ReloadServerData();
        }
    }

    Func<Payment, object> GetSortKeySelector(string sortByPropertyName) => sortByPropertyName switch
    {
        nameof(Payment.Id) => o => o.Id,
        nameof(Payment.DateRate) => o => o.DateRate,
        nameof(Payment.DealerName) => o => o.DealerName ?? "",
        nameof(Payment.CurrencyName) => o => o.CurrencyName ?? "",
        nameof(Payment.TypeName) => o => o.TypeName ?? "",
        nameof(Payment.StatusName) => o => o.StatusName ?? "",
        _ => null! //o => o.Id ?? 0 // Criterio de ordenación por defecto
    };

    private async Task<GridData<Payment>> LoadGridData(GridState<Payment> state)
    {
        await AuthenticationStateProvider.RefreshStaticVariables();
        Session.IsNewOrEdit = false;
        IsAllCheckBoxSelected = false;
        Loading = true;
        var TotalItems = 0;
        var mOffset = state.Page * state.PageSize;

        IEnumerable<Payment> Data;


        int? idRespaldado = SelectedStatus?.Value;
        if (idRespaldado.HasValue && StatusList != null) { SelectedStatus = StatusList.FirstOrDefault(x => x.Value == idRespaldado); }
        int? _estatusid = SelectedStatus?.Value;

        idRespaldado = SelectedPayment?.Value;
        if (idRespaldado.HasValue && StatusList != null) { SelectedPayment = PaymentList.FirstOrDefault(x => x.Value == idRespaldado); }
        int? _paymentid = SelectedPayment?.Value;

        idRespaldado = SelectedCurrency?.Value;
        if (idRespaldado.HasValue && StatusList != null) { SelectedCurrency = CurrencyList.FirstOrDefault(x => x.Value == idRespaldado); }
        int? _currencyid = SelectedCurrency?.Value;

        string _dateFromStr = string.IsNullOrEmpty(_dateFrom?.ToString()) ? string.Empty : _dateFrom.Value.ToString();
        string _dateToStr = string.IsNullOrEmpty(_dateTo?.ToString()) ? string.Empty : _dateTo.Value.ToString();

        var resumentResponse = await PaymentService.GetPaymentsStatusResumen(Session.UserId, Session.SupplierId, Session.DealerId, SearchString, _dateFromStr, _dateToStr, _estatusid, _currencyid, _paymentid);
        PaymentResumenList = resumentResponse.Processed ? resumentResponse.Data ?? new List<PaymentResumen>() : new List<PaymentResumen>();
        StateHasChanged();

        var serviceResponse = await PaymentService.GetPayments(Session.UserId, Session.SupplierId, Session.DealerId, mOffset, SearchString, _dateFromStr, _dateToStr, _estatusid, _currencyid, _paymentid);
        if (serviceResponse.Processed)
        {
            Data = serviceResponse.Data;
            TotalItems = serviceResponse.Total;

            if (state.SortDefinitions.FirstOrDefault() is SortDefinition<Payment> sortDefinition)
            {
                Data = Data.OrderByDirection(sortDefinition.Descending ? SortDirection.Descending : SortDirection.Ascending, GetSortKeySelector(sortDefinition.SortBy));
            }
        }
        else
        {
            Data = new List<Payment>();
            Success = false;
            NestedErrorMessage = serviceResponse.Message ?? MessageEnum.GetError.GetStringValue();

            // OpenNested();

        }

        Loading = false;
        StateHasChanged();

        return new GridData<Payment> { TotalItems = TotalItems, Items = Data };
    }

