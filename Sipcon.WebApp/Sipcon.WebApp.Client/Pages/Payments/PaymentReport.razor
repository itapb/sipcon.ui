    private async Task HandleMenuClick(ModuleAction module)
    {
        switch (module.ActionName)
        {
            
            case "APPROVE": //APROBAR
                await ApproveItemsAsync(module.IdAction, module.ActionName);
                break;
            case "VALIDATE": //VALIDAR
                await ValidateItemsAsync(module.IdAction, module.ActionName);
                break;
            case "DECLINE": //RECHAZAR
                await DeclineItemsAsync(module.IdAction, module.ActionName);
                break;
            case "PROCESS": //PROCESAR
                await ProcessItemsAsync(module.IdAction, module.ActionName);
                break;
            default:
                Console.WriteLine($"{MessageEnum.ActionsError.GetStringValue()}: {module.ActionName}");
                break;
        }
    }

    private async Task ExportItemsAsync()
    {
        int? idRespaldado = SelectedStatus?.Value;
        if (idRespaldado.HasValue && StatusList != null) { SelectedStatus = StatusList.FirstOrDefault(x => x.Value == idRespaldado); }
        int? _estatusid = SelectedStatus?.Value;

        idRespaldado = SelectedPayment?.Value;
        if (idRespaldado.HasValue && StatusList != null) { SelectedPayment = PaymentList.FirstOrDefault(x => x.Value == idRespaldado); }
        int? _paymentid = SelectedPayment?.Value;

        idRespaldado = SelectedCurrency?.Value;
        if (idRespaldado.HasValue && StatusList != null) { SelectedCurrency = CurrencyList.FirstOrDefault(x => x.Value == idRespaldado); }
        int? _currencyid = SelectedCurrency?.Value;

        string _dateFromStr = string.IsNullOrEmpty(_dateFrom?.ToString()) ? string.Empty : _dateFrom.Value.ToString();
        string _dateToStr = string.IsNullOrEmpty(_dateTo?.ToString()) ? string.Empty : _dateTo.Value.ToString();
        
        var serviceResponse = await PaymentService.ExportPayment(Session.UserId, Session.SupplierId, Session.DealerId, SearchString, _dateFromStr, _dateToStr, _estatusid, _currencyid, _paymentid);

        if (serviceResponse.Processed)
        {
            Success = true;
            NestedErrorMessage = "";

            var base64File = Convert.ToBase64String(serviceResponse.Data.ToArray());
            var fileUrl = $"data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{base64File}";
            await JSRuntime.InvokeVoidAsync("downloadFile", fileUrl, "PaymentReport.xlsx");

        }
        else
        {
            Success = false;
            NestedErrorMessage = serviceResponse.Message ?? MessageEnum.ExportNotOK.GetStringValue();
            OpenNested();
        }
    }

    private async Task ApproveItemsAsync(int moduleId, string moduleActionName)
    {
        
        if (selectedPaymens.Any())
        {

            DialogOptions options = new() { BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = false, NoHeader = true };
            var parameters = new DialogParameters<TextItemDialog> { { x => x.Title, "Aprobar Pago." } };
            var dialog = await DialogService.ShowAsync<TextItemDialog>("Aprobar Pago", parameters, options);

            StateHasChanged();

            var result = await dialog.Result;
            if (!result!.Canceled)
            {
                var _Report = (string)(result.Data ?? string.Empty);
                List<PostAction> ActionList = ([]);

                foreach (var item in selectedPaymens)
                {
                    var _Action = new PostAction
                    {
                        RecordId = item.Id,
                        ModuleId = moduleId,
                        ActionName = moduleActionName,
                        ActionComment = _Report
                    };
                    ActionList.Add(_Action);
                }

                var serviceResponse = await PaymentService.PaymentsActions(ActionList, Session.UserId);
                if (serviceResponse.Processed)
                {
                    Success = true;
                    NestedErrorMessage = MessageEnum.ApproveOK.GetStringValue();
                    
                    await PaymentsDataGrid!.ReloadServerData();
                    selectedPaymens = new List<Payment>();
                }
                else
                {
                    Success = false;
                    NestedErrorMessage = serviceResponse.Message ?? MessageEnum.ApproveNotOK.GetStringValue();

                }
                OpenNested();
            }
        }
        await Task.CompletedTask;
    }

