@page "/documentreport"

@using System.Globalization
@using System.Text.Json
@using Sipcon.WebApp.Client.Components.Payments
@using Sipcon.WebApp.Client.Repository.Auth


@inject IPaymentService PaymentsRepository
@inject IJSRuntime JSRuntime
@inject HubEventsService hubEventsService
@inject UtilModuleActions ModuleActionsService
@implements IDisposable

<PageTitle>Reporte de Pagos</PageTitle>

<CustomBreadcrumbs mItems="ItemsNavigate"></CustomBreadcrumbs>
<MudContainer MaxWidth="MaxWidth.False" Gutters="false" Class="mt-2">

    @* **//Filtros *@
    <MudCard Class="mt-4 pa-0">
        <MudCardContent Style="padding-top: 0px;">

            @if (ConceptList != null)
            {
                @* 1. Conceptos (MultiSelection usa Values y ValuesChanged) *@
              <MudToggleGroup T="string" SelectionMode="SelectionMode.MultiSelection"
                Values="_selectedConcepts"
                ValuesChanged="@(async (values) => { 
                    // 1. Evaluamos si el usuario está agregando (seleccionando) o quitando
                    bool isSelecting = values.Count() > (_selectedConcepts?.Count() ?? 0);

                    // 2. Actualizamos la referencia con los nuevos valores
                    _selectedConcepts = values; 

                    // 3. Ejecutamos tu lógica de exclusión visual
                    AfterAsyncExclusiveCheck(); 

                    // 4. Solo refrescamos el Grid si el usuario activó un nuevo filtro
                    if (isSelecting)
                    {
                        await ClickRefreshDocuments();
                    }
                })"
                SelectedClass="black white-text"
                Color="Color.Secondary" CheckMark>
                    @foreach (var action in ConceptList)
                    {
                        switch (action.Text.ToUpper())
                        {
                            case "PLACA":
                            case "IVA (25%)":
                                <MudToggleItem Value="@action.ValueStr" Text="@action.Text"
                                               UnselectedIcon="@Icons.Material.Filled.CheckBoxOutlineBlank"
                                               SelectedIcon="@Icons.Material.Filled.CheckBox"
                                               Disabled="@_IsExclusive" />
                                break;
                            case "BASE":
                                <MudToggleItem Value="@action.ValueStr" Text="@action.Text"
                                               UnselectedIcon="@Icons.Material.Filled.CheckBoxOutlineBlank"
                                               SelectedIcon="@Icons.Material.Filled.CheckBox"
                                               Disabled="@_IsExclusiveBase" />
                                break;
                            case "RETENCION IVA (75%)":
                                <MudToggleItem Value="@action.ValueStr" Text="@action.Text"
                                               UnselectedIcon="@Icons.Material.Filled.CheckBoxOutlineBlank"
                                               SelectedIcon="@Icons.Material.Filled.CheckBox"
                                               Disabled="@_IsExclusiveRetencion" />
                                break;
                            default:
                                <MudToggleItem Value="@action.ValueStr" Text="@action.Text"
                                               UnselectedIcon="@Icons.Material.Filled.CheckBoxOutlineBlank"
                                               SelectedIcon="@Icons.Material.Filled.CheckBox" />
                                break;
                        }
                        ;
                    }
                </MudToggleGroup>
            }

            <MudStack Row="true" Class="mt-2">

                @* 2. Fecha Pago *@
                <MudDatePicker @ref="_pickerPay"
                               Date="_datePay"
                               DateChanged="@(async (date) => { _datePay = date; await ClickRefreshDocuments(); })"
                               Style="font-size: 12px;line-height: 15px;min-width: 120px;"
                               Adornment="Adornment.End"
                               AdornmentColor="Color.Default"
                               Class="align-right"
                               Label="Fecha Pago"
                               Placeholder="dd/MM/yyyy"
                               Variant="Variant.Outlined"
                               PickerVariant="PickerVariant.Inline"
                               Margin="Margin.Dense"
                               DateFormat="dd/MM/yyyy"
                               AutoClose="true">
                    <PickerActions>
                        <MudButton Class="mr-auto align-self-start" OnClick="@(async () => { await _pickerPay.ClearAsync(); _datePay = null; await ClickRefreshDocuments(); })">Borrar</MudButton>
                        <MudButton OnClick="@(() => _pickerPay.CloseAsync(false))">Cancelar</MudButton>
                    </PickerActions>
                </MudDatePicker>

                @* 3. Tipo Documento *@
                <MudSelect T="SelectOption"
                           Value="SelectedDocumentType"
                           ValueChanged="@(async (value) => { SelectedDocumentType = value; await ClickRefreshDocuments(); })"
                           ToStringFunc="@(e => e?.Text)"
                           Style="font-size: 12px;line-height: 15px;min-width: 80px;"
                           Typo="Typo.caption"
                           Label="Tipo Documento"
                           Placeholder="Tipo Documento"
                           AdornmentColor="Color.Default"
                           Variant="Variant.Outlined"
                           Clearable="true"
                           Dense="true"
                           Margin="Margin.Dense">
                    @if (DocumentList != null)
                    {
                        @foreach (var action in DocumentList)
                        {
                            <MudSelectItem T="SelectOption" Value="@action">@action.Text</MudSelectItem>
                        }
                    }
                </MudSelect>

                @* 4. Estado *@
                <MudSelect T="SelectOption"
                           Value="SelectedStatus"
                           ValueChanged="@(async (value) => { SelectedStatus = value; await ClickRefreshDocuments(); })"
                           ToStringFunc="@(e => e?.Text)"
                           Style="font-size: 12px;line-height: 15px;min-width: 80px;"
                           Typo="Typo.caption"
                           Label="Estado"
                           Placeholder="Todos los estados"
                           AdornmentColor="Color.Default"
                           Variant="Variant.Outlined"
                           Clearable="true"
                           Dense="true"
                           Margin="Margin.Dense">
                    @if (StatusList != null)
                    {
                        @foreach (var action in StatusList)
                        {
                            <MudSelectItem T="SelectOption" Value="@action">@action.Text</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudStack>

            <MudStack Row="true">
                @* 5. Desde *@
                <MudDatePicker @ref="_picker"
                               Date="_dateFrom"
                               DateChanged="@(async (date) => { _dateFrom = date; await ClickRefreshDocuments(); })"
                               Style="font-size: 12px;line-height: 15px;min-width: 80px;"
                               Adornment="Adornment.End"
                               AdornmentColor="Color.Default"
                               Class="align-right"
                               Label="Desde"
                               Placeholder="dd/MM/yyyy"
                               Variant="Variant.Outlined"
                               PickerVariant="PickerVariant.Inline"
                               Margin="Margin.Dense"
                               DateFormat="dd/MM/yyyy"
                               AutoClose="true">
                    <PickerActions>
                        <MudButton Class="mr-auto align-self-start" OnClick="@(async () => { await _picker.ClearAsync(); _dateFrom = null; await ClickRefreshDocuments(); })">Borrar</MudButton>
                        <MudButton OnClick="@(() => _picker.CloseAsync(false))">Cancelar</MudButton>
                    </PickerActions>
                </MudDatePicker>

                @* 6. Hasta *@
                <MudDatePicker @ref="_pickerTo"
                               Date="_dateTo"
                               DateChanged="@(async (date) => { _dateTo = date; await ClickRefreshDocuments(); })"
                               Style="font-size: 12px;line-height: 15px;min-width: 80px;"
                               Adornment="Adornment.End"
                               AdornmentColor="Color.Default"
                               Class="align-right"
                               Label="Hasta"
                               Placeholder="dd/MM/yyyy"
                               Variant="Variant.Outlined"
                               PickerVariant="PickerVariant.Inline"
                               Margin="Margin.Dense"
                               DateFormat="dd/MM/yyyy"
                               AutoClose="true">
                    <PickerActions>
                        <MudButton Class="mr-auto align-self-start" OnClick="@(async () => { await _pickerTo.ClearAsync(); _dateTo = null; await ClickRefreshDocuments(); })">Borrar</MudButton>
                        <MudButton OnClick="@(() => _pickerTo.CloseAsync(false))">Cancelar</MudButton>
                    </PickerActions>
                </MudDatePicker>

                @* Dejas el botón original intacto por si quieren refrescar manualmente *@
                <div class="d-flex justify-end">
                    <MudButton StartIcon="@Icons.Material.Filled.Search" Variant="Variant.Filled" Style="margin: 11px;"
                               Size="Size.Small"
                               OnClick="ClickRefreshDocuments">Buscar</MudButton>
                </div>

            </MudStack>

        </MudCardContent>

    </MudCard>

    @* **//Documents *@
    <MudCard Class="mt-4 pa-0">
    <MudDataGrid @ref="DocumentsDataGrid"
                 T="Receivable"
                 ServerData="LoadGridData"
                 MultiSelection="true"
                 SortMode="SortMode.Multiple"
                 Filterable="true"
                 FixedHeader Height="calc(92vh - 350px)"
                 Hideable="true"
                 Bordered="false"
                 Dense="true"
                 Loading="Loading"
                 @bind-CurrentPage="DocumentsCurrentPage">
    
        <ToolBarContent>
            <MudTextField @bind-Value="SearchString"
                          OnKeyUp="HandleKeyDownSearch"
                          Variant="Variant.Filled"
                          Placeholder="Buscar por documento o tipo..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Small"
                          Style="font-size: 12px; line-height: 1px;max-width: 840px"
                          Immediate="true"
                          Typo="Typo.caption">
            </MudTextField>
            <MudSpacer />
         
            <MudButton StartIcon="@Icons.Material.Filled.Download" Variant="Variant.Outlined"
                       Size="Size.Small"
                       OnClick="ExportItemsAsync"
                       Class="mr-2">Exportar</MudButton>
            <MudButton EndIcon="@Icons.Material.Filled.Paid" Variant="Variant.Filled" Disabled="@(!IsDocumentSelected)"
                       Color="Color.Dark" Size="Size.Small" IconColor="Color.Secondary"
                       OnClick="ClickAddPayment">@(_isRetencion ? "Reportar Retención" : "Reportar Pago")</MudButton>
        </ToolBarContent>
      
        <Columns>
            @* 1. Checkbox: Centrado *@
            <TemplateColumn HeaderClass="dt-center" CellClass="dt-center">
                <HeaderTemplate>
                    <MudCheckBox @bind-Value="IsAllCheckBoxSelected" @bind-Value:after="AfterAsyncAllCheck" />
                </HeaderTemplate>
                <CellTemplate>
                    <MudCheckBox @bind-Value="context.Item.IsSelected" @bind-Value:after="AfterAsyncCheck"
                                 Disabled="@(_statusNotReportPay.Contains(context.Item.TransactionStatusName.ToUpper()))" />
                </CellTemplate>
            </TemplateColumn>

            @* 2. Documento: Izquierda *@
            <TemplateColumn Title="Documento" HeaderClass="dt-left" CellClass="dt-left">
                <CellTemplate>
                    <MudText Typo="Typo.caption" Inline="true" Color="Color.Primary" 
                             Style="font-weight:bold;">@context.Item.Number</MudText>
                </CellTemplate>
            </TemplateColumn>

            @* 3. Tipo: Izquierda *@
            <TemplateColumn Title="Tipo" HeaderClass="dt-left" CellClass="dt-left">
                <CellTemplate>
                    @if (context.Item.TypeName != null)
                    {
                        Color color = Color.Default;
                        string style = ";font-size: 12px;font-style:italic";
                        string txt = context.Item.TypeName.ToUpper() switch
                        {
                            "UNIDADES" => "Unidades",
                            "REPUESTOS" => "Repuestos",
                            "PROFORMA" => "Proforma",
                            "OTROS" => "Otros Gastos",
                            "GASTOS ADMINISTRATIVOS" => "Gastos Administrativos",
                            _ => ""
                        };
                        color = context.Item.TypeName.ToUpper() switch
                        {
                            "UNIDADES" => Color.Dark,
                            "REPUESTOS" => Color.Info,
                            "PROFORMA" => Color.Success,
                            "OTROS" => Color.Warning,
                            "GASTOS ADMINISTRATIVOS" => Color.Secondary,
                            _ => Color.Error
                        };

                        <MudChip T="string" Variant="Variant.Text" Color="@color" Style="@style">
                            @(txt)
                        </MudChip>
                    }
                </CellTemplate>
            </TemplateColumn>

            @* 4. Concepto: Izquierda *@
            <TemplateColumn Title="Concepto" HeaderClass="dt-left" CellClass="dt-left">
                <CellTemplate>
                    @if (context.Item.ConceptName != null)
                    {
                        Color color = Color.Default;
                        string style = ";font-size: 12px;font-style:italic";
                        string txt = context.Item.ConceptName.ToUpper() switch
                        {
                            "BASE" => "Base",
                            "PLACA" => "Placa",
                            "IVA (25%)" => "IVA (25%)",
                            "RETENCION IVA (75%)" => "Retención IVA (75%)",
                            _ => ""
                        };
                        color = context.Item.ConceptName.ToUpper() switch
                        {
                            "BASE" => Color.Success,
                            "PLACA" => Color.Info,
                            "IVA (25%)" => Color.Error,
                            "RETENCION IVA (75%)" => Color.Primary,
                            _ => Color.Error
                        };

                        <MudChip T="string" Variant="Variant.Text" Color="@color" Style="@style">
                            @(txt)
                        </MudChip>
                    }
                </CellTemplate>
            </TemplateColumn>

             @* 6. Emision: Izquierda *@
            <TemplateColumn Title="Emision" HeaderClass="dt-left" CellClass="dt-left">
                <CellTemplate>
                    <MudText Typo="Typo.caption">@(context.Item.DocumentDate.ToString("dd/MM/yyyy"))</MudText>
                </CellTemplate>
            </TemplateColumn>

            @* 7. Vencimiento: Izquierda *@
            <TemplateColumn Title="Vencimiento" HeaderClass="dt-left" CellClass="dt-left">
                <CellTemplate>
                    <MudText Typo="Typo.caption">@(context.Item.DocumentDueDate?.ToString("dd/MM/yyyy"))</MudText>
                </CellTemplate>
            </TemplateColumn>

            @* 8. Días Mora: Derecha para alinearse con números *@
            <TemplateColumn Title="Días Mora" HeaderClass="dt-right" CellClass="dt-right">
                <CellTemplate>
                    @if (context.Item.DocumentDueDate != null)
                    {
                        Color color = Color.Default;
                        Variant variant = Variant.Text;
                        string style = "font-size: 12px;";
                        TimeSpan diffDate = (TimeSpan)(DateTime.Now - context.Item.DocumentDueDate);
                        int daysDiff = diffDate.Days;

                        if (daysDiff >= 1 && daysDiff <= 5) color = Color.Warning;
                        else if (daysDiff > 5 && daysDiff <= 10) color = Color.Error;
                        else if (daysDiff > 10) color = Color.Secondary;

                        if (daysDiff > 0)
                        {
                            <MudChip T="string" Variant="@variant" Color="@color" Style="@style"
                                     Icon="@Icons.Material.Filled.TrendingUp" IconColor="@color">
                                @daysDiff
                            </MudChip>
                        }
                    }
                </CellTemplate>
            </TemplateColumn>

            @* 9. Monto $: Derecha *@
            <TemplateColumn Title="Monto $" HeaderClass="dt-right" CellClass="dt-right">
                <CellTemplate>
                    <MudText Typo="Typo.caption" Color="Color.Success">
                        @("$" + context.Item.Amount?.ToString("N2"))
                    </MudText>
                </CellTemplate>
            </TemplateColumn>

            @* 10. Saldo $: Derecha *@
            <TemplateColumn Title="Saldo $" HeaderClass="dt-right" CellClass="dt-right">
                <CellTemplate>
                    <div style="display: inline-flex; align-items: center; gap: 4px;">
                        <MudText Typo="Typo.caption" Color="Color.Success">
                            @("$" + context.Item.Balance?.ToString("N2"))
                        </MudText>
                        <MudIcon Icon="@Icons.Material.Filled.ArrowDownward" Color="Color.Success" Style="font-size: 1rem;" />
                    </div>
                </CellTemplate>
            </TemplateColumn>

            @* 11. Monto Bs: Derecha *@
            <TemplateColumn Title="Monto" HeaderClass="dt-right" CellClass="dt-right">
                <CellTemplate>
                    <MudText Typo="Typo.caption" Color="Color.Default">
                        @(context.Item.AmountBs?.ToString("N2"))
                    </MudText>
                </CellTemplate>
            </TemplateColumn>
            
            @* 12. Saldo Bs: Derecha *@
            <TemplateColumn Title="Saldo" HeaderClass="dt-right" CellClass="dt-right">
                <CellTemplate>
                    <div style="display: inline-flex; align-items: center; gap: 4px;">
                        <MudText Typo="Typo.caption" Color="Color.Error">
                            @(context.Item.BalanceBs?.ToString("N2"))
                        </MudText>
                        <MudIcon Icon="@Icons.Material.Filled.ArrowDownward" Color="Color.Error" Style="font-size: 1rem;" />
                    </div>
                </CellTemplate>
            </TemplateColumn>
             @* 13. Estado: Izquierda *@
                <TemplateColumn Title="Estado" HeaderClass="dt-left" CellClass="dt-left">
                      <CellTemplate>
                            <div class="d-flex justify-start">
                                @if (context.Item.StatusName != null)
                                {
                                    Color color = Color.Default;
                                    Variant variant = Variant.Text;
                                    string style = "";
                                    string txt = "";

                                    var pair = context.Item.StatusName.ToUpper() switch
                                    {
                                        "POR VENCER" => (txt: "Por Vencer", color: Color.Info, variant = Variant.Text),
                                        "PAGADO" => (txt: "Pagado", color: Color.Success, variant = Variant.Text),
                                        "VENCIDO" => (txt: "Vencido", color: Color.Secondary, variant = Variant.Filled),
                                        _ => (txt: "", color: Color.Error, variant = Variant.Filled)
                                    };
                                    txt = pair.txt;
                                    color = pair.color;
                                    variant = pair.Item3;
                                                                                                                                               
                                    style += "font-size: 12px;font-style:italic";
                                    

                                    <MudChip T="string" Variant="@variant" Color="@color" Style="@style">
                                        @(txt)
                                    </MudChip>
                                }
                   
                            </div>
                        </CellTemplate>
                </TemplateColumn>


                 <TemplateColumn Title="Estado Transaccion" HeaderClass="dt-left" CellClass="dt-left">
                      <CellTemplate>
                            <div class="d-flex justify-start">
                                @if (context.Item.TransactionStatusName != null)
                                {
                                    Color color = Color.Default;
                                    Variant variant = Variant.Text;
                                    string style = "";
                                    string txt = "";

                                    var pair = context.Item.TransactionStatusName.ToUpper() switch
                                    {
                                        "BORRADOR" => (txt: "Borrador", color: Color.Warning, variant = Variant.Text),
                                        "POR REVISION" => (txt: "Por Revision", color: Color.Primary, variant = Variant.Text),
                                        "DISPONIBLE" => (txt: "Disponible", color: Color.Info, variant = Variant.Text),
                                        "PAGADO" => (txt: "Pagado", color: Color.Success, variant = Variant.Text),
                                        _ => (txt: "", color: Color.Error, variant = Variant.Filled)
                                    };
                                    txt = pair.txt;
                                    color = pair.color;
                                    variant = pair.Item3;
                                                                                                                                               
                                    style += "font-size: 12px;font-style:italic";
                                    

                                    <MudChip T="string" Variant="@variant" Color="@color" Style="@style">
                                        @(txt)
                                    </MudChip>
                                }
                   
                            </div>
                        </CellTemplate>
                </TemplateColumn>

                 <PropertyColumn Title="Concesionario" Sortable="false" ShowFilterIcon="false" Property="x => x.DealerName"
                                HeaderClass="dt-left" CellClass="dt-left" CellStyle="white-space: nowrap; min-width: 200px;" />

           @* 14. Acciones fijas: Centrado o Derecha según gusto (se usó centrado) *@
                <TemplateColumn  HeaderClass="dt-left" CellClass="dt-left">
                    <CellTemplate>
                        <MudButtonGroup Size="@Size.Small" Variant="Variant.Text" Color="Color.Dark">
                            @if (context.Item.TransactionStatusName != null && context.Item.TransactionStatusName.ToUpper() == "BORRADOR")
                            {
                                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="() => ClickEditPayment(context.Item)" />
                            }
                        </MudButtonGroup>
                    </CellTemplate>
                </TemplateColumn>
            

        </Columns>
        <PagerContent>
            <MudDataGridPager T="Receivable" PageSizeOptions="new int[] { 100 }" InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Registros por Pagina" />
        </PagerContent>
    </MudDataGrid>
</MudCard>

</MudContainer>    
    
@if (DocumentSelecteds != null && DocumentSelecteds.Count > 0)
{
    @* **//Reportar Pago *@
    <MudDrawerContainer Class="mud-height-full">
        <MudDrawer @bind-Open="@_openDrawer" Width="950px" Anchor="Anchor.End" Elevation="1" Variant="@DrawerVariant.Temporary" OverlayAutoClose="false">
    
            <PaymentAccountDetail SelectedDocuments="@DocumentSelecteds" 
                SelectedPaymentId="@IdPaymentPreviewSelected" 
                OnClickCloseDetail="() => ClickClosedDrawer()">
            </PaymentAccountDetail>

        </MudDrawer>
    </MudDrawerContainer>
}


@if (IdPaymentPreviewSelected > 0)
{
    @* **//Reportar Pago *@
    <MudDrawerContainer Class="mud-height-full">
        <MudDrawer @bind-Open="@_openDrawer" Width="950px" Anchor="Anchor.End" Elevation="1" Variant="@DrawerVariant.Temporary" OverlayAutoClose="false">
    
            <PaymentAccountDetail SelectedDocuments="@DocumentSelecteds" 
                SelectedPaymentId="@IdPaymentPreviewSelected" 
                OnClickCloseDetail="() => ClickClosedDrawer()">
            </PaymentAccountDetail>
    
        </MudDrawer>
    </MudDrawerContainer>
}

<NestedDialogCustom IsVisible="@NestedVisible"
                    Icon="@Icons.Material.Filled.Payments"
                    Success="@Success"
                    onCloseNested="() => NestedVisible = false"
                    ErrorMessage="@NestedErrorMessage"
                    Title="@("Reporte de Pagos")" />



@code {
    [Inject] private UserSession Session { get; set; } = null!;
    [Inject] private AuthenticationProviderJWT AuthenticationStateProvider { get; set; } = null!;

    private List<BreadcrumbItem> ItemsNavigate =
               [
        new("Home", href: "", icon: Icons.Material.Filled.Home),
        new("Portal de Pagos",href: "", icon: Icons.Material.Filled.Payments),
        new("Documentos por Pagar",  href: "documentreport", disabled: false, icon: Icons.Material.Filled.Payment),
    ];

    private string ModuleName = "PAGOS-REPORTE";
    private string NestedErrorMessage = string.Empty;
    private bool NestedVisible;
    private bool Success = false;
    private bool Loading = false;
    private string SearchString = string.Empty;
    private bool _openDrawer = false;

    private bool IsAllCheckBoxSelected = false;
    int DocumentsCurrentPage = 0;

    private MudDataGrid<Receivable>? DocumentsDataGrid;
    private bool IsDocumentSelected = false;
    private bool _isRetencion = false;
    private List<AccountPreview> DocumentSelecteds { get; set; } = new List<AccountPreview>();
    private int IdPaymentPreviewSelected = 0;

    IMask maskDate = new DateMask("dd/MM/yyyy");
    private DateTime? _dateFrom { get; set; } = null;
    private DateTime? _dateTo { get; set; } = null;
    private DateTime? _datePay { get; set; } = null;
    private MudDatePicker _picker = new MudDatePicker();
    private MudDatePicker _pickerTo = new MudDatePicker();
    private MudDatePicker _pickerPay = new MudDatePicker();
    private List<SelectOption> StatusList = new List<SelectOption>();
    private List<SelectOption> DocumentList = new List<SelectOption>();
    private List<SelectOption> ConceptList = new List<SelectOption>();
    private SelectOption? SelectedStatus;
    private SelectOption? SelectedDocumentType;
    
    private IEnumerable<string> _selectedConcepts = new[] { "B" };
    private bool _IsExclusive = false;
    private bool _IsExclusiveBase = false;
    private bool _IsExclusiveRetencion = false;

    private List<string> _statusReportPay = new List<string>()
    {
        "DISPONIBLE"
    };

    private List<string> _statusNotReportPay = new List<string>()
    {
        "BORRADOR",
        "PAGADO",
        "POR REVISION"
    };

    protected override async Task OnInitializedAsync()
    {
        await AuthenticationStateProvider.RefreshStaticVariables();
        
        _selectedConcepts = new[] { "B" };
        _IsExclusiveBase = false;
        _IsExclusiveRetencion = true;
        _IsExclusive = true;
       
        hubEventsService.OnDealerChanged += ReloadPaymentReportGrid;
        hubEventsService.OnSupplierChanged += ReloadPaymentReportGrid;
        await Task.CompletedTask;
        StateHasChanged();


    }


    private async Task ReloadPaymentReportGrid()
    {
        if (DocumentsDataGrid != null )
        {
            await DocumentsDataGrid.ReloadServerData();
        }
    }

    Func<Receivable, object> GetSortKeySelector(string sortByPropertyName) => sortByPropertyName switch
    {
        nameof(Receivable.Id) => o => o.Id,
        nameof(Receivable.DocumentDate) => o => o.DocumentDate,
        //nameof(Receivable.DealerName) => o => o.DealerName ?? "",
        nameof(Receivable.ConceptName) => o => o.ConceptName ?? "",
        nameof(Receivable.TypeName) => o => o.TypeName ?? "",
        nameof(Receivable.StatusName) => o => o.StatusName ?? "",
        _ => null! //o => o.Id ?? 0 // Criterio de ordenación por defecto
    };

    private async Task<GridData<Receivable>> LoadGridData(GridState<Receivable> state)
    {
        await AuthenticationStateProvider.RefreshStaticVariables();
        Session.IsNewOrEdit = false;
        IsAllCheckBoxSelected = false;
        IsDocumentSelected = false;
        _isRetencion = false;
        Loading = true;
        var TotalItems = 0;
        var mOffset = state.Page * state.PageSize;

        IEnumerable<Receivable> Data;

        StatusList = await ModuleActionsService.GetDocumentStatusSelectOption();
        DocumentList = await ModuleActionsService.GetDocumentTypeSelectOption();
        ConceptList = await ModuleActionsService.GetDocumentConceptSelectOption();

        if (_selectedConcepts.ToList().Count() == 0 )
        {
            _selectedConcepts = new[] { "B" };
            _IsExclusiveBase = false;
            _IsExclusiveRetencion = true;
            _IsExclusive = true;
        }
        StateHasChanged();

        int? idRespaldado = SelectedStatus?.Value;
        if (idRespaldado.HasValue && StatusList != null) { SelectedStatus = StatusList.FirstOrDefault(x => x.Value == idRespaldado); }
        int? _estatusid = SelectedStatus?.Value;
        string _dateFromStr = string.IsNullOrEmpty(_dateFrom?.ToString()) ? string.Empty : _dateFrom.Value.ToString();
        string _dateToStr = string.IsNullOrEmpty(_dateTo?.ToString()) ? string.Empty : _dateTo.Value.ToString();
        string _datepayStr = string.IsNullOrEmpty(_datePay?.ToString()) ? string.Empty : _datePay.Value.ToString();

        string? _AuxdocumentTypeid = SelectedDocumentType?.ValueStr;
        if (!string.IsNullOrEmpty(_AuxdocumentTypeid) && DocumentList != null)
        {
            SelectedDocumentType = DocumentList.FirstOrDefault(x => x.ValueStr == _AuxdocumentTypeid);
        }
        else if (DocumentList != null)
        {
            SelectedDocumentType = DocumentList.FirstOrDefault();
        }
        string _documentTypeid = SelectedDocumentType?.ValueStr ?? "";

        string _conceptTypeId = string.Join("-", _selectedConcepts ?? Array.Empty<string>());

        var serviceResponse = await PaymentsRepository.GetAccountReceivables(Session.UserId, Session.SupplierId, Session.DealerId, _documentTypeid, _conceptTypeId, mOffset, SearchString, _dateFromStr, _dateToStr, _estatusid, _datepayStr);
        if (serviceResponse.Processed)
        {
            Data = serviceResponse.Data;
            TotalItems = serviceResponse.Total;

            if (state.SortDefinitions.FirstOrDefault() is SortDefinition<Receivable> sortDefinition)
            {
                Data = Data.OrderByDirection(sortDefinition.Descending ? SortDirection.Descending : SortDirection.Ascending, GetSortKeySelector(sortDefinition.SortBy));
            }
        }
        else
        {
            Data = new List<Receivable>();
            Success = false;
            NestedErrorMessage = serviceResponse.Message ?? MessageEnum.GetError.GetStringValue();

            // OpenNested();

        }

        Loading = false;
        StateHasChanged();

        return new GridData<Receivable> { TotalItems = TotalItems, Items = Data };
    }


    private async Task ExportItemsAsync()
    {
        int? idRespaldado = SelectedStatus?.Value;
        if (idRespaldado.HasValue && StatusList != null) { SelectedStatus = StatusList.FirstOrDefault(x => x.Value == idRespaldado); }
        int? _estatusid = SelectedStatus?.Value;
        string _dateFromStr = string.IsNullOrEmpty(_dateFrom?.ToString()) ? string.Empty : _dateFrom.Value.ToString();
        string _dateToStr = string.IsNullOrEmpty(_dateTo?.ToString()) ? string.Empty : _dateTo.Value.ToString();
        string _datepayStr = string.IsNullOrEmpty(_datePay?.ToString()) ? string.Empty : _datePay.Value.ToString();

        string? _AuxdocumentTypeid = SelectedDocumentType?.ValueStr;
        if (!string.IsNullOrEmpty(_AuxdocumentTypeid) && DocumentList != null)
        {
            SelectedDocumentType = DocumentList.FirstOrDefault(x => x.ValueStr == _AuxdocumentTypeid);
        }
        else if (DocumentList != null)
        {
            SelectedDocumentType = DocumentList.FirstOrDefault();
        }
        string _documentTypeid = SelectedDocumentType?.ValueStr ?? "";

        
        string _conceptTypeId = string.Join("-", _selectedConcepts ?? Array.Empty<string>());

        var serviceResponse = await PaymentsRepository.ExportAccountReceivable(Session.UserId, Session.SupplierId, 
                    Session.DealerId, _documentTypeid, _conceptTypeId, SearchString, _dateFromStr, _dateToStr, 
                    _estatusid, _datepayStr);
        if (serviceResponse.Processed)
        {
            Success = true;
            NestedErrorMessage = "";

            var base64File = Convert.ToBase64String(serviceResponse.Data.ToArray());
            var fileUrl = $"data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{base64File}";
            await JSRuntime.InvokeVoidAsync("downloadFile", fileUrl, "DocumentsReport.xlsx");

            DocumentsDataGrid?.FilteredItems.Where(s => s.IsSelected == true).ToList().ForEach(item => item.IsSelected = false);
            IsDocumentSelected = false;

            StateHasChanged();
        }
        else
        {
            Success = false;
            NestedErrorMessage = serviceResponse.Message ?? MessageEnum.ExportNotOK.GetStringValue();
            OpenNested();
        }
    }


    private void OpenNested()
    {
        NestedVisible = true;
        StateHasChanged();
    }



    private async Task HandleKeyDownSearch(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            if (SearchString.Length == 0 || SearchString.Length >= 3)
            {
                await DocumentsDataGrid!.ReloadServerData();
            }
        }
    }
    private async Task AfterAsyncAllCheck()
    {
        DocumentsDataGrid?.FilteredItems.Where(s => !_statusNotReportPay.Contains(s.TransactionStatusName.ToUpper())).ToList().ForEach(item => item.IsSelected = IsAllCheckBoxSelected);

        IsDocumentSelected = DocumentsDataGrid?.FilteredItems.Where(s => s.IsSelected == true).ToList().Count > 0 ? true : false;
        _isRetencion = DocumentsDataGrid?.FilteredItems.Where(s => s.IsSelected == true && s.ConceptName.ToUpper() == "RETENCION IVA (75%)").ToList().Count > 0 ? true : false;
        await Task.CompletedTask;
        StateHasChanged();
    }

    private async Task AfterAsyncCheck()
    {
        IsDocumentSelected = DocumentsDataGrid?.FilteredItems.Where(s => s.IsSelected == true ).ToList().Count > 0 ? true : false;
        _isRetencion = DocumentsDataGrid?.FilteredItems.Where(s => s.IsSelected == true && s.ConceptName.ToUpper() == "RETENCION IVA (75%)").ToList().Count > 0 ? true : false;
        StateHasChanged();
    }

    private void AfterAsyncExclusiveCheck()
    {
       
        _IsExclusive = false;
        _IsExclusiveBase = false;
        _IsExclusiveRetencion = false;

        if(_selectedConcepts.Contains("B"))
        {
            _selectedConcepts = _selectedConcepts.Where(s => s == "B").ToArray();
            _IsExclusiveRetencion = true;
            _IsExclusive = true;
        }
        if(_selectedConcepts.Contains("R"))
        {
            _selectedConcepts = _selectedConcepts.Where(s => s == "R").ToArray();
            _IsExclusiveBase = true;
            _IsExclusive = true;
        }

        StateHasChanged();
    }


      private async Task ClickRefreshDocuments(MouseEventArgs? args = null)
    {
        await DocumentsDataGrid!.ReloadServerData();

        IsDocumentSelected = DocumentsDataGrid?.FilteredItems.Where(s => s.IsSelected == true).ToList().Count > 0;
     
        StateHasChanged();
    }

    private async Task ClickAddPayment(MouseEventArgs args)
    {
        if (Session.DealerId != 0)
        {
            DocumentSelecteds = new List<AccountPreview>();
            IdPaymentPreviewSelected = 0;
            var _documentSelected = DocumentsDataGrid?.FilteredItems.Where(s => s.IsSelected == true).ToList();

            if (_documentSelected?.Count > 0)
            {
                _documentSelected.ForEach(item => DocumentSelecteds.Add(new AccountPreview()
                {
                    Id = item.Id,
                    Number = item.Number,
                    ConceptName = item.ConceptName,
                    TypeName = item.TypeName,
                    Amount = item.Amount,
                    AmountBs = item.AmountBs,
                    DocumentDate = item.DocumentDate,
                    DateRate = item.DateRate,
                    Rate = item.Rate
                }));
                _openDrawer = !_openDrawer;
            }
        
        }
        else
        {
            Success = false;
            NestedErrorMessage = "Seleccione un concesionario.";
            OpenNested();
        }
        
        StateHasChanged();

    }

