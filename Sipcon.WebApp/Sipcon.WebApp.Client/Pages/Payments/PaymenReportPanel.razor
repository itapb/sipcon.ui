@page "/paymentreport"

<CustomBreadcrumbs mItems="ItemsNavigate"></CustomBreadcrumbs>

<MudTabs Elevation="0"
         Rounded="false"
         Centered="false"
         PanelClass="pa-2 bg-white"
         SliderColor="Color.Dark"
         Style="background-color: #ffffff; border-bottom: 1px solid #e0e0e0;">

    <MudTabPanel>
        <TabContent>
            <MudText Typo="Typo.body1" Style="color: #000000; text-transform: none; font-weight: 500;">
                Pagos Realizados
            </MudText>
        </TabContent>
        <ChildContent>
            <PaymentReportList />
        </ChildContent>
    </MudTabPanel>

    <MudTabPanel>
        <TabContent>
            <MudText Typo="Typo.body1" Style="color: #000000; text-transform: none; font-weight: 500;">
                Extracto Bancarios
            </MudText>
        </TabContent>
        <ChildContent>
            <BankStatementList />
        </ChildContent>
    </MudTabPanel>
</MudTabs>

@code {
    [Inject] private UserSession Session { get; set; } = null!;
    List<BreadcrumbItem> ItemsNavigate = new();

    protected override void OnInitialized()
    {
        string hrefMovement = "paymentreport";
        $"Home,Portal de Pagos,Gestion de Pagos".Split(',').ToList().ForEach(s => ItemsNavigate.Add(new BreadcrumbItem(s, href: (s == "Home" ? "" : hrefMovement), icon: s.ToActionIcon())));
    }
}