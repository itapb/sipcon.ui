@page "/ratelist"

@using System.Text.Json
@using Sipcon.WebApp.Client.Components.Payments
@using Sipcon.WebApp.Client.Repository.Auth
@using MudBlazor

@inject IRateService RateService
@inject IDialogService DialogService
@inject UtilModuleActions ModuleActionsService
@inject IJSRuntime JSRuntime
@inject HubEventsService hubEventsService
@implements IDisposable

<PageTitle>Tasas</PageTitle>
<CustomBreadcrumbs mItems="_itemsNavigate"></CustomBreadcrumbs>

<MudDataGrid @ref="_mudDataGrid"
             T="Rate"
             SortMode="SortMode.Multiple"
             Filterable="false"
             FixedHeader Height="calc(92vh - 235px)"
             Hideable="true"
             Loading="_loading"
             Bordered="false"
             Dense="true"
             ServerData="LoadGridData">

    <ToolBarContent>
        <MudTextField @bind-Value="_searchString" Placeholder="Buscar" Adornment="Adornment.Start" Immediate="true"
                      Typo="Typo.caption"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      OnAdornmentClick="() => ClickSearch()"
                      IconSize="Size.Medium" Class="mt-0"
                      OnKeyDown="HandleKeyDownSearch"></MudTextField>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Info" OnClick="() => HandleOnClickRefresh()" />
        <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="Open user menu">
            @foreach (var module in _itemsModules)
            {
                <MudMenuItem Icon="@(module.Icon ?? "")" IconColor="@module.Color"
                             Label="@module.Text"
                             OnClick="() => HandleMenuClick(module)" />
            }
        </MudMenu>
    </ToolBarContent>

    <Columns>
        <PropertyColumn Property="x => x.Id" Title="ID" Sortable="false" />
        <TemplateColumn Title="FECHA">
            <CellTemplate>
                <MudText Typo="Typo.caption">@context.Item.DDate.ToString("dd/MM/yyyy")</MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="TASA">
            <CellTemplate>
                <MudText Typo="Typo.caption">@(context.Item.NRate?.ToString("N4") ?? "0.0000")</MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="TASA ALTERNATIVA">
            <CellTemplate>
                <MudText Typo="Typo.caption">@(context.Item.NAltRate?.ToString("N2") ?? "0.00")</MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Variant="Variant.Text"
                               Color="Color.Default"
                               Size="Size.Small"
                               Disabled="@(!IsToday(context.Item.DDate))"
                               OnClick="() => ClickEditRate(context.Item)" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>

    <PagerContent>
        <MudDataGridPager PageSizeOptions="new int[] { 100 }"
                          InfoFormat="{first_item}-{last_item} de {all_items}"
                          RowsPerPageString="Registros por Pagina" />
    </PagerContent>
</MudDataGrid>

@code {
    [Inject] private UserSession Session { get; set; } = null!;
    [Inject] private AuthenticationProviderJWT AuthenticationStateProvider { get; set; } = null!;

    private MudDataGrid<Rate>? _mudDataGrid;
    private IEnumerable<Rate> _rates = new List<Rate>();
    private string _nestedErrorMessage = string.Empty;
    private bool _nestedVisible;
    private bool _success = false;
    private int _rowsTotal = 0;
    private int _rowCount = 0;
    private string _searchString = string.Empty;
    private bool _loading = true;
    private string _moduleName = "TASAS";

    private List<ModuleAction> _itemsModules = new List<ModuleAction>([]);

    private List<BreadcrumbItem> _itemsNavigate =
    [
        new("Home", href: "", icon: Icons.Material.Filled.Home),
        new("Configuración", href: "", icon: Icons.Material.Filled.Settings),
        new("Tasas", href: "rates", disabled: false, icon: Icons.Material.Filled.AttachMoney)
    ];

    protected override async Task OnInitializedAsync()
    {
        await AuthenticationStateProvider.RefreshStaticVariables();
        hubEventsService.OnSupplierChanged += ReloadServerData;
        _itemsModules = await ModuleActionsService.GetModuleActions(Session.UserId, _moduleName);
    }

    private async Task ReloadServerData()
    {
        if (_mudDataGrid != null)
            await _mudDataGrid.ReloadServerData();
    }

    public void Dispose()
    {
        hubEventsService.OnSupplierChanged -= ReloadServerData;
    }

    private async Task<GridData<Rate>> LoadGridData(GridState<Rate> state)
    {
        _loading = true;
        StateHasChanged();

        _rowCount = state.Page * state.PageSize;
        var serviceResponse = await RateService.GetRates(_rowCount, _searchString);

        if (serviceResponse.Processed && serviceResponse.Data != null)
        {
            _rates = serviceResponse.Data;
            _rowsTotal = serviceResponse.Total;
        }

        _loading = false;
        StateHasChanged();

        return new GridData<Rate>
        {
            Items = _rates,
            TotalItems = _rowsTotal
        };
    }

    private async Task HandleKeyDownSearch(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            if (_searchString.Length >= 3 || string.IsNullOrEmpty(_searchString))
            {
                await _mudDataGrid!.ReloadServerData();
            }
        }
    }

    private async Task ClickSearch()
    {
        if (_searchString.Length >= 3 || string.IsNullOrEmpty(_searchString))
        {
            await _mudDataGrid!.ReloadServerData();
        }
    }

    private async Task HandleOnClickRefresh()
    {
        _searchString = string.Empty;
        await _mudDataGrid!.ReloadServerData();
    }

    private async Task ClickEditRate(Rate item)
    {
        DialogOptions options = new() { BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = false, NoHeader = true };

        var parameters = new DialogParameters
        {
            { "RateItem", item },
            { "ActionsModal", ActionsEnum.Edit }
        };

        var dialog = await DialogService.ShowAsync<RateEditDialog>("Editar Tasa", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled && _mudDataGrid != null)
            await _mudDataGrid.ReloadServerData();
    }

    private void OpenNested()
    {
        _nestedVisible = true;
        StateHasChanged();
    }

    private async Task HandleMenuClick(ModuleAction module)
    {
        switch (module.ActionName)
        {
            case "EXPORT":
                await ExportItemsAsync();
                break;
            default:
                Console.WriteLine($"{MessageEnum.ActionsError.GetStringValue()}: {module.ActionName}");
                break;
        }
    }

    private async Task ExportItemsAsync()
    {
        var serviceResponse = await RateService.ExportRates();
        if (serviceResponse.Processed)
        {
            _success = true;
            _nestedErrorMessage = "";
            var base64File = Convert.ToBase64String(serviceResponse.Data.ToArray());
            var fileUrl = $"data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{base64File}";
            await JSRuntime.InvokeVoidAsync("downloadFile", fileUrl, "Tasas.xlsx");
        }
        else
        {
            _success = false;
            _nestedErrorMessage = serviceResponse.Message ?? "Error al exportar";
            OpenNested();
        }
    }

    private bool IsToday(DateTime date)
    {
        return date.Date == DateTime.Today;
    }
}