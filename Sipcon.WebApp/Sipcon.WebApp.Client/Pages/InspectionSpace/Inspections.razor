@page "/inspections"

@using Sipcon.WebApp.Client.Components.Inspection
@using Sipcon.WebApp.Client.Repository.Auth
@using MudBlazor

@inject IInspectionService InspectionService
@inject IDialogService DialogService
@inject UtilModuleActions ModuleActionsService
@inject IJSRuntime JSRuntime
@inject HubEventsService hubEventsService
@implements IDisposable
@inject IJSRuntime JS

<PageTitle>Inspecciones</PageTitle>
<CustomBreadcrumbs mItems="_itemsNavigate" />

<MudDataGrid @ref="_mudDataGrid"
             T="Inspection"
             MultiSelection="true"
             SelectedItems="@_selectedItems"
             SortMode="SortMode.Multiple"
             Filterable="true"
             FixedHeader
             Height="calc(92vh - 235px)"
             Hideable="true"
             Loading="_loading"
             Bordered="false"
             Dense="true"
             ServerData="LoadGridData"
>
    <ToolBarContent>
        <MudTextField @bind-Value="_searchString"
                      Placeholder="Buscar"
                      Adornment="Adornment.Start"
                      Immediate="true"
                      Typo="Typo.caption"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      OnAdornmentClick="ClickSearch"
                      IconSize="Size.Medium"
                      Class="mt-0"
                      OnKeyDown="HandleKeyDownSearch" 
         />

        <MudSpacer />

        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                       Color="Color.Info"
                       OnClick="HandleOnClickRefresh" 
         />
    </ToolBarContent>

    <Columns>
        <TemplateColumn Title="CODIGO">
            <CellTemplate>
                <MudText Typo="Typo.caption" Inline="true" Color="Color.Primary" Style="font-weight:bold;">
                    @("#" + context.Item.InspectionId.ToString().PadLeft(10, '0'))
                </MudText>
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x => x.Area" Title="AREA" Sortable="false" Filterable="false" HeaderClass="mud-text-align-center" CellClass="mud-text-align-center" />

        <PropertyColumn Property="x => x.Model" Title="MODELO" Sortable="false" Filterable="false" HeaderClass="mud-text-align-center" CellClass="mud-text-align-center" />

        <PropertyColumn Property="x => x.Vin" Title="VIN" Sortable="false" Filterable="false" HeaderClass="mud-text-align-center" CellClass="mud-text-align-center" />

        <PropertyColumn Property="x => x.Plate" Title="PLACA" Sortable="false" Filterable="false" HeaderClass="mud-text-align-center" CellClass="mud-text-align-center" />

        <PropertyColumn Property="x => x.User" Title="USUARIO" Sortable="false" Filterable="false" HeaderClass="mud-text-align-center" CellClass="mud-text-align-center" />

        <TemplateColumn Title="ESTADO" Sortable="false" Filterable="false" HeaderClass="mud-text-align-center" CellClass="mud-text-align-center">
            <CellTemplate>
                @if (context.Item.Isclosed == 1)
                {
                    <MudChip T="string"
                             Variant="Variant.Filled"
                             Color="Color.Success"
                             Size="Size.Small"
                             Icon="@Icons.Material.Filled.CheckCircle"
                             Class="fw-bold">
                        CERRADA
                    </MudChip>
                }
                else
                {
                    <MudChip T="string"
                             Variant="Variant.Filled"
                             Color="Color.Warning"
                             Size="Size.Small"
                             Icon="@Icons.Material.Filled.Pending"
                             Class="fw-bold"
                    >
                        EN PROCESO
                    </MudChip>
                }
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn HeaderClass="mud-text-align-center" CellClass="mud-text-align-center">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Variant="Variant.Text"
                               Color="Color.Default"
                               Size="Size.Small"
                               OnClick="() => ClickEdit(context.Item)" 
                 />
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn HeaderClass="mud-text-align-center" CellClass="mud-text-align-center">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf"
                               Variant="Variant.Text"
                               Color="Color.Default"
                               Size="Size.Small"
                               OnClick="() => ClickFormat(context.Item)"            
                 />
            </CellTemplate>
        </TemplateColumn>
    </Columns>

    <PagerContent>
        <MudDataGridPager PageSizeOptions="new int[] { 100 }"
                          InfoFormat="{first_item}-{last_item} de {all_items}"
                          RowsPerPageString="Registros por Pagina" 
         />
    </PagerContent>
</MudDataGrid>

<NestedDialogCustom IsVisible="@_nestedVisible"
                    Success="@_success"
                    onCloseNested="() => _nestedVisible = false"
                    ErrorMessage="@_nestedErrorMessage"
                    Title="@("Inspecciones")" 
/>

@code {
    [Inject] private UserSession Session { get; set; } = null!;
    [Inject] private AuthenticationProviderJWT AuthenticationStateProvider { get; set; } = null!;

    private MudDataGrid<Inspection>? _mudDataGrid;
    private IEnumerable<Inspection> _items = new List<Inspection>();
    private HashSet<Inspection> _selectedItems = new([]);

    private string _nestedErrorMessage = string.Empty;
    private string _searchString = string.Empty;
    private bool _nestedVisible;
    private bool _success;
    private bool _loading = true;

    private int _rowCount;
    private int _rowsTotal;

    private List<BreadcrumbItem> _itemsNavigate = [
        new("Home", href: "", icon: Icons.Material.Filled.Home),
        new("Inspección", href: "", icon: Icons.Material.Filled.FactCheck),
        new("Inspecciones", href: "inspections", icon: Icons.Material.Filled.Category)
    ];

    protected override async Task OnInitializedAsync()
    {
        await AuthenticationStateProvider.RefreshStaticVariables();
        hubEventsService.OnSupplierChanged += ReloadServerData;
        hubEventsService.OnDealerChanged += ReloadServerData;
    }

    public void Dispose()
    {
        hubEventsService.OnSupplierChanged -= ReloadServerData;
        hubEventsService.OnDealerChanged -= ReloadServerData;
    }

    private async Task ReloadServerData()
    {
        if (_mudDataGrid != null) await _mudDataGrid.ReloadServerData();
    }

    private async Task<GridData<Inspection>> LoadGridData(GridState<Inspection> state)
    {
        _rowCount = state.Page * state.PageSize;
        await GetItems();
        return new GridData<Inspection> { TotalItems = _rowsTotal, Items = _items };
    }

    private async Task GetItems()
    {
        _loading = true;

        var res = await InspectionService.GetAllInspections(Session.SupplierId, _rowCount, _searchString);

        if (res.Processed)
        {
            _items = res.Data;
            _rowsTotal = res.Total;
        }
        else
        {
            _success = false;
            _nestedErrorMessage = res.Message ?? "Error al obtener datos";
            OpenNested();
        }

        _loading = false;
        StateHasChanged();
    }

    private async Task HandleKeyDownSearch(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && (_searchString.Length >= 3 || _searchString == string.Empty))
            await ReloadServerData();
    }

    private async Task ClickSearch()
    {
        if (_searchString.Length >= 3) await ReloadServerData();
    }

    private async Task HandleOnClickRefresh()
    {
        _searchString = string.Empty;
        await ReloadServerData();
    }

    private async Task ClickEdit(Inspection item)
    {
        var parameters = new DialogParameters<InspectionDetails> { { x => x.Id, item.InspectionId } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };

        var dialog = await DialogService.ShowAsync<InspectionDetails>("Detalle de Inspección", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await ReloadServerData();
        }
    }
    
    private async Task ClickFormat(Inspection item)
    {
        try
        {
            var serviceResponse = await InspectionService.GeneratePDF(item.InspectionId);

            if (serviceResponse.Processed && serviceResponse.Data != null)
            {
                var applicationName = string.Empty;

                var base64File = Convert.ToBase64String(serviceResponse.Data.ToArray());
                var fileUrl = $"data:{applicationName};base64,{base64File}";

                await JS.InvokeVoidAsync("downloadFile", fileUrl, $"Inspeccion_{item.Area}_{item.InspectionId}.pdf");
            }
            else
            {
                var errorMessage = serviceResponse.Message ?? "No se pudo exportar el archivo.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error en la descarga: {ex.Message}");
        }
    }

    private void OpenNested()
    {
        _nestedVisible = true;
        StateHasChanged();
    }
}