    private int _rowCount = 0;
    private int _rowsTotal = 0; 

    private string _searchString = string.Empty;
    private bool _loading = true;
    private string _moduleName = "INVENTARIO-DETALLES-CONTEO";
    //Fechas y filtrados po estatus 
    bool _open;
    IMask maskDate = new DateMask("dd/MM/yyyy");
    private DateTime? _dateFrom { get; set; } = null;
    private DateTime? _dateTo { get; set; } = null;
    private MudDatePicker _picker = new MudDatePicker();
    private MudDatePicker _pickerTo = new MudDatePicker();
    private List<SelectOption> _actions = new List<SelectOption>();
    private SelectOption? _selectedAction;

    private bool _isAllParentsSelected = false;
    private MudDataGrid<GetCountFull>? _mudDataGrid;
    private List<ModuleAction> _itemsModules = new List<ModuleAction>([]);
    private bool _hasActiveFilters => _dateFrom.HasValue || _dateTo.HasValue || _selectedAction != null;

    private List<BreadcrumbItem> _itemsNavigate =
                [
        new("Home", href: "", icon: Icons.Material.Filled.Home),
        new("Inventario",href: "", icon: Icons.Material.Filled.Inventory),
        new("Conteo de Inventario",  href: "inventorycount", disabled: false, icon: Icons.Material.Filled.Assessment),
    ];


    private void ClearFilters()
    {
        _dateFrom = null;
        _dateTo = null;
        _selectedAction = null;
        ClickSearch(); // O recargar el grid
    }

    protected override async Task OnInitializedAsync()
    {
        await AuthenticationStateProvider.RefreshStaticVariables();

        hubEventsService.OnSupplierChanged += ReloadServerData;
        hubEventsService.OnDealerChanged += ReloadServerData;
        await Task.CompletedTask;
    }

    private async Task ReloadServerData()
    {
        if (_mudDataGrid != null)
        {
            await _mudDataGrid!.ReloadServerData();
        }
    }

    public void Dispose()
    {
        hubEventsService.OnDealerChanged -= ReloadServerData;
        hubEventsService.OnSupplierChanged -= ReloadServerData;
    }


    private async Task<GridData<GetCountFull>> LoadGridData(GridState<GetCountFull> state)
    {
        await AuthenticationStateProvider.RefreshStaticVariables();
        _rowCount = state.Page * state.PageSize;

        await GetInventoryCountDetails();

        return new GridData<GetCountFull> { TotalItems = _rowsTotal, Items = _GetInventoryCountDetails };
    }

    private Color GetStatusColor(string statusName)
    {
        return statusName?.ToUpper() switch
        {
            "POR ASIGNAR" => Color.Info,
            "ASIGNADO" => Color.Info,
            "CONTADO" => Color.Dark,
            "POR CONTAR" => Color.Default,
            _ => Color.Warning // Para cualquier otro estatus
        };
    }

    private void ToggleAllParents(bool value)
    {
        _isAllParentsSelected = value;
        if (_mudDataGrid?.Items == null) return;

        foreach (var parent in _mudDataGrid.Items)
        {
            parent.IsSelected = value;
            if (parent.InventoryCountDetail != null)
            {
                foreach (var child in parent.InventoryCountDetail)
                {
                    child.IsSelected = value;
                }
            }
        }
    }

    // 2. Al cambiar el Checkbox de un Padre individual
    private void OnParentCheckChanged(GetCountFull parent)
    {
        // Sincroniza automáticamente a los hijos con el nuevo valor del padre
        if (parent.InventoryCountDetail != null)
        {
            foreach (var child in parent.InventoryCountDetail)
            {
                child.IsSelected = parent.IsSelected;
            }
        }
    }

    // 3. Evalúa si todos los Hijos de una Zona están marcados
    private bool IsAllChildrenSelected(GetCountFull parent)
    {
        if (parent.InventoryCountDetail == null || !parent.InventoryCountDetail.Any())
            return false;

        return parent.InventoryCountDetail.All(c => c.IsSelected);
    }

    // 4. Marcar / Desmarcar todos los Hijos de un Padre específico
    private void ToggleAllChildren(GetCountFull parent, bool value)
    {
        if (parent.InventoryCountDetail == null) return;

        foreach (var child in parent.InventoryCountDetail)
        {
            child.IsSelected = value;
        }
    }

    // 5. MÉTODOS OBTENEDORES DE SELECCIONADOS (Para cuando envíes datos al Server o Botones de Acción)
    private List<GetCountFull> GetSelectedParents()
    {
        return _mudDataGrid?.Items?.Where(x => x.IsSelected).ToList() ?? new List<GetCountFull>();
    }

    private List<GetInventoryCountDetail> GetSelectedChildren()
    {
        return _mudDataGrid?.Items?
            .Where(x => x.InventoryCountDetail != null)
            .SelectMany(x => x.InventoryCountDetail)
            .Where(c => c.IsSelected)
            .ToList() ?? new List<GetInventoryCountDetail>();
    }

    private async Task GetInventoryCountDetails()
    {
        _loading = true;
        _GetInventoryCountDetails = new List<GetCountFull>();
        _rowsTotal = 0;

        _itemsModules = await ModuleActionsService.GetModuleActions(Session.UserId, _moduleName);

        //fechas y filtros
        _actions = await ModuleActionsService.GetStatusByModule(Session.UserId, _moduleName);  
        int? idRespaldado = _selectedAction?.Value;
         if (idRespaldado.HasValue && _actions != null)   {  _selectedAction = _actions.FirstOrDefault(x => x.Value == idRespaldado); }
         int? _estatusid = _selectedAction?.Value;
         string _dateFromStr = string.IsNullOrEmpty(_dateFrom?.ToString()) ? string.Empty : _dateFrom.Value.ToString();
        string _dateToStr = string.IsNullOrEmpty(_dateTo?.ToString()) ? string.Empty : _dateTo.Value.ToString();

        var serviceResponse = await InventoryCountService.GetInventoryCountDetailByZone(Session.SupplierId, Session.UserId, InventoryCountId, _rowCount, _searchString, _dateFromStr, _dateToStr, _estatusid);
        if (serviceResponse.Processed)
        {
            _GetInventoryCountDetails = serviceResponse.Data;
            _rowsTotal = serviceResponse.Total;
        }
        else
        {
            // Console.WriteLine($"Error: {serviceResponse.Message}");
            _success = false;
            _nestedErrorMessage = serviceResponse.Message ?? MessageEnum.GetError.GetStringValue();

            OpenNested();

        }
       
        _loading = false;
        StateHasChanged();
    }


