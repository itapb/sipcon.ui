
@using System.Text.Json
@using Sipcon.WebApp.Client.Repository.Auth


@inject IInventoryCountService InventoryCountService
@inject IDialogService DialogService
@inject UtilModuleActions ModuleActionsService
@inject IJSRuntime JSRuntime
@inject NavigationManager UriHelper
@inject HubEventsService hubEventsService
@implements IDisposable



<MudDataGrid @ref="_mudDataGrid"
             T="GetInventoryCountDetail"
             MultiSelection="true" 
             SelectedItems="@selectedGetInventoryCountDetails"
             SortMode="SortMode.Multiple"
             Filterable="true"
             FixedHeader Height="calc(92vh - 235px)"
             Hideable="true"
             Loading="_loading"
             Bordered="false"
             Dense="true"
             ServerData="LoadGridData">

    <ToolBarContent>
        <MudIconButton Icon="@Icons.Material.Filled.AddCard" Color="Color.Info" OnClick="ClickAddFailReport"></MudIconButton>
       <MudTextField @bind-Value="_searchString" 
                      Style="font-size: 14px;line-height: 0.8rem;"
                    Placeholder="buscar" 
                    Adornment="Adornment.Start" 
                    Immediate="true"
                    Typo="Typo.caption"
                    IconSize="Size.Medium" Class="mt-0" 
                    OnKeyUp="HandleKeyDownSearch">
        </MudTextField>
        <MudSpacer />
        <!-- Botón de Filtros con Popover Flotante -->
        <MudMenu Icon="@(_hasActiveFilters ? Icons.Material.Filled.FilterAlt : Icons.Material.Filled.FilterAltOff)"
                 Color="@(_hasActiveFilters ? Color.Warning : Color.Info)"
                 AriaLabel="Filtros avanzados"
                 AnchorOrigin="Origin.BottomRight"
                 TransformOrigin="Origin.TopRight"
                 PopoverClass="pa-4 rounded-lg mud-elevation-4"
                 Dense="true">

            <MudText Typo="Typo.subtitle2" Class="mb-3 text-secondary"><b>FILTRAR BÚSQUEDA</b></MudText>

            <MudStack Spacing="3" Style="width: 280px;">
                <!-- Fecha Desde -->
                <MudDatePicker @ref="_picker"
                               @bind-Date="_dateFrom"
                               Label="Fecha Desde"
                               Adornment="Adornment.Start"
                               AdornmentColor="Color.Info"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               DateFormat="dd/MM/yyyy"
                               AutoClose="true"
                               Clearable="true" />

                <!-- Fecha Hasta -->
                <MudDatePicker @ref="_pickerTo"
                               @bind-Date="_dateTo"
                               Label="Fecha Hasta"
                               Adornment="Adornment.Start"
                               AdornmentColor="Color.Info"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               DateFormat="dd/MM/yyyy"
                               AutoClose="true"
                               Clearable="true" />

                <!-- Estatus -->
                <MudSelect T="SelectOption"
                           @bind-Value="_selectedAction"
                           ToStringFunc="@(e => e?.Text)"
                           Label="Estatus"
                           AdornmentIcon="@Icons.Material.Filled.FilterList"
                           AdornmentColor="Color.Info"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true"
                           Dense="true">
                    @if (_actions != null)
                    {
                        @foreach (var action in _actions)
                        {
                            <MudSelectItem T="SelectOption" Value="@action">@action.Text</MudSelectItem>
                        }
                    }
                </MudSelect>

                <!-- Botones de Acción -->
                <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-2">
                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="ClearFilters">
                        Limpiar
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small" OnClick="ClickSearch">
                        Aplicar
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudMenu>
        <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Info" OnClick="() => ClickSearch()"></MudIconButton>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Info" OnClick="() => HandleOnClickRefresh()" />
         @* <MudIconButton Icon="@Icons.Material.Filled.DocumentScanner" Color="Color.Info" OnClick="() => ClickExportReportSRG()" /> *@
        <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="Open user menu">
            @foreach (var module in _itemsModules)
            {
                <MudMenuItem Icon="@(module.Icon ?? "")" IconColor="@module.Color"
                Label="@module.Text"
                OnClick="() => HandleMenuClick(module)" />
            }
        </MudMenu>
    </ToolBarContent>
    <Columns>
        <SelectColumn  />

         <TemplateColumn Title="ZONA">
            <CellTemplate>
                <MudText Typo="Typo.caption" Align="Align.Left">@(context.Item.Zone.ToUpper())</MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn  Title="UBICACION">
            <CellTemplate>
                <MudText Typo="Typo.caption" Align="Align.Left" Inline="true" Color="Color.Primary" Style="font-weight:bold;">@context.Item.Location.ToUpper()</MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn  Title="CODIGO PARTE">
            <CellTemplate>
                <MudText Typo="Typo.caption" Align="Align.Left">@(context.Item.InnerCode.ToUpper()) </MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn  Title="PARTE">
            <CellTemplate>
                <MudText Typo="Typo.caption" Align="Align.Left">@(context.Item.PartName.ToUpper()) </MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn  Title="FECHA REGISTRO">
            <CellTemplate>
                <MudText Typo="Typo.caption" Align="Align.Left">@(context.Item.Created?.ToString("dd MMM yyyy"))</MudText>
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn  Title="FECHA DE CONTEO">
            <CellTemplate>
                <MudText Typo="Typo.caption" Align="Align.Left">@(context.Item.CountDate?.ToString("dd MMM yyyy"))</MudText>
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="CONTADO POR">
            <CellTemplate>
                <MudText Typo="Typo.caption" Align="Align.Left">@(context.Item.UserName)</MudText>
            </CellTemplate>
        </TemplateColumn>
        
        <TemplateColumn  Title="ESTATUS">
            <CellTemplate>
                <div class="d-flex justify-start">
                    @if (context.Item.StatusName != null)
                    {
                        string style = "";
                        if (context.Item.StatusName.ToUpper() == "BORRADOR")
                            style += "";
                        else if (context.Item.StatusName.ToUpper() == "VALIDADO")
                        {
                            style += "color:#fff";
                            style += ";background-color:#0099F3";
                        }
                        else if (context.Item.StatusName.ToUpper() == "PROCESADO")
                        {
                            style += "color:#fff";
                            style += ";background-color:#757575";
                        }
                        else
                        {
                            style += "color:#fff";
                            style += ";background-color:#FF7043";
                        }
                        style += ";font-size: 11px";
                        style += ";font-style:italic";

                        <MudChip T="string" Style="@style" Label="true" Disabled="true">
                            @(context.Item.StatusName.ToUpper())
                        </MudChip>
                    }
                   
                </div>
            </CellTemplate>
        </TemplateColumn>
    </Columns>

    <PagerContent>
        <MudDataGridPager  PageSizeOptions="new int[] {100}" InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Registros por Pagina" />
    </PagerContent>
</MudDataGrid>

<NestedDialogCustom IsVisible="@_nestedVisible" Success="@_success" 
                    onCloseNested="() => _nestedVisible = false"
                    ErrorMessage="@_nestedErrorMessage" 
                    Title="@("Detalle Conteo")"/>



