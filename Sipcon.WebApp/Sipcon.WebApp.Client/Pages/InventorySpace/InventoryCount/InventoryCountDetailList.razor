
@using System.Text.Json
@using Sipcon.WebApp.Client.Repository.Auth


@inject IInventoryCountService InventoryCountService
@inject IDialogService DialogService
@inject UtilModuleActions ModuleActionsService
@inject IJSRuntime JSRuntime
@inject NavigationManager UriHelper
@inject HubEventsService hubEventsService
@implements IDisposable



<MudDataGrid @ref="_mudDataGrid"
             T="GetCountFull"
             SortMode="SortMode.Multiple"
             Filterable="true"
             FixedHeader Height="calc(92vh - 235px)"
             Hideable="true"
             Loading="_loading"
             Bordered="false"
             Dense="true"
             ServerData="LoadGridData">

    <ToolBarContent>
        <MudIconButton Icon="@Icons.Material.Filled.AddCard" Color="Color.Info" OnClick="ClickAddFailReport" />
        <MudTextField @bind-Value="_searchString"
                      Style="font-size: 14px;line-height: 0.8rem;"
                      Placeholder="Buscar..."
                      Adornment="Adornment.Start"
                      Immediate="true"
                      Typo="Typo.caption"
                      IconSize="Size.Medium" Class="mt-0"
                      OnKeyUp="HandleKeyDownSearch" />
        <MudSpacer />

        <!-- Botón de Filtros con Popover Flotante -->
        <MudMenu Icon="@(_hasActiveFilters ? Icons.Material.Filled.FilterAlt : Icons.Material.Filled.FilterAltOff)"
                 Color="@(_hasActiveFilters ? Color.Warning : Color.Info)"
                 AriaLabel="Filtros avanzados"
                 AnchorOrigin="Origin.BottomRight"
                 TransformOrigin="Origin.TopRight"
                 PopoverClass="pa-4 rounded-lg mud-elevation-4"
                 Dense="true">

            <MudText Typo="Typo.subtitle2" Class="mb-3 text-secondary"><b>FILTRAR BÚSQUEDA</b></MudText>

            <MudStack Spacing="3" Style="width: 280px;">
                <MudDatePicker @ref="_picker"
                               @bind-Date="_dateFrom"
                               Label="Fecha Desde"
                               Adornment="Adornment.Start"
                               AdornmentColor="Color.Info"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               DateFormat="dd/MM/yyyy"
                               AutoClose="true"
                               Clearable="true" />

                <MudDatePicker @ref="_pickerTo"
                               @bind-Date="_dateTo"
                               Label="Fecha Hasta"
                               Adornment="Adornment.Start"
                               AdornmentColor="Color.Info"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               DateFormat="dd/MM/yyyy"
                               AutoClose="true"
                               Clearable="true" />

                <MudSelect T="SelectOption"
                           @bind-Value="_selectedAction"
                           ToStringFunc="@(e => e?.Text)"
                           Label="Estatus"
                           AdornmentIcon="@Icons.Material.Filled.FilterList"
                           AdornmentColor="Color.Info"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true"
                           Dense="true">
                    @if (_actions != null)
                    {
                        @foreach (var action in _actions)
                        {
                            <MudSelectItem T="SelectOption" Value="@action">@action.Text</MudSelectItem>
                        }
                    }
                </MudSelect>

                <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-2">
                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="ClearFilters">
                        Limpiar
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small" OnClick="ClickSearch">
                        Aplicar
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudMenu>

        <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Info" OnClick="() => ClickSearch()" />
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Info" OnClick="() => HandleOnClickRefresh()" />

        <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="Open user menu">
            @foreach (var module in _itemsModules)
            {
                <MudMenuItem Icon="@(module.Icon ?? "")"
                             IconColor="@module.Color"
                             Label="@module.Text"
                             OnClick="() => HandleMenuClick(module)" />
            }
        </MudMenu>
    </ToolBarContent>

    <Columns>
        <!-- Columna de Selección Padre Manual (Header Seleccionar Todo) -->
        <TemplateColumn Style="width: 50px;" HeaderClass="dt-center" CellClass="dt-center">
            <HeaderTemplate>
                <MudCheckBox T="bool"
                             Value="_isAllParentsSelected"
                             ValueChanged="ToggleAllParents"
                             Dense="true"
                             Color="Color.Primary" />
            </HeaderTemplate>
            <CellTemplate>
                <MudCheckBox @bind-Value="context.Item.IsSelected"
                             @bind-Value:after="() => OnParentCheckChanged(context.Item)"
                             Dense="true"
                             Color="Color.Primary" />
            </CellTemplate>
        </TemplateColumn>

        <!-- Columna para expandir/colapsar -->
        <HierarchyColumn T="GetCountFull" />

        <TemplateColumn Title="ZONA" Sortable="true" >
            <CellTemplate>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Place" Color="Color.Primary" Size="Size.Small" />
                    <MudText Typo="Typo.body2" Class="fw-bold text-primary">
                        @(context.Item.Zone?.ToUpper())
                    </MudText>
                </MudStack>
            </CellTemplate>
        </TemplateColumn>

        <!-- TOTAL UBICACIONES: Badge Neutral -->
        <TemplateColumn Title="TOTAL UBICACIONES" Sortable="true" HeaderClass="dt-center" CellClass="dt-center">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                    <b>@context.Item.LocationTotal</b>
                </MudChip>
            </CellTemplate>
        </TemplateColumn>

        <!-- UBICACIONES CONTADAS: Badge Info -->
        <TemplateColumn Title="CONTADAS" Sortable="true" HeaderClass="dt-center" CellClass="dt-center">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Info" Style="font-weight: 600;">
                    @context.Item.LocationCounted
                </MudChip>
            </CellTemplate>
        </TemplateColumn>

        <!-- PORCENTAJE AVANCE: Con indicador de color y progreso -->
        <TemplateColumn Title="AVANCE" Sortable="true" HeaderClass="dt-center" CellClass="dt-center">
            <CellTemplate>
                @{
                    var percentage = context.Item.Porcentage;
                    var color = percentage >= 100 ? Color.Success : (percentage > 50 ? Color.Info : Color.Warning);
                }
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="1">
                    <MudProgressCircular Color="@color" Value="@((int)percentage)" Size="Size.Small" Style="width: 22px; height: 22px;" />
                    <MudText Typo="Typo.caption" Color="@color" Class="fw-bold ml-1">
                        @percentage.ToString("N2") %
                    </MudText>
                </MudStack>
            </CellTemplate>
        </TemplateColumn>

        <!-- USUARIOS ASIGNADOS: Chip de usuario o Guion -->
        <TemplateColumn Title="USUARIOS ASIGNADOS">
            <CellTemplate>
                @if (!string.IsNullOrWhiteSpace(context.Item.UsersAssigned))
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Color="Color.Secondary" />
                        <MudText Typo="Typo.caption" Class="text-secondary">
                            @context.Item.UsersAssigned
                        </MudText>
                    </MudStack>
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="text-muted" Align="Align.Center">-</MudText>
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>

    <ChildRowContent Context="parentContext">
        <MudTd colspan="7" Class="pa-2 bg-grey-lighten-4">
       
            @if (parentContext.Item.InventoryCountDetail != null && parentContext.Item.InventoryCountDetail.Any())
            {
                <MudTable Items="@parentContext.Item.InventoryCountDetail"
                          T="GetInventoryCountDetail"
                          Dense="true"
                          Hover="true"
                          Bordered="true"
                          Elevation="0"
                          Class="mb-2">
                    <HeaderContent>
                        <!-- Checkbox Select All para los Hijos -->
                        <MudTh Style="width: 40px;" Class="dt-center">
                            <MudCheckBox T="bool"
                                         Value="@IsAllChildrenSelected(parentContext.Item)"
                                         ValueChanged="@(val => ToggleAllChildren(parentContext.Item, val))"
                                         Dense="true"
                                         Color="Color.Primary" />
                        </MudTh>
                        <MudTh><MudText Typo="Typo.caption"><b>UBICACIÓN</b></MudText></MudTh>
                        <MudTh><MudText Typo="Typo.caption"><b>CÓDIGO PARTE</b></MudText></MudTh>
                        <MudTh><MudText Typo="Typo.caption"><b>PARTE</b></MudText></MudTh>
                        <MudTh><MudText Typo="Typo.caption"><b>NUM CONTEO</b></MudText></MudTh>
                        <MudTh><MudText Typo="Typo.caption"><b>CANT. TEORICA</b></MudText></MudTh>
                        <MudTh><MudText Typo="Typo.caption"><b>CANT. CONTADA</b></MudText></MudTh>
                        <MudTh><MudText Typo="Typo.caption"><b>DIFERENCIA</b></MudText></MudTh>
                        <MudTh><MudText Typo="Typo.caption"><b>F. REGISTRO</b></MudText></MudTh>
                        <MudTh><MudText Typo="Typo.caption"><b>F. CONTEO</b></MudText></MudTh>
                        <MudTh><MudText Typo="Typo.caption"><b>CONTADO POR</b></MudText></MudTh>
                        <MudTh><MudText Typo="Typo.caption"><b>ESTATUS</b></MudText></MudTh>
                    </HeaderContent>
                    <RowTemplate Context="detail">
                        <!-- Checkbox Fila Hija -->
                        <MudTd Style="width: 40px;" Class="dt-center">
                            <MudCheckBox @bind-Value="detail.IsSelected"
                                         Dense="true"
                                         Color="Color.Primary" />
                        </MudTd>
                        <MudTd><MudText Typo="Typo.caption" Color="Color.Primary" Style="font-weight:bold;">@detail.Location?.ToUpper()</MudText></MudTd>
                        <MudTd><MudText Typo="Typo.caption">@detail.InnerCode?.ToUpper()</MudText></MudTd>
                        <MudTd><MudText Typo="Typo.caption">@detail.PartName?.ToUpper()</MudText></MudTd>
                        <MudTd><MudText Typo="Typo.caption">@detail.CountId</MudText></MudTd>
                        <MudTd><MudText Typo="Typo.caption">@detail.QuantityOld</MudText></MudTd>
                        <MudTd><MudText Typo="Typo.caption">@detail.QuantityNew</MudText></MudTd>
                        <MudTd><MudText Typo="Typo.caption">@detail.Diference</MudText></MudTd>
                        <MudTd><MudText Typo="Typo.caption">@detail.Created?.ToString("dd MMM yyyy")</MudText></MudTd>
                        <MudTd><MudText Typo="Typo.caption">@detail.CountDate?.ToString("dd MMM yyyy")</MudText></MudTd>
                        <MudTd><MudText Typo="Typo.caption">@detail.UserName</MudText></MudTd>
                        <MudTd>
                            @if (!string.IsNullOrEmpty(detail.StatusName))
                            {
                                <MudChip T="string"
                                         Color="@GetStatusColor(detail.StatusName)"
                                         Variant="Variant.Filled"
                                         Size="Size.Small"
                                         Style="font-size: 10px; font-style: italic;">
                                    @(detail.StatusName.ToUpper())
                                </MudChip>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else
            {
                <MudText Typo="Typo.caption" Class="ml-4 mb-2 text-italic" Color="Color.Default">
                    No hay detalles registrados para esta zona.
                </MudText>
            }
        </MudTd>
    </ChildRowContent>

    <PagerContent>
        <MudDataGridPager PageSizeOptions="new int[] { 500 }" InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Registros por página" />
    </PagerContent>
</MudDataGrid>

<NestedDialogCustom IsVisible="_nestedVisible"
                    Success="_success"
                    onCloseNested="() => _nestedVisible = false"
                    ErrorMessage="_nestedErrorMessage"
                    Title="Detalle Conteo" />

@code { 
    [Parameter] public int InventoryCountId { get; set; }
    [Inject] private UserSession Session { get; set; } = null!;
