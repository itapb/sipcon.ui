@page "/kardex"


@using Sipcon.WebApp.Client.Repository.Auth
@using System.Text.Json
@using System.Globalization;


@inject IKardexService KardexService
@inject IDialogService DialogService
@inject UtilModuleActions ModuleActionsService
@inject IJSRuntime JSRuntime
@inject HubEventsService hubEventsService
@implements IDisposable




<PageTitle>Kardex</PageTitle>
<CustomBreadcrumbs mItems="_itemsNavigate"></CustomBreadcrumbs>

<MudDataGrid @ref="_mudDataGrid"
             T="Kardex"
             MultiSelection="true" 
             SelectedItems="@selectedKardex"
             SortMode="SortMode.Multiple"
             Filterable="true"
             FixedHeader Height="calc(92vh - 235px)"
             Hideable="true"
             Loading="_loading"
             ShowColumnOptions="false"
             Bordered="false"
             Dense="true"
             Culture="@_esCulture"
             ServerData="LoadGridData">

    <ToolBarContent>
       <MudTextField @bind-Value="_searchString" 
                      Style="font-size: 14px;line-height: 0.8rem;"
                    Placeholder="buscar" 
                    Adornment="Adornment.Start" 
                    Immediate="true"
                    Typo="Typo.caption"
                    IconSize="Size.Medium" Class="mt-0" 
                    OnKeyUp="HandleKeyDownSearch">
        </MudTextField>
        <MudSpacer />
        @* BOTÓN DE AGRUPACIÓN MANUAL *@
        <MudTooltip Text="Agrupar por Código">
            <MudToggleIconButton Toggled="@_isGrouped"
                                 ToggledChanged="OnToggledChanged"
                                 Icon="@Icons.Material.Filled.ViewList" 
                                 Color="@Color.Default"
                                 ToggledIcon="@Icons.Material.Filled.TableRows" 
                                 ToggledColor="@Color.Info" />
        </MudTooltip>

        <div id="scroll_section" class="mx-auto" style="max-width: 650px">
            <MudExpansionPanels Outlined="false" Elevation="0">
                <MudExpansionPanel @bind-Expanded="@_open" HideIcon="true">
                    <TitleContent>
                        <div class="d-flex">
                            <MudIcon Icon="@(_open? Icons.Material.Filled.FilterAltOff  : Icons.Material.Filled.FilterAlt)" Color="Color.Info"></MudIcon>
                        </div>
                    </TitleContent>
                    <ChildContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
                            <MudDatePicker @ref="_picker"
                                           @bind-Date="_dateFrom"
                                           Style="font-size: 14px;line-height: 0.8rem;min-width: 120px;"
                                           Adornment="Adornment.Start"
                                           AdornmentColor="Color.Info"
                                           Class="align-right"
                                           Placeholder="Fecha Desde"
                                           Variant="Variant.Text"
                                           PickerVariant="PickerVariant.Inline"
                                           Margin="Margin.None"
                                           DateFormat="dd/MM/yyyy"
                                           AutoClose="true">
                                <PickerActions>
                                    <MudButton Class="mr-auto align-self-start" OnClick="@(() => _picker.ClearAsync())">Borrar</MudButton>
                                    <MudButton OnClick="@(() => _picker.CloseAsync(false))">Cancelar</MudButton>
                                </PickerActions>
                            </MudDatePicker>

                            <MudDatePicker @ref="_pickerTo"
                                           @bind-Date="_dateTo"
                                           Style="font-size: 14px;line-height: 0.8rem;min-width: 120px;"
                                           Adornment="Adornment.Start"
                                           AdornmentColor="Color.Info"
                                           Class="align-right"
                                           Placeholder="Fecha Hasta"
                                           Variant="Variant.Text"
                                           PickerVariant="PickerVariant.Inline"
                                           Margin="Margin.None"
                                           DateFormat="dd/MM/yyyy"
                                           AutoClose="true">
                                <PickerActions>
                                    <MudButton Class="mr-auto align-self-start" OnClick="@(() => _pickerTo.ClearAsync())">Borrar</MudButton>
                                    <MudButton OnClick="@(() => _pickerTo.CloseAsync(false))">Cancelar</MudButton>
                                </PickerActions>
                            </MudDatePicker>
                        </MudStack>
                </ChildContent>
                </MudExpansionPanel>
            </MudExpansionPanels>

        </div>
        <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Info" OnClick="() => ClickSearch()"></MudIconButton>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Info" OnClick="() => HandleOnClickRefresh()" />
        <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="Open user menu">
            @foreach (var module in _itemsModules)
            {
                <MudMenuItem Icon="@(module.Icon ?? "")" IconColor="@module.Color"
                Label="@module.Text"
                OnClick="() => HandleMenuClick(module)" />
            }
        </MudMenu>
    </ToolBarContent>
  <Columns>
    <SelectColumn T="Kardex" />

    <PropertyColumn Property="x => x.PartCode" 
                    Title="CÓDIGO" 
                    Align="Align.Center"
                    Groupable="true" 
                    Filterable="false" 
                    Sortable="false" 
                    Hideable="false" />
    
    <TemplateColumn Title="DESCRIPCION REPUESTO" Align="Align.Center" Filterable="false">
        <CellTemplate>
            <MudText Typo="Typo.caption">@context.Item.PartName.ToUpper()</MudText>
        </CellTemplate>
    </TemplateColumn>

    @* Trazabilidad *@
    <TemplateColumn Title="FECHA / HORA" Align="Align.Center" Filterable="false">
        <CellTemplate>
            <MudText Typo="Typo.caption">
                @(DateTime.TryParse(context.Item.Created, out var dt) 
                    ? dt.ToString("dd/MM/yyyy HH:mm") 
                    : context.Item.Created)
            </MudText>
        </CellTemplate>
    </TemplateColumn>

    <TemplateColumn Title="TIPO" Align="Align.Center" Filterable="false">
        <CellTemplate>
            <MudText Typo="Typo.caption">
                @(context.Item.Type switch {
                    "R" => "Recepción",
                    "S" => "Aj. Salida",
                    "E" => "Aj. Entrada",
                    "D" => "Despacho",
                    _ => context.Item.Type
                })
            </MudText>
        </CellTemplate>
    </TemplateColumn>

    <PropertyColumn Property="x => x.ReferenceId" Title="REFERENCIA" Align="Align.Center" Filterable="false" />

    @* Inventario *@
    <PropertyColumn Property="x => x.QuantityOld" Title="STOCK INICIAL" Align="Align.Center" Filterable="false" />

    <TemplateColumn Title="OPERACIÓN" Align="Align.Center" Filterable="false">
        <CellTemplate>
            @* Se eliminó el MudText innecesario para evitar conflictos de alineación y se usa un span con estilo *@
            <span style="font-weight:bold; font-size: 0.75rem;">
                @((context.Item.Type == "R" || context.Item.Type == "E") ? "+" : "-")@context.Item.Quantity
            </span>
        </CellTemplate>
    </TemplateColumn>

    <TemplateColumn Title="STOCK FINAL" Align="Align.Center" Filterable="false">
        <CellTemplate>
            <span style="font-weight:bold; font-size: 0.75rem;">@context.Item.QuantityNew</span>
        </CellTemplate>
    </TemplateColumn>

    @* Costo y Auditoría *@
    <PropertyColumn Property="x => x.Cost" Title="COSTO TOTAL" Align="Align.Center" Format="N2" Filterable="false" />
    <PropertyColumn Property="x => x.UserName" Title="RESPONSABLE" Align="Align.Center" Filterable="false" />
</Columns>

    <PagerContent>
        <MudDataGridPager  PageSizeOptions="new int[] {100}" InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Registros por Pagina" />
    </PagerContent>
</MudDataGrid>

<NestedDialogCustom IsVisible="@_nestedVisible" Success="@_success"
                    onCloseNested="() => _nestedVisible = false"
                    ErrorMessage="@_nestedErrorMessage" 
                    Title="@("Kardex")" />



