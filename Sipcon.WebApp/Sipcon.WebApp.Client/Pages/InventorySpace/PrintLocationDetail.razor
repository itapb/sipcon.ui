@using Sipcon.WebApp.Client.Models
<MudDialog Style="background-color: transparent; box-shadow: none;">
    <DialogContent>
        <MudGrid Spacing="0">
            <MudItem xs="12">
                <MudPaper Elevation="2" Class="jpv1-dialog-background-title pa-3" Square="true">
                    <MudPaper Elevation="2" Class="pa-2 mud-text-align-center">
                        <MudStack Row="true" StretchItems="StretchItems.Start" Justify="Justify.FlexEnd">
                            <MudStack Row="true">
                                <MudText Typo="Typo.h6" Color="Color.Info">Impresión de Ubicaciones</MudText>
                            </MudStack>
                            <MudStack Row="true" Spacing="2">
                                <MudFab Color="Color.Info" StartIcon="@Icons.Material.Filled.Print" Size="Size.Small" OnClick="ConfirmClick" />
                                <MudFab Color="Color.Error" StartIcon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CancelClick" />
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                </MudPaper>
            </MudItem>
            <MudItem xs="12">
                <MudDataGrid T="Location"
                             Items="@SelectedLocations"
                             Filterable="false"
                             FixedHeader="true"
                             Height="calc(100vh - 262px)">
                    <Columns>
                        <PropertyColumn Property="x => x.Name" Title="UBICACIÓN" />
                        <PropertyColumn Property="x => x.ZoneName" Title="ZONA" />
                        <PropertyColumn Property="x => x.WarehouseName" Title="ALMACÉN" />
                        <PropertyColumn Property="x => x.TypeName" Title="TIPO" />
                        <TemplateColumn Title="CANTIDAD">
                            <CellTemplate>
                                <MudNumericField @bind-Value="context.Item.PrintQty"
                                                 Variant="Variant.Outlined"
                                                 Min="0"
                                                 Max="999"
                                                 Error="@(context.Item.PrintQty < 1 || context.Item.PrintQty == null)"
                                                 ErrorText="La cantidad debe ser mayor a 0"
                                                 Immediate="true"
                                                 Style="width: 100px;" />
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                </MudDataGrid>
            </MudItem>
        </MudGrid>
    </DialogContent>
</MudDialog>

@code {
    [Inject] private UserSession Session { get; set; } = null!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private HttpClient Http { get; set; } = default!;
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public List<Location> SelectedLocations { get; set; } = new();

    private async Task ConfirmClick()
    {
        // Validar que hayan seleccionados
        if (SelectedLocations == null || SelectedLocations.Count == 0)
        {
            await DialogService.ShowMessageBox("Advertencia", "No hay ubicaciones seleccionadas.", "OK");
            return;
        }

        // Validar cantidades > 0
        var invalidItems = SelectedLocations.Where(x => (x.PrintQty ?? 0) <= 0).ToList();
        if (invalidItems.Any())
        {
            await DialogService.ShowDialog("Las ubicaciones deben tener cantidad mayor a 0.",
                    "Advertencia", "OK", Color.Error, Icons.Material.Filled.Warning);
            return;
        }

        List<Printqueue> printQueue = new();
        foreach (var item in SelectedLocations)
        {
            printQueue.Add(new Printqueue
            {
                RecordId = item.Id ?? 0,
                Type = "L",
                Code = item.Name ?? "",
                Description = item.Name ?? "",
                Quantity = item.PrintQty ?? 1,
                PrintedDate = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"),
                Supplier = "",
                CodePair = "",
                DescriptionPair = "",
                Note = "",
                NotePair = ""
            });
        }

        // Abrir selector de impresora
        var printerDialog = await DialogService.ShowAsync<PrinterSelectorDialog>(
            string.Empty,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false });

        var printerResult = await printerDialog.Result;

        if (printerResult == null || printerResult.Canceled)
            return;

        var selectedPrinter = (Printer)printerResult.Data;

        // Enviar a la API con printerId
        var result = await Http.PostAsync(
            $"api/Print/PostPrintQueue?userId={Session.UserId}&printerId={selectedPrinter.Id}",
            new StringContent(System.Text.Json.JsonSerializer.Serialize(printQueue),
                null, "application/json"));

        if (result.IsSuccessStatusCode)
        {
            await DialogService.ShowMessageBox("Éxito", "Ubicaciones enviadas a impresión exitosamente.", "OK");

            MudDialog?.Close(DialogResult.Ok(true));
        }
        else if (result.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            var conflictContent = await result.Content.ReadFromJsonAsync<WebApiResponse<object>>();
            await DialogService.ShowMessageBox("Error", conflictContent?.message ?? "Conflicto al procesar la impresión.", "OK");
        }
        else
        {
            var errorMessage = await result.Content.ReadAsStringAsync();
            await DialogService.ShowMessageBox("Error", $"Error: {errorMessage}", "OK");
        }
    }

    private void CancelClick()
    {
        MudDialog?.Close(DialogResult.Cancel());
    }
}