<div id="scrollableGridContentStyled" style="overflow-y: auto;  padding: 8px; background-color: #f0f0f0;">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="9">
            <MudStack>
                <MudPaper Elevation="2" Class="pa-2 mud-text-align-center">
                    <MudStack Row="true" Spacing="2">
                        <MudFab StartIcon="@Icons.Material.Filled.Save" Color="Color.Info" Size="Size.Small" Label="Guardar" OnClick="SaveClick" Disabled="@(!(IsCreatedAdjustment))"></MudFab>
                        <MudButton OnClick="CloseClick">Cerrar</MudButton>
                    </MudStack>
                </MudPaper>
                <MudPaper Elevation="2" Style="height: 100%;">
                    <MudDataGrid @ref="AdjustmentDetailsMudDataGrid" T="Models.AdjustmentDetails" ServerData="ServerReload" Filterable="false" FixedHeader Height="calc(100vh - 262px)" Loading="Loading" @bind-CurrentPage="PartCurrentPage">
                        <ToolBarContent>
                            <MudIconButton Icon="@Icons.Material.Filled.PlaylistAdd" Size="Size.Medium" OnClick="ClickAddAdjustmentDetail" Color="Color.Info" Disabled="@(!IsCreatedAdjustment)"></MudIconButton>
                            <MudIconButton Icon="@Icons.Material.Filled.PlaylistRemove" Size="Size.Medium" OnClick="ClickRemoveMovementDetails" Color="Color.Info" Disabled="@(!IsCreatedAdjustment)"></MudIconButton>                            
                        </ToolBarContent>
                        <Columns>
                            <TemplateColumn>
                                <HeaderTemplate>
                                    <MudCheckBox @bind-Value="IsAllCheckBoxSelected" @bind-Value:after="AfterAsyncAllCheck" />
                                </HeaderTemplate>
                                <CellTemplate>
                                    <MudCheckBox @bind-Value="context.Item.IsSelected" />
                                </CellTemplate>
                            </TemplateColumn>
                            <PropertyColumn Property="x => x.Inncercode" Title="COD REPUESTO" />
                            <PropertyColumn Property="x => x.PartDescription" Title="DESCRIPCION" />
                            <PropertyColumn Property="x => x.Location" Title="UBICACION" />
                            <PropertyColumn Property="x => x.Stock" Title="CANTIDAD" />
                            <PropertyColumn Property="x => x.AdjustmentType" Title="TIPO" />
                            <PropertyColumn Property="x => x.ReasonDescription" Title="CONCEPTO" />

                            <TemplateColumn StickyRight="true">
                                <CellTemplate>
                                    <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="() => ClickEditAdjustmentDetail(context.Item)" Disabled="@(!IsCreatedAdjustment)" />
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                    </MudDataGrid>
                </MudPaper>
            </MudStack>
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudStack Style="height: 100%; ">
                <MudPaper Elevation="2" Class="pa-2 mud-text-align-center flex-grow-1">
                    <MudForm @ref="form">
                        <MudGrid Spacing="2">
                            <MudItem xs="12"><MudText Typo="Typo.h6" Color="Color.Info">Datos Generales:</MudText></MudItem>
                            @if (MasterAdjustment == null)
                            {
                                <MudItem xs="12"><MudTextField T="string" ReadOnly="true" Value="@("Cargando..")" Variant="Variant.Text" /></MudItem>
                            }
                            else
                            {
                                <MudItem xs="12">
                                    <MudTextField ReadOnly="true" @bind-Value="MasterAdjustment.SupplierName" Adornment="Adornment.Start" AdornmentText="Contacto :" Variant="Variant.Text" Class="align-right-input"></MudTextField>
                                </MudItem>
                                <MudItem xs="12"><MudTextField ReadOnly="true" @bind-Value="MasterAdjustment.Id" Adornment="Adornment.Start" AdornmentText="Nro Doc :" Variant="Variant.Text" Class="align-right-input" /></MudItem>
                                <MudItem xs="12"><MudTextField ReadOnly="true" @bind-Value="MasterAdjustment.DCreated" Adornment="Adornment.Start" AdornmentText="Fecha :" Variant="Variant.Text" Class="align-right-input" /></MudItem>
                                <MudItem xs="12"><MudTextField ReadOnly="true" @bind-Value="MasterAdjustment.UserLogin" Adornment="Adornment.Start" AdornmentText="Usuario :" Variant="Variant.Text" Class="align-right-input" /></MudItem>
                                <MudItem xs="12"><MudTextField ReadOnly="true" @bind-Value="MasterAdjustment.StatusName" Adornment="Adornment.Start" AdornmentText="Estatus :" Variant="Variant.Text" Class="align-right-input" /></MudItem>                                
                                <MudItem xs="12"><MudTextField ReadOnly="@(!IsCreatedAdjustment)" @bind-Value="MasterAdjustment.Comment" Label="Observacion" Variant="Variant.Text" /></MudItem>
                            }

                        </MudGrid>
                    </MudForm>
                </MudPaper>
                <MudPaper Elevation="2" Class="pa-2 mud-text-align-center flex-grow-1">
                    <MudGrid Spacing="2">
                        <MudItem xs="12"><MudText Typo="Typo.h6" Color="Color.Info">Totales:</MudText></MudItem>
                        <MudItem xs="12"><MudTextField ReadOnly="true" Adornment="Adornment.Start" @bind-Value="UnitValue" AdornmentText="Unidad :" Variant="Variant.Text" Class="align-right-input" /></MudItem>
                        <MudItem xs="12"><MudTextField ReadOnly="true" Adornment="Adornment.Start" @bind-Value="ProductValue" AdornmentText="Productos :" Variant="Variant.Text" Class="align-right-input" /></MudItem>
                        <MudItem xs="12"><MudTextField ReadOnly="true" Adornment="Adornment.Start" @bind-Value="CostValue" AdornmentText="Costo :" Format="N2" Variant="Variant.Text" Class="align-right-input" /></MudItem>
                    </MudGrid>
                </MudPaper>
                <MudPaper Elevation="2" Class="pa-2 mud-text-align-center flex-grow-0">
                    <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd" StretchItems="StretchItems.Start">
                        <MudFab StartIcon="@Icons.Material.Filled.CheckCircleOutline" Color="Color.Info" Size="Size.Small" Label="Procesar" OnClick="ProcessClick" Disabled="@(!IsCreatedAdjustment)" />
                    </MudStack>
                </MudPaper>
            </MudStack>
        </MudItem>
    </MudGrid>
</div>

<style>
    .align-right-input input {
        text-align: right;
    }
</style>
@code {
    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;
    [Parameter] public int? Value { get; set; }
    [Parameter] public EventCallback<int?> ValueChanged { get; set; }
    [Parameter] public int? ModuleId { get; set; }

    DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Large, BackdropClick = false, NoHeader = true };

    string TempReference = "";
    int PartCurrentPage = 0;
    bool IsCreatedAdjustment = false;
    bool IsProcessedDispatch = false;
    bool IsCreatedReception = false;  


    private int? AdjustmentId
    {
        get => Value;
        set
        {
            if (Value != value)
            {
                Value = value;
                ValueChanged.InvokeAsync(Value);
            }
        }
    }
    private int UnitValue = 0;
    private int ProductValue = 0;
    private decimal? CostValue = 0;


    private bool IsAllCheckBoxSelected = false;
    bool Loading = false;
    private Models.Adjustment? MasterAdjustment;
    private MudDataGrid<Models.AdjustmentDetails>? AdjustmentDetailsMudDataGrid = new();
    private MudForm? form;
    private async Task AfterAsyncAllCheck()
    {
        AdjustmentDetailsMudDataGrid?.FilteredItems.ToList().ForEach(item => item.IsSelected = IsAllCheckBoxSelected);
        await Task.CompletedTask;
    }
    private async Task ClickEditAdjustmentDetail(Models.AdjustmentDetails item)
    {
        Type tipoCatalogo = typeof(PartToAdjustmentDetails);
        NewAdjustmentDetail AnewAdjustmentDetail = new NewAdjustmentDetail
        {
            Id = item.Id,         
            AdjustmentId = item.AdjustmentId,
            PartId = item.PartId,            
            Stock = item.Stock,
            ReasonId = item.ReasonId,
            LocationId = item.LocationId,
            AdjustmentType = item.AdjustmentType,
            IsActive = item.IsActive
        };
        var dialogReference = await DialogService.ShowAsync(tipoCatalogo, "", new DialogParameters { ["newAdjustmentDetail"] = AnewAdjustmentDetail }, options);
        if (!((await dialogReference.Result)!.Canceled))
            await AdjustmentDetailsMudDataGrid!.ReloadServerData();
    }

    private void getTotals(IEnumerable<Models.AdjustmentDetails> data)
    {       
        UnitValue = data.Sum(x => x.Stock) ?? 0;
        ProductValue = data.Count();
        CostValue = data.Sum(x => x.Cost);
    }
    Func<Models.AdjustmentDetails, object> GetSortKeySelector(string sortByPropertyName) => sortByPropertyName switch
    {
        nameof(Models.AdjustmentDetails.Inncercode) => o => o.Inncercode ?? "",
        nameof(Models.AdjustmentDetails.PartDescription) => o => o.PartDescription ?? "",
        nameof(Models.AdjustmentDetails.Location) => o => o.Location ?? "",
        nameof(Models.AdjustmentDetails.Stock) => o => o.Stock ?? 0,
        nameof(Models.AdjustmentDetails.AdjustmentType) => o => o.AdjustmentType ?? "",
        nameof(Models.AdjustmentDetails.ReasonDescription) => o => o.ReasonDescription ?? "",
        _ => null! //o => o.Id ?? 0 // Criterio de ordenación por defecto
    };

    private async Task<GridData<Models.AdjustmentDetails>> ServerReload(GridState<Models.AdjustmentDetails> state)
    {
        IsAllCheckBoxSelected = false;
        Loading = true;
        var totalItems = 0;
        var mOffset = state.Page * state.PageSize;
        IEnumerable<Models.AdjustmentDetails> data;
        HttpResponseMessage response = await Http.GetAsync($"api/Adjustment/GetAdjustmentWithContext?userId={Useful.userId}&adjustmentId={AdjustmentId}");
        if (response.IsSuccessStatusCode)
        {
            var content2 = await response.Content.ReadFromJsonAsync<WebApiResponse<Models.MasterAdjustmentDetails>>();
            totalItems = content2!.total ?? 0;
            var masterAdjustmentDetails = content2!.data ?? new Models.MasterAdjustmentDetails();
            MasterAdjustment = masterAdjustmentDetails.Adjustment;
            data = masterAdjustmentDetails.Details!;           
            IsCreatedAdjustment = (MasterAdjustment!.StatusName!.ToUpper() == "CREADO");            
            getTotals(data);
        }
        else
        {
            var errorMessage = await response.Content.ReadAsStringAsync();
            throw new Exception(errorMessage);
        }
        if (state.SortDefinitions.FirstOrDefault() is SortDefinition<Models.AdjustmentDetails> sortDefinition)
        {
            data = data.OrderByDirection(sortDefinition.Descending ? SortDirection.Descending : SortDirection.Ascending, GetSortKeySelector(sortDefinition.SortBy));
        }
        Loading = false;
        StateHasChanged();
        return new GridData<Models.AdjustmentDetails> { TotalItems = totalItems, Items = data };
    }

    private void CloseClick() => AdjustmentId = null;

    private async Task ClickAddAdjustmentDetail(MouseEventArgs ev)
    {
        Type tipoCatalogo = typeof(AdjustmentCatalog);
        var dialogReference = await DialogService.ShowAsync(tipoCatalogo, "", new DialogParameters { ["AdjustmentId"] = MasterAdjustment!.Id }, options);
        if ((await dialogReference.Result) is DialogResult dialogResult && !dialogResult.Canceled)
            await AdjustmentDetailsMudDataGrid!.ReloadServerData();
    }

    private async Task ClickRemoveMovementDetails(MouseEventArgs ev)
    {
        var mActions = AdjustmentDetailsMudDataGrid?.FilteredItems.Where(item => item.IsSelected)
                                                     .Select(item => new Client.Models.Action
                                                     {
                                                         UserId = Useful.userId,
                                                         RecordId = item.Id,
                                                         ModuleId = 0,
                                                         actionName = "DECLINE",
                                                         ActionComment = "",
                                                         RelatedId = 0
                                                     }).ToList();
        if (mActions?.Count > 0)
            await DeleteMovementDetailAction(mActions);
    }

    private async Task SaveClick(MouseEventArgs args)
    {
        if (AdjustmentDetailsMudDataGrid?.FilteredItems.Count() == 0)
        {
            await DialogService.ShowDialog("No se puede guardar. Debe agregar al menos un ítem.", "Error", "OK", Color.Error, Icons.Material.Filled.Error);
            return;
        }

        await form!.Validate();
        if (form.IsValid)
        {
            var strMasterMovement = System.Text.Json.JsonSerializer.Serialize(MasterAdjustment);
            var result_MasterMovement = await Http.PostAsync($"api/Adjustment/PostAdjustment?userId={Useful.userId}", new StringContent($"{strMasterMovement}", null, "application/json"));
            if (result_MasterMovement.IsSuccessStatusCode)
            {
                var sucessContent = await result_MasterMovement.Content.ReadFromJsonAsync<WebApiResponse<PostResponse>>();
                if (sucessContent?.data! is ({ insertedRows: 1 } or { updatedRows: 1 }))
                {
                    var result = await DialogService.ShowDialog(Useful.OkSavedMessage, "Guardar", "OK", Color.Info, Icons.Material.Filled.Commit);
                    if (!result!.Canceled)
                        AdjustmentId = null;
                    // TempReference = MasterAdjustment!.Reference;
                }
            }
            else if (result_MasterMovement.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                var conflictContent = await result_MasterMovement.Content.ReadFromJsonAsync<WebApiResponse<Object?>>();
                await DialogService.ShowDialog(conflictContent?.message!, "Error", "OK", Color.Error, Icons.Material.Filled.Error);
            }
            else
            {
                var errorMessage = await result_MasterMovement.Content.ReadAsStringAsync();
                throw new Exception(errorMessage);
            }
        }
    }
    private async Task ProcessClick(MouseEventArgs args)
    {
        var SelectedActions = AdjustmentDetailsMudDataGrid?.FilteredItems.Count() > 0 ?
                              new Client.Models.Action
                              {
                                  UserId = Useful.userId,
                                  RecordId = AdjustmentId,
                                  ModuleId = ModuleId ?? 0,
                                  actionName = "PROCESS",
                                  ActionComment = "",
                                  RelatedId = 0
                              }
                              : null;

        if (SelectedActions is null)
        {
            await DialogService.ShowDialog("No hay detalles para generar adjuste.", "Error", "OK", Color.Error, Icons.Material.Filled.Error);
            return;
        }

        await form!.Validate();
        var IsSuccess = false;
        if (form.IsValid)
        {
            var strMasterAdjustment = System.Text.Json.JsonSerializer.Serialize(MasterAdjustment);
            var result_MasterAdjustment = await Http.PostAsync($"api/Adjustment/PostAdjustment?userId={Useful.userId}", new StringContent($"{strMasterAdjustment}", null, "application/json"));
            if (result_MasterAdjustment.IsSuccessStatusCode)
            {
                var sucessContent = await result_MasterAdjustment.Content.ReadFromJsonAsync<WebApiResponse<PostResponse>>();
                IsSuccess = (sucessContent?.data! is ({ insertedRows: > 0 } or { updatedRows: > 0 }));
            }
            else if (result_MasterAdjustment.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                var conflictContent = await result_MasterAdjustment.Content.ReadFromJsonAsync<WebApiResponse<Object?>>();
                await DialogService.ShowDialog(conflictContent?.message!, "Error", "OK", Color.Error, Icons.Material.Filled.Error);
            }
            else
            {
                var errorMessage = await result_MasterAdjustment.Content.ReadAsStringAsync();
                throw new Exception(errorMessage);
            }
        }
        
        if (!IsSuccess)
        {
            return;
        }
  

        var strAdjustmentActions = System.Text.Json.JsonSerializer.Serialize(SelectedActions);
        var result_PostMovementActions = (SelectedActions is not null) ? await Http.PostAsync($"api/Adjustment/PostAdjustmentActions?userId={SelectedActions.UserId}", new StringContent($"[{strAdjustmentActions}]", null, "application/json")) : null;
        if ((result_PostMovementActions?.IsSuccessStatusCode ?? false))
        {
            var rest = result_PostMovementActions.Content.ReadAsStringAsync();
            await DialogService.ShowDialog(Useful.OkSavedMessage, "Accion", "OK", Color.Info, Icons.Material.Filled.Commit);
            AdjustmentId = null;
        }
    }

    private async Task DeleteMovementDetailAction(List<Models.Action>? actions)
    {
        var result_Post_Actions = (actions?.Count > 0) ? await Http.PostAsync($"api/Adjustment/DeleteAdjustmentDetails?userId={Useful.userId}", new StringContent(System.Text.Json.JsonSerializer.Serialize(actions), null, "application/json")) : null;
        if ((result_Post_Actions?.IsSuccessStatusCode ?? false))
        {
            //var rest = result_Post_Actions.Content.ReadAsStringAsync();
            await DialogService.ShowDialog(Useful.OkSavedMessage, "Remover", "OK", Color.Info, Icons.Material.Filled.Commit);
            await AdjustmentDetailsMudDataGrid!.ReloadServerData();
        }
        else if (result_Post_Actions?.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            var conflictContent = await result_Post_Actions.Content.ReadFromJsonAsync<WebApiResponse<Object?>>();
            await DialogService.ShowDialog(conflictContent?.message!, "Error", "OK", Color.Error, Icons.Material.Filled.Error);
        }
        else
        {
            var errorMessage = await result_Post_Actions!.Content.ReadAsStringAsync() ?? "";
            throw new Exception(errorMessage);
        }
    }
 
   
  
}
