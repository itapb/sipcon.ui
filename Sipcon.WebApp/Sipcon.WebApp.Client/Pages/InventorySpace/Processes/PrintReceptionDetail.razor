<MudGrid Spacing="0">
    <MudItem xs="12">
        <MudPaper Elevation="2" Class="jpv1-dialog-background-title pa-3" Square="true">
        <MudPaper Elevation="2" Class="pa-2 mud-text-align-center">
            <MudStack Row="true" StretchItems="StretchItems.Start" Justify="Justify.FlexEnd">
                <MudStack Row="true">
                    <MudText Typo="Typo.h6" Color="Color.Info">Detalles de Recepcion</MudText>
                </MudStack>
                <MudStack Row="true" Spacing="2">
                        <MudFab Color="Color.Info" StartIcon="@Icons.Material.Filled.Print" Size="Size.Small" OnClick="() => ClickPrintReceptionDetail()" />
                    <MudFab Color="Color.Info" StartIcon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseClick" />
                </MudStack>
            </MudStack>
        </MudPaper></MudPaper>
    </MudItem>
     <MudItem xs="12">
         <MudDataGrid @ref="MovementDetailsMudDataGrid" T="MovementDetails" ServerData="ServerReload" Filterable="false" FixedHeader Height="calc(100vh - 262px)" Loading="Loading" @bind-CurrentPage="PartCurrentPage">
             <Columns>
                 <PropertyColumn Property="x => x.PartInnerCode" Title="COD REPUESTO" />
                 <PropertyColumn Property="x => x.PartDescription" Title="DESCRIPCION" />                
                 <TemplateColumn Title="CANTIDAD">
                    <CellTemplate>
                        <MudNumericField @bind-Value="context.Item.PrintQty" Variant="Variant.Outlined" Min="1" Max="10" />
                    </CellTemplate>
                 </TemplateColumn>                 

             </Columns>
         </MudDataGrid>
     </MudItem>
</MudGrid>
@code {
    [Inject] private UserSession Session { get; set; } = null!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private HttpClient Http { get; set; } = default!;
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    int PartCurrentPage = 0;
    bool Loading = false;
    [Parameter] public MasterMovementDetails? masterMovementDetails { get; set; } = default!;
    private MudDataGrid<MovementDetails>? MovementDetailsMudDataGrid = new();
    private async Task<GridData<MovementDetails>> ServerReload(GridState<MovementDetails> state)
    {
        var totalItems = 0;
        var mOffset = state.Page * state.PageSize;
        IEnumerable<MovementDetails> data;

        data = masterMovementDetails!.Details ?? new List<MovementDetails>();

        if (state.SortDefinitions.FirstOrDefault() is SortDefinition<MovementDetails> sortDefinition)
        {
            data = data.OrderByDirection(sortDefinition.Descending ? SortDirection.Descending : SortDirection.Ascending, GetSortKeySelector(sortDefinition.SortBy));
        }
        return new GridData<MovementDetails> { TotalItems = totalItems, Items = data};
    }
    Func<MovementDetails, object> GetSortKeySelector(string sortByPropertyName) => sortByPropertyName switch
    {
        nameof(MovementDetails.PartInnerCode) => o => o.PartInnerCode ?? "",
        nameof(MovementDetails.PartDescription) => o => o.PartDescription ?? "",
        nameof(MovementDetails.PrintQty) => o => o.PrintQty ?? 1,
        _ => null! //o => o.Id ?? 0 // Criterio de ordenación por defecto
    };
    private async Task ClickPrintReceptionDetail()
    {
        List<Models.Printqueue> mActions = new();
        foreach (var item in masterMovementDetails!.Details!)
        {
            mActions.Add(new Models.Printqueue
            {
                RecordId = item.Id,
                Type = item.TypeId!,
                PrintedDate = $"{DateTime.Now:yyyy-MM-dd HH:mm:ss}",
                Code = item.PartInnerCode ?? "",
                Description = item.PartDescription ?? "",
                Quantity = item.PrintQty ?? 1,
            });

        }
       

        await PostPrintQueue(mActions, $"api/Print/PostPrintQueue?userId={Session.UserId}");
        await Task.CompletedTask;   
    }
    private void CloseClick(MouseEventArgs args)
    {
        MudDialog?.Close(DialogResult.Ok(true));
    }
    private async Task PostPrintQueue(List<Models.Printqueue>? actions, string requesturi)
    {
        var result_Post_Actions = (actions?.Count > 0) ? await Http.PostAsync(requesturi, new StringContent(System.Text.Json.JsonSerializer.Serialize(actions), null, "application/json")) : null;
        if ((result_Post_Actions?.IsSuccessStatusCode ?? false))
        {
            var rest = result_Post_Actions.Content.ReadAsStringAsync();
            await DialogService.ShowDialog(Useful.OkSavedMessage, "Accion", "OK", Color.Info, Icons.Material.Filled.Commit);        
        }
        else if (result_Post_Actions?.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            var conflictContent = await result_Post_Actions.Content.ReadFromJsonAsync<WebApiResponse<Object?>>();
            await DialogService.ShowDialog(conflictContent?.message!, "Error", "OK", Color.Error, Icons.Material.Filled.Error);
        }
        else
        {
            var errorMessage = await result_Post_Actions!.Content.ReadAsStringAsync();
            await DialogService.ShowDialog(errorMessage, "Error", "OK", Color.Error, Icons.Material.Filled.Error);
        }
    }
}
