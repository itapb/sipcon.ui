@page "/adjustment"
@inject HubEventsService hubEventsService
@implements IDisposable

<CustomBreadcrumbs mItems="ItemsNavigate"></CustomBreadcrumbs>

@if (AdjustmentId != null)
{
    <AdjustmentForm @bind-Value="AdjustmentId" ModuleId="Modules!.FirstOrDefault()?.Id" />
}
else
{
    <MudDataGrid @ref="AdjustmentMudDataGrid" T="Models.Adjustment" ServerData="ServerReload" Striped="true" Hover="true" Filterable="false" FixedHeader Height="calc(100vh - 240px)" Loading="Loading" @bind-CurrentPage="ReceptionCurrentPage">
        <ToolBarContent>
            <MudIconButton Icon="@Icons.Material.Filled.AddCard" Color="Color.Info" OnClick="ClickNewAdjustment"></MudIconButton>
            <MudTextField T="string" Placeholder="Buscar" Adornment="Adornment.Start" ValueChanged="@(s => OnSearch(s))" Value="searchString" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Info" OnClick="ClickRefreshAdjustment"></MudIconButton>
            <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="Open user menu">
                @foreach (var strmodulo in Modules!)
                {
                    <MudMenuItem Label="@strmodulo.ActionDisplay" Icon="@(strmodulo.ActionDisplay.ToActionIcon())" IconColor="@Color.Info" OnClick="@(() => ClickMenuAdjustment(strmodulo.ActionName))" />
                }
            </MudMenu>
        </ToolBarContent>
        <Columns>
            <TemplateColumn>
                <HeaderTemplate>
                    <MudCheckBox @bind-Value="IsAllCheckBoxSelected" @bind-Value:after="AfterAsyncAllCheck" />
                </HeaderTemplate>
                <CellTemplate>
                    <MudCheckBox @bind-Value="context.Item.IsSelected" />
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Id" Title="NRO DOC" />
            <PropertyColumn Property="x => x.DCreated" Title="FECHA" />
            <PropertyColumn Property="x => x.UserLogin" Title="USUARIO" />
            <PropertyColumn Property="x => x.StatusName" Title="ESTATUS" />           
            <PropertyColumn Property="x => x.Comment" Title="OBSERVACION" />
            <TemplateColumn StickyRight="true">
                <CellTemplate>
                    <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="() => ClickEdiAdjustment(context.Item)" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="Models.Adjustment" PageSizeOptions="new int[] { 100 }" InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Registros por Pagina" />
        </PagerContent>
    </MudDataGrid>
}

@code { [Inject] private UserSession Session { get; set; } = null!;
    [Inject] private Repository.Auth.AuthenticationProviderJWT AuthenticationStateProvider { get; set; } = null!;
    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ILogger<Adjustment> Logger { get; set; } = default!;
    List<BreadcrumbItem> ItemsNavigate = new();
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;

    [Parameter]
    public string? TypeId { get; set; }
    private int? AdjustmentId = null;    //4

    private bool IsAllCheckBoxSelected = false;
    int ReceptionCurrentPage = 0;
    bool Loading = false;
    private MudDataGrid<Models.Adjustment>? AdjustmentMudDataGrid;
    private List<Module>? Modules;
    DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Large, BackdropClick = false, NoHeader = true };
    private string searchString = string.Empty;
    string AdjustmentTitle = "";



    private async Task OnSearch(string text)
    {
        if (text.Length == 0 || text.Length >= 3)
        {
            Loading = true;
            searchString = text;
            await AdjustmentMudDataGrid!.ReloadServerData();
        }
    }
    private async Task ClickRefreshAdjustment(MouseEventArgs args) => await AdjustmentMudDataGrid!.ReloadServerData();
    private async Task ClickNewAdjustment(MouseEventArgs ev)
    {
        HttpResponseMessage response = await Http.GetAsync($"api/Adjustment/NewAdjustmentWithContext?userId={Session.UserId}&supplierId={Session.SupplierId}");
        if (response.IsSuccessStatusCode)
        {
            var content2 = await response.Content.ReadFromJsonAsync<WebApiResponse<MasterAdjustmentDetails>>();
            var data = content2!.data ?? new MasterAdjustmentDetails();
            Session.IsNewOrEdit = true;
            AdjustmentId = data.Adjustment?.Id;
        }
        else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            var conflictContent = await response.Content.ReadFromJsonAsync<WebApiResponse<Object?>>();
            await DialogService.ShowDialog(conflictContent?.message!, "Error", "OK", Color.Error, Icons.Material.Filled.Error);
        }
        else
        {
            var errorMessage = await response.Content.ReadAsStringAsync();
            Logger.LogError(Session.TemplateLog(AdjustmentTitle, errorMessage));
            await DialogService.ShowDialog(errorMessage, "Error", "OK", Color.Error, Icons.Material.Filled.Error);                     
        }
        await Task.CompletedTask;
    }
    private async Task AfterAsyncAllCheck()
    {
        AdjustmentMudDataGrid?.FilteredItems.ToList().ForEach(item => item.IsSelected = IsAllCheckBoxSelected);
        await Task.CompletedTask;
    }

    private async Task ClickEdiAdjustment(Models.Adjustment item)
    {
        Session.IsNewOrEdit = true;
        await Task.FromResult(AdjustmentId = item.Id);
    }

    protected override async Task OnInitializedAsync()
    {
        await AuthenticationStateProvider.RefreshStaticVariables();
        await LoadDataAsync();
        hubEventsService.OnSupplierChanged += ReloadAdjustmentGrid;
    }


    private async Task LoadDataAsync()
    {
        AdjustmentTitle = "Ajuste" ;
        string hrefAdjustment = "adjustment";       

        $"Home,Inventario,{AdjustmentTitle}".Split(',').ToList().ForEach(s => ItemsNavigate.Add(new BreadcrumbItem(s, href: (s == "Home" ? "" : hrefAdjustment), icon: s.ToActionIcon())));
        Modules = await Http.GetFromJsonAsync<List<Module>>($"api/Module/GetAll?moduleName=INVENTARIO-PROCESOS-{AdjustmentTitle.ToUpper()}&userId={Session.UserId}");
    }
    Func<Models.Adjustment, object> GetSortKeySelector(string sortByPropertyName) => sortByPropertyName switch
    {
        nameof(Models.Adjustment.Id) => o => o.Id ?? 0,
        nameof(Models.Adjustment.DCreated) => o => o.DCreated ?? DateTime.Now,
        nameof(Models.Adjustment.UserLogin) => o => o.UserLogin ?? "",
        nameof(Models.Adjustment.StatusName) => o => o.StatusName ?? "",
        nameof(Models.Adjustment.Comment) => o => o.Comment ?? "",
        _ => null! //o => o.Id ?? 0 // Criterio de ordenación por defecto
    };

    private async Task<GridData<Models.Adjustment>> ServerReload(GridState<Models.Adjustment> state)
    {
        await AuthenticationStateProvider.RefreshStaticVariables();
        IsAllCheckBoxSelected = false;
        Loading = true;
        var totalItems = 0;
        var mOffset = state.Page * state.PageSize;
        IEnumerable<Models.Adjustment> data;
        HttpResponseMessage response = await Http.GetAsync($"api/Adjustment/GetAdjustments?userId={Session.UserId}&supplierId={Session.SupplierId}&rowFrom={mOffset}&filter={searchString}");

        if (response.IsSuccessStatusCode)
        {
            var content2 = await response.Content.ReadFromJsonAsync<WebApiResponse<List<Models.Adjustment>>>();
            totalItems = content2!.total ?? 0;
            data = content2!.data ?? new List<Models.Adjustment>();

            if (state.SortDefinitions.FirstOrDefault() is SortDefinition<Models.Adjustment> sortDefinition)
            {
                data = data.OrderByDirection(sortDefinition.Descending ? SortDirection.Descending : SortDirection.Ascending, GetSortKeySelector(sortDefinition.SortBy));
            }
        }
        else
        {
            data = new List<Models.Adjustment>();
            var errorMessage = await response.Content.ReadAsStringAsync();
            Logger.LogError(Session.TemplateLog(AdjustmentTitle, errorMessage));
            await DialogService.ShowUnexpected();
        }

        Loading = false;
        return new GridData<Models.Adjustment> { TotalItems = totalItems, Items = data };
    }

    private async Task ClickMenuAdjustment(string? actionName)
    {    
        if (actionName == "EXPORT" && AdjustmentMudDataGrid?.FilteredItems.Count() > 0)
        {
             Loading = true;
             var ResultZonas = await Http.GetAsync($"api/Adjustment/Export?filter={searchString}&userId={Session.UserId}&supplierId={Session.SupplierId}");
             if (ResultZonas.IsSuccessStatusCode)
             {
                    var fileContent = await ResultZonas.Content.ReadAsByteArrayAsync();
                    var base64File = Convert.ToBase64String(fileContent);
                    var fileUrl = $"data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{base64File}";
                    await JSRuntime.InvokeVoidAsync("downloadFile", fileUrl, "Ajustes.xlsx");
             }
             Loading = false;
             return;
         }

        var mActions = AdjustmentMudDataGrid?.FilteredItems.Where(item => item.IsSelected )
                                                         .Select(item => new Client.Models.Action
                                                         {
                                                             UserId = Session.UserId,
                                                             RecordId = item.Id,
                                                             ModuleId = Modules!.FirstOrDefault()?.Id,
                                                             actionName = actionName,
                                                             ActionComment = "",
                                                             RelatedId = 0
                                                         }).ToList();

        if (mActions?.Count == 0)
        {
            await DialogService.ShowDialog("Accion no permitada, Verificar datos seleccionado(s)", "Error", "OK", Color.Error, Icons.Material.Filled.Error);
        }
        else if (mActions?.Count > 0)
        { 
            await PostActionAndReload(mActions, $"api/Adjustment/PostAdjustmentActions?userId={Session.UserId}");                    
        }

    }
    private async Task PostActionAndReload(List<Models.Action>? actions, string requesturi)
    {
        var result_Post_Actions = (actions?.Count > 0) ? await Http.PostAsync(requesturi, new StringContent(System.Text.Json.JsonSerializer.Serialize(actions), null, "application/json")) : null;
        if ((result_Post_Actions?.IsSuccessStatusCode ?? false))
        {
            var rest = result_Post_Actions.Content.ReadAsStringAsync();
            await DialogService.ShowDialog(Useful.OkSavedMessage, "Accion", "OK", Color.Info, Icons.Material.Filled.Commit);
            await AdjustmentMudDataGrid!.ReloadServerData();
        }
        else if (result_Post_Actions?.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            var conflictContent = await result_Post_Actions.Content.ReadFromJsonAsync<WebApiResponse<Object?>>();
            await DialogService.ShowDialog(conflictContent?.message!, "Error", "OK", Color.Error, Icons.Material.Filled.Error);
        }
        else
        {
            var errorMessage = await result_Post_Actions!.Content.ReadAsStringAsync() ?? "";
            Logger.LogError(Session.TemplateLog(AdjustmentTitle, errorMessage));
            await DialogService.ShowUnexpected(); ;
        }
    }
    private async Task ReloadAdjustmentGrid()
    {
        if (AdjustmentMudDataGrid != null && AdjustmentId == null)
        {
            await AdjustmentMudDataGrid.ReloadServerData();
        }
    }

    public void Dispose()
    {
        Session.IsNewOrEdit = false;
        hubEventsService.OnSupplierChanged -= ReloadAdjustmentGrid;
    }
}

