@if (mGuideDetails == null || ClaimReasons == null )
{
    <LoadingForm IsMudDialog="@(MudDialog != null)" />
}
else
{
    <MudForm @ref="form">
        <div style="flex-shrink: 0;" class="pa-3 jpv1-dialog-body-background">
            <MudPaper Elevation="2" Class="pa-3">
                <MudFocusTrap Disabled="false" DefaultFocus="DefaultFocus.FirstChild">
                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudFocusTrap Disabled="false" DefaultFocus="DefaultFocus.LastChild"><MudTextField T="int?" Label="Cantidad Recibida" @bind-Value="mGuideDetails.Received" For="@(() => mGuideDetails.Received)" Required="true" Validation="@(new Func<int?, string>(ValidateInteger))" @bind-Value:after="AfterAsyncChange"></MudTextField></MudFocusTrap>
                        </MudItem>
@*                         <MudItem xs="12">
                            <MudTextField T="string" Label="Observacion" @bind-Value="mGuideDetails!.Observation" For="@(() => mGuideDetails.Observation)" Required="@(!(mGuideDetails?.Received == mGuideDetails?.Quantity))" RequiredError="Campo requerido"></MudTextField>
                        </MudItem> *@
                        <MudItem xs="12" hidden="@(NotReason)">
                            <MudSelect T="Reason" Label="Observacion" ToStringFunc="@ConvertReasonFunc" Value="ClaimReasonSelected" ValueChanged="OnClaimReasonValueChanged" Required="@(!NotReason)" RequiredError="Campo requerido">
                                @foreach (var claimreason in FilteredClaimReasons ?? Enumerable.Empty<Reason>())
                                {
                                    <MudSelectItem Value="claimreason" />
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12">
                            <MudStack Row="true" Justify="Justify.Center">
                                <MudStack Row="true" Spacing="4">
                                    <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Check" Size="Size.Medium" OnClick="CheckClick" />
                                    <MudFab Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Close" Size="Size.Medium" OnClick="CloseClick" />
                                </MudStack>
                            </MudStack>
                        </MudItem>
                    </MudGrid>
                </MudFocusTrap>
            </MudPaper>
        </div>
    </MudForm>
}
@code {
    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    private MudForm? form;
    [Parameter] public GuideDetails? mGuideDetails { get; set; } = default!;

    private Func<Reason?, string> ConvertReasonFunc = reasontype => reasontype?.Description!;
    private Reason? ClaimReasonSelected;
    private List<Reason>? ClaimReasons;
    private List<Reason>? FilteredClaimReasons;
    private bool NotReason = false;
    private async Task CheckClick(MouseEventArgs args)
    {
        await form!.Validate();
        if (form.IsValid)
        {
            var sGuideDetails = new { Id = mGuideDetails?.Id, Received = mGuideDetails?.Received, Observation = mGuideDetails?.Observation, ReasonId = ClaimReasonSelected!.Id };

            var strmGuideDetails = System.Text.Json.JsonSerializer.Serialize(sGuideDetails);
            var result_PostGuideDetail = await Http.PostAsync($"api/Guide/PostGuideDetail?userId={Useful.userId}", new StringContent($"[{strmGuideDetails}]", null, "application/json"));
            if (result_PostGuideDetail.IsSuccessStatusCode)
            {
                var sucessContent = await result_PostGuideDetail.Content.ReadFromJsonAsync<WebApiResponse<PostResponse>>();
                if (sucessContent?.data is ({ insertedRows: 1 } or { updatedRows: 1 }))
                {
                    var result = await DialogService.ShowDialog(Useful.OkSavedMessage, "Item", "OK", Color.Info, Icons.Material.Filled.Commit);
                    if (!result!.Canceled)
                        MudDialog?.Close(DialogResult.Ok(true));
                }
            }
            else if (result_PostGuideDetail.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                var conflictContent = await result_PostGuideDetail.Content.ReadFromJsonAsync<WebApiResponse<Object?>>();
                await DialogService.ShowDialog(conflictContent?.message!, "Error", "OK", Color.Error, Icons.Material.Filled.Error);
            }
            else
            {
                var errorMessage = await result_PostGuideDetail.Content.ReadAsStringAsync();
                await DialogService.ShowDialog(errorMessage, "Error", "OK", Color.Error, Icons.Material.Filled.Error);
            }
        }
    }
    private void CloseClick(MouseEventArgs args) => MudDialog?.Cancel();

    private string ValidateInteger(int? value)
    {
        var strmsg = (value.HasValue && value < 0) ? $"El valor debe ser mayor o igual a cero" : string.Empty;       
        return strmsg;
    }
    protected override async Task OnInitializedAsync()
    {
        await GetClaimReasons();
        NotReason = mGuideDetails!.Received == mGuideDetails.Quantity;
        if (!NotReason)
        {
            FilterClaimReasons();
        }
    }
    private async Task GetClaimReasons()
    {
        var GetClaimReasonsResult = await Http.GetFromJsonAsync<WebApiResponse<List<Reason>>>("api/SaleOrder/GetClaimReasons");
        if (GetClaimReasonsResult != null)
        {
            ClaimReasons = GetClaimReasonsResult.data;
        }
        await Task.CompletedTask;
    }

    private Task OnClaimReasonValueChanged(Reason selectedReason)
    {
        ClaimReasonSelected = selectedReason;
        return Task.CompletedTask;
    }
    private void FilterClaimReasons()
    { 
        ClaimReasonSelected = null;
        var strType = mGuideDetails!.Received > mGuideDetails?.Quantity ? "S" : "F";
        FilteredClaimReasons = ClaimReasons?.Where(f => f.Type!.ToUpper() == strType).ToList();
    }
    private async Task AfterAsyncChange()
    {
        if (mGuideDetails != null)
        {
            NotReason = (mGuideDetails.Received == mGuideDetails.Quantity);
            if (!NotReason)
            {
                FilterClaimReasons();
            }           
        }       
        await Task.CompletedTask;
    }
}
