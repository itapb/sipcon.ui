@page "/reporting"

@using System.Globalization
@using System.Text.Json
@using Sipcon.WebApp.Client.Repository.Auth
@using System.Dynamic;
@using Sipcon.WebApp.Client.Utils
@using FluentValidation


@inject IReportingService ReportingService
@inject IDialogService DialogService
@inject UtilModuleActions ModuleActionsService
@inject IJSRuntime JSRuntime
@inject NavigationManager UriHelper
@inject HubEventsService hubEventsService
@implements IDisposable


<PageTitle>Reportes</PageTitle>
<CustomBreadcrumbs mItems="_itemsNavigate"></CustomBreadcrumbs>

<MudDataGrid @ref="_mudDataGrid"
             T="ExpandoObject"
             Items="_Report"
            
             SortMode="SortMode.Multiple"
             FixedHeader Height="calc(92vh - 235px)"
             MultiSelection="false"
             Loading="_loading"
             Filterable="true"
             Hideable="true"
             Bordered="false"
             Dense="true"
             Striped="true"
             Hover="true"
            @bind-CurrentPage="_currentPage">
    <ToolBarContent>
       
        <MudTextField @bind-Value="_searchString" 
                      Style="font-size: 14px;line-height: 0.8rem;"
                    Placeholder="buscar" 
                    Adornment="Adornment.Start" 
                    Immediate="true"
                    Typo="Typo.caption"
                    AdornmentIcon="@Icons.Material.Filled.Search"
                    OnAdornmentClick="() => ClickSearch()"
                    IconSize="Size.Medium" Class="mt-0" 
                    OnKeyUp="HandleKeyDownSearch">
        </MudTextField>
        <MudSpacer />
        <div id="scroll_section" class="mx-auto" style="max-width: 600px">
            <MudExpansionPanels Outlined="false" Elevation="0">
                <MudExpansionPanel @bind-Expanded="@_open" HideIcon="true" >
                    <TitleContent>
                        <div class="d-flex">
                            <MudText>Filtrar por: </MudText>
                            <MudIcon Icon="@(_open? Icons.Material.Filled.FilterAltOff  : Icons.Material.Filled.FilterAlt)" Color="Color.Info"></MudIcon>
                        </div>
                    </TitleContent>
                    <ChildContent>
                         <MudStack Row="true">
                            <MudSelect @bind-Value="@_reportingTypeValue"
                                       Style="font-size: 14px;line-height: 0.8rem;min-width: 160px;max-width: 160px;margin-top: -3px;"
                                       Placeholder="Tipo Reporte"
                                       AdornmentColor="Color.Info"
                                       Margin="Margin.Dense"
                                       Disabled="false"
                                       Validation="@_SelectValidator.Validation"
                                       Immediate="true"
                                       Required="true"
                                       RequiredError="Campo Requerido">
                                @foreach (var model in _reportingTypeList)
                                {
                                    <MudSelectItem Value="@model.Value">@model.Text</MudSelectItem>
                                }
                            </MudSelect>
                            <MudDatePicker @ref="_picker"
                                           @bind-Date="_dateFrom"
                                           Style="font-size: 14px;line-height: 0.8rem;min-width: 100px;"
                                           Adornment="Adornment.Start"
                                           AdornmentColor="Color.Info"
                                           Class="align-right"
                                           Placeholder="Fecha Desde"
                                           Variant="Variant.Text"
                                           PickerVariant="PickerVariant.Inline"
                                           Margin="Margin.None"
                                           DateFormat="dd/MM/yyyy"
                                           AutoClose="true">
                                <PickerActions>
                                    <MudButton Class="mr-auto align-self-start" OnClick="@(() => _picker.ClearAsync())">Borrar</MudButton>
                                    <MudButton OnClick="@(() => _picker.CloseAsync(false))">Cancelar</MudButton>
                                </PickerActions>
                            </MudDatePicker>

                            <MudDatePicker @ref="_pickerTo"
                                           @bind-Date="_dateTo"
                                           Style="font-size: 14px;line-height: 0.8rem;min-width: 100px;"
                                           Adornment="Adornment.Start"
                                           AdornmentColor="Color.Info"
                                           Class="align-right"
                                           Placeholder="Fecha Hasta"
                                           Variant="Variant.Text"
                                           PickerVariant="PickerVariant.Inline"
                                           Margin="Margin.None"
                                           DateFormat="dd/MM/yyyy"
                                           AutoClose="true">
                                <PickerActions>
                                    <MudButton Class="mr-auto align-self-start" OnClick="@(() => _pickerTo.ClearAsync())">Borrar</MudButton>
                                    <MudButton OnClick="@(() => _pickerTo.CloseAsync(false))">Cancelar</MudButton>
                                </PickerActions>
                            </MudDatePicker>

                         </MudStack>
                    </ChildContent>
                </MudExpansionPanel>
            </MudExpansionPanels>
            
        </div>
        <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Info" OnClick="() => ClickSearch()"></MudIconButton>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Info" OnClick="() => HandleOnClickRefresh()" />
        <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="Open user menu">
            @foreach (var module in _itemsModules)
            {
                <MudMenuItem Icon="@(module.Icon ?? "")" IconColor="@module.Color"
                Label="@module.Text"
                OnClick="() => HandleMenuClick(module)" />
            }
        </MudMenu>


    </ToolBarContent>
    
        <Columns>
        @foreach (var colName in _columns)
        {
            <TemplateColumn T="ExpandoObject" Title="@colName">
                <CellTemplate>
                    @{
                        var dict = (IDictionary<string, object>)context.Item;
                        <MudText Typo="Typo.caption" Align="Align.Left">@dict[colName]</MudText>
                    }
                </CellTemplate>
            </TemplateColumn>
        }
        </Columns>
        
    <PagerContent>
        <MudDataGridPager  PageSizeOptions="new int[] {100}" InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Registros por Pagina" />
    </PagerContent>
</MudDataGrid>

<NestedDialogCustom IsVisible="@_nestedVisible" Success="@_success" 
                    onCloseNested="() => _nestedVisible = false"
                    ErrorMessage="@_nestedErrorMessage" 
                    Title="@("Reportes")"/>



@code {
    [Inject] private UserSession Session { get; set; } = null!;
    [Inject] private AuthenticationProviderJWT AuthenticationStateProvider { get; set; } = null!;

    private IEnumerable<ExpandoObject> _Report = new List<ExpandoObject>();

    private string _nestedErrorMessage = string.Empty;
    private bool _nestedVisible;
    bool _success = false;
    bool _open;

    private int _currentPage = 0;
    private int _rowCount = 0;
    private int _rowsTotal = 0; 

    private int? _reportingTypeValue = null;
    private string _searchString = string.Empty;
    private DateTime? _dateFrom { get; set; } = null;
    private DateTime? _dateTo { get; set; } = null;
    private bool _loading = true;
    private string _moduleName = "REPORTES-REPORTES";


    IMask maskDate = new DateMask("dd/MM/yyyy");

    private MudDatePicker _picker = new MudDatePicker();
    private MudDatePicker _pickerTo = new MudDatePicker();
    private MudDataGrid<ExpandoObject>? _mudDataGrid;

    private List<ModuleAction> _itemsModules = new List<ModuleAction>([]);
    public IEnumerable<SelectOption> _reportingTypeList { get; set; } = ([]);

    private List<BreadcrumbItem> _itemsNavigate =
                [
        new("Home", href: "", icon: Icons.Material.Filled.Home),
        new("Reportes",href: "", icon: Icons.Material.Filled.ReportProblem),
        new("Reportes",  href: "reporting", disabled: false, icon: Icons.Material.Filled.ReportProblem),
    ];

    List<string> _columns = new();



    // The validation rules (overkill, I know, but very fluent):
    SelectValidator<int> _SelectValidator = new SelectValidator<int>(x => x
        .NotEmpty().NotNull().WithMessage("Campo requerido")
        .GreaterThan(0).WithMessage("Seleccione un Concesionario."));


    protected override async Task OnInitializedAsync()
    {
        await AuthenticationStateProvider.RefreshStaticVariables();

        hubEventsService.OnSupplierChanged += ReloadServerData;
        hubEventsService.OnDealerChanged += ReloadServerData;

        var state = new GridState<ExpandoObject>
        {
            Page = _currentPage,

        };
        await LoadGridData(state);
        await Task.CompletedTask;
    }

    private async Task ReloadServerData()
    {
        if (_mudDataGrid != null)
        {
            _mudDataGrid = new MudDataGrid<ExpandoObject>();
            
            _open = false;
            StateHasChanged();
            var state = new GridState<ExpandoObject>
            {
                Page = 0,

            };
            await LoadGridData(state);
        }
    }

    public void Dispose()
    {
        hubEventsService.OnDealerChanged -= ReloadServerData;
        hubEventsService.OnSupplierChanged -= ReloadServerData;
    }


    private async Task<GridData<ExpandoObject>> LoadGridData(GridState<ExpandoObject> state)
    {
        await AuthenticationStateProvider.RefreshStaticVariables();
        _rowCount = state.Page * state.PageSize;

        _reportingTypeList = await ModuleActionsService.GetReportingType(Session.UserId);

        await GetReporting();

        return new GridData<ExpandoObject> { TotalItems = _rowsTotal, Items = _Report };
    }

    private async Task GetReporting()
    {
        _loading = true;
        _Report = new List<ExpandoObject>();
        _columns = new List<string>();
        _rowsTotal = 0;

        StateHasChanged();

        _itemsModules = await ModuleActionsService.GetModuleActions(Session.UserId, _moduleName);


        string _dateFromStr = string.IsNullOrEmpty(_dateFrom?.ToString()) ? string.Empty : _dateFrom.Value.ToString();
        string _dateToStr = string.IsNullOrEmpty(_dateTo?.ToString()) ? string.Empty : _dateTo.Value.ToString();

        var serviceResponse = await ReportingService.GetReports(_reportingTypeValue ?? 0, Session.SupplierId, Session.UserId, _rowCount, _searchString, _dateFromStr, _dateToStr);
        if (serviceResponse.Processed)
        {
            _Report = serviceResponse.Data;
            _rowsTotal = serviceResponse.Total;

            if (_Report.Any())
            {
                _columns = ((IDictionary<string, object>)_Report.First()).Keys.ToList();
            }
        }
        else
        {
            _success = false;
            _nestedErrorMessage = serviceResponse.Message ?? MessageEnum.GetError.GetStringValue();

            OpenNested();

        }

        _loading = false;
        StateHasChanged();
    }


    private async Task HandleKeyDownSearch(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            if (_searchString.Length >= 3 || _searchString == string.Empty)
            {
                var state = new GridState<ExpandoObject>
                {
                    Page = _currentPage,

                };
                await LoadGridData(state);
            }

        }
    }

    private async Task ClickSearch()
    {
        var state = new GridState<ExpandoObject>
        {
            Page = _currentPage,

        };
        await LoadGridData(state);

    }

    private async Task HandleOnClickRefresh()
    {
        _searchString = string.Empty;
        _dateFrom = null;
        _dateTo = null;
        await _picker.ClearAsync();
        await _pickerTo.ClearAsync();
        _open = false;
        StateHasChanged();
        var state = new GridState<ExpandoObject>
        {
            Page = _currentPage,
            
        };
        await LoadGridData(state);
    }

    private void OpenNested()
    {
        _nestedVisible = true;
        StateHasChanged();
    }


    private async Task HandleMenuClick(ModuleAction module)
    {
        switch (module.ActionName)
        {
            case "EXPORT":
                await ExportItemsAsync();
                break;
            default:
                Console.WriteLine($"{MessageEnum.ActionsError.GetStringValue()}: {module.ActionName}");
                break;
        }
    }

    private async Task ExportItemsAsync()
    {
        string _dateFromStr = string.IsNullOrEmpty(_dateFrom?.ToString()) ? string.Empty : _dateFrom.Value.ToString();
        string _dateToStr = string.IsNullOrEmpty(_dateTo?.ToString()) ? string.Empty : _dateTo.Value.ToString();

        var serviceResponse = await ReportingService.Export(_reportingTypeValue ?? 0, Session.SupplierId,  Session.UserId, _searchString, _dateFromStr, _dateToStr);
        if (serviceResponse.Processed)
        {
            _success = true;
            _nestedErrorMessage = "";

            var base64File = Convert.ToBase64String(serviceResponse.Data.ToArray());
            var fileUrl = $"data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{base64File}";
            await JSRuntime.InvokeVoidAsync("downloadFile", fileUrl, "Reporte.xlsx");
        
        }
        else
        {
            _success = false;
            _nestedErrorMessage = serviceResponse.Message ?? MessageEnum.ExportNotOK.GetStringValue();
            OpenNested();
        }
    }

    public class SelectValidator<T> : AbstractValidator<T>
    {

        public SelectValidator(Action<IRuleBuilderInitial<T, T>> rule)
        {
            rule(RuleFor(x => x));
        }


        private IEnumerable<string> ValidateValue(T arg)
        {
            var result = Validate(arg);
            if (result.IsValid)
                return new string[0];
            return result.Errors.Select(e => e.ErrorMessage);
        }

        public Func<T, IEnumerable<string>> Validation => ValidateValue;

    }
}
