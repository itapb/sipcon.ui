@inject HubEventsService hubEventsService
@implements IDisposable
@using System.Collections.Generic
@using MudBlazor.Utilities
@using Sipcon.WebApp.Client.Models

<MudDataGrid @ref="DataGrid" T="InttPlanta"
             ServerData="@ServerReload"
             Hover FixedHeader
             Groupable
             Height="calc(100vh - 310px)">
    <ToolBarContent>
        <MudTextField T="string"
                      Placeholder="Buscar"
                      Adornment="Adornment.Start"
                      ValueChanged="@(s => OnSearch(s))"
                      Value="searchString"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Medium" />
        <MudSpacer />

        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                       Color="Color.Info"
                       OnClick="ClickRefresh" />
        <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="Open user menu">
            @foreach (var strmodulo in Modules!)
            {
                @if (strmodulo.ActionName == "UNASSIGN")
                {
                    <MudMenuItem Label="@strmodulo.ActionDisplay"
                                 Icon="@(strmodulo.ActionDisplay.ToActionIcon())"
                                 IconColor="@Color.Info"
                                 OnClick="@(() => ClickMenu(strmodulo.ActionName))" />
                }
            }
        </MudMenu>
    </ToolBarContent>

    <Columns>
        <TemplateColumn>
            <HeaderTemplate>
                <MudCheckBox @bind-Value="IsAllCheckBoxSelected"
                             @bind-Value:after="AfterAsyncAllCheck" />
            </HeaderTemplate>
            <CellTemplate>
                <MudCheckBox @bind-Value="@context.Item.IsSelected"
                             @bind-Value:after="() => ToggleSelection(context.Item)" />
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x => x.VNUMBERPLANTATXT"
                        Title="NRO CONTROL PLANTA"
                        Groupable="@(_numberTxtGrouping)"
                        @bind-Grouping="_numberTxtGrouping"
                        GroupBy="_groupBy1"
                        @bind-GroupByOrder="_numberTxtOrder"
                        @bind-GroupExpanded="_numberTxtExpanded">
            <GroupTemplate>
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.TextSnippet"
                             Color="Color.Dark"
                             Size="Size.Small"
                             Class="mr-2" />
                    <span style="font-weight:bold">@context.Grouping.Key</span>
                    <MudChip Variant="Variant.Outlined"
                             Color="Color.Dark"
                             Size="Size.Small"
                             Class="ml-2">
                        @context.Grouping.Count() Registros
                    </MudChip>
                    <MudIconButton Icon="@Icons.Material.Filled.Download"
                                   OnClick="@(() => ClickExportTxt(Convert.ToString(@context.Grouping.Key)))"
                                   Title="Descargar TXT" />\
                    <MudIconButton Icon="@Icons.Material.Filled.SimCardDownload"
                                   Color="Color.Success"
                                   OnClick="@(() => ClickExportExcel(Convert.ToString(@context.Grouping.Key)))"
                                   Title="Descargar Excel" />
                </div>
            </GroupTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.VCERTIFICATENUMBER"
                        Title="NRO CERTIFICADO"
                        Groupable="@(_certificateGrouping)"
                        @bind-Grouping="_certificateGrouping"
                        GroupBy="_groupBy1"
                        @bind-GroupByOrder="_certificateOrder"
                        @bind-GroupExpanded="_certificateExpanded">
            <GroupTemplate>
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Description"
                             Color="Color.Dark"
                             Size="Size.Small"
                             Class="mr-2" />
                    <span style="font-weight:bold">@context.Grouping.Key</span>
                    <MudChip Variant="Variant.Outlined"
                             Color="Color.Dark"
                             Size="Size.Small"
                             Class="ml-2">
                        @context.Grouping.Count() Registros
                    </MudChip>
                </div>
            </GroupTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.VRIF" Title="RIF CLIENTE" Groupable="false" />
        <PropertyColumn Property="x => x.VMODEL" Title="MODELO" Groupable="false" />
        <PropertyColumn Property="x => x.VPLATE" Title="PLACA" Groupable="false" />
        <PropertyColumn Property="x => x.VVIN" Title="VIN" Groupable="false" />
        <PropertyColumn Property="x => x.VCOLOR1" Title="COLOR" Groupable="false" />
        <TemplateColumn Title="FECHA FACTURA">
            <CellTemplate>
                @{
                    var displayDate = context.Item.VSELLINVOICEDATE;
                    if (!string.IsNullOrEmpty(context.Item.VSELLINVOICEDATE) &&
                           context.Item.VSELLINVOICEDATE.Length == 8 &&
                           DateTime.TryParseExact(context.Item.VSELLINVOICEDATE, "yyyyMMdd",
                               System.Globalization.CultureInfo.InvariantCulture,
                               System.Globalization.DateTimeStyles.None,
                               out DateTime parsedDate))
                    {
                        displayDate = parsedDate.ToString("yyyy-MM-dd");
                    }
                }
                <MudText Style="white-space: nowrap; min-width: 110px;">@displayDate</MudText>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.VSELLINVOICENUMBER" Title="NRO FACTURA" Groupable="false" />
    </Columns>

    <PagerContent>
        <MudDataGridPager T="InttPlanta"
                          PageSizeOptions="new int[] { 100 }"
                          InfoFormat="{first_item}-{last_item} de {all_items}"
                          RowsPerPageString="Registros por Pagina" />
    </PagerContent>
</MudDataGrid>

@code {
    [Inject] private UserSession Session { get; set; } = null!;
    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;

    private MudDataGrid<InttPlanta> DataGrid = null!;
    private string? searchString = string.Empty;
    private List<Module>? Modules;
    private CancellationTokenSource? _cts;
    private Func<InttPlanta, object>? _groupBy1 = x => int.TryParse(x.VNUMBERPLANTATXT, out var num) ? num : 0;

    private bool _numberTxtGrouping = true;
    private int _numberTxtOrder = 1;
    private bool _numberTxtExpanded = false;

    private bool _certificateGrouping = false;
    private int _certificateOrder;
    private bool _certificateExpanded = false;

    private bool IsAllCheckBoxSelected = false;
    private HashSet<int> _selectedIds = new HashSet<int>();

    protected override async Task OnInitializedAsync()
    {
        Modules = await Http.GetFromJsonAsync<List<Module>>($"api/Module/GetAll?moduleName=REPORTES-INTT-PLANTA&userId={Session.UserId}");
        hubEventsService.OnSupplierChanged += ReloadGrid;
    }

    private async Task<GridData<InttPlanta>> ServerReload(GridState<InttPlanta> state)
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;

        var offset = state.Page * state.PageSize;
        string url = $"api/InttPlanta/GetGenerados?userId={Session.UserId}&supplierId={Session.SupplierId}&rowFrom={offset}&filter={searchString}";

        try
        {
            var response = await Http.GetAsync(url, token);

            if (token.IsCancellationRequested)
                return new GridData<InttPlanta> { TotalItems = 0, Items = [] };

            if (response.IsSuccessStatusCode)
            {
                var content = await response.Content.ReadFromJsonAsync<WebApiResponse<List<InttPlanta>>>(cancellationToken: token);

                var items = content?.data ?? new List<InttPlanta>();
                foreach (var item in items)
                {
                    item.IsSelected = _selectedIds.Contains(item.Id);
                }

                return new GridData<InttPlanta>
                {
                    TotalItems = content!.total ?? 0,
                    Items = items
                };
            }

            var errorMessage = await response.Content.ReadAsStringAsync(token);
            throw new Exception(errorMessage);
        }
        catch (OperationCanceledException)
        {
            return new GridData<InttPlanta> { TotalItems = 0, Items = [] };
        }
    }

    private void ToggleSelection(InttPlanta item)
    {
        if (item.IsSelected)
            _selectedIds.Add(item.Id);
        else
            _selectedIds.Remove(item.Id);
    }

    private async Task AfterAsyncAllCheck()
    {
        if (DataGrid?.FilteredItems != null)
        {
            var currentItems = DataGrid.FilteredItems.ToList();
            foreach (var item in currentItems)
            {
                item.IsSelected = IsAllCheckBoxSelected;
                if (item.IsSelected)
                    _selectedIds.Add(item.Id);
                else
                    _selectedIds.Remove(item.Id);
            }
            StateHasChanged();
        }
        await Task.CompletedTask;
    }

    private async Task ClickRefresh()
    {
        IsAllCheckBoxSelected = false;
        _selectedIds.Clear();
        if (DataGrid?.FilteredItems != null)
        {
            foreach (var item in DataGrid.FilteredItems)
            {
                item.IsSelected = false;
            }
        }
        await DataGrid!.ReloadServerData();
    }

    private async Task OnSearch(string text)
    {
        if (text.Length == 0 || text.Length >= 3)
        {
            searchString = text;
            _cts?.Cancel();
            _cts = new CancellationTokenSource();
            await DataGrid!.ReloadServerData();
        }
    }

    private async Task ClickExportTxt(string numeroTxt)
    {
        var result = await Http.GetAsync($"api/InttPlanta/ExportTXT?userId={Session.UserId}&supplierId={Session.SupplierId}&controlId={numeroTxt}");

        if (result.IsSuccessStatusCode)
        {
            var fileContent = await result.Content.ReadAsByteArrayAsync();
            var base64File = Convert.ToBase64String(fileContent);
            var fileUrl = $"data:text/plain;base64,{base64File}";
            await JSRuntime.InvokeVoidAsync("downloadFile", fileUrl, $"{numeroTxt.PadLeft(10, '0')}.txt");
        }
        else
        {
            var errorMessage = await result.Content.ReadAsStringAsync();
            await DialogService.ShowDialog(errorMessage, "Error", "OK", Color.Error, Icons.Material.Filled.Error);
        }
    }

    private async Task ReloadGrid()
    {
        if (DataGrid != null)
        {
            await DataGrid.ReloadServerData();
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        hubEventsService.OnSupplierChanged -= ReloadGrid;
    }

    private async Task ClickMenu(string? actionName)
    {
        if (actionName == "UNASSIGN")
        {
            if (DataGrid?.FilteredItems == null)
            {
                await DialogService.ShowDialog(
                    "El grid no ha cargado datos aún",
                    "Error",
                    "OK",
                    Color.Error,
                    Icons.Material.Filled.Error);
                return;
            }

            var selectedItems = DataGrid.FilteredItems
                .Where(item => _selectedIds.Contains(item.Id))
                .ToList();

            if (selectedItems == null || !selectedItems.Any())
            {
                await DialogService.ShowDialog(
                    "Debe seleccionar al menos un registro para desasignar",
                    "Error",
                    "OK",
                    Color.Error,
                    Icons.Material.Filled.Error);
                return;
            }

            var actions = selectedItems.Select(item => new Models.Action
            {
                UserId = Session.UserId,
                RecordId = item.Id,
                ModuleId = Modules?.FirstOrDefault(m => m.ActionName == "UNASSIGN")?.Id,
                ActionName = "UNASSIGN",
                ActionComment = "",
                RelatedId = 0
            }).ToList();

            try
            {
                var response = await Http.PostAsync(
                    $"api/InttPlanta/PostActions?userId={Session.UserId}&supplierId={Session.SupplierId}",
                    new StringContent(System.Text.Json.JsonSerializer.Serialize(actions), null, "application/json"));

                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadFromJsonAsync<WebApiResponse<object>>();

                    if (result != null && result.status == 200)
                    {
                        await DialogService.ShowDialog(
                            $"{selectedItems.Count} registros desasignados exitosamente",
                            "Éxito",
                            "OK",
                            Color.Success,
                            Icons.Material.Filled.CheckCircle);
                    }
                    else
                    {
                        await DialogService.ShowDialog(
                            result?.message ?? "Error al desasignar registros",
                            "Error",
                            "OK",
                            Color.Error,
                            Icons.Material.Filled.Error);
                    }

                    _selectedIds.Clear();
                    IsAllCheckBoxSelected = false;
                    foreach (var item in selectedItems)
                    {
                        item.IsSelected = false;
                    }

                    await DataGrid!.ReloadServerData();
                }
                else
                {
                    var err = await response.Content.ReadAsStringAsync();
                    await DialogService.ShowDialog(err, "Error", "OK", Color.Error, Icons.Material.Filled.Error);
                }
            }
            catch (Exception ex)
            {
                await DialogService.ShowDialog(
                    $"Error al procesar la solicitud: {ex.Message}",
                    "Error",
                    "OK",
                    Color.Error,
                    Icons.Material.Filled.Error);
            }
        }
    }

    private async Task ClickExportExcel(string numeroTxt)
    {
        try
        {
            var url = $"api/InttPlanta/ExportGeneradosExcel?userId={Session.UserId}&supplierId={Session.SupplierId}&controlId={numeroTxt}";

            var response = await Http.GetAsync(url);

            if (response.IsSuccessStatusCode)
            {
                var fileBytes = await response.Content.ReadAsByteArrayAsync();
                var base64 = Convert.ToBase64String(fileBytes);
                var fileUrl = $"data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{base64}";
                await JSRuntime.InvokeVoidAsync("downloadFile", fileUrl, $"CONTROL_{numeroTxt.PadLeft(10, '0')}.xlsx");
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                await DialogService.ShowDialog(err, "Error", "OK", Color.Error, Icons.Material.Filled.Error);
            }
        }
        catch (Exception ex)
        {
            await DialogService.ShowDialog(
                $"Error al exportar Excel: {ex.Message}",
                "Error",
                "OK",
                Color.Error,
                Icons.Material.Filled.Error);
        }
    }
}