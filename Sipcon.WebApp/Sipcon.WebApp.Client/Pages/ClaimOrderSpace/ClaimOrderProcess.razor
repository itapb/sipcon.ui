    <div style="flex-shrink: 0;" class="pa-3 jpv1-dialog-body-background">
        <MudPaper Elevation="2" Class="pa-3">
            <MudFocusTrap Disabled="false" DefaultFocus="DefaultFocus.FirstChild">
                <MudGrid Spacing="2">
                     <MudItem xs="12">
                    <MudFocusTrap Disabled="false" DefaultFocus="DefaultFocus.LastChild">
                    <MudNumericField T="string" HideSpinButtons="true" Label="NRO DE GUIA (REPOSICIÓN)" @bind-Value="NoteCreditGuide" @ref="NoteCreditGuideMudNumericField"></MudNumericField>
                    <MudTextField T="string" Label="NOTA DE CREDITO" @bind-Value="NoteCredit"></MudTextField>                       
                    </MudFocusTrap>
                     </MudItem>
                    <MudItem xs="12">
                        <MudStack Row="true" Justify="Justify.Center">
                            <MudStack Row="true" Spacing="4">
                                <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Check" Size="Size.Medium" OnClick="CheckClick" />
                                <MudFab Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Close" Size="Size.Medium" OnClick="CloseClick" />
                            </MudStack>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </MudFocusTrap>
        </MudPaper>
    </div>


@code {
    [Inject] private UserSession Session { get; set; } = null!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;        
    [Parameter] public Models.Action? mAction { get; set; } = default!;
    private string? NoteCreditGuide { get; set; } = null;
    private string? NoteCredit { get; set; } = null;
    private MudNumericField<string>? NoteCreditGuideMudNumericField;
    private void CloseClick(MouseEventArgs args) => MudDialog?.Cancel();
    private async Task CheckClick(MouseEventArgs args)
    {

        if (await AnyValidFields())
        {
            if (mAction != null)
            {
                mAction.RelatedId = int.Parse(NoteCreditGuide ?? "0");
                mAction.ActionComment = NoteCredit;
            }
            MudDialog?.Close(DialogResult.Ok(true)); //ActionComment
        }
    }
    private async Task<bool> AnyValidFields()
    {
        var result = string.IsNullOrEmpty(NoteCreditGuide) && string.IsNullOrEmpty(NoteCredit);
        if (result) {
            await NoteCreditGuideMudNumericField!.FocusAsync();
            await DialogService.ShowDialog("Requerido algun campo", "Error", "OK", Color.Error, Icons.Material.Filled.Error);            
        }
        return !result;
    }
}

