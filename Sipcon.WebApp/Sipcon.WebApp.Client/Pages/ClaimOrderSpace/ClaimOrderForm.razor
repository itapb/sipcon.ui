<div id="scrollableGridContentStyled" style="overflow-y: auto;  padding: 8px; background-color: #f0f0f0;">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="9">
            <MudStack>
                <MudPaper Elevation="2" Class="pa-2 mud-text-align-center">
                    <MudStack Row="true" StretchItems="StretchItems.Start" Justify="Justify.FlexEnd">
                    <MudStack Row="true" Spacing="2">
                        <MudFab StartIcon="@Icons.Material.Filled.Save" Color="Color.Info" Size="Size.Small" Label="Guardar" OnClick="SaveClick" Disabled="@(!IsCreatedClaimOrder)"></MudFab>
                        <MudButton OnClick="CloseClick">Cerrar</MudButton>
                    </MudStack>

                    </MudStack>
                </MudPaper>
                <MudPaper Elevation="2" Style="height: 100%;">
                    <MudDataGrid @ref="ClaimOrderDetailsMudDataGrid" T="Models.ClaimDetails" ServerData="ServerReload" Filterable="false" FixedHeader Height="calc(100vh - 262px)" Loading="Loading" @bind-CurrentPage="PartCurrentPage">
                        <ToolBarContent>
                            <MudIconButton Icon="@Icons.Material.Filled.PlaylistAdd" Size="Size.Medium" OnClick="ClickAddClaimOrderDetails" Color="Color.Info" Disabled="@(!IsCreatedClaimOrder)"></MudIconButton>
                            <MudIconButton Icon="@Icons.Material.Filled.PlaylistRemove" Size="Size.Medium" OnClick="ClickRemoveClaimOrderDetails" Color="Color.Info" Disabled="@(!IsCreatedClaimOrder)"></MudIconButton>                          
                        </ToolBarContent>
                        <Columns>
                            <TemplateColumn>
                                <HeaderTemplate>
                                    <MudCheckBox @bind-Value="IsAllCheckBoxSelected" @bind-Value:after="AfterAsyncAllCheck" />
                                </HeaderTemplate>
                                <CellTemplate>
                                    <MudCheckBox @bind-Value="context.Item.IsSelected" />
                                </CellTemplate>
                            </TemplateColumn>
                            <PropertyColumn Property="x => x.PartInnerCode" Title="CODIGO" />
                            <PropertyColumn Property="x => x.PartName" Title="DESCRIPCION" />
                            <PropertyColumn Property="x => x.Price" Title="PRECIO $" />
                            <PropertyColumn Property="x => x.Quantity" Title="CANTIDAD" />
                            <PropertyColumn Property="x => x.ReasonDescription" Title="MOTIVO" />
                            <PropertyColumn Property="x => x.StatusName" Title="ESTADO" />
                            <PropertyColumn Property="x => x.RemplacemetInnerCode" Title="COD PARTE REEMPLAZAR" />
                            <PropertyColumn Property="x => x.ReplacemetName" Title="NOMBRE PARTE REEMPLAZAR" />
                            <PropertyColumn Property="x => x.RemplacemetPrice" Title="PRECIO PARTE REEMPLAZAR $" />
                            <PropertyColumn Property="x => x.IApproved" Title="CANTIDAD APROBADA" />
                            <PropertyColumn Property="x => x.Comment" Title="COMENTARIO" />
                            <TemplateColumn StickyRight="true">
                                <CellTemplate>
                                    <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="() => ClickEditClaimOrderDetail(context.Item)" Disabled="@(!IsCreatedClaimOrder)" />
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                    </MudDataGrid>
                </MudPaper>
            </MudStack>
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudStack Style="height: 100%; ">
                <MudPaper Elevation="2" Class="pa-2 mud-text-align-center flex-grow-1">
                    <MudForm @ref="form">
                        <MudGrid Spacing="2">
                            <MudItem xs="12"><MudText Typo="Typo.h6" Color="Color.Info">Datos Generales:</MudText></MudItem>
                            @if (MasterClaimOrder == null)
                            {
                                <MudItem xs="12"><MudTextField T="string" ReadOnly="true" Value="@("Cargando..")" Variant="Variant.Text" /></MudItem>
                            }
                            else
                            {
                                <MudItem xs="12"><MudTextField ReadOnly="true" @bind-Value="MasterClaimOrder.DealerName" Adornment="Adornment.Start" AdornmentText="Concesionario :" Variant="Variant.Text" Class="align-right-input" /></MudItem>                                
                                <MudItem xs="12"><MudTextField ReadOnly="true" @bind-Value="MasterClaimOrder.Id" Adornment="Adornment.Start" AdornmentText="Nro Doc :" Variant="Variant.Text" Class="align-right-input" /></MudItem>
                                <MudItem xs="12"><MudTextField ReadOnly="true" @bind-Value="MasterClaimOrder.DCreated" Adornment="Adornment.Start" AdornmentText="Fecha :" Variant="Variant.Text" Class="align-right-input" /></MudItem>
                                <MudItem xs="12"><MudTextField ReadOnly="true" @bind-Value="MasterClaimOrder.Login" Adornment="Adornment.Start" AdornmentText="Login :" Variant="Variant.Text" Class="align-right-input" /></MudItem>
                                <MudItem xs="12"><MudTextField ReadOnly="true" @bind-Value="MasterClaimOrder.StatusName" Adornment="Adornment.Start" AdornmentText="Estatus :" Variant="Variant.Text" Class="align-right-input" /></MudItem>

                                <MudItem xs="12"><MudTextField ReadOnly="false" @bind-Value="MasterClaimOrder.Reference" Label="Guia de Reclamo" Variant="Variant.Text" RequiredError="Campo requerido." Required="false" /></MudItem>
                                <MudItem xs="12"><MudTextField ReadOnly="false" @bind-Value="MasterClaimOrder.Invoice" Label="Nro de Factura" Variant="Variant.Text" RequiredError="Campo requerido." Required="false" /></MudItem>
                                <MudItem xs="12"><MudTextField ReadOnly="false" @bind-Value="MasterClaimOrder.Guide" Label="Guia de Nota de Credito" Variant="Variant.Text" RequiredError="Campo requerido." Required="false" /></MudItem>
                                <MudItem xs="12"><MudTextField ReadOnly="false" @bind-Value="MasterClaimOrder.Note" Label="Nota de Credito" Variant="Variant.Text" RequiredError="Campo requerido." Required="false" /></MudItem>
                                <MudItem xs="12"><MudTextField ReadOnly="@(!IsCreatedClaimOrder)" @bind-Value="MasterClaimOrder.Comment" Label="Comentario" Variant="Variant.Text" /></MudItem>
                            }

                        </MudGrid>
                    </MudForm>
                </MudPaper>
                <MudPaper Elevation="2" Class="pa-2 mud-text-align-center flex-grow-1">
                    <MudGrid Spacing="2">
                        <MudItem xs="12"><MudText Typo="Typo.h6" Color="Color.Info">Totales:</MudText></MudItem>
                        <MudItem xs="12"><MudTextField ReadOnly="true" Adornment="Adornment.Start" @bind-Value="UnitValue" AdornmentText="Unidad :" Variant="Variant.Text" Class="align-right-input" /></MudItem>
                        <MudItem xs="12"><MudTextField ReadOnly="true" Adornment="Adornment.Start" @bind-Value="ProductValue" AdornmentText="Productos :" Variant="Variant.Text" Class="align-right-input" /></MudItem>
                        <MudItem xs="12"><MudTextField ReadOnly="true" Adornment="Adornment.Start" @bind-Value="CostValue" Format="N2" AdornmentText="Precio $ :" Variant="Variant.Text" Class="align-right-input" /></MudItem>
                    </MudGrid>
                </MudPaper>
                <MudPaper Elevation="2" Class="pa-2 mud-text-align-center flex-grow-0">
                    <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd" StretchItems="StretchItems.Start">
                        <MudFab StartIcon="@Icons.Material.Filled.CheckCircleOutline" Color="Color.Info" Size="Size.Small" Label="Generar" OnClick="GenerateClick" Disabled="@(!IsCreatedClaimOrder)" />
                    </MudStack>
                </MudPaper>
            </MudStack>
        </MudItem>
    </MudGrid>
</div>

<style>
    .align-right-input input {
        text-align: right;
    }
</style>
@code {
    [Inject] private UserSession Session { get; set; } = null!;
    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;
    [Parameter] public int? Value { get; set; }
    [Parameter] public EventCallback<int?> ValueChanged { get; set; }
    [Parameter] public List<SaleOrderType>? ClaimOrderTypes { get; set; }
    DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Large, BackdropClick = false, NoHeader = true };

    string TempReference = "";
    int PartCurrentPage = 0;
    bool IsCreatedClaimOrder = false;


    private int? ClaimOrderId
    {
        get => Value;
        set
        {
            if (Value != value)
            {
                Value = value;
                ValueChanged.InvokeAsync(Value);
            }
        }
    }
    private int UnitValue = 0;
    private int ProductValue = 0;
    private decimal CostValue = 0;
    private bool IsAllCheckBoxSelected = false;
    bool Loading = false;
    private Models.ClaimPart? MasterClaimOrder;
    private MudDataGrid<Models.ClaimDetails>? ClaimOrderDetailsMudDataGrid = new();
    private MudForm? form;


    private MudTextField<string?>? VehicleVinRef;

    private async Task AfterAsyncAllCheck()
    {
        ClaimOrderDetailsMudDataGrid?.FilteredItems.ToList().ForEach(item => item.IsSelected = IsAllCheckBoxSelected);
        await Task.CompletedTask;
    }
    private async Task ClickEditClaimOrderDetail(Models.ClaimDetails item)
    {
       
        var temReference = MasterClaimOrder!.Reference;
        var tempComment = MasterClaimOrder.Comment;

        var tempInvoice = MasterClaimOrder.Invoice;
        var tempGuide = MasterClaimOrder.Guide;
        var tempNote = MasterClaimOrder.Note;


        NewClaimOrderDetails AnewClaimOrderrDetail = new NewClaimOrderDetails
        {
            Id = item.Id ?? 0,
            ReplacementPartId = 0,
            PartId = item.PartId,                                            
            Quantity = item.Quantity ,
            IsActive = item.IsActive ?? false,
            ClaimId = ClaimOrderId,
            ReasonId = item.ReasonId
        };
        var dialogReference = await DialogService.ShowAsync(typeof(PartToClaimOrderDetails), "", new DialogParameters { ["newClaimOrderDetails"] = AnewClaimOrderrDetail }, options);
        if (!((await dialogReference.Result)!.Canceled))
        {
            await ClaimOrderDetailsMudDataGrid!.ReloadServerData(); 

       
            
            MasterClaimOrder!.Reference = temReference;
            MasterClaimOrder.Comment = tempComment;
            MasterClaimOrder.Invoice = tempInvoice;
            MasterClaimOrder.Guide = tempGuide;
            MasterClaimOrder.Note = tempNote;
        }

    }

    private void getTotals(IEnumerable<Models.ClaimDetails> data)
    {       
        UnitValue = data.Sum(x => x.Quantity) ?? 0;
        ProductValue = data.Count();
        CostValue = data.Sum(x => x.SubTotal) ?? 0m;
    }
    Func<Models.ClaimDetails, object> GetSortKeySelector(string sortByPropertyName) => sortByPropertyName switch
    {
        nameof(Models.ClaimDetails.PartInnerCode) => o => o.PartInnerCode ?? "",
        nameof(Models.ClaimDetails.PartName) => o => o.PartName ?? "",     
        nameof(Models.ClaimDetails.Quantity) => o => o.Quantity ?? 0, 
        nameof(Models.ClaimDetails.ReasonDescription) => o => o.ReasonDescription ?? "",
        nameof(Models.ClaimDetails.StatusName) => o => o.StatusName ?? "",
        nameof(Models.ClaimDetails.RemplacemetInnerCode) => o => o.RemplacemetInnerCode ?? "",
        nameof(Models.ClaimDetails.ReplacemetName) => o => o.ReplacemetName ?? "",
        nameof(Models.ClaimDetails.IApproved) => o => o.IApproved ?? 0,
        nameof(Models.ClaimDetails.Comment) => o => o.Comment ?? "",
        _ => null! //o => o.Id ?? 0 // Criterio de ordenación por defecto
    };

    private async Task<GridData<Models.ClaimDetails>> ServerReload(GridState<Models.ClaimDetails> state)
    {
        IsAllCheckBoxSelected = false;
        Loading = true;
        var totalItems = 0;
        var mOffset = state.Page * state.PageSize;
        IEnumerable<ClaimDetails> data;
        HttpResponseMessage response = await Http.GetAsync($"api/Claim/GetClaimWithContext?userId={Session.UserId}&claimId={ClaimOrderId}");
        if (response.IsSuccessStatusCode)
        {
            var content2 = await response.Content.ReadFromJsonAsync<WebApiResponse<MasterClaimOrderDetails>>();
            totalItems = content2!.total ?? 0;
            var masterClaimOrderDetails = content2!.data ?? new MasterClaimOrderDetails();
            MasterClaimOrder = masterClaimOrderDetails.Claim;
            data = masterClaimOrderDetails.Details!;
            IsCreatedClaimOrder = (MasterClaimOrder!.StatusName == "BORRADOR");    
            TempReference = MasterClaimOrder!.Reference ?? "";           
            getTotals(data);

            
        }
        else
        {
            var errorMessage = await response.Content.ReadAsStringAsync();
            throw new Exception(errorMessage);
        }
        if (state.SortDefinitions.FirstOrDefault() is SortDefinition<Models.ClaimDetails> sortDefinition)
        {
            data = data.OrderByDirection(sortDefinition.Descending ? SortDirection.Descending : SortDirection.Ascending, GetSortKeySelector(sortDefinition.SortBy));
        }
        Loading = false;
        StateHasChanged();
        return new GridData<Models.ClaimDetails> { TotalItems = totalItems, Items = data };
    }

    private void CloseClick() => ClaimOrderId = null;

    private async Task ClickAddClaimOrderDetails(MouseEventArgs ev)
    {       
        var temReference = MasterClaimOrder!.Reference;
        var tempComment = MasterClaimOrder.Comment;

        var invoice = MasterClaimOrder.Invoice;
        var guide = MasterClaimOrder.Guide;
        var note = MasterClaimOrder.Note;
    
        var dialogReference = await DialogService.ShowAsync(typeof(ClaimOrderPartsCatalog), "", new DialogParameters { ["ClaimOrderId"] = MasterClaimOrder!.Id }, options);
        if ((await dialogReference.Result) is DialogResult dialogResult && !dialogResult.Canceled)
        {
            await ClaimOrderDetailsMudDataGrid!.ReloadServerData();

                       
            MasterClaimOrder!.Reference = temReference;
            MasterClaimOrder.Comment = tempComment;
            MasterClaimOrder.Invoice = invoice;
            MasterClaimOrder.Guide = guide;
            MasterClaimOrder.Note = note;                
        }

    }
    record ClaimOrderItem(int? Id);
    private async Task ClickRemoveClaimOrderDetails(MouseEventArgs ev)
    {
        var mActions = ClaimOrderDetailsMudDataGrid?.FilteredItems.Where(item => item.IsSelected)
                                                     .Select(item => new ClaimOrderItem(item.Id)).ToList();
        if (mActions?.Count > 0)
            await DeleteClaimOrderDetailAction(mActions);
    }

    private async Task SaveClick(MouseEventArgs args)
    {
        if (ClaimOrderDetailsMudDataGrid?.FilteredItems.Count() == 0)
        {
            await DialogService.ShowDialog("No se puede guardar. Debe agregar al menos un ítem.", "Error", "OK", Color.Error, Icons.Material.Filled.Error);
            return;
        }

        await form!.Validate();
        if (form.IsValid)
        {           
            var strMasterClaimOrder = System.Text.Json.JsonSerializer.Serialize(MasterClaimOrder);
            var result_MasterClaimOrder = await Http.PostAsync($"api/Claim/PostClaim?userId={Session.UserId}", new StringContent($"[{strMasterClaimOrder}]", null, "application/json"));
            if (result_MasterClaimOrder.IsSuccessStatusCode)
            {
                var sucessContent = await result_MasterClaimOrder.Content.ReadFromJsonAsync<WebApiResponse<PostResponse>>();
                if (sucessContent?.data! is ({ insertedRows: 1 } or { updatedRows: 1 }))
                {
                    var result = await DialogService.ShowDialog(Useful.OkSavedMessage, "Guardar", "OK", Color.Info, Icons.Material.Filled.Commit);
                    if (!result!.Canceled)
                        ClaimOrderId = null;                    
                }
            }
            else if (result_MasterClaimOrder.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                var conflictContent = await result_MasterClaimOrder.Content.ReadFromJsonAsync<WebApiResponse<Object?>>();
                await DialogService.ShowDialog(conflictContent?.message!, "Error", "OK", Color.Error, Icons.Material.Filled.Error);
            }
            else
            {
                var errorMessage = await result_MasterClaimOrder.Content.ReadAsStringAsync();
                await DialogService.ShowDialog(errorMessage!, "Error", "OK", Color.Error, Icons.Material.Filled.Error);
            }
        }
    }
    private async Task GenerateClick(MouseEventArgs args)
    {
        var SelectedActions = ClaimOrderDetailsMudDataGrid?.FilteredItems.Count() > 0 ?
                              new Client.Models.Action
                              {
                                  UserId = Session.UserId,
                                  RecordId = ClaimOrderId,
                                  ModuleId = 32,
                                  actionName = "GENERATE",
                                  ActionComment = "",
                                  RelatedId = 0
                              }
                              : null;

        if (SelectedActions is null)
        {
            await DialogService.ShowDialog("No hay detalles para generar reclamo.", "Error", "OK", Color.Error, Icons.Material.Filled.Error);
            return;
        }

        await form!.Validate();
        var IsSuccess = false;
        if (form.IsValid)
        {            
            var strMasterClaimOrder = System.Text.Json.JsonSerializer.Serialize(MasterClaimOrder);
            var result_MasterSalesOrder = await Http.PostAsync($"api/Claim/PostClaim?userId={Session.UserId}", new StringContent($"[{strMasterClaimOrder}]", null, "application/json"));
            if (result_MasterSalesOrder.IsSuccessStatusCode)
            {
                var sucessContent = await result_MasterSalesOrder.Content.ReadFromJsonAsync<WebApiResponse<PostResponse>>();
                IsSuccess = (sucessContent?.data! is ({ insertedRows: 1 } or { updatedRows: 1 }));
            }
            else if (result_MasterSalesOrder.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                var conflictContent = await result_MasterSalesOrder.Content.ReadFromJsonAsync<WebApiResponse<Object?>>();
                await DialogService.ShowDialog(conflictContent?.message!, "Error", "OK", Color.Error, Icons.Material.Filled.Error);
            }
            else
            {
                var errorMessage = await result_MasterSalesOrder.Content.ReadAsStringAsync();
                await DialogService.ShowDialog(errorMessage, "Error", "OK", Color.Error, Icons.Material.Filled.Error);
            }
        }

        if (!IsSuccess)
        {
            return;
        }


        var strMovementActions = System.Text.Json.JsonSerializer.Serialize(SelectedActions);
        var result_PostMovementActions = (SelectedActions is not null) ? await Http.PostAsync($"/api/Claim/PostActionsClaim?userId={Session.UserId}", new StringContent($"[{strMovementActions}]", null, "application/json")) : null;
        if ((result_PostMovementActions?.IsSuccessStatusCode ?? false))
        {
            var rest = result_PostMovementActions.Content.ReadAsStringAsync();
            await DialogService.ShowDialog(Useful.OkSavedMessage, "Accion", "OK", Color.Info, Icons.Material.Filled.Commit);
            ClaimOrderId = null;
        }
        else if (result_PostMovementActions?.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            var conflictContent = await result_PostMovementActions.Content.ReadFromJsonAsync<WebApiResponse<Object?>>();
            await DialogService.ShowDialog(conflictContent?.message!, "Error", "OK", Color.Error, Icons.Material.Filled.Error);
        }
       


    }

    private async Task DeleteClaimOrderDetailAction(List<ClaimOrderItem>? actions)
    {
        var result_Post_Actions = (actions?.Count > 0) ? await Http.PostAsync($"api/Claim/DeleteClaimDetails?userId={Session.UserId}", new StringContent(System.Text.Json.JsonSerializer.Serialize(actions), null, "application/json")) : null;
        if ((result_Post_Actions?.IsSuccessStatusCode ?? false))
        {
            //var rest = result_Post_Actions.Content.ReadAsStringAsync();
            await DialogService.ShowDialog(MessageEnum.DeclineOK.GetStringValue(), "Remover", "OK", Color.Info, Icons.Material.Filled.Commit);
            await ClaimOrderDetailsMudDataGrid!.ReloadServerData();
        }
        else if (result_Post_Actions?.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            var conflictContent = await result_Post_Actions.Content.ReadFromJsonAsync<WebApiResponse<Object?>>();
            await DialogService.ShowDialog(conflictContent?.message!, "Error", "OK", Color.Error, Icons.Material.Filled.Error);
        }
        else
        {
            var errorMessage = await result_Post_Actions!.Content.ReadAsStringAsync() ?? "";
            throw new Exception(errorMessage);
        }
    }

}
