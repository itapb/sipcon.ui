@page "/claimorder"
@inject HubEventsService hubEventsService
@inject UtilModuleActions ModuleActionsService //agregue esto
@implements IDisposable

<CustomBreadcrumbs mItems="ItemsNavigate"></CustomBreadcrumbs>
@if (ClaimOrderId != null)
{
    <ClaimOrderForm @bind-Value="ClaimOrderId" Modules="Modules" />
}
else
{
    <MudDataGrid @ref="ClaimOrderMudDataGrid" T="Models.ClaimPart" ServerData="ServerReload" Striped="true" Hover="true" Filterable="false" FixedHeader Height="calc(100vh - 240px)" Loading="Loading" @bind-CurrentPage="ReceptionCurrentPage">
        @*  <ToolBarContent>
            <MudIconButton Icon="@Icons.Material.Filled.AddCard" Color="Color.Info" OnClick="ClickNewClaimOrder"></MudIconButton>
            <MudTextField T="string" Placeholder="Buscar" Adornment="Adornment.Start" ValueChanged="@(s => OnSearch(s))" Value="searchString" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Info" OnClick="ClickRefreshClaimOrder"></MudIconButton>
            <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="Open user menu">
                @foreach (var strmodulo in Modules!)
                {
                    <MudMenuItem Label="@strmodulo.ActionDisplay" Icon="@(strmodulo.ActionDisplay.ToActionIcon())" IconColor="@Color.Info" OnClick="@(() => ClickMenuClaimOrder(strmodulo.ActionName))" />
                }
            </MudMenu>
        </ToolBarContent> *@
        <ToolBarContent>
            <MudIconButton Icon="@Icons.Material.Filled.AddCard" Color="Color.Info" OnClick="ClickNewClaimOrder"></MudIconButton>
            <MudTextField T="string"
                          Value="searchString"
                          ValueChanged="@(s => OnSearch(s))"
                          Placeholder="Buscar"
                          Adornment="Adornment.Start"
                          IconSize="Size.Medium"
                          Class="mt-0"
                          Style="font-size: 14px; line-height: 0.8rem;"
                          Immediate="true"
                          Typo="Typo.caption">
            </MudTextField>
            <MudSpacer />
            <div id="scroll_section" class="mx-auto" style="max-width: 650px">
                <MudExpansionPanels Outlined="false" Elevation="0">
                    <MudExpansionPanel @bind-Expanded="@_open" HideIcon="true">
                        <TitleContent>
                            <div class="d-flex">
                                <MudIcon Icon="@(_open? Icons.Material.Filled.FilterAltOff  : Icons.Material.Filled.FilterAlt)" Color="Color.Info"></MudIcon>
                            </div>
                        </TitleContent>
                        <ChildContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
                                <MudDatePicker @ref="_picker"
                                               @bind-Date="_dateFrom"
                                               Style="font-size: 14px;line-height: 0.8rem;min-width: 120px;"
                                               Adornment="Adornment.Start"
                                               AdornmentColor="Color.Info"
                                               Class="align-right"
                                               Placeholder="Fecha Desde"
                                               Variant="Variant.Text"
                                               PickerVariant="PickerVariant.Inline"
                                               Margin="Margin.None"
                                               DateFormat="dd/MM/yyyy"
                                               AutoClose="true">
                                    <PickerActions>
                                        <MudButton Class="mr-auto align-self-start" OnClick="@(() => _picker.ClearAsync())">Borrar</MudButton>
                                        <MudButton OnClick="@(() => _picker.CloseAsync(false))">Cancelar</MudButton>
                                    </PickerActions>
                                </MudDatePicker>

                                <MudDatePicker @ref="_pickerTo"
                                               @bind-Date="_dateTo"
                                               Style="font-size: 14px;line-height: 0.8rem;min-width: 120px;"
                                               Adornment="Adornment.Start"
                                               AdornmentColor="Color.Info"
                                               Class="align-right"
                                               Placeholder="Fecha Hasta"
                                               Variant="Variant.Text"
                                               PickerVariant="PickerVariant.Inline"
                                               Margin="Margin.None"
                                               DateFormat="dd/MM/yyyy"
                                               AutoClose="true">
                                    <PickerActions>
                                        <MudButton Class="mr-auto align-self-start" OnClick="@(() => _pickerTo.ClearAsync())">Borrar</MudButton>
                                        <MudButton OnClick="@(() => _pickerTo.CloseAsync(false))">Cancelar</MudButton>
                                    </PickerActions>
                                </MudDatePicker>

                                <MudSelect T="SelectOption"
                                           @bind-Value="_selectedAction"
                                           ToStringFunc="@(e => e?.Text)"
                                           Placeholder="ESTATUS"
                                           AdornmentIcon="@Icons.Material.Filled.FilterList"
                                           AdornmentColor="Color.Info"
                                           Style="font-size: 14px; width: 160px;"
                                           Variant="Variant.Text"
                                           Clearable="true"
                                           Dense="true">
                                    @if (_actions != null)
                                    {
                                        @foreach (var action in _actions)
                                        {
                                            <MudSelectItem T="SelectOption" Value="@action">@action.Text</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudStack>
                        </ChildContent>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Info" OnClick="ClickRefreshClaimOrder"></MudIconButton>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Info" OnClick="ClickRefreshClaimOrder" />
            <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="Open user menu">
                @foreach (var strmodulo in Modules!)
                {
                    <MudMenuItem Label="@strmodulo.ActionDisplay" Icon="@(strmodulo.ActionDisplay.ToActionIcon())" IconColor="@Color.Info" OnClick="@(() => ClickMenuClaimOrder(strmodulo.ActionName))" />
                }
            </MudMenu>
        </ToolBarContent>
        <Columns>
            <TemplateColumn>
                <HeaderTemplate>
                    <MudCheckBox @bind-Value="IsAllCheckBoxSelected" @bind-Value:after="AfterAsyncAllCheck" />
                </HeaderTemplate>
                <CellTemplate>
                    <MudCheckBox @bind-Value="context.Item.IsSelected" />
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Id" Title="NRO RECLAMO" />
            <PropertyColumn Property="x => x.Reference" Title="NRO GUIA" />
            <PropertyColumn Property="x => x.Invoice" Title="NRO FACTURA" />
            <PropertyColumn Property="x => x.DCreated" Title="FECHA CREACIÓN" Format="dd/MM/yyyy" />
            <PropertyColumn Property="x => x.PartInnerCode" Title="CODIGO REPUESTO" />
            <PropertyColumn Property="x => x.PartName" Title="DESCRIPCION REPUESTO" />
            <PropertyColumn Property="x => x.Quantity" Title="CANTIDAD RECLAMADA" />
            <PropertyColumn Property="x => x.ReasonDescription" Title="MOTIVO RECLAMO" />
            <TemplateColumn>
                <HeaderTemplate>
                    NOTA CREDITO
                </HeaderTemplate>
                <CellTemplate>
                    @if ((context.Item.StatusName?.ToUpper() == "APROBADO" || context.Item.StatusName?.ToUpper() == "PROCESADO") && (context.Item.ReasonDescription?.ToUpper() == "FALTANTE" || context.Item.ReasonDescription?.ToUpper() == "MAL ESTADO"))
                    {
                        <MudIcon Icon="@(context.Item.Credit ?? false ? Icons.Material.Filled.VerifiedUser : Icons.Material.Filled.Dangerous)"
                                 Color="@(context.Item.Credit ?? false ? Color.Success : Color.Error)"
                                 Size="Size.Medium" />
                    }
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.DealerName" Title="CONCESIONARIO" />
            <PropertyColumn Property="x => x.Login" Title="USUARIO" />
            <PropertyColumn Property="x => x.StatusName" Title="ESTATUS" />
            @*             <TemplateColumn>
                <CellTemplate>
                    <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Print" OnClick="() => ClickPrintClaimOrder(context.Item)" />
                </CellTemplate>
            </TemplateColumn> *@
            <TemplateColumn StickyRight="true">
                <CellTemplate>
                    <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="() => ClickEditClaimOrder(context.Item)" />
                </CellTemplate>
            </TemplateColumn>

        </Columns>
        <PagerContent>
            <MudDataGridPager T="Models.ClaimPart" PageSizeOptions="new int[] { 100 }" InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Registros por Pagina" />
        </PagerContent>
    </MudDataGrid>
}

