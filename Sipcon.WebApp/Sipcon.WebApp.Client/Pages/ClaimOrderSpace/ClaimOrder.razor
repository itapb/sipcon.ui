    private async Task<GridData<Models.ClaimPart>> ServerReload(GridState<Models.ClaimPart> state)
    {
        await AuthenticationStateProvider.RefreshStaticVariables();
        Session.IsNewOrEdit = false;
        IsAllCheckBoxSelected = false;
        Loading = true;
        var totalItems = 0;

        //AGREGUE ESTO
        int? idRespaldado = _selectedAction?.Value;
        if (idRespaldado.HasValue && _actions != null) { _selectedAction = _actions.FirstOrDefault(x => x.Value == idRespaldado); }
        int? _estatusid = _selectedAction?.Value;
        string _dateFromStr = _dateFrom?.ToString("yyyy-MM-dd") ?? string.Empty;
        string _dateToStr = _dateTo?.ToString("yyyy-MM-dd") ?? string.Empty;

        var mOffset = state.Page * state.PageSize;
        IEnumerable<Models.ClaimPart> data;

        HttpResponseMessage response = await Http.GetAsync($"api/Claim/GetAllClaims?userId={Session.UserId}&supplierId={Session.SupplierId}&dealerId={Session.DealerId}&rowfrom={mOffset}&filter={searchString}&fromDate={_dateFromStr}&upToDate={_dateToStr}&estatusId={_estatusid}");//

        if (response.IsSuccessStatusCode)
        {
            var content2 = await response.Content.ReadFromJsonAsync<WebApiResponse<List<Models.ClaimPart>>>();
            totalItems = content2!.total ?? 0;
            data = content2!.data ?? new List<Models.ClaimPart>();

            if (state.SortDefinitions.FirstOrDefault() is SortDefinition<Models.ClaimPart> sortDefinition)
            {
                data = data.OrderByDirection(sortDefinition.Descending ? SortDirection.Descending : SortDirection.Ascending, GetSortKeySelector(sortDefinition.SortBy));
            }
        }
        else
        {
            data = new List<Models.ClaimPart>();
            var errorMessage = await response.Content.ReadAsStringAsync();
            Logger.LogError(Session.TemplateLog(RequisitionTitle, errorMessage));
            await DialogService.ShowUnexpected();
        }

        Loading = false;
        return new GridData<Models.ClaimPart> { TotalItems = totalItems, Items = data };
    }
    private async Task ClickMenuClaimOrder(string? actionName)
    {
        //fechas y filtros
        _actions = await ModuleActionsService.GetAction(Session.UserId, "PEDIDOS-RECLAMOS");
        int? idRespaldado = _selectedAction?.Value;
        if (idRespaldado.HasValue && _actions != null) { _selectedAction = _actions.FirstOrDefault(x => x.Value == idRespaldado); }
        int? _estatusid = _selectedAction?.Value;
        string _dateFromStr = _dateFrom?.ToString("yyyy-MM-dd") ?? string.Empty;
        string _dateToStr = _dateTo?.ToString("yyyy-MM-dd") ?? string.Empty;

        // if (actionName == "EXPORT" && ClaimOrderMudDataGrid?.FilteredItems.Count() > 0)
        // {
        //     Loading = true;
        //     // var ResultZonas = await Http.GetAsync($"api/SaleOrder/ExportExcelsaleOrder?filter={searchString}&userId={Session.UserId}&supplierId={Session.SupplierId}");

        //     var ResultZonas = await Http.GetAsync($"api/SaleOrder/GetExportResume?userId={Session.UserId}&supplierId={Session.SupplierId}&dealerId={Session.DealerId}");

        //     if (ResultZonas.IsSuccessStatusCode)
        //     {
        //         var fileContent = await ResultZonas.Content.ReadAsByteArrayAsync();
        //         var base64File = Convert.ToBase64String(fileContent);
        //         var fileUrl = $"data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{base64File}";
        //         await JSRuntime.InvokeVoidAsync("downloadFile", fileUrl, "Pedidos.xlsx");
        //     }
        //     Loading = false;
        //     return;
        // }
        if (actionName == "EXPORT" && ClaimOrderMudDataGrid?.FilteredItems.Count() > 0)
        {
            Loading = true;
            var ResultZonas = await Http.GetAsync($"api/Claim/ExportClaims?userId={Session.UserId}&supplierId={Session.SupplierId}&dealerId={Session.DealerId}&filter={searchString}&fromDate={_dateFromStr}&upToDate={_dateToStr}&estatusId={_estatusid}");

            if (ResultZonas.IsSuccessStatusCode)
            {
                var fileContent = await ResultZonas.Content.ReadAsByteArrayAsync();
                var base64File = Convert.ToBase64String(fileContent);
                var fileUrl = $"data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{base64File}";
                await JSRuntime.InvokeVoidAsync("downloadFile", fileUrl, "Reclamos.xlsx");
            }
            Loading = false;
            return;
        }

        var strDictionary = new Dictionary<string, string> {{ "GENERATE", "BORRADOR" }, { "TOAPPROVE", "BORRADOR" }, { "PROCESS", "APROBADO" }, { "DECLINE", "BORRADOR,PARA APROBAR" }, { "APPROVE", "PARA APROBAR" } };
        var mActions = ClaimOrderMudDataGrid?.FilteredItems.Where(item => item.IsSelected && strDictionary[actionName!].Contains(item!.StatusName!.ToUpper()))
                                                         .Select(item => new Client.Models.Action
                                                         {
                                                             UserId = Session.UserId,
                                                             RecordId = item.Id,
                                                             ModuleId = Modules!.FirstOrDefault()?.Id,
                                                             actionName = actionName,
                                                             ActionComment = "",
                                                             RelatedId = 1
                                                         }).ToList();

        if (mActions?.Count == 0 || (actionName == "PROCESS" && mActions?.Count > 1))
        {
            await DialogService.ShowDialog("Accion no permitida, Verificar datos seleccionado(s)", "Error", "OK", Color.Error, Icons.Material.Filled.Error);
        }
        else if (actionName == "PROCESS" && mActions?.Count == 1)
        {
            var dialogReference = await DialogService.ShowAsync(typeof(ClaimOrderProcess), "", new DialogParameters { ["mAction"] = mActions.FirstOrDefault() }, options);
            if (!((await dialogReference.Result)!.Canceled))
            {
                await PostActionAndReload(mActions, $"api/Claim/PostActionsClaim?userId={Session.UserId}");
            }
        }
        else if (mActions?.Count > 0)
        {
            await PostActionAndReload(mActions, $"api/Claim/PostActionsClaim?userId={Session.UserId}");
        }

    }
    private async Task PostActionAndReload(List<Models.Action>? actions, string requesturi)
    {
        var result_Post_Actions = (actions?.Count > 0) ? await Http.PostAsync(requesturi, new StringContent(System.Text.Json.JsonSerializer.Serialize(actions), null, "application/json")) : null;
        if ((result_Post_Actions?.IsSuccessStatusCode ?? false))
        {
            var rest = result_Post_Actions.Content.ReadAsStringAsync();
            await DialogService.ShowDialog(Useful.OkSavedMessage, "Accion", "OK", Color.Info, Icons.Material.Filled.Commit);
            await ClaimOrderMudDataGrid!.ReloadServerData();
        }
        else if (result_Post_Actions?.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            var conflictContent = await result_Post_Actions.Content.ReadFromJsonAsync<WebApiResponse<Object?>>();
            await DialogService.ShowDialog(conflictContent?.message!, "Error", "OK", Color.Error, Icons.Material.Filled.Error);
        }
        else
        {
            var errorMessage = await result_Post_Actions!.Content.ReadAsStringAsync() ?? "";
            Logger.LogError(Session.TemplateLog(RequisitionTitle, errorMessage));
            await DialogService.ShowUnexpected(); ;
        }
    }
    private async Task ReloadSalesOrderGrid()
    {
        if (ClaimOrderMudDataGrid != null && ClaimOrderId == null)
        {
            await ClaimOrderMudDataGrid.ReloadServerData();
        }
    }
    public void Dispose()
    {
        Session.IsNewOrEdit = false;
        hubEventsService.OnDealerChanged -= ReloadSalesOrderGrid;
        hubEventsService.OnSupplierChanged -= ReloadSalesOrderGrid;
    }
