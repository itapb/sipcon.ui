    string RequisitionTitle = "";

    public List<SaleOrderType>? SaleOrderTypes;

    private async Task LoadSaleOrderTypes()
    {
        var SaleOrderTypesResult = await Http.GetFromJsonAsync<WebApiResponse<List<SaleOrderType>>>("api/SaleOrder/GetSaleOrderTypes");
        SaleOrderTypes = SaleOrderTypesResult?.data ?? new List<SaleOrderType>();
    }

    private async Task OnSearch(string text)
    {
        if (text.Length == 0 || text.Length >= 3)
        {
            Loading = true;
            searchString = text;
            await ClaimOrderMudDataGrid!.ReloadServerData();
        }
    }
    private async Task ClickRefreshClaimOrder(MouseEventArgs args) => await ClaimOrderMudDataGrid!.ReloadServerData();
    private async Task ClickNewClaimOrder(MouseEventArgs ev)
    {
        HttpResponseMessage response = await Http.GetAsync($"api/Claim/NewClaimWithContext?userId={Session.UserId}&dealerId={Session.DealerId}"); //&supplierId={Session.SupplierId}&typeId={TypeId!.ToUpper()}
        if (response.IsSuccessStatusCode)
        {
            var content2 = await response.Content.ReadFromJsonAsync<WebApiResponse<MasterClaimOrderDetails>>();
            var data = content2!.data ?? new MasterClaimOrderDetails();
            Session.IsNewOrEdit = true;
            ClaimOrderId = data.Claim?.Id;
        }
        else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            var conflictContent = await response.Content.ReadFromJsonAsync<WebApiResponse<Object?>>();
            await DialogService.ShowDialog(conflictContent?.message!, "Error", "OK", Color.Error, Icons.Material.Filled.Error);
        }
        else
        {
            var errorMessage = await response.Content.ReadAsStringAsync();
            Logger.LogError(Session.TemplateLog(RequisitionTitle, errorMessage));
            await DialogService.ShowDialog(errorMessage, "Error", "OK", Color.Error, Icons.Material.Filled.Error);
        }
        await Task.CompletedTask;
    }
    private async Task AfterAsyncAllCheck()
    {
        ClaimOrderMudDataGrid?.FilteredItems.ToList().ForEach(item => item.IsSelected = IsAllCheckBoxSelected);
        await Task.CompletedTask;
    }
    private async Task ClickEditClaimOrder(Models.ClaimPart item)
    {
        Session.IsNewOrEdit = true;
        await Task.FromResult(ClaimOrderId = item.Id);
    }
    private async Task ClickPrintClaimOrder(Models.ClaimPart item)
    {
        Loading = true;
        var ResultZonas = await Http.GetAsync($"api/SaleOrder/ExportSaleOrder?saleOrderId={item.Id}&userId={Session.UserId}");
        if (ResultZonas.IsSuccessStatusCode)
        {
            var fileContent = await ResultZonas.Content.ReadAsByteArrayAsync();
            var base64File = Convert.ToBase64String(fileContent);
            var fileUrl = $"data:application/pdf;base64,{base64File}";
            await JSRuntime.InvokeVoidAsync("downloadFile", fileUrl, $"Pedido{item.Id}.pdf");
        }
        Loading = false;
    }
    protected override async Task OnInitializedAsync()
    {
        await AuthenticationStateProvider.RefreshStaticVariables();
        await LoadDataAsync();
        hubEventsService.OnDealerChanged += ReloadSalesOrderGrid;
        hubEventsService.OnSupplierChanged += ReloadSalesOrderGrid;
    }

    private async Task LoadDataAsync()
    {
        RequisitionTitle = "Reclamo";
        string hrefMovement = "claimorder";

        $"Home,Pedidos,{RequisitionTitle}".Split(',').ToList().ForEach(s => ItemsNavigate.Add(new BreadcrumbItem(s, href: (s == "Home" ? "" : hrefMovement), icon: s.ToActionIcon())));
        Modules = await Http.GetFromJsonAsync<List<Module>>($"api/Module/GetAll?moduleName=PEDIDOS-RECLAMOS&userId={Session.UserId}");
        //await LoadSaleOrderTypes();
        _actions = await ModuleActionsService.GetAction(Session.UserId, "PEDIDOS-RECLAMOS"); //AGREGUE ESTO
    }
    Func<Models.ClaimPart, object> GetSortKeySelector(string sortByPropertyName) => sortByPropertyName switch
    {
        nameof(Models.ClaimPart.Id) => o => o.Id ?? 0,
        nameof(Models.ClaimPart.DCreated) => o => o.DCreated ?? DateTime.Now,
        nameof(Models.ClaimPart.DealerName) => o => o.DealerName ?? "",
        nameof(Models.ClaimPart.Login) => o => o.Login ?? "",
        nameof(Models.ClaimPart.StatusName) => o => o.StatusName ?? "",
        _ => null! //o => o.Id ?? 0 // Criterio de ordenación por defecto
    };

