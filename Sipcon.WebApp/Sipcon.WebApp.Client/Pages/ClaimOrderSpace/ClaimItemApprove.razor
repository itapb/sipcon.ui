
    <div style="flex-shrink: 0;" class="pa-3 jpv1-dialog-body-background">
        <MudPaper Elevation="2" Class="pa-3">
            <MudFocusTrap Disabled="false" DefaultFocus="DefaultFocus.FirstChild">
                <MudGrid Spacing="2">
                    <MudItem xs="12">
                        <MudTextField T="string" ReadOnly="true" Variant="Variant.Filled" Label="CODIGO" @bind-Value="ClaimItem?.PartInnerCode"></MudTextField>
                        <MudTextField T="string" ReadOnly="true" Variant="Variant.Filled" Label="DESCRIPCION" @bind-Value="ClaimItem?.PartName"></MudTextField>
                        <MudFocusTrap Disabled="false" DefaultFocus="DefaultFocus.FirstChild">
                            <MudStack Row="true" Spacing="2">
                                <MudNumericField T="int?" HideSpinButtons="true" Label="@TransactionQuantityTitle" @bind-Value="ApproveQuantity" @ref="TransactionQuantityMudNumericField"></MudNumericField>
                                <MudNumericField T="int?" HideSpinButtons="true" Label="@ApproveQuantityTitle" @bind-Value="TransactionQuantity"></MudNumericField>
                            </MudStack>
                            
                            <MudTextField T="string" Label="COMENTARIO" @bind-Value="Comment" ></MudTextField>
                         </MudFocusTrap>
                    </MudItem>
                    <MudItem xs="12">
                        <MudStack Row="true" Justify="Justify.Center">
                            <MudStack Row="true" Spacing="4">
                                <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Check" Size="Size.Medium" OnClick="CheckClick" />
                                <MudFab Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Close" Size="Size.Medium" OnClick="CloseClick" />
                            </MudStack>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </MudFocusTrap>
        </MudPaper>
    </div>


@code {
    [Inject] private UserSession Session { get; set; } = null!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Models.Action? mAction { get; set; } = default!;


    [Parameter] public Models.ClaimDetails? ClaimItem { get; set; } = default!;

    DialogOptions options = new DialogOptions { MaxWidth = MaxWidth.Large, BackdropClick = false, NoHeader = true };

    private int? TransactionQuantity { get; set; } = default!;
    private int? ApproveQuantity { get; set; } = default!;

    private String? TransactionQuantityTitle { get; set; } = default!;
    private String? ApproveQuantityTitle { get; set; } = default!;
    private String? Comment { get; set; } = "";
 
    private MudNumericField<int?>? TransactionQuantityMudNumericField;

    private void CloseClick(MouseEventArgs args) => MudDialog?.Cancel();    

    private async Task CheckClick(MouseEventArgs args)
    {       
        if (IsQuantityValid())
        {
            if (ClaimItem?.ReasonDescription == "NO APLICA")
            {
                mAction!.RelatedId = 0;
            }
            else
            {
                mAction!.RelatedId = ApproveQuantity > 0 ? ClaimItem?.PartId ?? 0 : 0;
            }
            mAction?.ActionComment = Comment;
            mAction?.ApproveQuantity = ApproveQuantity ?? 0;
            mAction?.TransactionQuantity = TransactionQuantity ?? 0;
            MudDialog?.Close(DialogResult.Ok(true)); //ActionComment
        }else
        {
            await TransactionQuantityMudNumericField!.FocusAsync();
            await DialogService.ShowDialog($"Debe responder por la totalidad de la cantidad reclamada ({(ClaimItem?.Quantity ?? 0)}). No se permite respuesta parcial.", "Error", "OK", Color.Error, Icons.Material.Filled.Error);
        }
    }

    private void SetTitle()
    {

        if ("SOBRANTE,NO SOLICTADO".Contains(ClaimItem?.ReasonDescription ?? ""))
        {            
            TransactionQuantityTitle = "CANT. INGRESAR";
            ApproveQuantityTitle = "CANT. FACTURAR";
        }        
        else if ("FALTANTE,MAL ESTADO, MAL FUNCIONAMIENTO".Contains(ClaimItem?.ReasonDescription ?? ""))
        {
            TransactionQuantityTitle = "CANT. REPONER";
            ApproveQuantityTitle = "CANT. NOTA";            
        }
        else if (ClaimItem?.ReasonDescription == "NO APLICA")
        {
            TransactionQuantityTitle = "CANT. REPONER";
            ApproveQuantityTitle = "CANT. NOTA";
        }

        if (mAction != null)
        {
            Comment = mAction.ActionComment;
            TransactionQuantity = mAction.TransactionQuantity;
            ApproveQuantity = mAction.ApproveQuantity;
        }

        // 3. SOLO si es NO APLICA y NO hay mAction, forzar valores por defecto
        if (ClaimItem?.ReasonDescription == "NO APLICA" && mAction == null)
        {
            ApproveQuantity = ClaimItem?.Quantity ?? 0;
        }
    }
    protected override void OnInitialized()
    {
        SetTitle();
        base.OnInitialized();
    } 
    private bool IsQuantityValid()
    {       
        var QuantitySum = (ApproveQuantity ?? 0) + (TransactionQuantity ?? 0);
        return (QuantitySum > 0 && QuantitySum == (ClaimItem?.Quantity ?? 0));         
    }
}
