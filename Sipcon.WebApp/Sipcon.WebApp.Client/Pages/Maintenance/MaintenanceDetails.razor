    private string GetTripleLineStyle(bool isSelected)
    {
        if (isSelected)
        {
            // Fondo amarillo suave, texto oscuro, borde izquierdo y padding para que no se pegue
            return "font-size: 11px; background-color: #fff9c4; color: #333; border-left: 3px solid #fbc02d; padding-left: 4px; width: fit-content; border-radius: 2px; font-weight: bold;";
        }
        return "font-size: 11px; color: var(--mud-palette-text-secondary);";
    }
    private Color GetTimelineColor(string status)
    {
        return status switch
        {
            "VALIDO" => Color.Success,
            "NO VALIDO" => Color.Error,
            "PENDIENTE" => Color.Info,
            "NO REGISTRADO" => Color.Warning,
            "SRAN" => Color.Default,
            _ => Color.Default
        };
    }

