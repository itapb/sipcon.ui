                        </MudCardHeader>
                        <MudCardContent Style="padding-top: 0px;">
                            <MudFlexBreak />

                            <div class="d-flex align-end justify-space-between mud-width-full">
                                <div class="d-flex flex-column">
                                    @if (_modelPolicy.EstatusId != null)
                                    {
                                        <MudText Typo="Typo.caption"><b>Nro. Poliza: </b> <MudText Typo="Typo.caption" Color="Color.Info">@(!string.IsNullOrEmpty(_modelPolicy.Id.ToString()) ? " #" + _model.NumberPolicy : "")</MudText></MudText>
                                        <MudDivider />
                                    }
                                </div>
                            </div>

                            
                            <MudContainer Class="dialog-background-surface py-1 pt-0 pa-1">
                            <MudTimeline TimelinePosition="TimelinePosition.Start">
                                @foreach (var item in _policyDetail)
