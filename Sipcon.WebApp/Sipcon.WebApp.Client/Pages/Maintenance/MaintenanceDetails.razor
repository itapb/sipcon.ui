                                            @("Desde: " + item.FromDate?.ToString("dd MMM yyyy") + " - Hasta: " + item.UpToDate?.ToString("dd MMM yyyy"))
                                        </MudText>

                                        @* Tercera línea: Resaltado tipo 'badge' o marcador si es el actual *@
                                        <MudText Typo="Typo.body2" Style="@GetTripleLineStyle(isCurrentService)">
                                            @("Km: " + item.KM?.ToString("N0") + " - " + item.Date?.ToString("dd MMM yyyy") + " - Servicio: " + item.ServiceId?.ToString("N0"))
                                        </MudText>

                                    </MudTimelineItem>
                                }
                            </MudTimeline>
                        </MudContainer>
                            
                        </MudCardContent>

                    </MudCard>
                    <MudScrollToTop TopOffset="100"
                                    Selector="#scroll_section_policydetail"
