                                                 Variant="Variant.Text"
                                                 Margin="Margin.Dense"
                                                 HideSpinButtons="true"
                                                 ReadOnly="true" />
                            </MudStack>

                            <MudDivider />

                            <MudTextField Typo="Typo.caption" @bind-Value="_model.DealerReport"
                                          Label="Reporte Concesionario"
