                        </MudCardContent>
                    </MudCard>

                </MudItem>
   
                <MudItem xs="12" sm="4">
                    @* Datos Poliza *@
                     <div id="scroll_section_policydetail" class="ma-0" style="height:285px;overflow: auto;">
                        <MudCard Elevation="2" Class="pa-1 mt-2" Style="min-height:280px;">
                        <MudCardHeader>
                            <CardHeaderContent>

                                <MudGrid Spacing="0" Justify="Justify.Center">
