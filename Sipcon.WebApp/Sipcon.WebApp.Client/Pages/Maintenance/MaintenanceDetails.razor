                                        style += ";background-color:#0099F3";
                                    }
                                    else if (_modelPolicy.EstatusName.ToUpper() == "PROCESADO")
                                    {
                                        style += "color:#fff";
                                        style += ";background-color:#757575";
                                    }
                                    else
