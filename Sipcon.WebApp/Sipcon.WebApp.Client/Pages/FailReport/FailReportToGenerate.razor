
@using Sipcon.WebApp.Client.Components.FailReport
@using System.Text.Json
@using Sipcon.WebApp.Client.Repository.Auth


@inject IFailReportService FailReportService
@inject IDialogService DialogService
@inject UtilModuleActions ModuleActionsService
@inject IJSRuntime JSRuntime
@inject NavigationManager UriHelper
@inject HubEventsService hubEventsService
@implements IDisposable



<MudDataGrid @ref="_mudDataGrid"
             T="FailReport"
             MultiSelection="true" 
             SelectedItems="@selectedFailReport"
             SortMode="SortMode.Multiple"
             Filterable="true"
             FixedHeader Height="calc(92vh - 235px)"
             Hideable="true"
             Loading="_loading"
             Bordered="false"
             Dense="true"
             ServerData="LoadGridData">

    <ToolBarContent>
        <MudIconButton Icon="@Icons.Material.Filled.AddCard" Color="Color.Info" OnClick="ClickAddFailReport"></MudIconButton>
       <MudTextField @bind-Value="_searchString" 
                      Style="font-size: 14px;line-height: 0.8rem;"
                    Placeholder="buscar" 
                    Adornment="Adornment.Start" 
                    Immediate="true"
                    Typo="Typo.caption"
                    IconSize="Size.Medium" Class="mt-0" 
                    OnKeyUp="HandleKeyDownSearch">
        </MudTextField>
        <MudSpacer />
        <div id="scroll_section" class="mx-auto" style="max-width: 650px">
            <MudExpansionPanels Outlined="false" Elevation="0">
                <MudExpansionPanel @bind-Expanded="@_open" HideIcon="true">
                    <TitleContent>
                        <div class="d-flex">
                           
                            <MudIcon Icon="@(_open? Icons.Material.Filled.FilterAltOff  : Icons.Material.Filled.FilterAlt)" Color="Color.Info"></MudIcon>
                        </div>
                    </TitleContent>
                    <ChildContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
                            <MudDatePicker @ref="_picker"
                                           @bind-Date="_dateFrom"
                                           Style="font-size: 14px;line-height: 0.8rem;min-width: 120px;"
                                           Adornment="Adornment.Start"
                                           AdornmentColor="Color.Info"
                                           Class="align-right"
                                           Placeholder="Fecha Desde"
                                           Variant="Variant.Text"
                                           PickerVariant="PickerVariant.Inline"
                                           Margin="Margin.None"
                                           DateFormat="dd/MM/yyyy"
                                           AutoClose="true">
                                <PickerActions>
                                    <MudButton Class="mr-auto align-self-start" OnClick="@(() => _picker.ClearAsync())">Borrar</MudButton>
                                    <MudButton OnClick="@(() => _picker.CloseAsync(false))">Cancelar</MudButton>
                                </PickerActions>
                            </MudDatePicker>

                            <MudDatePicker @ref="_pickerTo"
                                           @bind-Date="_dateTo"
                                           Style="font-size: 14px;line-height: 0.8rem;min-width: 120px;"
                                           Adornment="Adornment.Start"
                                           AdornmentColor="Color.Info"
                                           Class="align-right"
                                           Placeholder="Fecha Hasta"
                                           Variant="Variant.Text"
                                           PickerVariant="PickerVariant.Inline"
                                           Margin="Margin.None"
                                           DateFormat="dd/MM/yyyy"
                                           AutoClose="true">
                                <PickerActions>
                                    <MudButton Class="mr-auto align-self-start" OnClick="@(() => _pickerTo.ClearAsync())">Borrar</MudButton>
                                    <MudButton OnClick="@(() => _pickerTo.CloseAsync(false))">Cancelar</MudButton>
                                </PickerActions>
                            </MudDatePicker>

                          <MudSelect T="SelectOption" 
                               @bind-Value="_selectedAction" 
                               ToStringFunc="@(e => e?.Text)"
                               Placeholder="ESTATUS"
                               AdornmentIcon="@Icons.Material.Filled.FilterList"
                               AdornmentColor="Color.Info"
                               Style="font-size: 14px; width: 160px;"
                               Variant="Variant.Text"
                               Clearable="true"
                               Dense="true">
                        @if (_actions != null)
                        {
                            @foreach (var action in _actions)
                            {
                                @* T debe ser SelectOption *@
                                <MudSelectItem T="SelectOption" Value="@action">@action.Text</MudSelectItem>
                            }
                        }
                    </MudSelect>
                        </MudStack>
                </ChildContent>
                </MudExpansionPanel>
            </MudExpansionPanels>

        </div>
        <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Info" OnClick="() => ClickSearch()"></MudIconButton>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Info" OnClick="() => HandleOnClickRefresh()" />
            <MudIconButton Icon="@Icons.Material.Filled.DocumentScanner" Color="Color.Info" OnClick="() => ClickExportReportSRG()" />
        <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="Open user menu">
            @foreach (var module in _itemsModules)
            {
                <MudMenuItem Icon="@(module.Icon ?? "")" IconColor="@module.Color"
                Label="@module.Text"
                OnClick="() => HandleMenuClick(module)" />
            }
        </MudMenu>
    </ToolBarContent>
    <Columns>
        <SelectColumn  />
        <TemplateColumn  Title="CODIGO">
            <CellTemplate>
                <MudText Typo="Typo.caption" Align="Align.Left" Inline="true" Color="Color.Primary" Style="font-weight:bold;">
                    @("#" + context.Item.Id.ToString().PadLeft(10, '0'))
                </MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn  Title="VIN">
            <CellTemplate>
                <MudText Typo="Typo.caption" Align="Align.Left" Inline="true" Color="Color.Primary" Style="font-weight:bold;">@context.Item.VIN.ToUpper()</MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn  Title="CLIENTE">
            <CellTemplate>
                <MudText Typo="Typo.caption" Align="Align.Left">@(context.Item.CustomerName.ToUpper() + " " + context.Item.CustomerLastName.ToUpper()) </MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn  Title="TIPO" >
            <CellTemplate>
                <MudText Typo="Typo.caption" Align="Align.Left">
                    @(context.Item.ReportTypeName.ToUpper())
                </MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="CONCESIONARIO">
            <CellTemplate>
                <MudText Typo="Typo.caption" Align="Align.Left">@(context.Item.DealerServiceCod.ToUpper())</MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn  Title="FECHA REGISTRO">
            <CellTemplate>
                <MudText Typo="Typo.caption" Align="Align.Left">@(context.Item.DateCreated?.ToString("dd MMM yyyy"))</MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn  Title="F. ORDEN DE SERVICIO">
            <CellTemplate>
                <MudText Typo="Typo.caption" Align="Align.Left">@(context.Item.ServiceDate?.ToString("dd MMM yyyy"))</MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="SRG">
            <CellTemplate>
                <MudText Typo="Typo.caption" Align="Align.Left">@(context.Item.SrgNumber)</MudText>
            </CellTemplate>
        </TemplateColumn>
        
        <TemplateColumn  Title="ESTATUS">
            <CellTemplate>
                <div class="d-flex justify-start">
                    @if (context.Item.EstatusName != null)
                    {
                        string style = "";
                        if (context.Item.EstatusName.ToUpper() == "BORRADOR")
                            style += "";
                        else if (context.Item.EstatusName.ToUpper() == "VALIDADO")
                        {
                            style += "color:#fff";
                            style += ";background-color:#0099F3";
                        }
                        else if (context.Item.EstatusName.ToUpper() == "PROCESADO")
                        {
                            style += "color:#fff";
                            style += ";background-color:#757575";
                        }
                        else
                        {
                            style += "color:#fff";
                            style += ";background-color:#FF7043";
                        }
                        style += ";font-size: 11px";
                        style += ";font-style:italic";

                        <MudChip T="string" Style="@style" Label="true" Disabled="true">
                            @(context.Item.EstatusName.ToUpper())
                        </MudChip>
                    }
                   
                </div>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn >
            <CellTemplate>
                <MudStack Row="true">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Variant="Variant.Text" Color="Color.Default" Size="Size.Small" Href="@(" FailReportdetail/" + context.Item.Id)" />
                    @if (_statusPrintSRG.Contains(context.Item.EstatusName.ToUpper()))
                    {
                        <MudIconButton Icon="@Icons.Custom.FileFormats.FilePdf" Color="Color.Default" Size="Size.Small" OnClick="() => ClickExportPdfSRG(context.Item)"></MudIconButton>
                    }

                </MudStack>

            </CellTemplate>
        </TemplateColumn>
    </Columns>

    <PagerContent>
        <MudDataGridPager  PageSizeOptions="new int[] {100}" InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Registros por Pagina" />
    </PagerContent>
</MudDataGrid>

<NestedDialogCustom IsVisible="@_nestedVisible" Success="@_success" 
                    onCloseNested="() => _nestedVisible = false"
                    ErrorMessage="@_nestedErrorMessage" 
                    Title="@("Reporte de Falla")"/>



@code { [Inject] private UserSession Session { get; set; } = null!;
    [Inject] private AuthenticationProviderJWT AuthenticationStateProvider { get; set; } = null!;
    private IEnumerable<FailReport> _FailReports = new List<FailReport>();
    private string _nestedErrorMessage = string.Empty;
    private bool _nestedVisible;
    bool _success = false;

    private int _rowCount = 0;
    private int _rowsTotal = 0; 

    private string _searchString = string.Empty;
    private bool _loading = true;
    private string _moduleName = "SERVICIOS-REPORTE FALLA";
    //Fechas y filtrados po estatus 
    bool _open;
    IMask maskDate = new DateMask("dd/MM/yyyy");
    private DateTime? _dateFrom { get; set; } = null;
    private DateTime? _dateTo { get; set; } = null;
    private MudDatePicker _picker = new MudDatePicker();
    private MudDatePicker _pickerTo = new MudDatePicker();
    private List<SelectOption> _actions = new List<SelectOption>();
    private SelectOption? _selectedAction;

    private MudDataGrid<FailReport>? _mudDataGrid;
    private HashSet<FailReport> selectedFailReport = new([]);
    private List<ModuleAction> _itemsModules = new List<ModuleAction>([]);

    private List<BreadcrumbItem> _itemsNavigate =
                [
        new("Home", href: "", icon: Icons.Material.Filled.Home),
        new("Servicios",href: "", icon: Icons.Material.Filled.Speed),
        new("Reporte Falla",  href: "failreport", disabled: false, icon: Icons.Material.Filled.CarCrash),
    ];

    List<string> _statusPrintSRG = new List<string>()
    {
        "APROBADO",
        "GENERADO",
        "PROCESADO"
    };


    protected override async Task OnInitializedAsync()
    {
        await AuthenticationStateProvider.RefreshStaticVariables();

        hubEventsService.OnSupplierChanged += ReloadServerData;
        hubEventsService.OnDealerChanged += ReloadServerData;
        await Task.CompletedTask;
    }

    private async Task ReloadServerData()
    {
        if (_mudDataGrid != null)
        {
            await _mudDataGrid!.ReloadServerData();
        }
    }

    public void Dispose()
    {
        hubEventsService.OnDealerChanged -= ReloadServerData;
        hubEventsService.OnSupplierChanged -= ReloadServerData;
    }


    private async Task<GridData<FailReport>> LoadGridData(GridState<FailReport> state)
    {
        await AuthenticationStateProvider.RefreshStaticVariables();
        _rowCount = state.Page * state.PageSize;

        await GetFailReports();

        return new GridData<FailReport> { TotalItems = _rowsTotal, Items = _FailReports };
    }

    private async Task GetFailReports()
    {
        _loading = true;
        _FailReports = new List<FailReport>();
        _rowsTotal = 0;

        _itemsModules = await ModuleActionsService.GetModuleActions(Session.UserId, _moduleName);

        //fechas y filtros
        _actions = await ModuleActionsService.GetAction(Session.UserId, _moduleName);
        _actions = _actions.Where(a => a.Text == "GENERATE" || a.Text == "EXPORT" || a.Text == "DECLINE").ToList
        int? idRespaldado = _selectedAction?.Value;
         if (idRespaldado.HasValue && _actions != null)   {  _selectedAction = _actions.FirstOrDefault(x => x.Value == idRespaldado); }
         int? _estatusid = _selectedAction?.Value;
         string _dateFromStr = string.IsNullOrEmpty(_dateFrom?.ToString()) ? string.Empty : _dateFrom.Value.ToString();
        string _dateToStr = string.IsNullOrEmpty(_dateTo?.ToString()) ? string.Empty : _dateTo.Value.ToString();

        var serviceResponse = await FailReportService.GetFailReportsToGenerate(Session.SupplierId, Session.UserId, _rowCount, _searchString, Session.DealerId,_dateFromStr,_dateToStr);
        if (serviceResponse.Processed)
        {
            _FailReports = serviceResponse.Data;
            _rowsTotal = serviceResponse.Total;
        }
        else
        {
            // Console.WriteLine($"Error: {serviceResponse.Message}");
            _success = false;
            _nestedErrorMessage = serviceResponse.Message ?? MessageEnum.GetError.GetStringValue();

            OpenNested();

        }
       
        _loading = false;
        StateHasChanged();
    }


    private async Task HandleKeyDownSearch(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
           // if (_searchString.Length >= 3 || _searchString == string.Empty)
           // {
                Console.WriteLine($"Buscando: {_searchString}");
                await _mudDataGrid!.ReloadServerData();
           // }

        }
    }

    private async Task ClickSearch()
    {

        //if (_searchString.Length >= 3 )
        //{
            Console.WriteLine($"Buscando: {_searchString}");
            await _mudDataGrid!.ReloadServerData();
        //}

    }


    private async Task HandleOnClickRefresh()
    {
       _searchString = string.Empty; // Limpia el MudTextField
        _selectedAction = null;       // Limpia el MudSelect
        _dateFrom = null;             // Limpia el primer MudDatePicker
        _dateTo = null;
        await _mudDataGrid!.ReloadServerData();
    }


    private async Task ClickEditFailReport(FailReport item)
    {
        UriHelper.NavigateTo("FailReportdetail/" + item.Id);
        await Task.CompletedTask;
    }


    private async Task ClickAddFailReport()
    {

        DialogOptions options = new() { BackdropClick = false, MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = false, NoHeader = true };

        var parameters = new DialogParameters<FailReportDialog> { { x => x.IdFailReport, 0 }, { x => x.ActionsModal, ActionsEnum.Create } };
        var dialog = await DialogService.ShowAsync<FailReportDialog>("Reporte Falla", parameters, options);
        var result = await dialog.Result;
        if (!result!.Canceled)
        {
            await _mudDataGrid!.ReloadServerData();
            StateHasChanged();
        }

        await Task.CompletedTask;
    }


    private async Task ClickExportPdfSRG(FailReport item)
    {
        var serviceResponse = await FailReportService.ExportPdfSRG(Session.UserId, item.Id, Session.DealerId);
        if (serviceResponse.Processed)
        {
            _success = true;
            _nestedErrorMessage = "";

            var base64File = Convert.ToBase64String(serviceResponse.Data.ToArray());
            var fileUrl = $"data:application/pdf;base64,{base64File}";
            await JSRuntime.InvokeVoidAsync("downloadFile", fileUrl, $"SRG_{item.Id.ToString().PadLeft(10, '0')}.pdf");

            if (string.IsNullOrWhiteSpace(item.SrgNumber))
            {
                _searchString = string.Empty;
                await _mudDataGrid!.ReloadServerData();
            }

        }
        else
        {
            // Console.WriteLine(serviceResponse.Message);
            _success = false;
            _nestedErrorMessage = serviceResponse.Message ?? MessageEnum.ExportNotOK.GetStringValue();
            
            OpenNested();

        }
    }

    private async Task ClickExportReportSRG()
    {
        var serviceResponse = await FailReportService.ExportReportSRG(Session.UserId, Session.SupplierId, Session.DealerId);
        if (serviceResponse.Processed)
        {
            _success = true;
            _nestedErrorMessage = "";

            var base64File = Convert.ToBase64String(serviceResponse.Data.ToArray());
            var fileUrl = $"data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{base64File}";
            await JSRuntime.InvokeVoidAsync("downloadFile", fileUrl, $"SRG_Report_{DateTime.Today.ToString("yyyyMMddhhmmss")}.xlsx");
        }
        else
        {
            // Console.WriteLine(serviceResponse.Message);
            _success = false;
            _nestedErrorMessage = serviceResponse.Message ?? MessageEnum.ExportNotOK.GetStringValue();

            OpenNested();

        }
    }


    private void OpenNested()
    {
        _nestedVisible = true;
        StateHasChanged();
    }


    private async Task HandleMenuClick(ModuleAction module)
    {
        switch (module.ActionName)
        {
            case "EXPORT":
                await ExportItemsAsync();
                break;
            case "GENERATE":
                await GenerateItemsAsync(module.IdAction, module.ActionName);
                break;
            case "DECLINE":
                await DeclineItemsAsync(module.IdAction, module.ActionName);
                break;
            default:
                Console.WriteLine($"{MessageEnum.ActionsError.GetStringValue()}: {module.ActionName}");
                break;
        }
    }


    private async Task ExportItemsAsync()
    {
           int? idRespaldado = _selectedAction?.Value;
         if (idRespaldado.HasValue && _actions != null)   {  _selectedAction = _actions.FirstOrDefault(x => x.Value == idRespaldado); }
         int? _estatusid = _selectedAction?.Value;
         string _dateFromStr = string.IsNullOrEmpty(_dateFrom?.ToString()) ? string.Empty : _dateFrom.Value.ToString();
        string _dateToStr = string.IsNullOrEmpty(_dateTo?.ToString()) ? string.Empty : _dateTo.Value.ToString();

        var serviceResponse = await FailReportService.ExportFailReports(Session.SupplierId, Session.UserId, _searchString, Session.DealerId,_dateFromStr,_dateToStr,_estatusid);
        if (serviceResponse.Processed)
        {
            _success = true;
            _nestedErrorMessage = "";

            var base64File = Convert.ToBase64String(serviceResponse.Data.ToArray());
            var fileUrl = $"data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{base64File}";
            await JSRuntime.InvokeVoidAsync("downloadFile", fileUrl, "Reporte de Falla.xlsx");

        }
        else
        {
            // Console.WriteLine(serviceResponse.Message);
            _success = false;
            _nestedErrorMessage = serviceResponse.Message ?? MessageEnum.ExportNotOK.GetStringValue();
            
            OpenNested();

        }
    }

    private async Task GenerateItemsAsync(int moduleId, string moduleActionName)
    {
        Console.WriteLine("Generar Reporte de Falla...");
        if (selectedFailReport.Any())
        {
            var option = new DialogOptions
                {
                    CloseButton = false,
                    MaxWidth = MaxWidth.Small,
                    FullWidth = true,
                    BackdropClick = false
                };
            bool? result = await DialogService.ShowMessageBox(
                "Generar Reporte de Falla",
                $"Seguro de Generar Reporte de Falla? ",
                yesText: "Si", noText: "No", "", option);

            if (result == true)
            {
                List<PostAction> ActionList = ([]);

                foreach (var Item in selectedFailReport)
                {
                    var ItemAction = new PostAction
                        {
                            RecordId = Item.Id,
                            ModuleId = moduleId,
                            ActionName = moduleActionName
                        };
                    ActionList.Add(ItemAction);
                }

                var serviceResponse = await FailReportService.ActionsFailReport(ActionList, Session.UserId);
                if (serviceResponse.Processed)
                {

                    _success = true;
                    _nestedErrorMessage = MessageEnum.GenerateOK.GetStringValue();

                    await _mudDataGrid!.ReloadServerData();
                }
                else
                {
                    // Console.WriteLine(serviceResponse.Message);
                    _success = false;
                    _nestedErrorMessage = serviceResponse.Message ?? MessageEnum.GenerateNotOK.GetStringValue();
                }
                OpenNested();
            }

        }

        selectedFailReport = new([]);
        await Task.CompletedTask;
    }


    private async Task DeclineItemsAsync(int moduleId, string moduleActionName)
    {
        Console.WriteLine("Rechazar Reporte Falla...");
        if (selectedFailReport.Any())
        {
            var option = new DialogOptions
            {
                CloseButton = false,
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                BackdropClick = false
            };
            bool? confirm = await DialogService.ShowMessageBox(
                "Rechazar Reporte Falla ",
                $"Seguro de Rechazar? ",
                yesText: "Si", noText: "No", "", option);

            if (confirm == true)
            {
                DialogOptions options = new() { BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = false, NoHeader = true };
                var parameters = new DialogParameters<TextItemDialog> { { x => x.Title, "Rechazar Reporte Falla ..." } };
                var dialog = await DialogService.ShowAsync<TextItemDialog>("Reporte Falla ", parameters, options);

                StateHasChanged();

                var result = await dialog.Result;
                if (!result!.Canceled)
                {
                    var _Observacion = (string)(result.Data ?? string.Empty);
                    List<PostAction> ActionList = ([]);

                    foreach (var Item in selectedFailReport)
                    {
                        var ItemAction = new PostAction
                        {
                            RecordId = Item.Id,
                            ModuleId = moduleId,
                            ActionName = moduleActionName,
                            ActionComment = _Observacion
                        };
                        ActionList.Add(ItemAction);
                    }

                    var serviceResponse = await FailReportService.ActionsFailReport(ActionList, Session.UserId);
                    if (serviceResponse.Processed)
                    {

                        _success = true;
                        _nestedErrorMessage = MessageEnum.DeclineOK.GetStringValue();

                        await _mudDataGrid!.ReloadServerData();

                    }
                    else
                    {
                        // Console.WriteLine(serviceResponse.Message);
                        _success = false;
                        _nestedErrorMessage = serviceResponse.Message ?? MessageEnum.DeclineNotOK.GetStringValue();

                    }
                    OpenNested();
                }

            }

        }

        selectedFailReport = new([]);
        await Task.CompletedTask;
    }


}
