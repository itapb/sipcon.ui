@page "/FigoCxC"

@using Sipcon.WebApp.Client.Components.Inspection
@using Sipcon.WebApp.Client.Repository.Auth

@inject IFigoService FigoService
@inject IDialogService DialogService
@inject UtilModuleActions ModuleActionsService
@inject IJSRuntime JSRuntime
@inject HubEventsService hubEventsService
@implements IDisposable

@inject IJSRuntime JS

<PageTitle>FigoCxC</PageTitle>
<CustomBreadcrumbs mItems="_itemsNavigate"></CustomBreadcrumbs>

<MudDataGrid @ref="_mudDataGrid"
             T="FIGO_Reporte_RelacionCxC"
             FixedHeader Height="calc(92vh - 235px)"
             Hideable="true"
             Loading="_loading"
             Bordered="false"
             Dense="true"
             ServerData="LoadGridData">

    <ToolBarContent>
        <MudTextField @bind-Value="_searchString" Placeholder="Buscar" Adornment="Adornment.Start" Immediate="true"
                      Typo="Typo.caption"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      OnAdornmentClick="() => ClickSearch()"
                      IconSize="Size.Medium" Class="mt-0"
                      OnKeyDown="HandleKeyDownSearch"></MudTextField>
        <MudSpacer />
        <MudToggleGroup T="string" Value="_activeCurrency"
                        ValueChanged="@((string v) => OnFilterChanged(v))"
                        Color="Color.Info" Size="Size.Small" Class="mr-2"
                        SelectionMode="SelectionMode.SingleSelection">
            <MudToggleItem Value="@("USD")" Text="USD" />
            <MudToggleItem Value="@("BS")" Text="BS" />
        </MudToggleGroup>

        <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf" Color="Color.Error" OnClick='() => ExportFile("PDF")' />
        <MudIconButton Icon="@Icons.Custom.FileFormats.FileExcel" Color="Color.Success" OnClick='() => ExportFile("EXCEL")' />
         <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Info" OnClick="() => HandleOnClickRefresh()" />
    </ToolBarContent>

    <Columns>
        <PropertyColumn Property="x => x.Vat" Title="RIF" Sortable="false" Filterable="false"
                        HeaderClass="mud-text-align-center" CellClass="mud-text-align-center" />
 
        <PropertyColumn Property="x => x.Client" Title="CLIENTE" Sortable="false" Filterable="false" Groupable="true" Grouping="true" GroupExpanded="true"
                        HeaderClass="mud-text-align-center" CellClass="mud-text-align-center" />

        <PropertyColumn Property="x => x.Product + ' ' + x.SerialNumber" Title="Producto" Sortable="false" Filterable="false"
                        HeaderClass="mud-text-align-center" CellClass="mud-text-align-center" />

        <PropertyColumn Property="x => x.Occurrence + ' ' + x.Document" Title="Documento" Sortable="false" Filterable="false"
                        HeaderClass="mud-text-align-center" CellClass="mud-text-align-center" />

        <PropertyColumn Property="x => x.IssueDate" Title="Emisión" Sortable="false" Filterable="false"
                        HeaderClass="mud-text-align-center" CellClass="mud-text-align-center" />

        <PropertyColumn Property="x => x.DueDate" Title="Vencimiento" Sortable="false" Filterable="false"
                        HeaderClass="mud-text-align-center" CellClass="mud-text-align-center" />

        <PropertyColumn Property="x => x.OverdueDays" Title="Días" Sortable="false" Filterable="false"
                        HeaderClass="mud-text-align-right" CellClass="mud-text-align-right"  />

        <PropertyColumn Property="x => x.OverdueAmount" Title="Vencido" Format="N2" Sortable="false" Filterable="false"
                        HeaderClass="mud-text-align-right" CellClass="mud-text-align-right" Align="right" />

        <PropertyColumn Property="x => x.CurrentAmount" Title="Por vencer" Format="N2" Sortable="false" Filterable="false"
                        HeaderClass="mud-text-align-right" CellClass="mud-text-align-right" Align="right" />

        <PropertyColumn Property="x => x.TotalDebt" Title="Total Deuda" Format="N2" Sortable="false" Filterable="false"
                        HeaderClass="mud-text-align-right" CellClass="mud-text-align-right" Align="right" />
    </Columns>

    <PagerContent>
        <MudDataGridPager PageSizeOptions="new int[] { 100 }"
                          InfoFormat="{first_item}-{last_item} de {all_items}"
                          RowsPerPageString="Registros por Pagina" />
    </PagerContent>
</MudDataGrid>

@code {
    [Inject] private UserSession Session { get; set; } = null!;
    [Inject] private AuthenticationProviderJWT AuthenticationStateProvider { get; set; } = null!;

    private IEnumerable<FIGO_Reporte_RelacionCxC> _figoPersona = new List<FIGO_Reporte_RelacionCxC>();
    private string _nestedErrorMessage = string.Empty;
    private bool _nestedVisible;
    private bool _success;
    private int _rowCount;
    private int _rowsTotal;
    private string _searchString = string.Empty;
    private string _activeCurrency = "USD";
    private bool _loading = true;

    private MudDataGrid<FIGO_Reporte_RelacionCxC>? _mudDataGrid;
    private List<ModuleAction> _itemsModules = new([]);
    private HashSet<int> _togglingIds = new([]);

    private List<BreadcrumbItem> _itemsNavigate =
    [
        new("Home",                             href: "",           icon: Icons.Material.Filled.Home),
        new("Reportes",                         href: "",           icon: Icons.Material.Filled.FactCheck),
        new("Relación de cuentas por cobrar",   href: "FigoCxC",    icon: Icons.Material.Filled.CurrencyExchange)
    ];

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        await AuthenticationStateProvider.RefreshStaticVariables();
        hubEventsService.OnSupplierChanged += ReloadServerData;
        hubEventsService.OnDealerChanged += ReloadServerData;
    }

    public void Dispose()
    {
        hubEventsService.OnSupplierChanged -= ReloadServerData;
        hubEventsService.OnDealerChanged -= ReloadServerData;
    }

    private async Task OnFilterChanged(string value)
    {
        _activeCurrency = value;
        await _mudDataGrid!.ReloadServerData();
    }

    private async Task ExportFile(string format)
    {
        switch (format)
        {
            case "EXCEL":
                await ExportItemsExcel();
                break;
            case "PDF":
                await ExportItemsPDF();
                break;
        }
    }

    private async Task ReloadServerData()
    {
        if (_mudDataGrid != null)
            await _mudDataGrid.ReloadServerData();
    }

    private async Task<GridData<FIGO_Reporte_RelacionCxC>> LoadGridData(GridState<FIGO_Reporte_RelacionCxC> state)
    {
        await AuthenticationStateProvider.RefreshStaticVariables();
        _rowCount = state.Page * state.PageSize;
        await GetPersonas();
        return new GridData<FIGO_Reporte_RelacionCxC> { TotalItems = _rowsTotal, Items = _figoPersona };
    }
   
    private async Task ExportItemsExcel()
    {
        var serviceResponse = await FigoService.ExportRelacionCxCExcel(_activeCurrency, _searchString);

        if (serviceResponse.Processed)
        {
            var base64File = Convert.ToBase64String(serviceResponse.Data.ToArray());
            var fileUrl = $"data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{base64File}";
            await JSRuntime.InvokeVoidAsync("downloadFile", fileUrl, "ReporteCxC.xlsx");
        }
        else
        {
            _success = false;
            _nestedErrorMessage = serviceResponse.Message ?? MessageEnum.ExportNotOK.GetStringValue();
            OpenNested();
        }
    }

    private async Task ExportItemsPDF()
    {
        try
        {
            var serviceResponse = await FigoService.ExportRelacionCxCPDF(_activeCurrency, _searchString);

            if (serviceResponse.Processed && serviceResponse.Data != null)
            {
                var applicationName = string.Empty;

                var base64File = Convert.ToBase64String(serviceResponse.Data.ToArray());
                var fileUrl = $"data:{applicationName};base64,{base64File}";

                await JS.InvokeVoidAsync("downloadFile", fileUrl, $"ReporteCxC.pdf");
            }
            else
            {
                var errorMessage = serviceResponse.Message ?? "No se pudo exportar el archivo.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error en la descarga: {ex.Message}");
        }
    }

    private async Task GetPersonas()
    {
        _loading = true;
        _figoPersona = new List<FIGO_Reporte_RelacionCxC>();
        _rowsTotal = 0;

        bool? activeParam = _activeCurrency switch
        {
            "USD" => true,
            "BS" => false,
            _ => null
        };

        var serviceResponse = await FigoService.GetRelacionCxC(_activeCurrency, _searchString);

        if (serviceResponse.Processed)
        {
            _figoPersona = serviceResponse.Data;
            _rowsTotal = serviceResponse.Total;
        }
        else
        {
            _success = false;
            _nestedErrorMessage = serviceResponse.Message ?? MessageEnum.GetError.GetStringValue();
            OpenNested();
        }

        _loading = false;
        _figoPersona ??= new List<FIGO_Reporte_RelacionCxC>();
        StateHasChanged();
    }

    private async Task HandleKeyDownSearch(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && (_searchString.Length >= 3 || _searchString == string.Empty))
            await _mudDataGrid!.ReloadServerData();
    }

    private async Task ClickSearch()
    {
        if (_searchString.Length >= 3)
            await _mudDataGrid!.ReloadServerData();
    }

    private async Task HandleOnClickRefresh()
    {
        _searchString = string.Empty;
        await _mudDataGrid!.ReloadServerData();
    }

    private void OpenNested()
    {
        _nestedVisible = true;
        StateHasChanged();
    }
}