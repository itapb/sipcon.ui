@page "/ReportingFigo"

@using System.Globalization
@using System.Text.Json
@using Sipcon.WebApp.Client.Repository.Auth
@using System.Dynamic;
@using Sipcon.WebApp.Client.Utils
@using FluentValidation


@inject IReportingService ReportingService
@inject IFigoService FigoService
@inject IDialogService DialogService
@inject UtilModuleActions ModuleActionsService
@inject IJSRuntime JSRuntime
@inject NavigationManager UriHelper
@inject HubEventsService hubEventsService
@implements IDisposable


<PageTitle>Reportes</PageTitle>
<CustomBreadcrumbs mItems="_itemsNavigate"></CustomBreadcrumbs>

<MudDataGrid @ref="_mudDataGrid"
             T="Dictionary<string, object>"
             ServerData="LoadGridData"
             @key="@(_columns.Count)"
             Loading="_loading"
             Height="calc(92vh - 235px)"
             FixedHeader="true"
             Dense="true"
             Hover="true"
             RowStyleFunc="EvaluateRowStyle" @key="@(_columns.Count)"
             Striped="true"
             SortMode="SortMode.Multiple"
             @bind-CurrentPage="_currentPage">
    <ToolBarContent>
        <MudTextField @bind-Value="_searchString"
                      Style="font-size: 14px;line-height: 0.8rem;"
                      Placeholder="buscar"
                      Adornment="Adornment.Start"
                      Immediate="true"
                      Typo="Typo.caption"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      OnAdornmentClick="() => ClickSearch()"
                      IconSize="Size.Medium" Class="mt-0"
                      OnKeyUp="HandleKeyDownSearch">
        </MudTextField>

        <MudSelect T="int?"
                   Value="@_reportingTypeValue"
                   ValueChanged="@(async (int? id) => await OnReportTypeChanged(id))"
                   Style="font-size: 14px; line-height: 0.8rem; min-width: 160px; max-width: 160px; margin-left: 10px;"
                   Placeholder="Seleccione Reporte"
                   Margin="Margin.Dense"
                   Variant="Variant.Outlined">
            @foreach (var model in _reportingTypeList)
            {
                <MudSelectItem Value="@((int?)model.Value)">@model.Text</MudSelectItem>
            }
        </MudSelect>

        <MudSpacer />
        <MudMenu Icon="@Icons.Material.Filled.FilterList"
                 Color="Color.Info"
                 AnchorOrigin="Origin.BottomRight"
                 TransformOrigin="Origin.TopRight"
                 Style="margin-right: 10px;">

            <div class="pa-4" style="min-width: 350px; max-width: 450px;">
                <div class="d-flex justify-space-between align-center mb-3">
                    <MudText Typo="Typo.subtitle2">Filtros de Reporte</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="ResetFilters" Title="Limpiar Filtros" />
                </div>
                <MudDivider Class="mb-3" />

                <div style="max-height: 400px; overflow-y: auto;" class="pr-2">
                    <MudGrid Spacing="2">
                        @{
                            var groupedFields = _dynamicFields
                                .Where(x => x.ActionType == "F")
                                .GroupBy(x => x.FieldType)
                                .OrderBy(x => x.Key == "DATE" ? 0 : (x.Key == "INT" ? 1 : 2));
                        }

                        @foreach (var group in groupedFields)
                        {
                            @foreach (var config in group)
                            {
                                <MudItem xs="12" sm="6">
                                    @switch (group.Key)
                                    {
                                        case "DATE":
                                            <MudDatePicker Label="@config.Field"
                                                           Date="@(_filterValues.ContainsKey(config.Field) && _filterValues[config.Field] is string s ? DateTime.ParseExact(s, "MM/dd/yyyy", null) : DateTime.Today)"
                                                           DateChanged="@((DateTime? v) => _filterValues[config.Field] = v?.ToString("MM/dd/yyyy") ?? DateTime.Today.ToString("MM/dd/yyyy"))"
                                                           DateFormat="dd/MM/yyyy"
                                                           Variant="Variant.Outlined"
                                                           Margin="Margin.Dense" />
                                            break;

                                        case "INT":
                                            <MudNumericField Typo="Typo.caption"
                                                             Label="@config.Field"
                                                             Value="@(_filterValues[config.Field]?.ToString())"
                                                             ValueChanged="@((string v) => _filterValues[config.Field] = v)"
                                                             MaxLength="10"
                                                             Variant="Variant.Outlined"
                                                             Margin="Margin.Dense"
                                                             HideSpinButtons="true"
                                                             Pattern="[0-9]*"
                                                             Format="N0"
                                                             Culture="@CultureInfo.GetCultureInfo("es-VE")"
                                                             Immediate="true" />
                                            break;

                                        case "VARCHAR":
                                            @* NUEVO: Si el VARCHAR viene con opciones desde el backend, usamos MudSelect *@
                                            @if (config.Options != null && config.Options.Any())
                                            {
                                                <MudSelect T="string"
                                                           Label="@config.Field"
                                                           Value="@(_filterValues[config.Field]?.ToString())"
                                                           ValueChanged="@((string v) => _filterValues[config.Field] = v)"
                                                           Variant="Variant.Outlined"
                                                           Margin="Margin.Dense"
                                                           Dense="true">
                                                    <MudSelectItem T="string" Value="@(null)">Seleccione...</MudSelectItem>
                                                    @foreach (var option in config.Options)
                                                    {
                                                        @* 'option.Value' guarda "USD" o "BS" y 'option.Name' muestra "DOLAR" o "BOLIVARES" *@
                                                        <MudSelectItem T="string" Value="@option.Value">@option.Name</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            }
                                            else
                                            {
                                                @* Si es VARCHAR plano sin opciones, se mantiene como texto tradicional *@
                                                <MudTextField Label="@config.Field"
                                                              Value="@(_filterValues[config.Field]?.ToString())"
                                                              ValueChanged="@((string v) => _filterValues[config.Field] = v)"
                                                              Variant="Variant.Outlined"
                                                              Margin="Margin.Dense" />
                                            }
                                            break;
                                    }
                                </MudItem>
                            }
                        }

                        @* NUEVA SECCIÓN: AGRUPAR POR *@
                        @if (_groupingFields != null && _groupingFields.Any())
                        {
                            <MudItem xs="12" Class="mt-3">
                                <MudText Typo="Typo.subtitle2">Agrupar por</MudText>
                                <MudDivider Class="mt-1 mb-2" />
                            </MudItem>

                            @foreach (var groupConfig in _groupingFields)
                            {
                                <MudItem xs="12" sm="6" Class="py-0">
                                    <MudCheckBox T="bool"
                                                 Label="@groupConfig.Field"
                                                 Value="@GetGroupState(groupConfig.Field)"
                                                 ValueChanged="@((bool val) => ToggleGroupField(groupConfig.Field, val))"
                                                 Color="Color.Primary"
                                                 Dense="true" />
                                </MudItem>
                            }
                        }
                    </MudGrid>
                </div>

                <MudButton FullWidth="true" Color="Color.Primary" Variant="Variant.Filled" Class="mt-4" OnClick="() => ClickSearch()">Aplicar Filtros</MudButton>
            </div>
        </MudMenu>
        <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Info" OnClick="() => ClickSearch()"></MudIconButton>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Info" OnClick="() => HandleOnClickRefresh()" />
    
        <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="Open user menu">
            @foreach (var module in _itemsModules)
            {
                <MudMenuItem Icon="@(module.Icon ?? "")" IconColor="@module.Color"
                             Label="@module.Text"
                             OnClick="() => HandleMenuClick(module)" />
            }
        </MudMenu>
    </ToolBarContent>

    <Columns>
        @if (_columns != null && _columns.Any())
        {
            @foreach (var col in _columns)
            {
                <TemplateColumn T="Dictionary<string, object>" Title="@col">
                    <CellTemplate>
                        @{
                            var item = context.Item;
                            bool isFirstColumn = col == _columns.First();

                            // 1. Si es una fila de cabecera de grupo
                            if (item.ContainsKey("IsHeaderGroupRow"))
                            {
                                if (isFirstColumn)
                                {
                                    string groupKey = item["HeaderGroupTitle"]?.ToString() ?? "";
                                    bool isExpanded = _expandedGroups.Contains(groupKey);

                                    @* Contenedor con estilos para evitar saltos de línea (nowrap) *@
                                    <div class="d-flex align-center" style="padding: 2px 0px; gap: 4px; white-space: nowrap;">
                                        <MudIconButton Icon="@(isExpanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                                                       Size="Size.Small"
                                                       Color="Color.Primary"
                                                       Class="pa-1"
                                                       OnClick="() => ToggleGroupExpansion(groupKey)" />
                                        <MudText Typo="Typo.subtitle2" Color="Color.Primary" Style="white-space: nowrap;">
                                            <strong>📁 @groupKey</strong>
                                        </MudText>
                                    </div>
                                }
                            }
                            else // 2. Registro de datos ordinario
                            {
                                string displayValue = "";
                                if (item.TryGetValue(col, out var val) && val != null)
                                {
                                    displayValue = val is JsonElement element ? element.ToString() : val.ToString();
                                }
                                <MudText Typo="Typo.caption">@displayValue</MudText>
                            }
                        }
                    </CellTemplate>
                </TemplateColumn>
            }
        }
    </Columns>

    <PagerContent>
        <MudDataGridPager PageSizeOptions="new int[] { 100 }" InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Registros por Pagina" />
    </PagerContent>
</MudDataGrid>

<NestedDialogCustom IsVisible="@_nestedVisible" Success="@_success"
                    onCloseNested="() => _nestedVisible = false"
                    ErrorMessage="@_nestedErrorMessage"
                    Title="@("Reportes")" />



@code {
    [Inject] private UserSession Session { get; set; } = null!;
    [Inject] private AuthenticationProviderJWT AuthenticationStateProvider { get; set; } = null!;

    private List<Dictionary<string, object>> _ReportFigo = new();
    private List<Dictionary<string, object>> _processedRows = new();
    private List<string> _columns = new();
    private MudDataGrid<Dictionary<string, object>>? _mudDataGrid;
    private HashSet<string> _expandedGroups = new();

    private Dictionary<string, object> _filterValues = new();
    private Dictionary<string, bool> _selectedGroups = new();

    // 2. Lista de configuración (la que recibes del backend)
    private List<ReportConfig> _dynamicFields = new();
    private List<ReportConfig> _groupingFields = new();

    private string _nestedErrorMessage = string.Empty;
    private bool _nestedVisible;
    bool _success = false;
    bool _open;

    private int _currentPage = 0;
    private int _rowCount = 0;
    private int _rowsTotal = 0;

    private int? _reportingTypeValue = null;
    private string _searchString = string.Empty;
    private DateTime? _dateFrom { get; set; } = null;
    private DateTime? _dateTo { get; set; } = null;
    private bool _loading = true;
    private string _moduleName = "REPORTES-FIGO";
    private List<SelectOption> _actions = new List<SelectOption>();
    private SelectOption? _selectedAction;

    IMask maskDate = new DateMask("dd/MM/yyyy");

    private MudDatePicker _picker = new MudDatePicker();
    private MudDatePicker _pickerTo = new MudDatePicker();

    private List<ModuleAction> _itemsModules = new List<ModuleAction>([]);
    public IEnumerable<SelectOption> _reportingTypeList { get; set; } = ([]);

    private List<BreadcrumbItem> _itemsNavigate =
                [
        new("Home", href: "", icon: Icons.Material.Filled.Home),
        new("Reportes",href: "", icon: Icons.Material.Filled.ReportProblem),
        new("Reportes Figo",  href: "ReportingFigo", disabled: false, icon: Icons.Material.Filled.ReportProblem),
    ];




    // The validation rules (overkill, I know, but very fluent):
    SelectValidator<int> _SelectValidator = new SelectValidator<int>(x => x
        .NotEmpty().NotNull().WithMessage("Campo requerido")
        .GreaterThan(0).WithMessage("Seleccione un Concesionario."));


    protected override async Task OnInitializedAsync()
    {
        await AuthenticationStateProvider.RefreshStaticVariables();

        hubEventsService.OnSupplierChanged += ReloadServerData;
        hubEventsService.OnDealerChanged += ReloadServerData;

        // Nota: El Grid llamará a LoadGridData automáticamente al renderizarse
        // porque está configurado con ServerData.
    }

    private async Task ReloadServerData()
    {
        if (_mudDataGrid != null)
        {
            _open = false;
            _currentPage = 0;
            // IMPORTANTE: ReloadServerData() disparará internamente LoadGridData
            await _mudDataGrid.ReloadServerData();
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        hubEventsService.OnDealerChanged -= ReloadServerData;
        hubEventsService.OnSupplierChanged -= ReloadServerData;
    }

    private bool _loadingGrid = false;

    private async Task<GridData<Dictionary<string, object>>> LoadGridData(GridState<Dictionary<string, object>> state)
    {
        if (_loadingGrid)
            return new GridData<Dictionary<string, object>>();

        _loadingGrid = true;

        try
        {
            _rowCount = state.Page;
            _currentPage = state.Page;
            _reportingTypeList = await ModuleActionsService.GetReportingTypeFigo(Session.UserId);

            // 1. Llama al backend para llenar _ReportFigo
            await GetReporting();

            // 2. Procesa la lista en memoria según los checkboxes activos antes de mandarla al Grid
            ProcessActiveGroups();

            return new GridData<Dictionary<string, object>>
            {
                TotalItems = _rowsTotal,
                Items = _processedRows // <-- IMPORTANTE: Cambiamos _ReportFigo por _processedRows
            };
        }
        finally
        {
            _loadingGrid = false;
        }
    }


    private void ToggleGroupExpansion(string groupKey)
    {
        if (_expandedGroups.Contains(groupKey))
        {
            _expandedGroups.Remove(groupKey);
        }
        else
        {
            _expandedGroups.Add(groupKey);
        }
        StateHasChanged(); // Fuerza al Grid a revaluar los estilos de fila
    }

    // 3. Función que oculta o muestra la fila completa en el DOM
    private string EvaluateRowStyle(Dictionary<string, object> item, int rowNumber)
    {
        if (item == null) return string.Empty;

        if (item.ContainsKey("BelongsToGroup"))
        {
            string parentGroup = item["BelongsToGroup"]?.ToString() ?? "";
       
            // Si el grupo padre NO está en el HashSet, ocultamos la fila entera (display: none)
            if (!string.IsNullOrEmpty(parentGroup) && !_expandedGroups.Contains(parentGroup))
            {
                return "display: none;";
            }
        }

        if (item.ContainsKey("IsHeaderGroupRow"))
        {
            return "background-color: var(--mud-palette-background-grey);";
        }

        return string.Empty;
    }

    private void ProcessActiveGroups()
    {
        _processedRows.Clear();

        var activeGroupFields = _selectedGroups.Where(x => x.Value).Select(x => x.Key).ToList();

        if (!activeGroupFields.Any() || !_ReportFigo.Any())
        {
            _processedRows = new List<Dictionary<string, object>>(_ReportFigo);
            return;
        }

        var groupedData = _ReportFigo.GroupBy(row =>
            string.Join(" | ", activeGroupFields.Select(f => row.ContainsKey(f) && row[f] != null ? row[f].ToString() : "N/A"))
        );

        foreach (var group in groupedData)
        {
            string groupKey = group.Key;

            // ❌ ELIMINADO: Ya no forzamos el Add a _expandedGroups aquí.
            // Al no agregarlo, el grupo iniciará CERRADO.

            // Creamos el registro virtual de cabecera
            var headerRow = new Dictionary<string, object>
        {
            { "IsHeaderGroupRow", true },
            { "HeaderGroupTitle", groupKey }
        };
       
            _processedRows.Add(headerRow);
       
            // Añadimos los registros reales
            foreach (var row in group)
            {
                row["BelongsToGroup"] = groupKey;
                _processedRows.Add(row);
            }
        }
    }


    private async Task OnReportTypeChanged(int? reportId)
    {
        _loading = true;
        _reportingTypeValue = reportId;

        // 1. Traemos los filtros/campos dinámicos como siempre
        var response = await FigoService.GetFilterReport(Session.UserId, reportId ?? 0);
 
        if (response != null && response.Processed)
        {
            _dynamicFields = response.Data;
            _filterValues.Clear();
     
            _groupingFields.Clear();
            _selectedGroups.Clear();
            _expandedGroups.Clear();

            // 2. Traemos las opciones de filtros desde el backend
            var optionsResponse = await FigoService.GetFilterOptions(Session.UserId, reportId ?? 0);
            List<FilterOptionDto> allOptions = null;

            if (optionsResponse != null && optionsResponse.Processed)
            {
                allOptions = optionsResponse.Data;
            }

            foreach (var field in _dynamicFields)
            {
                // 3. Asignamos las opciones correspondientes a cada filtro dinámico
                if (allOptions != null)
                {
                    field.Options = allOptions
                        .Where(o => o.FilterReportId == field.Id)
                        .ToList();
                }

                // Filtro para campos de entrada (F)
                if (field.ActionType == "F")
                {
                    if (field.Options != null && field.Options.Any())
                    {
                        _filterValues[field.Field] = null; // Default para los MudSelects: "Seleccione..."
                    }
                    else
                    {
                        _filterValues[field.Field] = (field.FieldType == "DATE")
                            ? DateTime.Today.ToString("MM/dd/yyyy")
                            : null;
                    }
                }
       
                // Campos de Agrupación (A)
                if (field.ActionType == "A")
                {
                    _groupingFields.Add(field);
                    _selectedGroups[field.Field] = false;
                }
            }
        }

        // --- CORRECCIÓN CRUCIAL DE FLUJO ---
    
        _loadingGrid = false;
        _loading = false;

        // 1. Forzamos a Blazor a pintar primero la nueva botonera, selects y filtros dinámicos en el HTML
        StateHasChanged();

        // 2. Cedemos el control un milisegundo para asegurar que los componentes de la interfaz existan en el DOM
        await Task.Delay(5);

        // 3. Ahora que el escenario está limpio y listo, le ordenamos al Grid invocar a LoadGridData
        if (_mudDataGrid != null)
        {
            await _mudDataGrid.ReloadServerData();
        }
    }

    private bool GetGroupState(string fieldName)
    {
        return _selectedGroups.TryGetValue(fieldName, out var isChecked) && isChecked;
    }

    // Método que guarda el cambio cuando el usuario marca o desmarca el check
    private async Task ToggleGroupField(string fieldName, bool isChecked)
    {
        _selectedGroups[fieldName] = isChecked;

        // 1. Limpiamos los estados de expansión para que el nuevo agrupamiento inicie CERRADO
        _expandedGroups.Clear();

        // 2. Apagamos el candado de carga por seguridad antes de invocar la recarga
        _loadingGrid = false;

        // 3. Forzamos al MudDataGrid a ejecutar 'LoadGridData' y procesar 'ProcessActiveGroups'
        if (_mudDataGrid != null)
        {
            await _mudDataGrid.ReloadServerData();
        }

        StateHasChanged();
    }

    

    // 4. MÉTODOS AUXILIARES PARA EVITAR EL ERROR CS0445
    // Estos métodos actúan como puente seguro entre la UI y el Dictionary

    private DateTime? GetDateValue(string key) =>
        _filterValues.ContainsKey(key) ? (DateTime?)_filterValues[key] : null;

    private void SetDateValue(string key, DateTime? val) => _filterValues[key] = val;

    private string GetStringValue(string key) =>
        _filterValues.ContainsKey(key) ? _filterValues[key]?.ToString() : string.Empty;

    private void SetStringValue(string key, string val) => _filterValues[key] = val;

    private decimal GetDecimalValue(string key) =>
        _filterValues.ContainsKey(key) && _filterValues[key] != null ? Convert.ToDecimal(_filterValues[key]) : 0;

    private void SetDecimalValue(string key, decimal val) => _filterValues[key] = val;

    // 5. Método de Reseteo (que ya tienes en el botón)
    private async Task ResetFilters()
    {
        foreach (var key in _filterValues.Keys.ToList())
        {
            _filterValues[key] = null;
        }
        _filterValues.Clear();
        _selectedGroups.Clear();
        await _mudDataGrid.ReloadServerData();
    }

    private async Task GetReporting()
    {
        try
        {
            _loading = true;
            _ReportFigo = new List<Dictionary<string, object>>();
            // No reseteamos _columns aquí para evitar que el Grid parpadee desapareciendo cabeceras
            StateHasChanged();
            string jsonString = JsonSerializer.Serialize(_filterValues);

            _itemsModules = await ModuleActionsService.GetModuleActions(Session.UserId, _moduleName);
            _actions = await ModuleActionsService.GetStatusByModule(Session.UserId, _moduleName);

            int? idRespaldado = _selectedAction?.Value;
            if (idRespaldado.HasValue && _actions != null)
            {
                _selectedAction = _actions.FirstOrDefault(x => x.Value == idRespaldado);
            }

            int? _estatusid = _selectedAction?.Value;

            var serviceResponse = await FigoService.GetReportsFigo(Session.UserId, Session.SupplierId, _rowCount, _reportingTypeValue ?? 0, jsonString, _searchString);

            if (serviceResponse.Processed)
            {
                _ReportFigo = serviceResponse.Data ?? new List<Dictionary<string, object>>();
                _rowsTotal = serviceResponse.Total;

                if (_ReportFigo.Any())
                {
                    var nuevasColumnas = _ReportFigo.First().Keys.ToList();

                    // Reemplazo manual de SequenceEqual para evitar el error de .NET 10
                    bool sonIguales = _columns.Count == nuevasColumnas.Count;
                    if (sonIguales)
                    {
                        for (int i = 0; i < _columns.Count; i++)
                        {
                            if (_columns[i] != nuevasColumnas[i])
                            {
                                sonIguales = false;
                                break;
                            }
                        }
                    }

                    // Solo actualizamos si detectamos un cambio real
                    if (!sonIguales)
                    {
                        _columns = nuevasColumnas;
                    }
                }
            }
            else
            {
                _success = false;
                _nestedErrorMessage = serviceResponse.Message ?? "Error al obtener datos";
                OpenNested();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error en GetReporting: {ex.Message}");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task HandleKeyDownSearch(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            if (_searchString.Length >= 3 || string.IsNullOrEmpty(_searchString))
            {
                await ClickSearch();
            }
        }
    }

    private async Task ClickSearch()
    {
        if (_mudDataGrid != null)
        {
            await _mudDataGrid.ReloadServerData();
        }
    }

    private async Task HandleOnClickRefresh()
    {
        _searchString = string.Empty;
        _dateFrom = null;
        _dateTo = null;
        if (_picker != null) await _picker.ClearAsync();
        if (_pickerTo != null) await _pickerTo.ClearAsync();

        _open = false;
        if (_mudDataGrid != null)
        {
            await _mudDataGrid.ReloadServerData();
        }
    }

    private void OpenNested()
    {
        _nestedVisible = true;
        StateHasChanged();
    }



    private async Task HandleMenuClick(ModuleAction module)
    {
        switch (module.ActionName)
        {
            case "EXPORT":
                await ExportItemsAsync();
                break;
            default:
                Console.WriteLine($"{MessageEnum.ActionsError.GetStringValue()}: {module.ActionName}");
                break;
        }
    }

    private async Task ExportItemsAsync()
    {

        //fechas y filtros
        _actions = await ModuleActionsService.GetStatusByModule(Session.UserId, _moduleName);
        int? idRespaldado = _selectedAction?.Value;
        if (idRespaldado.HasValue && _actions != null) { _selectedAction = _actions.FirstOrDefault(x => x.Value == idRespaldado); }
        int? _estatusid = _selectedAction?.Value;
        StateHasChanged();
        string jsonString = JsonSerializer.Serialize(_filterValues);


        var serviceResponse = await FigoService.Export(Session.UserId,Session.SupplierId, _reportingTypeValue ?? 0, jsonString);
        if (serviceResponse.Processed)
        {
            _success = true;
            _nestedErrorMessage = "";

            var base64File = Convert.ToBase64String(serviceResponse.Data.ToArray());
            var fileUrl = $"data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{base64File}";
            await JSRuntime.InvokeVoidAsync("downloadFile", fileUrl, "Reporte.xlsx");

        }
        else
        {
            _success = false;
            _nestedErrorMessage = serviceResponse.Message ?? MessageEnum.ExportNotOK.GetStringValue();
            OpenNested();
        }
    }

    public class SelectValidator<T> : AbstractValidator<T>
    {

        public SelectValidator(Action<IRuleBuilderInitial<T, T>> rule)
        {
            rule(RuleFor(x => x));
        }


        private IEnumerable<string> ValidateValue(T arg)
        {
            var result = Validate(arg);
            if (result.IsValid)
                return new string[0];
            return result.Errors.Select(e => e.ErrorMessage);
        }

        public Func<T, IEnumerable<string>> Validation => ValidateValue;

    }
}