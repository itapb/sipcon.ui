                                            ReadOnly="true" />


                            <MudStack Row="true">

                                <MudTextField Typo="Typo.caption" T="string" Text="@_model.Plate"
                                                Label="Placa"
                                                Variant="Variant.Text"
                                                Margin="Margin.None"
                                                ReadOnly="true" />

                                <MudTextField Typo="Typo.caption" T="string" Text="@_model.Year"
                                                Label="Año"
                                                Variant="Variant.Text"
                                                Margin="Margin.None"
