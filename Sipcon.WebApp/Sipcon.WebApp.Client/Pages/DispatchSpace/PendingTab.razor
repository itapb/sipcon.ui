@inject HubEventsService hubEventsService
@implements IDisposable
@using System.Collections.Generic
@using MudBlazor.Utilities

<MudDataGrid @ref="@DataGrid" T="BackOrder"
             ServerData="@ServerReload"
             Hover FixedHeader Groupable
             Height="calc(100vh - 310px)">
    <ToolBarContent>
        <MudTextField T="string"
                      Value="searchString"
                      ValueChanged="@(s => OnSearch(s))"
                      Placeholder="buscar"
                      Adornment="Adornment.Start"
                      IconSize="Size.Medium"
                      Class="mt-0"
                      Style="font-size: 14px; line-height: 0.8rem;"
                      Typo="Typo.caption" />
        <MudSpacer />
        <MudSpacer />
        <MudSpacer />

        <MudSelect T="string" @bind-Value="SelectedmGroup"
                   Immediate="true" FitContent="true"
                   @bind-Value:after="AfterAsync">
            @foreach (var mgroup in mGroups)
            {
                <MudSelectItem T="string" Value="@mgroup">@mgroup</MudSelectItem>
            }
        </MudSelect>

        <MudSwitch T="bool"
                   @bind-Value="@StockOnly"
                   @bind-Value:after="OnFilterChanged"
                   Label="CON STOCK"
                   Color="Color.Success"
                   CheckedIcon="@Icons.Material.Filled.Inventory"
                   UncheckedIcon="@Icons.Material.Filled.Inventory2" />

        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                       Color="Color.Info"
                       OnClick="ClickRefresh" />

        @if (Modules != null)
        {
            <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="Open user menu">
                @foreach (var strmodulo in Modules)
                {
                    @if (strmodulo.ActionName is "UNASSIGN" or "UNAVAILABLE" or "DECLINE")
                    {
                        <MudMenuItem Label="@GetActionDisplayName(strmodulo.ActionName)"
                                     Icon="@GetActionIcon(strmodulo.ActionName)"
                                     IconColor="@GetActionIconColor(strmodulo.ActionName)"
                                     OnClick="@(() => ClickMenu(strmodulo.ActionName))" />
                    }
                }
            </MudMenu>
        }
    </ToolBarContent>

    <Columns>
        <TemplateColumn>
            <HeaderTemplate>
                <MudCheckBox @bind-Value="IsAllCheckBoxSelected"
                             @bind-Value:after="AfterAsyncAllCheck" />
            </HeaderTemplate>
            <CellTemplate>
                <MudCheckBox @bind-Value="@context.Item.IsSelected" />
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x => x.SaleOrderNumber" Title="NRO PEDIDO"
                        Groupable="@(_saleOrderNumberGrouping)"
                        @bind-Grouping="_saleOrderNumberGrouping"
                        GroupBy="_groupBy1"
                        @bind-GroupByOrder="_saleOrderNumberOrder"
                        @bind-GroupExpanded="_saleOrderNumberExpanded">
            <GroupTemplate>
                @if (_customizeGroupTemplate)
                {
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Dark" Size="Size.Small" Class="mr-2" />
                        <span style="font-weight:bold">@context.Grouping.Key</span>
                        <MudChip Variant="Variant.Outlined" Color="Color.Dark" Size="Size.Small" Class="ml-2">
                            @context.Grouping.Count() Repuesto
                        </MudChip>
                        <MudChip Variant="Variant.Outlined" Color="Color.Dark" Size="Size.Small" Class="ml-2">
                            @context.Grouping.Select(x => x.DealerName).FirstOrDefault()
                        </MudChip>
                        <MudChip Variant="Variant.Outlined" Color="Color.Dark" Size="Size.Small" Class="ml-2">
                            @context.Grouping.Sum(x => x.Quantity) Unidad
                        </MudChip>
                    </div>
                }
                else
                {
                    <span style="font-weight:bold">@context.Grouping.Key</span>
                }
            </GroupTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.CreatedDate" Title="FECHA">
            <GroupTemplate>
                <span style="font-weight:bold">
                    FECHA: @context.Grouping.Key
                    <MudChip Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">
                        total @context.Grouping.Count()
                    </MudChip>
                </span>
            </GroupTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.DealerName" Title="CONCESIONARIO" Groupable="false" />

        <PropertyColumn Property="x => x.PartInnerCode" Title="CODIGO"
                        Groupable="@(_partInnerCodeGrouping)"
                        @bind-Grouping="_partInnerCodeGrouping"
                        GroupBy="_groupBy1"
                        @bind-GroupByOrder="_partInnerCoderOrder"
                        @bind-GroupExpanded="_partInnerCodeExpanded">
            <GroupTemplate>
                @if (_customizeGroupTemplate)
                {
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Hardware" Color="Color.Dark" Size="Size.Small" Class="mr-2" />
                        <span style="font-weight:bold">@context.Grouping.Key</span>
                        <MudChip Variant="Variant.Outlined" Color="Color.Dark" Size="Size.Small" Class="ml-2">
                            @context.Grouping.Select(x => x.DealerName).Distinct().Count() Concesionario
                        </MudChip>
                        <MudChip Variant="Variant.Outlined" Color="Color.Dark" Size="Size.Small" Class="ml-2">
                            @context.Grouping.Sum(x => x.Quantity) Cantidad
                        </MudChip>
                    </div>
                }
                else
                {
                    <span style="font-weight:bold">@context.Grouping.Key</span>
                }
            </GroupTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.PartDescription" Title="DESCRIPCION" Groupable="false" />
        <PropertyColumn Property="x => x.Quantity" Title="CANTIDAD" Groupable="false" Format="N0" />

        <PropertyColumn Property="x => x.TypeName" Title="TIPO"
                        Groupable="@(_typeIdCodeGrouping)"
                        @bind-Grouping="_typeIdCodeGrouping"
                        GroupBy="_groupBy1"
                        @bind-GroupByOrder="_typeIdCodeOrder"
                        @bind-GroupExpanded="_typeIdCodeExpanded">
            <GroupTemplate>
                @if (_customizeGroupTemplate)
                {
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Bloodtype" Color="Color.Dark" Size="Size.Small" Class="mr-2" />
                        <span style="font-weight:bold">@context.Grouping.Key</span>
                        <MudChip Variant="Variant.Outlined" Color="Color.Dark" Size="Size.Small" Class="ml-2">
                            @context.Grouping.Select(x => x.DealerName).Distinct().Count() Concesionario
                        </MudChip>
                        <MudChip Variant="Variant.Outlined" Color="Color.Dark" Size="Size.Small" Class="ml-2">
                            @context.Grouping.Sum(x => x.Quantity) Cantidad
                        </MudChip>
                    </div>
                }
                else
                {
                    <span style="font-weight:bold">@context.Grouping.Key</span>
                }
            </GroupTemplate>
        </PropertyColumn>

        <TemplateColumn Title="ESTATUS">
            <CellTemplate>
                <MudChip Size="Size.Small"
                         Color="@GetStatusColor(context.Item.Status)"
                         Variant="Variant.Filled">
                    @context.Item.Status
                </MudChip>
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x => x.Stock" Title="EXISTENCIA" Groupable="false" />
        <PropertyColumn Property="x => x.Arrival" Title="FECHA LLEGADA" Groupable="false" />

        <TemplateColumn StickyRight="true">
            <CellTemplate>
                <MudIconButton Size="@Size.Small"
                               Icon="@Icons.Material.Outlined.Edit"
                               Color="Color.Primary"
                               OnClick="() => ClickEdit(context.Item)"
                               Title="Editar" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>

    <PagerContent>
        <MudDataGridPager T="BackOrder"
                          PageSizeOptions="new int[] { 100 }"
                          InfoFormat="{first_item}-{last_item} de {all_items}"
                          RowsPerPageString="Registros por Pagina" />
    </PagerContent>
</MudDataGrid>

@code {
    [Inject] private UserSession Session { get; set; } = null!;
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;
    [Inject] private Repository.Auth.AuthenticationProviderJWT AuthenticationStateProvider { get; set; } = null!;
    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;

    [Parameter] public List<Module>? Modules { get; set; }
    [Parameter] public List<SelectOption>? AllStatuses { get; set; }

    public bool StockOnly { get; set; } = false;
    string SelectedmGroup = "NRO PEDIDO";
    string[] mGroups = ["NRO PEDIDO", "CODIGO PARTE", "TIPO"];

    DialogOptions options = new() { MaxWidth = MaxWidth.Large, BackdropClick = false, NoHeader = true };
    private MudDataGrid<BackOrder> DataGrid = null!;
    private string? searchString = string.Empty;

    private bool _customizeGroupTemplate = true;
    private bool _saleOrderNumberGrouping = true;
    private int _saleOrderNumberOrder;
    private bool _partInnerCodeGrouping = false;
    private int _partInnerCoderOrder;
    private bool _typeIdCodeGrouping = false;
    private int _typeIdCodeOrder;
    private bool _saleOrderNumberExpanded = false;
    private bool _partInnerCodeExpanded = false;
    private bool _typeIdCodeExpanded = false;

    private Func<BackOrder, object>? _groupBy1;
    bool IsAllCheckBoxSelected = false;

    // *** OPTIMIZACIÓN: CancellationToken para cancelar peticiones obsoletas ***
    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        await AuthenticationStateProvider.RefreshStaticVariables();
        hubEventsService.OnSupplierChanged += ReloadGrid;
        hubEventsService.OnDealerChanged += ReloadGrid;
    }

    private async Task<GridData<BackOrder>> ServerReload(GridState<BackOrder> state)
    {
        // *** OPTIMIZACIÓN: Cancelar petición anterior si aún está en vuelo ***
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;

        IsAllCheckBoxSelected = false;

        var offset = state.Page * state.PageSize;
        string url = $"api/BackOrder/GetAll?userId={Session.UserId}&supplierId={Session.SupplierId}" +
                     $"&dealerId={Session.DealerId}&rowFrom={offset}&stockOnly={StockOnly}" +
                     $"&filter={searchString}&tab=PENDIENTES";

        try
        {
            var response = await Http.GetAsync(url, token);

            if (token.IsCancellationRequested)
                return new GridData<BackOrder> { TotalItems = 0, Items = [] };

            if (response.IsSuccessStatusCode)
            {
                var content = await response.Content.ReadFromJsonAsync<WebApiResponse<List<BackOrder>>>(
                    cancellationToken: token);

                IEnumerable<BackOrder> data = content?.data ?? [];

                if (state.SortDefinitions.FirstOrDefault() is SortDefinition<BackOrder> sortDefinition)
                {
                    data = data.OrderByDirection(
                        sortDefinition.Descending ? SortDirection.Descending : SortDirection.Ascending,
                        GetSortKeySelector(sortDefinition.SortBy));
                }

                return new GridData<BackOrder>
                {
                    TotalItems = content!.total ?? 0,
                    Items = data
                };
            }

            var errorMessage = await response.Content.ReadAsStringAsync(token);
            throw new Exception(errorMessage);
        }
        catch (OperationCanceledException)
        {
            return new GridData<BackOrder> { TotalItems = 0, Items = [] };
        }
    }
    private Func<BackOrder, object> GetSortKeySelector(string sortByPropertyName) => sortByPropertyName switch
    {
        nameof(BackOrder.SaleOrderNumber) => o => (object)(o.SaleOrderNumber ?? 0),
        nameof(BackOrder.CreatedDate) => o => (object)(o.CreatedDate ?? DateTime.MinValue),
        nameof(BackOrder.DealerName) => o => (object)(o.DealerName ?? ""),
        nameof(BackOrder.PartInnerCode) => o => (object)(o.PartInnerCode ?? ""),
        nameof(BackOrder.PartDescription) => o => (object)(o.PartDescription ?? ""),
        nameof(BackOrder.Quantity) => o => (object)(o.Quantity ?? 0),
        nameof(BackOrder.TypeName) => o => (object)(o.TypeName ?? ""),
        nameof(BackOrder.Status) => o => (object)(o.Status ?? ""),
        nameof(BackOrder.Stock) => o => (object)(o.Stock ?? 0),
        nameof(BackOrder.Arrival) => o => (object)(o.Arrival ?? DateTime.MinValue),
        _ => o => (object)(o.SaleOrderNumber ?? 0)
    };
    private async Task AfterAsync()
    {
        // *** OPTIMIZACIÓN: asignación directa, sin múltiples reloads ***
        _saleOrderNumberGrouping = SelectedmGroup == "NRO PEDIDO";
        _partInnerCodeGrouping = SelectedmGroup == "CODIGO PARTE";
        _typeIdCodeGrouping = SelectedmGroup == "TIPO";
        await DataGrid!.ReloadServerData();
    }

    private async Task AfterAsyncAllCheck()
    {
        DataGrid?.FilteredItems.ToList().ForEach(item => item.IsSelected = IsAllCheckBoxSelected);
        StateHasChanged();
        await Task.CompletedTask;
    }

    private async Task OnFilterChanged() => await DataGrid!.ReloadServerData();

    private async Task ClickRefresh() => await DataGrid!.ReloadServerData();

    private async Task OnSearch(string text)
    {
        if (text.Length == 0 || text.Length >= 3)
        {
            searchString = text;
            await DataGrid!.ReloadServerData();
        }
    }

    private async Task ClickMenu(string? actionName)
    {
        if (actionName == "EXPORT")
        {
            var result = await Http.GetAsync(
                $"api/BackOrder/Export?filter={searchString}&userId={Session.UserId}" +
                $"&supplierId={Session.SupplierId}&dealerId={Session.DealerId}&tab=PENDIENTES");
            if (result.IsSuccessStatusCode)
            {
                var bytes = await result.Content.ReadAsByteArrayAsync();
                var fileUrl = $"data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{Convert.ToBase64String(bytes)}";
                await JSRuntime.InvokeVoidAsync("downloadFile", fileUrl, "BackOrders_Pendientes.xlsx");
            }
            else
            {
                var err = await result.Content.ReadAsStringAsync();
                await DialogService.ShowDialog(err, "Error", "OK", Color.Error, Icons.Material.Filled.Error);
            }
            return;
        }

        if (Modules == null || !Modules.Any())
        {
            await DialogService.ShowDialog("No hay módulos disponibles", "Error", "OK",
                Color.Error, Icons.Material.Filled.Error);
            return;
        }

        var mActions = DataGrid?.FilteredItems
            .Where(item => item.IsSelected)
            .Select(item => new Models.Action
            {
                UserId = Session.UserId,
                RecordId = item.Id,
                ModuleId = Modules!.FirstOrDefault()?.Id,
                ActionName = actionName,
                ActionComment = "",
                RelatedId = 0
            }).ToList();

        if (mActions is not { Count: > 0 })
        {
            await DialogService.ShowDialog("Acción no permitida, verificar datos seleccionado(s)",
                "Error", "OK", Color.Error, Icons.Material.Filled.Error);
            return;
        }

        if (actionName == "ASSIGN")
        {
            var dialogRef = await DialogService.ShowAsync<AssignUserToBackOrder>("",
                new DialogParameters { ["SelectedActions"] = mActions, ["moduleName"] = "INVENTARIO-MOVIL-RECOLECCION" }, options);
            if (await Useful.AsyncDialogResultIsOk(dialogRef))
                await DataGrid!.ReloadServerData();
        }
        else if (actionName == "DECLINE")
        {
            var dialogRef = await DialogService.ShowAsync<BackOrderPartDeclineReason>("", new DialogParameters { }, options);
            if ((await dialogRef.Result) is { Canceled: false, Data: string comment })
            {
                mActions.ForEach(a => a.ActionComment = comment);
                await PostActionAndReload(mActions, $"api/BackOrder/PostActions?userId={Session.UserId}");
            }
        }
        else
        {
            await PostActionAndReload(mActions, $"api/BackOrder/PostActions?userId={Session.UserId}");
        }
    }

    private async Task PostActionAndReload(List<Models.Action>? actions, string uri)
    {
        if (actions is not { Count: > 0 }) return;

        var response = await Http.PostAsync(uri,
            new StringContent(System.Text.Json.JsonSerializer.Serialize(actions), null, "application/json"));

        if (response.IsSuccessStatusCode)
        {
            await DialogService.ShowDialog(Useful.OkSavedMessage, "Acción", "OK",
                Color.Info, Icons.Material.Filled.Commit);
            await DataGrid!.ReloadServerData();
        }
        else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            var conflict = await response.Content.ReadFromJsonAsync<WebApiResponse<object?>>();
            await DialogService.ShowDialog(conflict?.message!, "Error", "OK",
                Color.Error, Icons.Material.Filled.Error);
        }
        else
        {
            var err = await response.Content.ReadAsStringAsync();
            await DialogService.ShowDialog(err, "Error", "OK", Color.Error, Icons.Material.Filled.Error);
        }
    }

    private async Task ClickEdit(BackOrder item)
    {
        var mBackOrderItem = new BackOrderItem { Id = item.Id, Quantity = item.Quantity, Arrival = item.Arrival };
        var dialogRef = await DialogService.ShowAsync(typeof(PartToBackOrderDetails), "",
            new DialogParameters { ["mBackOrderItem"] = mBackOrderItem }, options);
        if ((await dialogRef.Result) is { Canceled: false })
            await DataGrid!.ReloadServerData();
    }

    private Color GetStatusColor(string? status) => status switch
    {
        "PENDIENTE" => Color.Transparent,
        _ => Color.Default
    };

    private string GetActionDisplayName(string actionName) => actionName switch
    {
        "UNAVAILABLE" => "BACKORDER",
        "UNASSIGN" => "POR ASIGNAR",
        "DECLINE" => "RECHAZAR",
        _ => actionName
    };

    private string GetActionIcon(string actionName) => actionName switch
    {
        "UNAVAILABLE" => Icons.Material.Filled.HourglassBottom,
        "UNASSIGN" => Icons.Material.Filled.AssignmentInd,
        "DECLINE" => Icons.Material.Filled.ThumbDown,
        _ => Icons.Material.Filled.MoreHoriz
    };

    private Color GetActionIconColor(string actionName) => actionName switch
    {
        "UNAVAILABLE" or "UNASSIGN" or "DECLINE" => Color.Info,
        _ => Color.Default
    };

    private async Task ReloadGrid() =>
    await InvokeAsync(async () =>
    {
        if (DataGrid != null)
            await DataGrid.ReloadServerData();
        StateHasChanged();
    });

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        hubEventsService.OnSupplierChanged -= ReloadGrid;
        hubEventsService.OnDealerChanged -= ReloadGrid;
    }
}
