@inject HubEventsService hubEventsService
@implements IDisposable
@inject ILogger<CompletedTab> Logger
@using Microsoft.Extensions.Logging
@using System.Collections.Generic
@using MudBlazor.Utilities

<MudDataGrid @ref="@DataGrid" T="BackOrder"
             ServerData="@ServerReload"
             Hover FixedHeader Groupable
             Height="calc(100vh - 310px)">
    <ToolBarContent>
        <MudTextField T="string"
                      Value="searchString"
                      ValueChanged="@(s => OnSearch(s))"
                      Placeholder="buscar"
                      Adornment="Adornment.Start"
                      IconSize="Size.Medium"
                      Class="mt-0"
                      Style="font-size: 14px; line-height: 0.8rem;"
                      Immediate="true"
                      Typo="Typo.caption">
        </MudTextField>

        <MudSpacer />

        <div id="scroll_section" class="mx-auto" style="max-width: 650px">
            <MudExpansionPanels Outlined="false" Elevation="0">
                <MudExpansionPanel @ref="_filtersPanel" @bind-Expanded="@_openFilters" HideIcon="true" ShowExpandIcon="false">
                    <TitleContent>
                        <div class="d-flex">
                            @if (!_openFilters)
                            {
                                <div class="d-flex">
                                    <MudIcon Icon="@Icons.Material.Filled.FilterAlt"
                                             Color="Color.Info"></MudIcon>
                                </div>
                            }
                        </div>
                    </TitleContent> 
                    <ChildContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
                            <!-- Fecha Desde -->
                            <MudDatePicker @ref="_pickerFrom"
                                           @bind-Date="_dateFrom"
                                           Style="font-size: 14px;line-height: 0.8rem;min-width: 120px;"
                                           Adornment="Adornment.Start"
                                           AdornmentColor="Color.Info"
                                           Class="align-right"
                                           Placeholder="Fecha Desde"
                                           Variant="Variant.Text"
                                           PickerVariant="PickerVariant.Inline"
                                           Margin="Margin.None"
                                           DateFormat="dd/MM/yyyy"
                                           AutoClose="true"
                                           Clearable="true">
                                <PickerActions>
                                    <MudButton Class="mr-auto align-self-start" OnClick="@(() => _pickerFrom.ClearAsync())">Borrar</MudButton>
                                    <MudButton OnClick="@(() => _pickerFrom.CloseAsync(false))">Cancelar</MudButton>
                                </PickerActions>
                            </MudDatePicker>

                            <!-- Fecha Hasta -->
                            <MudDatePicker @ref="_pickerTo"
                                           @bind-Date="_dateTo"
                                           Style="font-size: 14px;line-height: 0.8rem;min-width: 120px;"
                                           Adornment="Adornment.Start"
                                           AdornmentColor="Color.Info"
                                           Class="align-right"
                                           Placeholder="Fecha Hasta"
                                           Variant="Variant.Text"
                                           PickerVariant="PickerVariant.Inline"
                                           Margin="Margin.None"
                                           DateFormat="dd/MM/yyyy"
                                           AutoClose="true"
                                           Clearable="true">
                                <PickerActions>
                                    <MudButton Class="mr-auto align-self-start" OnClick="@(() => _pickerTo.ClearAsync())">Borrar</MudButton>
                                    <MudButton OnClick="@(() => _pickerTo.CloseAsync(false))">Cancelar</MudButton>
                                </PickerActions>
                            </MudDatePicker>

                            <!-- Selector de Estatus -->
                            <MudSelect T="SelectOption"
                                       @bind-Value="_selectedStatus"
                                       ToStringFunc="@(e => e?.Text)"
                                       Placeholder="ESTATUS"
                                       Adornment="Adornment.Start"
                                       AdornmentIcon="@Icons.Material.Filled.Label"
                                       AdornmentColor="Color.Info"
                                       Style="font-size: 14px;line-height: 0.8rem;min-width: 160px;"
                                       Variant="Variant.Text"
                                       Clearable="true"
                                       Dense="true">
                                @if (_statuses != null)
                                {
                                    @foreach (var status in _statuses)
                                    {
                                        <MudSelectItem T="SelectOption" Value="@status">@status.Text</MudSelectItem>
                                    }
                                }
                            </MudSelect>

                            <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Info" OnClick="ClickRefresh" />
                        </MudStack>
                    </ChildContent>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </div>
         
        <MudSelect T="string" @bind-Value="SelectedmGroup"
                   Immediate="true" FitContent="true"
                   @bind-Value:after="AfterAsync"
                   Style="font-size: 14px; width: 160px;"
                   Variant="Variant.Text"
                   Dense="true">
            @foreach (var mgroup in mGroups)
            {
                <MudSelectItem T="string" Value="@mgroup">@mgroup</MudSelectItem>
            }
        </MudSelect>

        <MudSwitch T="bool"
                   @bind-Value="@StockOnly"
                   @bind-Value:after="OnFilterChanged"
                   Label="CON STOCK"
                   Color="Color.Success"
                   CheckedIcon="@Icons.Material.Filled.Inventory"
                   UncheckedIcon="@Icons.Material.Filled.Inventory2" />

        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Info" OnClick="ClickRefresh" />

        @if (Modules != null)
        {
            <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="Open user menu">
                @foreach (var strmodulo in Modules)
                {
                    @if (strmodulo.ActionName == "EXPORT")
                    {
                        <MudMenuItem Label="@strmodulo.ActionDisplay"
                                     Icon="@(strmodulo.ActionDisplay.ToActionIcon())"
                                     IconColor="@Color.Info"
                                     OnClick="@(() => ClickMenu(strmodulo.ActionName))" />
                    }
                }
            </MudMenu>
        }
    </ToolBarContent>

    <Columns>
        @* SIN CHECKBOX *@

        <PropertyColumn Property="x => x.SaleOrderNumber" Title="NRO PEDIDO" Groupable="@(_saleOrderNumberGrouping)"
                        @bind-Grouping="_saleOrderNumberGrouping" GroupBy="_groupBy1"
                        @bind-GroupByOrder="_saleOrderNumberOrder"
                        @bind-GroupExpanded="_saleOrderNumberExpanded">
            <GroupTemplate>
                @if (_customizeGroupTemplate)
                {
                    var color = context.Grouping.Key?.ToString() switch
                    {
                        "Healthcare" => Color.Primary,
                        "Tech" => Color.Secondary,
                        "Tourism" => Color.Info,
                        _ => Color.Dark
                    };
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Business" Color="@color" Size="Size.Small" Class="mr-2" />
                        <span style="font-weight:bold">@context.Grouping.Key</span>
                        <MudChip Variant="Variant.Outlined" Color="@color" Size="Size.Small" Class="ml-2">
                            @context.Grouping.Count() Repuesto
                        </MudChip>
                        <MudChip Variant="Variant.Outlined" Color="@color" Size="Size.Small" Class="ml-2">
                            @context.Grouping.Select(x => x.DealerName).FirstOrDefault()?.ToString()
                        </MudChip>
                        <MudChip Variant="Variant.Outlined" Color="@color" Size="Size.Small" Class="ml-2">
                            @context.Grouping.Sum(x => x.Quantity) Unidad
                        </MudChip>
                    </div>
                }
                else
                {
                    <span style="font-weight:bold">@(context.Grouping.Key)</span>
                }
            </GroupTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.CreatedDate" Title="FECHA">
            <GroupTemplate>
                @if (_customizeGroupTemplate)
                {
                    <span style="font-weight:bold">FECHA: @context.Grouping.Key <MudChip Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">total @context.Grouping.Count()</MudChip></span>
                }
                else
                {
                    <span style="font-weight:bold">@context.Title: @(context.Grouping.Key)</span>
                }
            </GroupTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.DealerName" Title="CONCESIONARIO" Groupable="false" />

        <PropertyColumn Property="x => x.PartInnerCode" Title="CODIGO" Groupable="@(_partInnerCodeGrouping)"
                        @bind-Grouping="_partInnerCodeGrouping" GroupBy="_groupBy1"
                        @bind-GroupByOrder="_partInnerCoderOrder"
                        @bind-GroupExpanded="_partInnerCodeExpanded">
            <GroupTemplate>
                @if (_customizeGroupTemplate)
                {
                    var color = context.Grouping.Key?.ToString() switch
                    {
                        "Healthcare" => Color.Primary,
                        "Tech" => Color.Secondary,
                        "Tourism" => Color.Info,
                        _ => Color.Dark
                    };
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Hardware" Color="@color" Size="Size.Small" Class="mr-2" />
                        <span style="font-weight:bold">@context.Grouping.Key</span>
                        <MudChip Variant="Variant.Outlined" Color="@color" Size="Size.Small" Class="ml-2">
                            @context.Grouping.Select(x => x.DealerName).Distinct().Count() Concesionario
                        </MudChip>
                        <MudChip Variant="Variant.Outlined" Color="@color" Size="Size.Small" Class="ml-2">
                            @context.Grouping.Sum(x => x.Quantity) Cantidad
                        </MudChip>
                    </div>
                }
                else
                {
                    <span style="font-weight:bold">@(context.Grouping.Key)</span>
                }
            </GroupTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.PartDescription" Title="DESCRIPCION" Groupable="false" />
        <PropertyColumn Property="x => x.Quantity" Title="CANTIDAD" Groupable="false" Format="N0" />

        <PropertyColumn Property="x => x.TypeName" Title="TIPO" Groupable="@(_typeIdCodeGrouping)"
                        @bind-Grouping="_typeIdCodeGrouping" GroupBy="_groupBy1"
                        @bind-GroupByOrder="_typeIdCodeOrder"
                        @bind-GroupExpanded="_typeIdCodeExpanded">
            <GroupTemplate>
                @if (_customizeGroupTemplate)
                {
                    var color = context.Grouping.Key?.ToString() switch
                    {
                        "Healthcare" => Color.Primary,
                        "Tech" => Color.Secondary,
                        "Tourism" => Color.Info,
                        _ => Color.Dark
                    };
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Bloodtype" Color="@color" Size="Size.Small" Class="mr-2" />
                        <span style="font-weight:bold">@context.Grouping.Key</span>
                        <MudChip Variant="Variant.Outlined" Color="@color" Size="Size.Small" Class="ml-2">
                            @context.Grouping.Select(x => x.DealerName).Distinct().Count() Concesionario
                        </MudChip>
                        <MudChip Variant="Variant.Outlined" Color="@color" Size="Size.Small" Class="ml-2">
                            @context.Grouping.Sum(x => x.Quantity) Cantidad
                        </MudChip>
                    </div>
                }
                else
                {
                    <span style="font-weight:bold">@(context.Grouping.Key)</span>
                }
            </GroupTemplate>
        </PropertyColumn>
        <TemplateColumn Title="ESTATUS">
            <CellTemplate>
                <MudChip Size="Size.Small"
                         Color="@GetStatusColor(context.Item.Status)"
                         Variant="Variant.Filled">
                    @context.Item.Status
                </MudChip>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.Stock" Title="EXISTENCIA" Groupable="false" />
        <PropertyColumn Property="x => x.Arrival" Title="FECHA LLEGADA" Groupable="false" />
        @* SIN BOTÓN EDITAR *@
    </Columns>

    <PagerContent>
        <MudDataGridPager T="BackOrder" PageSizeOptions="new int[] { 100 }" InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Registros por Pagina" />
    </PagerContent>
</MudDataGrid>

@* <div class="d-flex flex-wrap mt-4">
    <MudButton OnClick="@ExpandAllGroupsAsync" Color="@Color.Primary">Expand all</MudButton>
    <MudButton OnClick="@CollapseAllGroupsAsync" Color="@Color.Primary">Collapse all</MudButton>
</div> *@

@code {
    [Inject] private UserSession Session { get; set; } = null!;
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;
    [Inject] private Repository.Auth.AuthenticationProviderJWT AuthenticationStateProvider { get; set; } = null!;
    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;

    [Parameter] public List<Module>? Modules { get; set; }
    [Parameter] public List<SelectOption>? AllStatuses { get; set; }

    public bool StockOnly { get; set; } = false;
    string SelectedmGroup = "NRO PEDIDO";
    string[] mGroups = ["NRO PEDIDO", "CODIGO PARTE", "TIPO"];

    private MudDataGrid<BackOrder> DataGrid = null!;
    private string? searchString = string.Empty;

    private bool _customizeGroupTemplate = true;
    private bool _customizeGroupBy;
    private bool _customizeGroupStyle;
    private bool _saleOrderNumberGrouping = true;
    private int _saleOrderNumberOrder;
    private bool _partInnerCodeGrouping = false;
    private int _partInnerCoderOrder;
    private bool _typeIdCodeGrouping = false;
    private int _typeIdCodeOrder;

    private bool _saleOrderNumberExpanded = false;
    private bool _partInnerCodeExpanded = false;
    private bool _typeIdCodeExpanded = false;

    private DateRange? _dateRange { get; set; }
    private Func<BackOrder, object>? _groupBy1;
    private MudExpansionPanel _filtersPanel = new();
    bool _loading = true;

    // Filtros avanzados
    private bool _openFilters = false;
    private DateTime? _dateFrom { get; set; } = null;
    private DateTime? _dateTo { get; set; } = null;
    private MudDatePicker _pickerFrom = new();
    private MudDatePicker _pickerTo = new();
    private List<SelectOption> _statuses = new();
    private SelectOption? _selectedStatus;

    private async Task OnFilterChanged() => await DataGrid!.ReloadServerData();

    private async Task ClearDateFrom()
    {
        _dateFrom = null;
        await _pickerFrom.ClearAsync();
        await DataGrid!.ReloadServerData();
    }

    private async Task ClearDateTo()
    {
        _dateTo = null;
        await _pickerTo.ClearAsync();
        await DataGrid!.ReloadServerData();
    }

    protected override async Task OnInitializedAsync()
    {
        await AuthenticationStateProvider.RefreshStaticVariables();

        // Filtrar estatus para este tab  
        _statuses = AllStatuses?.Where(s => s != null && (
            (s.Text?.Contains("PROCESS") ?? false) ||
            (s.Text?.Contains("DECLINE") ?? false) ||
            (s.Text?.Contains("Procesado") ?? false) ||
            (s.Text?.Contains("Rechazado") ?? false) ||
            s.Value == 18 ||
            s.Value == 19
        )).ToList() ?? new();

        hubEventsService.OnSupplierChanged += ReloadGrid;
        hubEventsService.OnDealerChanged += ReloadGrid;
    }
    private Color GetStatusColor(string? status)
    {
        return status switch
        {
            "RECHAZADO" => Color.Error,
            "PROCESADO" => Color.Success,
            _ => Color.Default
        };
    }
    private async Task AfterDateRangeAsync()
    {
        if (_dateRange is not null) await DataGrid!.ReloadServerData();
    }

    private async Task AfterAsync()
    {
        _saleOrderNumberGrouping = false;
        _partInnerCodeGrouping = false;
        _typeIdCodeGrouping = false;
        switch (SelectedmGroup)
        {
            case "NRO PEDIDO":
                _saleOrderNumberGrouping = true;
                break;
            case "CODIGO PARTE":
                _partInnerCodeGrouping = true;
                break;
            case "TIPO":
                _typeIdCodeGrouping = true;
                break;
        }
        await DataGrid!.ReloadServerData();
    }

    private async Task<GridData<BackOrder>> ServerReload(GridState<BackOrder> state)
    {
        await AuthenticationStateProvider.RefreshStaticVariables();

        _loading = true;

        string rowFromParam = state.Page > 0 ? $"&rowFrom={state.Page * state.PageSize}" : "";

        var totalItems = 0;
        IEnumerable<BackOrder> data;

        string _dateFromStr = _dateFrom?.ToString("yyyy-MM-dd") ?? string.Empty;
        string _dateToStr = _dateTo?.ToString("yyyy-MM-dd") ?? string.Empty;
        int? _estatusId = _selectedStatus?.Value;

        string url = $"api/BackOrder/GetAll?userId={Session.UserId}&supplierId={Session.SupplierId}&dealerId={Session.DealerId}{rowFromParam}&filter={searchString}&startdate={_dateFromStr}&enddate={_dateToStr}&estatusId={_estatusId}&tab=ATENDIDOS&stockOnly={StockOnly}";

        HttpResponseMessage response = await Http.GetAsync(url);
        if (response.IsSuccessStatusCode)
        {
            var content2 = await response.Content.ReadFromJsonAsync<WebApiResponse<List<BackOrder>>>();
            totalItems = content2!.total ?? 0;
            data = content2!.data ?? new List<BackOrder>();
        }
        else
        {
            var errorMessage = await response.Content.ReadAsStringAsync();
            throw new Exception(errorMessage);
        }

        _loading = false;

        return new GridData<BackOrder> { TotalItems = totalItems, Items = data };
    }

    private Task ExpandAllGroupsAsync() => DataGrid.ExpandAllGroupsAsync();
    private Task CollapseAllGroupsAsync() => DataGrid.CollapseAllGroupsAsync();

    private async Task OnSearch(string text)
    {
        if (text.Length == 0 || text.Length >= 3)
        {
            _loading = true;
            searchString = text;
            await DataGrid!.ReloadServerData();
        }
    }

    private async Task ClickRefresh()
    {
        await DataGrid!.ReloadServerData();
        if (_openFilters)
        {
            await _filtersPanel.CollapseAsync();
        }
    }

    private async Task ClickMenu(string? actionName)
    {
        if (actionName == "EXPORT")
        {
            _loading = true;

            string _dateFromStr = _dateFrom?.ToString("yyyy-MM-dd") ?? string.Empty;
            string _dateToStr = _dateTo?.ToString("yyyy-MM-dd") ?? string.Empty;
            int? _estatusId = _selectedStatus?.Value;

            var ResultZonas = await Http.GetAsync($"api/BackOrder/Export?filter={searchString}&userId={Session.UserId}&supplierId={Session.SupplierId}&dealerId={Session.DealerId}&tab=ATENDIDOS&startdate={_dateFromStr}&enddate={_dateToStr}&estatusId={_estatusId}");

            if (ResultZonas.IsSuccessStatusCode)
            {
                var fileContent = await ResultZonas.Content.ReadAsByteArrayAsync();
                var base64File = Convert.ToBase64String(fileContent);
                var fileUrl = $"data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{base64File}";
                await JSRuntime.InvokeVoidAsync("downloadFile", fileUrl, "BackOrders_Atendidos.xlsx");
            }
            else
            {
                var errorMessage = await ResultZonas.Content.ReadAsStringAsync();
                await DialogService.ShowDialog(errorMessage, "Error", "OK", Color.Error, Icons.Material.Filled.Error);
            }
            _loading = false;
        }
    }

    private async Task ReloadGrid()
    {
        if (DataGrid != null)
            await DataGrid.ReloadServerData();
    }

    public void Dispose()
    {
        hubEventsService.OnSupplierChanged -= ReloadGrid;
        hubEventsService.OnDealerChanged -= ReloadGrid;
    }
}