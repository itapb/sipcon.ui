@page "/dispatchcontrol"
<CustomBreadcrumbs mItems="ItemsNavigate"></CustomBreadcrumbs>
<MudTabs Elevation="2" Rounded="true" Centered="true" ApplyEffectsToContainer="true" PanelClass="pa-2" Color="Color.Info">
    <MudTabPanel Icon="@Icons.Material.Filled.PendingActions" Text="PENDIENTES" RenderPanel="false">
        <PendingTab Modules="Modules" AllStatuses="AllStatuses" />
    </MudTabPanel>

    <MudTabPanel Icon="@Icons.Material.Filled.MarkUnreadChatAlt" Text="POR ATENDER" RenderPanel="false">
        <PendingActionTab Modules="Modules" AllStatuses="AllStatuses" />
    </MudTabPanel>

    <MudTabPanel Icon="@Icons.Material.Filled.Verified" Text="ATENDIDOS" RenderPanel="false">
        <CompletedTab Modules="Modules" AllStatuses="AllStatuses" />
    </MudTabPanel>
</MudTabs>

@code {
    [Inject] private UserSession Session { get; set; } = null!;
    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private UtilModuleActions ModuleActionsService { get; set; } = default!;
    [Inject] private ILogger<ControlTab> Logger { get; set; } = default!;

    List<BreadcrumbItem> ItemsNavigate = new();
    private List<Module>? Modules { get; set; }
    private List<SelectOption>? AllStatuses { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Configurar breadcrumbs
        string hrefMovement = "dispatchcontrol";
        "Home,Inventario,Control Despacho".Split(',').ToList().ForEach(s =>
            ItemsNavigate.Add(new BreadcrumbItem(s, href: (s == "Home" ? "" : hrefMovement), icon: s.ToActionIcon())));

        // Cargar datos comunes
        await LoadCommonData();
    }

    private async Task LoadCommonData()
    {
        try
        {
            // Cargar módulos
            Modules = await Http.GetFromJsonAsync<List<Module>>($"api/Module/GetAll?moduleName=INVENTARIO-PROCESOS-CONTROLDESPACHO&userId={Session.UserId}");

            // Cargar todos los estatus  
            var statuses = await ModuleActionsService.GetAction(Session.UserId, "INVENTARIO-PROCESOS-CONTROLDESPACHO");
            AllStatuses = statuses ?? new List<SelectOption>();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error cargando datos comunes en DispatchControl");
        }
    }
}
 