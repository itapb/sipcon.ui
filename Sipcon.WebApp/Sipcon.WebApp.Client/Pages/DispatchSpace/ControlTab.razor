@page "/dispatchcontrol"
@inject ILogger<ControlTab> Logger

<CustomBreadcrumbs mItems="ItemsNavigate"></CustomBreadcrumbs>

<MudTabs @ref="_tabs"
         Elevation="2" Rounded="true" Centered="true"
         ApplyEffectsToContainer="true" PanelClass="pa-2"
         Color="Color.Info"
         @bind-ActivePanelIndex="_activeTabIndex"
         @bind-ActivePanelIndex:after="OnTabChanged">
    <MudTabPanel Icon="@Icons.Material.Filled.PendingActions" Text="PENDIENTES">
        @if (_tabsLoaded[0])
        {
            <PendingTab Modules="Modules" AllStatuses="AllStatuses" />
        }
    </MudTabPanel>
    <MudTabPanel Icon="@Icons.Material.Filled.MarkUnreadChatAlt" Text="POR ATENDER">
        @if (_tabsLoaded[1])
        {
            <PendingActionTab Modules="Modules" AllStatuses="AllStatuses" />
        }
    </MudTabPanel>
    @if (_moduleActions.Any(x => x.Text.Equals("ASIGNAR", StringComparison.OrdinalIgnoreCase)))
    {
        <MudTabPanel Icon="@Icons.Material.Filled.Verified" Text="ATENDIDOS">
            @if (_tabsLoaded[2])
            {
                <CompletedTab Modules="Modules" AllStatuses="AllStatuses" />
            }
        </MudTabPanel>
    }
    </MudTabs>

@code {
    [Inject] private UserSession Session { get; set; } = null!;
    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private UtilModuleActions ModuleActionsService { get; set; } = default!;

    List<BreadcrumbItem> ItemsNavigate = new();
    private List<Module>? Modules { get; set; }
    private List<SelectOption>? AllStatuses { get; set; }
    private MudTabs _tabs = null!;
    private int _activeTabIndex = 0;

    private bool[] _tabsLoaded = [true, false, false];
    private List<ModuleAction> _moduleActions = new();

    private void OnTabChanged()
    {
        if (_activeTabIndex >= 0 && _activeTabIndex < _tabsLoaded.Length)
            _tabsLoaded[_activeTabIndex] = true;
    }

    protected override async Task OnInitializedAsync()
    {
        string hrefMovement = "dispatchcontrol";
        "Home,Inventario,Control Despacho".Split(',').ToList().ForEach(s =>
            ItemsNavigate.Add(new BreadcrumbItem(s,
                href: s == "Home" ? "" : hrefMovement,
                icon: s.ToActionIcon())));

        await LoadCommonData();

        if (_activeTabIndex >= 0 && _activeTabIndex < _tabsLoaded.Length)
            _tabsLoaded[_activeTabIndex] = true;
    }

    private async Task LoadCommonData()
    {
        try
        {
            string moduleName = "INVENTARIO-PROCESOS-CONTROLDESPACHO";

            var modulesTask = Http.GetFromJsonAsync<List<Module>>(
                $"api/Module/GetAll?moduleName={moduleName}&userId={Session.UserId}");
            var statusesTask = ModuleActionsService.GetStatusByModule(
                Session.UserId, moduleName); 
            var actionsTask = ModuleActionsService.GetModuleActions(Session.UserId, moduleName);

           
            await Task.WhenAll(modulesTask, statusesTask, actionsTask); 

            _moduleActions = actionsTask.Result ?? new(); 
            Modules = modulesTask.Result;
            AllStatuses = statusesTask.Result ?? new();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error cargando datos comunes en DispatchControl");
        }
    }
}