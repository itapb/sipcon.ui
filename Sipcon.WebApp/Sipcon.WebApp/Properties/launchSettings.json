      "applicationUrl": "http://localhost:5091",
      "launchUrl": "sipconappdev",
      //"launchUrl": "sipconapp/process-list",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "https": {
      "hotReloadEnabled": false,
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
