<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <base href="@AppSettingsHelper.GetAppSetting(AppSettingsHelper.GetAppSetting("PathBase"))" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href=@Assets["_content/MudBlazor/MudBlazor.min.css"] rel="stylesheet" />
    <link href=@Assets["_content/Gotho.BlazorPdf/blazorpdf.min.css"] rel="stylesheet" />
    <link href=@Assets["css/site.css"] rel="stylesheet" />
    <link href=@Assets["css/chatbot.css"] rel="stylesheet" />
    <ImportMap />
    <link rel="icon" type="image/ico" href="ico.ico" />
    <HeadOutlet @rendermode="@PageRenderMode" />
</head>

<body>
    <Routes @rendermode="@PageRenderMode"  />

    <div class="coni-bot" style="@(IsVisibleBot ? "" : "display: none;")">
        <!-- Burbuja "Soy CONI" para el login-->
        <div id="coni-login-bubble">👋 Soy <b>CONI</b><br>¿Te ayudo?</div>

        <!-- Botón flotante principal (logo) -->
        <div class="chatbot-button" title="Abrir chatbot">
            <img src="images/coni-logo.png" alt="CONI" />
        </div>

        <!-- Overlay que difumina el fondo cuando el menú está abierto -->
        <div class="chatbot-overlay" aria-hidden="true"></div>

        <!-- Ventana del Chatbot -->
        <div class="chatbot-window" role="dialog" aria-label="Chatbot CONI">
            <div class="chatbot-header">
                <img src="images/coni-logo.png" alt="CONI" />
                <h3>CONI</h3>
                <button class="chatbot-close" aria-label="Cerrar chat">✕</button>
            </div>

            <div class="chatbot-body">
            </div>
            <div class="chatbot-input">
                <div class="menu-placeholder"></div>

                <input type="text" placeholder="Escribe aquí..." aria-label="Escribe un mensaje" />
                <button class="send-button" aria-label="Enviar">➡</button>
            </div>
        </div>
    </div>
    



    <script src="_framework/blazor.web.js"></script>
    <script src=@Assets["_content/MudBlazor/MudBlazor.min.js"]></script>

    <script src="@Assets["js/sipconapp.js"]"></script>
    <!-- Script del chatbot-->
    <script src="@Assets["js/chatbot.js"]" defer></script>
    <script src="js/dragdrop.js"></script>
   
</body>

</html>
@code {

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;
    [CascadingParameter] private bool IsVisibleBot { get; set; } = false;

    private IComponentRenderMode? PageRenderMode
        => HttpContext.AcceptsInteractiveRouting() ? new InteractiveAutoRenderMode(prerender: false) : null;
    // new InteractiveAutoRenderMode(prerender: false)
    //InteractiveAuto
    //InteractiveServer
    //InteractiveWebAssembly


   
}